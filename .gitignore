.idea
node_modules/
.pnpm-store/
packages/plugins/.tmp-upstream-*/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# Local Agent UI tooling data; project configuration and source records remain tracked.
.agent-ui/creator/*
!.agent-ui/creator/.env.example
.agent-ui/operator/
.agent-ui/connection.local.json
.agent-ui/visual-observations/
examples/creator-host-sandbox/.env.local
examples/creator-assistant-host/.env.local
examples/creator-embedded-host/.env.local
examples/creator-host-sandbox/.env.development.local
examples/creator-assistant-host/.env.development.local
examples/creator-embedded-host/.env.development.local
__pycache__/
.pytest_cache/
.venv/
*.pyc
apps/creator-workbench/test-results/
apps/creator-workbench/playwright-report/

# Generated logical views; edit src/plugins and src/shared instead.
packages/plugins/src/internal/vendor-generated/assistant-ui/
packages/plugins/src/internal/adapters-generated/assistant-ui/
packages/plugins/resources/registry/items/plugin/*/files/
packages/plugins/resources/registry/items/plugin/*/changelog.json

# TypeScript authoring resolution generated from the source-layout owners.
packages/plugins/.typecheck/

# Documentation build output and cache
website/doc_build/
website/.rspress/

# Maintained examples track generated source and portable project metadata.
examples/creator-host-sandbox/.agent-ui/*
!examples/creator-host-sandbox/.agent-ui/project.json
!examples/creator-host-sandbox/.agent-ui/source-lock.json
!examples/creator-host-sandbox/.agent-ui/.gitignore
!examples/creator-host-sandbox/.agent-ui/mocks/
examples/creator-host-sandbox/.agent-ui/mocks/*
!examples/creator-host-sandbox/.agent-ui/mocks/*.jsonl
examples/creator-assistant-host/.agent-ui/*
!examples/creator-assistant-host/.agent-ui/project.json
!examples/creator-assistant-host/.agent-ui/source-lock.json
!examples/creator-assistant-host/.agent-ui/.gitignore
!examples/creator-assistant-host/.agent-ui/mocks/
examples/creator-assistant-host/.agent-ui/mocks/*
!examples/creator-assistant-host/.agent-ui/mocks/*.jsonl
examples/creator-embedded-host/.agent-ui/*
!examples/creator-embedded-host/.agent-ui/project.json
!examples/creator-embedded-host/.agent-ui/source-lock.json
!examples/creator-embedded-host/.agent-ui/.gitignore
!examples/creator-embedded-host/.agent-ui/mocks/
examples/creator-embedded-host/.agent-ui/mocks/*
!examples/creator-embedded-host/.agent-ui/mocks/*.jsonl

# Generated offline documentation handoff; copy with source into the intranet.
artifacts/creator-documentation/
