# Local Agent UI / Creator configuration. Never commit .agent-ui/creator/.env.local.
# CREATOR_* values are server-only; do not prefix credentials with VITE_.
# Copy this file to .agent-ui/creator/.env.local at the workspace root.
CREATOR_MODEL_BASE_URL=
CREATOR_MODEL_API_KEY=
CREATOR_MODEL_NAME=mimo-v2.5-pro
CREATOR_MODEL_MAX_TOKENS=8192
# Estimated total request budget (messages, system/tools and output reserve).
# CREATOR_CONTEXT_MAX_TOKENS=65536
# CREATOR_CONTEXT_KEEP_TOKENS=12000
# Set to 0 only to disable snapshot offloading and history summaries; inspection deduplication remains.
# CREATOR_CONTEXT_COMPRESSION=1
# For OpenCode Go only; sends the Creator thread ID as x-opencode-session.
# CREATOR_MODEL_OPENCODE_SESSION_HEADER=1

# Optional: attach the Vite host to an already-running local Node Agent.
# Configure both values together; otherwise Vite owns a managed Node Agent process.
# CREATOR_ENDPOINT=http://127.0.0.1:8010
# CREATOR_AUTH_TOKEN=development-only-token-1234567890

# Optional diagnostic mode override (echo, minimal, or domain-read):
# CREATOR_AGENT_MODE=minimal
