# Local-only model configuration for the default Python Creator control plane.
# Copy this file to .env.creator.local at the workspace root.
CREATOR_MODEL_BASE_URL=
CREATOR_MODEL_API_KEY=
CREATOR_MODEL_NAME=mimo-v2.5-pro

# Optional emergency fallback only:
# CREATOR_AGENT_RUNTIME=typescript

# Optional diagnostic mode override (echo, minimal, or domain-read):
# CREATOR_PYTHON_AGENT_MODE=minimal
