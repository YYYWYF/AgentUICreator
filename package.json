{
  "name": "agent-ui-creator-workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": "^22.0.0 || ^24.22.1"
  },
  "scripts": {
    "preinstall": "node scripts/check-dependency-pins.mjs",
    "dev": "node scripts/dev-workbench.mjs",
    "build": "node scripts/build-workspace.mjs",
    "check:assistant-ui-upstream": "pnpm --filter @za38.03/agent-ui-plugins check:assistant-ui-upstream",
    "check:assistant-ui-latest": "pnpm --filter @za38.03/agent-ui-plugins check:assistant-ui-latest",
    "check:assistant-ui-revision": "pnpm --filter @za38.03/agent-ui-plugins check:assistant-ui-revision",
    "assistant-ui:update": "node scripts/update-assistant-ui.mjs",
    "check:assistant-ui-agui-compat": "node scripts/check-assistant-ui-agui-compat.mjs",
    "check:assistant-ui-langgraph-compat": "node scripts/check-assistant-ui-langgraph-compat.mjs",
    "check:assistant-ui-agui-lockfile": "node scripts/check-ag-ui-lockfile.mjs",
    "assistant-ui:report": "node scripts/generate-assistant-ui-upgrade-report.mjs",
    "typecheck": "node scripts/typecheck-workspace.mjs",
    "test": "pnpm test:ts",
    "test:ts": "node scripts/test-workspace-ts.mjs",
    "verify:style-isolation": "pnpm check:assistant-ui-upstream && pnpm --filter @za38.03/agent-ui-plugins exec vitest run tests/portal-container-boundary.test.tsx tests/agent-theme-prop.test.tsx && pnpm --filter @za38.03/agent-ui-creator test:operator tests/migrated/plugin-style-verifier.test.ts && pnpm test:style-isolation",
    "verify:assistant-ui-upgrade-contract": "pnpm --filter @za38.03/agent-ui-plugins exec vitest run tests/lexical-upgrade-contract.test.mjs tests/assistant-ui-upgrade-drill.test.mjs tests/product-localization-generation.test.mjs",
    "verify:assistant-ui-upgrade": "pnpm verify:assistant-ui-upgrade-contract && pnpm verify:style-isolation",
    "package:repo": "node scripts/package-repository.mjs",
    "check:operator-contract": "node scripts/check-operator-contract.mjs",
    "check:react-compat": "node scripts/check-react-compat.mjs",
    "check:i18n": "node scripts/audit-ui-copy.mjs",
    "audit:ui-copy": "node scripts/audit-ui-copy.mjs --output docs/i18n/ui-copy-audit.json",
    "test:web-component": "pnpm --filter @za38.03/agent-ui-web-component build && pnpm --filter @za38.03/agent-ui-web-component test && pnpm --filter @za38.03/agent-ui-web-component test:distribution && pnpm --filter @za38.03/agent-ui-web-component test:installation && pnpm --filter @za38.03/agent-ui-creator-workbench exec tsc --noEmit -p tsconfig.web-component-tests.json && pnpm --filter @za38.03/agent-ui-creator-workbench exec playwright test -c playwright.web-component.config.ts",
    "check:dependency-pins": "node scripts/check-dependency-pins.mjs",
    "verify:dev-startup": "node scripts/verify-dev-startup.mjs",
    "creator:demo": "node scripts/start-creator-workbench.mjs",
    "build:package": "node scripts/build-public-packages.mjs",
    "verify:package": "node --test scripts/package-ownership.test.mjs && node scripts/verify-public-packages.mjs",
    "prepare:types": "node scripts/prepare-typescript-authoring.mjs",
    "postinstall": "node scripts/prepare-typescript-authoring.mjs",
    "test:types": "node --test scripts/typescript-authoring.test.mjs",
    "dev:vue-host": "pnpm --filter @za38.03/agent-ui-web-component-vue3-demo dev",
    "creator": "pnpm --filter @za38.03/agent-ui-creator build && node packages/creator/dist/cli.js --config-root .",
    "test:style-isolation": "pnpm test:web-component",
    "dev:examples": "node scripts/dev-examples.mjs",
    "dev:host-sandbox": "node scripts/dev-examples.mjs platform",
    "dev:assistant-host": "node scripts/dev-examples.mjs assistant",
    "dev:embedded-host": "node scripts/dev-examples.mjs embedded",
    "test:examples": "node --test scripts/prepare-example-host.test.mjs",
    "docs:dev": "pnpm --dir website dev",
    "docs:build": "pnpm --dir website build",
    "docs:preview": "pnpm --dir website preview",
    "docs:package": "node scripts/creator-documentation.mjs --generate",
    "docs:check": "node scripts/creator-documentation.mjs --check",
    "test:documentation": "node --test scripts/creator-documentation.test.mjs",
    "docs:install": "pnpm --dir website install --frozen-lockfile",
    "check:project-code": "node scripts/project-code-quality.mjs"
  },
  "devDependencies": {
    "typescript-ui-audit": "npm:typescript@5.9.3",
    "get-tsconfig": "4.14.0",
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {}
    },
    "overrides": {
      "@assistant-ui/react": "0.15.31",
      "@assistant-ui/core": "0.3.31",
      "@assistant-ui/store": "0.3.22",
      "@assistant-ui/tap": "0.9.24",
      "assistant-stream": "0.3.54",
      "assistant-cloud": "0.2.8",
      "@assistant-ui/react-markdown": "0.14.6",
      "@assistant-ui/react-lexical": "0.2.15",
      "@assistant-ui/react-ag-ui": "0.1.0",
      "@assistant-ui/react-langgraph": "0.14.29",
      "lexical": "0.51.0",
      "@lexical/react": "0.51.0",
      "@lexical/utils": "0.51.0",
      "@lexical/history": "0.51.0",
      "@lexical/plain-text": "0.51.0",
      "get-tsconfig": "4.14.0",
      "react": "19.1.1",
      "react-dom": "19.1.1",
      "react-test-renderer": "19.1.1",
      "@vitejs/plugin-react": "4.7.0",
      "@vitejs/plugin-vue": "5.2.4",
      "vue-tsc": "3.0.6",
      "vue": "3.5.42",
      "@types/node": "26.6.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/react-test-renderer": "19.1.0",
      "@types/semver": "7.7.1",
      "tailwind-merge": "3.6.0",
      "@types/jsdom": "28.0.3",
      "@ag-ui/client": "1.0.3",
      "@ag-ui/core": "1.0.3"
    }
  }
}
