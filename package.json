{
  "name": "agent-ui-creator-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-workbench.mjs",
    "dev:host-sandbox": "pnpm --filter @agent-ui/creator-host-sandbox dev",
    "dev:assistant-host": "pnpm --filter @agent-ui/creator-assistant-host dev",
    "dev:embedded-host": "pnpm --filter @agent-ui/creator-embedded-host dev",
    "reset:host-sandbox": "pnpm --filter @agent-ui/creator-host-sandbox reset",
    "inspect:host-sandbox": "pnpm --filter @agent-ui/creator-host-sandbox inspect",
    "init:host-sandbox:assistant": "pnpm --filter @agent-ui/creator-host-sandbox init:assistant",
    "init:host-sandbox:embedded": "pnpm --filter @agent-ui/creator-host-sandbox init:embedded",
    "init:host-sandbox:platform": "pnpm --filter @agent-ui/creator-host-sandbox init:platform",
    "creator:python": "scripts/start-creator-python.sh",
    "build": "node scripts/build-workspace.mjs",
    "check:assistant-ui-upstream": "pnpm --filter @agent-ui/react check:assistant-ui-upstream",
    "check:assistant-ui-latest": "pnpm --filter @agent-ui/react check:assistant-ui-latest",
    "check:assistant-ui-revision": "pnpm --filter @agent-ui/react check:assistant-ui-revision",
    "assistant-ui:update": "node scripts/update-assistant-ui.mjs",
    "check:assistant-ui-agui-compat": "node scripts/check-assistant-ui-agui-compat.mjs",
    "check:assistant-ui-langgraph-compat": "node scripts/check-assistant-ui-langgraph-compat.mjs",
    "check:assistant-ui-agui-lockfile": "node scripts/check-ag-ui-lockfile.mjs",
    "assistant-ui:report": "node scripts/generate-assistant-ui-upgrade-report.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:python && pnpm test:ts",
    "test:ts": "node scripts/test-workspace-ts.mjs",
    "test:python:setup": "node scripts/run-python-tests.mjs --setup-only",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:python-live-model": "node scripts/run-python-tests.mjs --live-model",
    "test:python-sidecar": "pnpm test:python:setup && pnpm --filter @agent-ui/creator test:python-sidecar",
    "creator": "pnpm --filter @agent-ui/creator build && node packages/creator/dist/cli.js --project examples/creator-host-sandbox --config-root .",
    "verify:creator:live": "node scripts/run-python-tests.mjs --live-model",
    "verify:creator-package": "node scripts/verify-creator-package.mjs",
    "verify:creator-python-wheel": "node scripts/verify-creator-python-wheel.mjs",
    "test:creator-package-runtime": "node scripts/test-creator-package-runtime.mjs",
    "verify:creator-distribution": "node scripts/verify-creator-distribution.mjs",
    "check:project-control-contract": "node scripts/check-project-control-contract.mjs"
  }
}
