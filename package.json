{
  "name": "agent-ui-creator-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-ui/creator-workbench dev",
    "dev:app": "pnpm --filter @agent-ui/example-agent-frontend dev",
    "build": "pnpm --filter @agent-ui/creator build && pnpm --filter @agent-ui/example-agent-frontend build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:python && pnpm test:ts",
    "test:ts": "pnpm -r --if-present test",
    "test:python:setup": "node scripts/run-python-tests.mjs --setup-only",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:python-live-model": "pnpm test:python:setup && CREATOR_RUN_LIVE_MODEL=1 packages/creator-python/.venv/bin/python -m pytest -m live_model -s packages/creator-python/tests/live",
    "test:python-sidecar": "pnpm test:python:setup && pnpm --filter @agent-ui/creator test:python-sidecar",
    "test:watch": "pnpm --filter @agent-ui/example-agent-frontend test:watch",
    "creator": "pnpm --filter @agent-ui/creator build && node packages/creator/dist/cli.js --project examples/agent-frontend --config-root .",
    "verify:creator:live": "pnpm --filter @agent-ui/creator verify:live"
  }
}
