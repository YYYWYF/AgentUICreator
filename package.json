{
  "name": "agent-ui-creator-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-ui/creator-workbench dev",
    "dev:app": "pnpm --filter @agent-ui/example-agent-frontend dev",
    "creator:python": "scripts/start-creator-python.sh",
    "build": "pnpm --filter @agent-ui/runtime-core build && pnpm --filter @agent-ui/react build && pnpm --filter @agent-ui/runtime-conversation build && pnpm --filter @agent-ui/runtime-react build && pnpm --filter @agent-ui/mock-agent build && pnpm --filter @agent-ui/source-registry build && pnpm --filter @agent-ui/creator build && pnpm --filter @agent-ui/example-agent-frontend build",
    "check:assistant-ui-upstream": "pnpm --filter @agent-ui/react check:assistant-ui-upstream",
    "check:assistant-ui-latest": "pnpm --filter @agent-ui/react check:assistant-ui-latest",
    "check:assistant-ui-revision": "pnpm --filter @agent-ui/react check:assistant-ui-revision",
    "assistant-ui:update": "node scripts/update-assistant-ui.mjs",
    "assistant-ui:report": "node scripts/generate-assistant-ui-upgrade-report.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:python && pnpm test:ts",
    "test:ts": "node --test scripts/run-python-tests.test.mjs && pnpm -r --if-present test",
    "test:python:setup": "node scripts/run-python-tests.mjs --setup-only",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:python-live-model": "node scripts/run-python-tests.mjs --live-model",
    "test:python-sidecar": "pnpm test:python:setup && pnpm --filter @agent-ui/creator test:python-sidecar",
    "test:watch": "pnpm --filter @agent-ui/example-agent-frontend test:watch",
    "creator": "pnpm --filter @agent-ui/creator build && node packages/creator/dist/cli.js --project examples/agent-frontend --config-root .",
    "verify:creator:live": "node scripts/run-python-tests.mjs --live-model"
  }
}
