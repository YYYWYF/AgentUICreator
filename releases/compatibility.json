    {
      "id": "agent-ui-2026-11-16-0.0.10",
      "publishedAt": "2026-11-16T12:36:08.935Z",
      "channel": "stable",
      "node": ">=20.0.0 >=20.0.0 >=20.0.0 >=20.0.0 >=22.0.0 <23.0.0-0 || >=20.0.0 >=20.0.0 >=20.0.0 >=20.0.0 >=24.22.1 <25.0.0-0",
