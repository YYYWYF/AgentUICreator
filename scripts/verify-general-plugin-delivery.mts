/** Generated Host browser check with a local AG-UI fixture; no model is called. */
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath,pathToFileURL} from 'node:url';
import {planPluginSourceTakeover,takeoverPluginSource} from '../packages/operator/src/project/takeover-plugin-source.js';
import {createConnectionHostFixture} from '../apps/creator-workbench/tests/support/agent-connection-host.js';
const repo=fileURLToPath(new URL('..',import.meta.url));
const output=path.join(repo,'docs/verification/general-plugin-delivery-2026-10-17');await mkdir(output,{recursive:true});
const require=createRequire(path.join(repo,'apps/creator-workbench/package.json'));const {chromium}=require('@playwright/test');
const {build}=await import(pathToFileURL(require.resolve('vite')).href);
const fixture=await createConnectionHostFixture({liveModel:false});let browser;
try{
 fixture.enableCors();
 const app=path.join(fixture.hostRoot,'src/agent-ui/plugins/copy-action/index.tsx');
 const original=await readFile(app,'utf8');assert(original.includes('agent-ui-plugins/copy-action'));
 await writeFile(app,original.replace('<Implementation {...props} />','<Implementation {...props} aria-label="thin-copy-verification" style={{padding: 12, backgroundColor: "rgb(243, 232, 255)"}} />'));
 const main=path.join(fixture.hostRoot,'src/main.tsx');await writeFile(main,(await readFile(main,'utf8')).replace('<Agent />',`<Agent endpoint=${JSON.stringify(fixture.agentEndpoint)} locale="zh-CN" />`));
 browser=await chromium.launch({headless:true,...(process.platform==='darwin'?{executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'}:{})});
 const page=await browser.newPage({viewport:{width:1440,height:1000}});page.setDefaultTimeout(45000);const errors=[];page.on('pageerror',e=>errors.push(e.message));
 await page.goto(fixture.hostOrigin);console.log('HOST',fixture.hostRoot,fixture.hostOrigin);
 const input=page.locator('[contenteditable="true"], textarea').last();await input.waitFor();await input.fill('Verify packaged actions');await input.press('Enter');
 await page.getByText('wire:first',{exact:false}).first().waitFor();fixture.finishRun();
 await page.getByText('wire:first wire:finished',{exact:true}).waitFor();
 const copy=page.getByRole('button',{name:'thin-copy-verification'});await copy.waitFor();
 assert.equal(await copy.evaluate(el=>getComputedStyle(el).padding),'12px');
 assert.equal(await copy.evaluate(el=>getComputedStyle(el).backgroundColor),'rgb(243, 232, 255)');
 await copy.waitFor({state:'visible'});await page.waitForFunction(()=>!document.querySelector('[aria-label="thin-copy-verification"]')?.disabled);await copy.hover();
 await page.screenshot({path:path.join(output,'generated-host-thin-props.png'),fullPage:true});
 const pkgFile=path.join(fixture.hostRoot,'package.json');const pkg=JSON.parse(await readFile(pkgFile,'utf8'));pkg.scripts={...pkg.scripts,build:'fixture-build'};await writeFile(pkgFile,JSON.stringify(pkg));
 const applicationBefore=await readFile(app,'utf8');
 const plan=await planPluginSourceTakeover(fixture.hostRoot,{pluginId:'copy-action'});
 await takeoverPluginSource(fixture.hostRoot,{pluginId:'copy-action',planHash:plan.planHash},async staged=>{await build({root:staged,configFile:false,logLevel:'error',build:{write:false,lib:{entry:path.join(staged,'src/agent-ui/plugins/copy-action/definition.ts'),formats:['es']},rollupOptions:{external:id=>!id.startsWith('.')&&!path.isAbsolute(id)}}});});
 assert.equal(await readFile(app,'utf8'),applicationBefore.replace('@za38.03/agent-ui-plugins/copy-action','./source/index'));
 const owned=path.join(fixture.hostRoot,'src/agent-ui/plugins/copy-action/source/adapters/copy-action.tsx');
 await writeFile(owned,(await readFile(owned,'utf8')).replace('<TooltipIconButton','<TooltipIconButton data-source-verification="local"'));
 await page.reload();const nextInput=page.locator('[contenteditable="true"], textarea').last();await nextInput.waitFor();await nextInput.fill('Verify source-owned action');await nextInput.press('Enter');await page.getByText('wire:first',{exact:false}).first().waitFor();fixture.finishRun();await page.getByText('wire:first wire:finished',{exact:true}).first().waitFor();
 const localCopy=page.getByRole('button',{name:'thin-copy-verification'});await localCopy.waitFor();assert.equal(await localCopy.getAttribute('data-source-verification'),'local');assert.equal(await localCopy.evaluate(el=>getComputedStyle(el).padding),'12px');await localCopy.hover();
 await page.screenshot({path:path.join(output,'generated-host-owned-source.png'),fullPage:true});
 await writeFile(path.join(output,'browser.json'),JSON.stringify({mode:'generated-host-real-browser-local-AGUI-fixture-no-model',plugin:'copy-action',sourceOwnedDOM:true,applicationPreserved:true,npmImport:original.includes('agent-ui-plugins/copy-action'),padding:'12px',backgroundColor:'rgb(243, 232, 255)',browserErrors:errors},null,2));assert.deepEqual(errors,[]);
 console.log('BROWSER_PASS');
}finally{await browser?.close();await fixture.close();}
