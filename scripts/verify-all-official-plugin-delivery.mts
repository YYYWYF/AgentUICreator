/** Actual initialized Host with local HTTP AG-UI data, not an external model. */
import assert from "node:assert/strict";
import {createRequire} from "node:module";
import {mkdir,readFile,writeFile} from "node:fs/promises";
import path from "node:path";
import {fileURLToPath,pathToFileURL} from "node:url";
import deliveries from "../packages/plugins/src/catalog/plugin-delivery.json" with {type:"json"};
import {ensurePluginApplication} from "../packages/operator/src/project/plugin-application.js";
import {planPluginSourceTakeover,takeoverPluginSource} from "../packages/operator/src/project/takeover-plugin-source.js";
import {writeGeneratedPluginRegistry} from "../packages/operator/src/generate-plugin-registry.js";
import {createConnectionHostFixture} from "../apps/creator-workbench/tests/support/agent-connection-host.js";
const repo=fileURLToPath(new URL("..",import.meta.url));const output=path.join(repo,"docs/verification/all-official-plugin-delivery-2026-10-17");await mkdir(output,{recursive:true});
const require=createRequire(path.join(repo,"apps/creator-workbench/package.json"));const {chromium}=require("@playwright/test");const {build}=await import(pathToFileURL(require.resolve("vite")).href);
const fixture=await createConnectionHostFixture({mode:"assistant",liveModel:false});let browser;let page;const errors:string[]=[];
try{
 fixture.enableCors();const plugins=deliveries.map(item=>item.id);assert.equal(plugins.length,43);
 for(const id of plugins){await ensurePluginApplication(fixture.hostRoot,id);assert.equal(JSON.parse(await readFile(path.join(fixture.hostRoot,"src/agent-ui/plugins",id,"application.json"),"utf8")).pluginId,id);}
 await writeGeneratedPluginRegistry(fixture.hostRoot);
 const identity=path.join(fixture.hostRoot,"src/agent-ui/plugins/agent-identity/index.tsx");const original=await readFile(identity,"utf8");const custom=original.replace("config={agentIdentityConfig}",'config={{...agentIdentityConfig,name:"工程定制助手"}}').replace("{...props} />",'{...props} rootProps={{"aria-label":"thin-identity",style:{padding:8,border:"2px solid rgb(139, 92, 246)",background:"rgb(245,243,255)"}}} />');assert.notEqual(custom,original);await writeFile(identity,custom);await ensurePluginApplication(fixture.hostRoot,"agent-identity");assert.equal(await readFile(identity,"utf8"),custom);
 const main=path.join(fixture.hostRoot,"src/main.tsx");await writeFile(main,(await readFile(main,"utf8")).replace("<Agent />",`<Agent endpoint=${JSON.stringify(fixture.agentEndpoint)} locale="zh-CN" />`));
 browser=await chromium.launch({headless:true,...(process.platform==="darwin"?{executablePath:"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}:{})});page=await browser.newPage({viewport:{width:1000,height:850}});page.setDefaultTimeout(45000);page.on("pageerror",error=>errors.push(error.message));
 const open=async()=>{await page.locator(".agent-ui-assistant-trigger").click();await page.locator('[aria-label="thin-identity"]').waitFor();assert.equal(await page.locator('[aria-label="thin-identity"]').evaluate(element=>getComputedStyle(element).padding),"8px");await page.getByText("工程定制助手",{exact:true}).waitFor();};
 const run=async()=>{const previous=fixture.runCount();const input=page.locator('[contenteditable="true"], textarea').last();await input.waitFor();await input.fill("Verify all official plugin delivery");await input.press("Enter");await page.getByText("wire:first",{exact:true}).waitFor();assert.equal(fixture.runCount(),previous+1);fixture.finishRun();await page.getByText("wire:first wire:finished",{exact:true}).waitFor();};
 await page.goto(fixture.hostOrigin);await open();await run();await page.locator(".agent-ui-assistant-panel").screenshot({path:path.join(output,"generated-host-all-npm.png"),animations:"disabled"});
 const pkgFile=path.join(fixture.hostRoot,"package.json");const pkg=JSON.parse(await readFile(pkgFile,"utf8"));pkg.scripts={...pkg.scripts,build:"fixture-build"};await writeFile(pkgFile,JSON.stringify(pkg));
 const model=path.join(fixture.hostRoot,"src/agent-ui/app-ui/app-ui.json");const modelBefore=await readFile(model);const preservedFiles=[identity,path.join(fixture.hostRoot,"src/agent-ui/plugins/agent-identity/config.ts"),path.join(fixture.hostRoot,"src/agent-ui/agent-ui/theme/theme-config.ts")];const preserved=new Map<string,Buffer>();for(const file of preservedFiles)preserved.set(file,await readFile(file));
 for(const id of ["agent-identity","conversation-surface","theme-provider"]){const plan=await planPluginSourceTakeover(fixture.hostRoot,{pluginId:id});await takeoverPluginSource(fixture.hostRoot,{pluginId:id,planHash:plan.planHash},async staged=>{await build({root:staged,configFile:false,logLevel:"error",build:{write:false,lib:{entry:path.join(staged,"src/agent-ui/plugins",id,"definition.ts"),formats:["es"]},rollupOptions:{external:id=>!id.startsWith(".")&&!path.isAbsolute(id)}}});});}
 assert.equal(await readFile(identity,"utf8"),preserved.get(identity)!.toString().replaceAll("@za38.03/agent-ui-plugins/agent-identity","./source/index"));for(const [file,bytes] of preserved)if(file!==identity)assert.deepEqual(await readFile(file),bytes);assert.deepEqual(await readFile(model),modelBefore);
 for(const id of ["agent-identity","conversation-surface"]){const source=path.join(fixture.hostRoot,"src/agent-ui/plugins",id,"source/adapters",`${id}.tsx`);const text=await readFile(source,"utf8");const updated=text.replace(`data-ui-plugin="${id}"`,`data-ui-plugin="${id}" data-source-verification="${id}"`);assert.notEqual(updated,text);await writeFile(source,updated);}
 const themeSource=path.join(fixture.hostRoot,"src/agent-ui/plugins/theme-provider/source/adapters/theme-service.ts");await writeFile(themeSource,(await readFile(themeSource,"utf8"))+"\n// local provider customization is independent of Host configuration\n");
 await page.reload();await open();await page.locator('[data-source-verification="agent-identity"]').waitFor();await page.locator('[data-source-verification="conversation-surface"]').waitFor();await run();assert.equal(fixture.runCount(),2);await page.locator(".agent-ui-assistant-panel").screenshot({path:path.join(output,"generated-host-all-owned.png"),animations:"disabled"});assert.deepEqual(errors,[]);
 await writeFile(path.join(output,"browser.json"),JSON.stringify({mode:"real-initialized-assistant-host-local-HTTP-AGUI-no-external-model",modernThinApplications:plugins.length,allApplicationMarkersValidated:true,sourceOwnedPlugins:["agent-identity","conversation-surface","theme-provider"],applicationAndConfigPreserved:true,modelPreserved:true,sourceOwnedIdentityAndSurfaceDOM:true,providerLifecycleStillRuns:true,runCount:fixture.runCount(),padding:"8px",browserErrors:errors},null,2)+"\n");console.log("ALL_OFFICIAL_BROWSER_PASS");
}catch(error){if(page){console.error("BROWSER_ERRORS",JSON.stringify(errors));console.error("BROWSER_BODY",(await page.locator("body").innerText()).slice(0,4500));await page.screenshot({path:"/tmp/all-official-browser-failure.png",fullPage:true});}throw error;}finally{await browser?.close();await fixture.close();}
