import {fileURLToPath} from 'node:url';import assert from 'node:assert/strict';import{readFile,writeFile,readdir}from'node:fs/promises';import{createRequire}from'node:module';import path from'node:path';import{createHash}from'node:crypto';
const repo=fileURLToPath(new URL('..',import.meta.url)),out=process.argv[2]?path.resolve(process.argv[2]):path.join(repo,'docs/verification/creator-real-npm-update-2026-10-18/npm-only');const s=JSON.parse(await readFile(out+'/live-session.json','utf8'));const{chromium}=createRequire(repo+'/apps/creator-workbench/package.json')('@playwright/test');const b=await chromium.connect(s.webSocket);const p=await b.newPage({viewport:{width:1840,height:1250}});p.setDefaultTimeout(60000);const responses:any[]=[],errors:string[]=[];p.on('pageerror',(e:any)=>errors.push(e.message));p.on('response',async(r:any)=>{if(new URL(r.url()).pathname.includes('/__creator/updates/')){const body=await r.json();responses.push({route:new URL(r.url()).pathname,status:r.status(),body});await writeFile(out+'/real-ui-update-responses.json',JSON.stringify(responses,null,2));console.log('UPDATE',new URL(r.url()).pathname,r.status(),body.error??body.status??body.packageUpdates?.status);}});
const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');const snapshot=async()=>{const result:any={};async function walk(dir:string){for(const e of await readdir(dir,{withFileTypes:true})){const f=path.join(dir,e.name);if(e.isDirectory())await walk(f);else result[path.relative(s.hostRoot,f)]=hash(await readFile(f));}}await walk(path.join(s.hostRoot,'src'));return result;};const before=await snapshot(),lockBefore=await readFile(path.join(s.hostRoot,'package-lock.json'),'utf8');
await p.goto(s.creatorOrigin);await p.locator('#creator-request').waitFor();await p.frameLocator('iframe[title="Host Application"]').locator('[data-slot="aui_composer-input"]').waitFor({timeout:120000});
const separator=p.getByRole('separator');if(await separator.count()){await separator.focus();for(let i=0;i<12;i++)await separator.press('ArrowLeft');}
await p.getByRole('button',{name:'设置',exact:true}).click();await p.getByRole('button',{name:'插件更新',exact:true}).click();await p.getByRole('heading',{name:'更新中心',exact:true}).click();await p.getByText('Composer 新增实时输入字数统计',{exact:false}).first().waitFor();await p.screenshot({path:out+'/01-online-actual-versions.png',fullPage:true});
const planning=p.waitForResponse((r:any)=>new URL(r.url()).pathname.endsWith('/packages/plan'),{timeout:180000});await p.getByRole('button',{name:'校验产物并准备升级',exact:true}).click();const plan=await(await planning).json();console.log('PLAN',JSON.stringify(plan));assert(plan.id);await p.getByRole('button',{name:'确认升级依赖',exact:true}).waitFor();await p.screenshot({path:out+'/02-verified-npm-plan.png',fullPage:true});
const installing=p.waitForResponse((r:any)=>new URL(r.url()).pathname.endsWith('/packages/execute'),{timeout:300000});await p.getByRole('button',{name:'确认升级依赖',exact:true}).click();await p.screenshot({path:out+'/03-npm-confirmed-installing.png',fullPage:true});const result=await(await installing).json();assert.equal(result.status,'installed',JSON.stringify(result));await p.getByText('依赖已升级并通过验证。现在可以选择是否同步已托管源码。',{exact:true}).first().waitFor();await p.screenshot({path:out+'/04-real-npm-upgrade-complete.png',fullPage:true});assert.deepEqual(await snapshot(),before);
const lockAfter=await readFile(path.join(s.hostRoot,'package-lock.json'),'utf8');assert.notEqual(lockAfter,lockBefore);assert.equal(JSON.parse(lockAfter).packages['node_modules/@za38.03/agent-ui-plugins'].version,'0.0.2');await writeFile(out+'/npm-only-verification.json',JSON.stringify({realCreator:true,realNpmInstall:true,realModel:false,sourceSync:false,modelBlocker:'api_key_expired',plan,result,sourceFilesUnchanged:true,lockChanged:true,lockHashBefore:hash(Buffer.from(lockBefore)),lockHashAfter:hash(Buffer.from(lockAfter)),pageErrors:errors},null,2));console.log('NPM_UPGRADE_UI_PASS');process.exit(0);
