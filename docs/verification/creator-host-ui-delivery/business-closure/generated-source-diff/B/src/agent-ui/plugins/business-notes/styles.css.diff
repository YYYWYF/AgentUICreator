--- a/src/agent-ui/plugins/business-notes/styles.css
+++ b/src/agent-ui/plugins/business-notes/styles.css
@@ -0,0 +1,105 @@
+.business-notes-plugin {
+  display: flex;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  flex-direction: column;
+  overflow: hidden;
+  padding: 0.75rem;
+  color: var(--business-notes-text);
+  font-family: var(--business-notes-font-family);
+}
+
+.business-notes-modal-title {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+}
+
+.business-notes-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem;
+  flex-shrink: 0;
+  margin-bottom: 0.75rem;
+}
+
+.business-notes-title {
+  margin: 0 !important;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.business-notes-input-row {
+  display: flex;
+  width: 100%;
+  flex-shrink: 0;
+  gap: 0;
+  margin-bottom: 0.75rem;
+}
+
+.business-notes-plugin .business-notes-input-row .ant-input {
+  flex: 1;
+  min-width: 0;
+  color: var(--business-notes-text);
+  font-family: var(--business-notes-font-family);
+  background-color: var(--business-notes-input-background);
+  border-color: var(--business-notes-input-border);
+}
+
+.business-notes-plugin .business-notes-input-row .ant-input:hover:not(:disabled) {
+  border-color: var(--business-notes-input-hover-border);
+}
+
+.business-notes-plugin .business-notes-input-row .ant-input:focus {
+  border-color: var(--business-notes-input-focus-border);
+}
+
+.business-notes-plugin .business-notes-input-row .ant-input:disabled {
+  color: var(--business-notes-input-disabled-text);
+  background-color: var(--business-notes-input-disabled-background);
+  border-color: var(--business-notes-input-border);
+}
+
+.business-notes-plugin .ant-btn,
+.business-notes-plugin .ant-typography {
+  font-family: var(--business-notes-font-family);
+}
+
+.business-notes-modal-theme {
+  color: var(--business-notes-text);
+  font-family: var(--business-notes-font-family);
+}
+
+.business-notes-modal-theme .ant-modal-content,
+.business-notes-modal-theme .ant-modal-header {
+  color: var(--business-notes-text);
+  font-family: var(--business-notes-font-family);
+  background-color: var(--business-notes-modal-background);
+}
+
+.business-notes-modal-theme .ant-modal-title,
+.business-notes-modal-theme .ant-modal-body,
+.business-notes-modal-theme .ant-typography,
+.business-notes-modal-theme .ant-btn {
+  color: var(--business-notes-text);
+  font-family: var(--business-notes-font-family);
+}
+
+.business-notes-list {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+}
+
+.business-notes-item-text {
+  word-break: break-word;
+}
+
+.business-notes-list .ant-empty-description {
+  color: inherit;
+}
