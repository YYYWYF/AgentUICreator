{
  "name": "@agent-ui/project-control",
  "version": "0.1.0",
  "type": "module",
  "description": "Development-only managed Agent UI control plane",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/install.d.mts",
      "import": "./src/install.mjs"
    },
    "./protocol": "./dist/runtime/project-control-runtime.mjs",
    "./dev": {
      "types": "./src/dev.ts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    },
    "./bootstrap-host": {
      "types": "./src/bootstrap-host.d.mts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "typescript": "7.0.2",
    "@agent-ui/bootstrap": "workspace:^",
    "@agent-ui/source-registry": "workspace:^",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "zod": "^4.5.4",
    "@agent-ui/react": "workspace:^",
    "@agent-ui/runtime-core": "workspace:^",
    "@agent-ui/runtime-react": "workspace:^",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "vitest": "^4.1.11",
    "tsx": "4.20.6",
    "jsdom": "^27.0.0",
    "@agent-ui/runtime-conversation": "workspace:^",
    "@agent-ui/source-registry": "workspace:^",
    "@agent-ui/mock-agent": "workspace:^",
    "@agent-ui/bootstrap": "workspace:^",
    "react-test-renderer": "19.2.8",
    "@types/react-test-renderer": "19.1.0",
    "semver": "^7.7.3",
    "@types/semver": "^7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "rxjs": "7.8.1",
    "react-hook-form": "^7",
    "@assistant-ui/react-hook-form": "0.12.34",
    "@assistant-ui/react-generative-ui": "0.0.21",
    "react-markdown": "10.1.0",
    "react-dom": "^19.2.8"
  }
}
