{
  "name": "@agent-ui/project-control",
  "version": "0.1.0",
  "type": "module",
  "description": "Development-only managed Agent UI control plane",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/install.d.mts",
      "import": "./src/install.mjs"
    },
    "./protocol": "./dist/runtime/project-control-runtime.mjs",
    "./resources": {
      "types": "./src/resources.d.mts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    },
    "./updates": {
      "types": "./src/updates.d.mts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    },
    "./commands": {
      "types": "./src/commands.d.mts",
      "import": "./dist/runtime/project-control-runtime.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@agentui/web-component": "workspace:*",
    "typescript": "7.0.2",
    "@agent-ui/bootstrap": "workspace:*",
    "@agent-ui/source-registry": "workspace:*",
    "postcss": "8.5.28",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "zod": "4.5.4",
    "@agent-ui/react": "workspace:*",
    "@agent-ui/runtime-core": "workspace:*",
    "@agent-ui/runtime-react": "workspace:*",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "react": "19.1.1",
    "vitest": "4.1.8",
    "tsx": "4.20.6",
    "jsdom": "27.4.0",
    "react-test-renderer": "19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "semver": "7.8.5",
    "@types/semver": "7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.3.0",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "rxjs": "7.8.1",
    "react-hook-form": "7.88.0",
    "@assistant-ui/react-hook-form": "0.12.34",
    "@assistant-ui/react-generative-ui": "0.0.22",
    "react-markdown": "10.1.0",
    "react-dom": "19.1.1"
  }
}
