{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../packages/project-control/node_modules/@types/react"
      ],
      "react/*": [
        "../../packages/project-control/node_modules/@types/react/*"
      ],
      "@agent-ui/bootstrap": [
        "../../packages/bootstrap/src/index.ts"
      ],
      "@agent-ui/mock-agent": [
        "../../packages/mock-agent/src/index.ts"
      ],
      "@agent-ui/source-registry": [
        "../../packages/source-registry/src/index.ts"
      ],
      "@agent-ui/react": [
        "../../packages/react/src/index.ts"
      ],
      "@agent-ui/runtime-conversation": [
        "../../packages/runtime-conversation/src/index.ts"
      ],
      "@assistant-ui/react": [
        "../../packages/react/node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react-generative-ui": [
        "../../packages/project-control/node_modules/@assistant-ui/react-generative-ui"
      ],
      "@assistant-ui/react-ag-ui": [
        "../../packages/runtime-conversation/node_modules/@assistant-ui/react-ag-ui"
      ],
      "@agent-ui/runtime-core": [
        "../../packages/runtime-core/src/index.ts"
      ],
      "@agent-ui/runtime-react": [
        "../../packages/runtime-react/src/index.ts"
      ],
      "@agent-ui/runtime-core/testing": [
        "../../packages/runtime-core/src/testing/index.ts"
      ],
      "react-markdown": [
        "../../packages/project-control/node_modules/react-markdown"
      ],
      "remark-gfm": [
        "../../packages/project-control/node_modules/remark-gfm"
      ]
    },
    "rootDirs": [
      ".",
      "../../packages/source-registry/registry/items/integration-a2ui/files",
      "../../packages/source-registry/registry/items/integration-generative-ui/files",
      "../../packages/source-registry/registry/items/agent-component-assistant-ui-generative-ui/files"
    ]
  },
  "exclude": [
    "tests/fixtures"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
