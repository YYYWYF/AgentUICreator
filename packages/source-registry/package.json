{
  "name": "@agent-ui/source-registry",
  "version": "0.1.0",
  "description": "Development-time source registry for Agent UI foundations and primitives",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "registry/**",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM_ADAPTATION.md",
    "fixtures/releases/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --import tsx scripts/verify-package-services.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:generative-ui-upstream": "node scripts/sync-generative-ui-upstream.mjs",
    "release:verify": "node --import tsx scripts/prepare-release.mjs --verify",
    "release:prepare": "node --import tsx scripts/prepare-release.mjs",
    "prepublishOnly": "node --import tsx scripts/prepare-release.mjs --verify --publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4",
    "tsx": "4.20.6",
    "esbuild": "0.25.12"
  }
}
