{
  "id": "assistant-ui-tool-group",
  "name": "Assistant UI Tool Group Renderer",
  "description": "Displays one assistant-ui tool group with canonical presentation.",
  "version": "1.0.0",
  "capabilities": ["conversation-tool-group-renderer"],
  "requiresRenderScope": true,
  "authoring": {
    "intents": [
      "show grouped tool activity",
      "restore tool group presentation"
    ],
    "visualRole": "assistant tool group presentation",
    "defaultPlacement": {
      "type": "plugin_slot",
      "parentPluginId": "conversation-surface",
      "slot": "toolGroup"
    }
  }
}
