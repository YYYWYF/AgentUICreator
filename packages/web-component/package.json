    "typecheck": "node scripts/prepare-shell.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:distribution": "node tests/distribution.test.mjs",
    "test:installation": "node tests/installation.test.mjs",
    "prepack": "node ../../scripts/package-build-integrity.mjs check web-component && node ../../scripts/sync-package-release-metadata.mjs web-component",
    "prepublishOnly": "node ../../scripts/package-build-integrity.mjs check web-component && node ../../scripts/sync-package-release-metadata.mjs web-component --publish"
