{
  "name": "@agentui/web-component",
  "version": "0.1.0",
  "description": "Standalone Web Component compatibility host for the React Agent UI",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/agent-ui.js",
  "module": "./dist/agent-ui.es.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/agent-ui.es.js"
    },
    "./agent-ui.js": "./dist/agent-ui.js"
  },
  "sideEffects": true,
  "scripts": {
    "prepare:shell": "node scripts/prepare-shell.mjs",
    "build": "pnpm prepare:shell && tsc --noEmit && vite build && tsc -p tsconfig.types.json && node scripts/finish-build.mjs",
    "typecheck": "pnpm prepare:shell && tsc --noEmit",
    "test": "vitest run",
    "test:distribution": "node tests/distribution.test.mjs"
  },
  "dependencies": {
    "@agent-ui/react": "workspace:^",
    "@agent-ui/runtime-conversation": "workspace:^",
    "@agent-ui/runtime-core": "workspace:^",
    "@agent-ui/runtime-react": "workspace:^",
    "lucide-react": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "@assistant-ui/react-lexical": "0.2.15",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "lexical": "0.51.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "@agent-ui/bootstrap": "workspace:^",
    "@agent-ui/project-control": "workspace:^",
    "@agent-ui/mock-agent": "workspace:^",
    "vitest": "^4.1.11",
    "jsdom": "^27.0.0"
  },
  "agentUICompatibility": {
    "kind": "compatibility",
    "targets": [
      "vue",
      "legacy",
      "html"
    ]
  }
}
