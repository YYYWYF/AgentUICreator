{
  "name": "@agent-ui/runtime-react",
  "version": "0.1.2",
  "description": "Official deterministic React layout runtime for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "jsdom": "^27.0.0",
    "zod": "^4.5.4",
    "react-test-renderer": "19.2.8",
    "@types/react-test-renderer": "19.1.0",
    "tsx": "4.20.6",
    "semver": "^7.7.3",
    "@types/semver": "^7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "rxjs": "7.8.1",
    "react-hook-form": "^7",
    "@assistant-ui/react-hook-form": "0.12.34",
    "@assistant-ui/react-generative-ui": "0.0.22",
    "react-markdown": "10.1.0"
  }
}
