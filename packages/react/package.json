{
  "name": "@agent-ui/react",
  "version": "0.1.0",
  "description": "Public React conversation components for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./lexical": {
      "types": "./dist/lexical.d.ts",
      "import": "./dist/lexical.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-lexical-boundary.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:assistant-ui-upstream": "node scripts/check-assistant-ui-upstream.mjs",
    "check:assistant-ui-latest": "node scripts/check-assistant-ui-latest.mjs",
    "check:assistant-ui-revision": "node scripts/check-assistant-ui-revision.mjs",
    "sync:assistant-ui-upstream": "node scripts/sync-assistant-ui-upstream.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "check:lexical-boundary": "node scripts/check-lexical-boundary.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-markdown": "0.14.16",
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.41.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.13",
    "zustand": "5.0.15",
    "@agent-ui/runtime-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "@assistant-ui/react-lexical": "0.2.15",
    "lexical": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "jsdom": "^27.0.0",
    "zod": "^4.5.4",
    "react-test-renderer": "19.2.8",
    "@types/react-test-renderer": "19.1.0",
    "tsx": "4.20.6",
    "semver": "^7.7.3",
    "@types/semver": "^7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "rxjs": "7.8.1",
    "react-hook-form": "^7",
    "@assistant-ui/react-hook-form": "0.12.34",
    "@assistant-ui/react-generative-ui": "0.0.22",
    "react-markdown": "10.1.0",
    "@assistant-ui/react-lexical": "0.2.15",
    "lexical": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0",
    "@types/jsdom": "^30.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react-lexical": {
      "optional": true
    },
    "lexical": {
      "optional": true
    },
    "@lexical/react": {
      "optional": true
    },
    "@lexical/utils": {
      "optional": true
    },
    "@lexical/history": {
      "optional": true
    },
    "@lexical/plain-text": {
      "optional": true
    }
  }
}
