{
  "name": "@agent-ui/react",
  "version": "0.1.0",
  "description": "Public React conversation components for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "check:assistant-ui-upstream": "node scripts/check-assistant-ui-upstream.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.19",
    "@assistant-ui/react-markdown": "0.14.15",
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.41.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.13",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
