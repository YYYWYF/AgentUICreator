{
  "name": "@za38.03/agent-ui-core",
  "version": "0.0.1",
  "description": "Framework- and protocol-independent runtime contracts for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-package-release-metadata.mjs core && tsc -p tsconfig.build.json && node ../../scripts/sync-package-release-metadata.mjs core",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs core",
    "prepublishOnly": "node ../../scripts/sync-package-release-metadata.mjs core --publish"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentUI": {
    "schemaVersion": 1,
    "compatibility": {
      "schemaVersion": 1,
      "releases": []
    }
  }
}
