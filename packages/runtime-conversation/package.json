{
  "name": "@agent-ui/runtime-conversation",
  "version": "0.1.0",
  "description": "Canonical Conversation runtime adapter for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-consumer-types.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@agent-ui/react": "workspace:*",
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-ag-ui": "0.0.63",
    "@assistant-ui/react-langgraph": "0.14.29",
    "rxjs": "7.8.1",
    "@assistant-ui/core": "0.3.27"
  },
  "peerDependencies": {
    "@agent-ui/runtime-core": "0.1.0",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@agent-ui/runtime-core": "workspace:*",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.1.1",
    "react-test-renderer": "19.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.8"
  }
}
