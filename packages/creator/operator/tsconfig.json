{
  "extends": "../../plugins/tsconfig.authoring-paths.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ],
      "@za38.03/agent-ui-creator/bootstrap": [
        "./src/bootstrap/index.ts"
      ],
      "@za38.03/agent-ui-creator/mock-agent": [
        "../src/mock-agent/index.ts"
      ],
      "@za38.03/agent-ui-creator/source-registry": [
        "./src/source-catalog/index.ts"
      ],
      "@za38.03/agent-ui-plugins": [
        "../../plugins/src/index.ts"
      ],
      "@za38.03/agent-ui-runtime": [
        "../../runtime/src/index.ts"
      ],
      "@assistant-ui/react": [
        "../../plugins/node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react-generative-ui": [
        "../node_modules/@assistant-ui/react-generative-ui"
      ],
      "@assistant-ui/react-ag-ui": [
        "../../runtime/node_modules/@assistant-ui/react-ag-ui"
      ],
      "@za38.03/agent-ui-core": [
        "../../core/src/index.ts"
      ],
      "@za38.03/agent-ui-renderer": [
        "../../renderer/src/index.ts"
      ],
      "@za38.03/agent-ui-core/testing": [
        "../../core/src/testing/index.ts"
      ],
      "react-markdown": [
        "../node_modules/react-markdown"
      ],
      "remark-gfm": [
        "../node_modules/remark-gfm"
      ],
      "@za38.03/agent-ui-plugins/catalog": [
        "../../plugins/src/catalog/index.ts"
      ]
    },
    "rootDirs": [
      ".",
      "../../plugins/resources/registry/items/integration/a2ui/files",
      "../../plugins/resources/registry/items/integration/generative-ui/files"
    ]
  },
  "exclude": [
    "tests/fixtures"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
