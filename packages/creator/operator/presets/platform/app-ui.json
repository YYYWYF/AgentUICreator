{
  "applicationPlugins": [
    {
      "pluginId": "conversation-data-source"
    },
    {
      "pluginId": "conversation-service"
    },
    {
      "pluginId": "theme-provider"
    },
    {
      "pluginId": "locale-provider"
    },
    {
      "pluginId": "context-retrieval-message"
    }
  ],
  "root": {
    "type": "row",
    "gap": 0,
    "sizes": [
      "280px",
      "minmax(0, 1fr)"
    ],
    "responsive": {
      "type": "drawer",
      "primaryIndex": 1,
      "drawerIndex": 0,
      "minPrimaryWidth": 320
    },
    "children": [
      {
        "type": "panel",
        "child": {
          "type": "column",
          "gap": 0,
          "sizes": [
            "52px",
            "minmax(0, 1fr)"
          ],
          "children": [
            {
              "type": "slot",
              "plugins": [
                {
                  "pluginId": "agent-identity"
                }
              ]
            },
            {
              "type": "slot",
              "plugins": [
                {
                  "pluginId": "conversation-thread-list",
                  "slots": {
                    "headerActions": [
                      {
                        "pluginId": "conversation-new"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "panel",
        "child": {
          "type": "column",
          "gap": 0,
          "sizes": [
            "minmax(0, 1fr)"
          ],
          "children": [
            {
              "type": "slot",
              "plugins": [
                {
                  "pluginId": "conversation-surface",
                  "slots": {
                    "emptySuggestions": [
                      {
                        "pluginId": "conversation-suggestions"
                      }
                    ],
                    "composer": [
                      {
                        "pluginId": "composer",
                        "slots": {
                          "leadingActions": [
                            {
                              "pluginId": "add-attachment-action"
                            }
                          ],
                          "submitAction": [
                            {
                              "pluginId": "submit-action"
                            }
                          ],
                          "beforeInput": [
                            {
                              "pluginId": "conversation-quote"
                            }
                          ]
                        }
                      }
                    ],
                    "reasoningGroup": [
                      {
                        "pluginId": "reasoning"
                      }
                    ],
                    "toolGroup": [
                      {
                        "pluginId": "tool-group"
                      }
                    ],
                    "toolFallback": [
                      {
                        "pluginId": "tool-result"
                      }
                    ],
                    "assistantResponseFooter": [
                      {
                        "pluginId": "response-footer",
                        "slots": {
                          "actions": [
                            {
                              "pluginId": "copy-action"
                            },
                            {
                              "pluginId": "reload-action"
                            },
                            {
                              "pluginId": "export-markdown-action"
                            }
                          ]
                        }
                      }
                    ],
                    "transientMessages": [
                      {
                        "pluginId": "transient-assistant-messages"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
