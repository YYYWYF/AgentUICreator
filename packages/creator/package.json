{
  "name": "@za38.03/agent-ui-creator",
  "version": "0.0.1",
  "description": "TypeScript Creator Agent, Operator tools and development workbench in one npm package",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.22.1"
  },
  "bin": {
    "agent-ui-creator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vitePlugin.js"
    },
    "./ui": {
      "types": "./dist/ui/CreatorWorkbench.d.ts",
      "import": "./dist/ui/CreatorWorkbench.js"
    },
    "./runtime-diagnostics": {
      "types": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.d.ts",
      "import": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.js"
    },
    "./visual-observation": {
      "types": "./dist/visual-observation/VisualObservationReporter.d.ts",
      "import": "./dist/visual-observation/VisualObservationReporter.js"
    },
    "./ui.css": "./dist/ui/creator-workbench.css",
    "./host-preview": {
      "types": "./dist/host-preview/hostPreviewWorkbench.d.ts",
      "import": "./dist/host-preview/hostPreviewWorkbench.js"
    },
    "./host-preview/client": "./dist/host-preview/hostPreviewClient.js",
    "./host-preview/vite": {
      "types": "./dist/host-preview/vite.d.ts",
      "import": "./dist/host-preview/vite.js"
    },
    "./server": {
      "types": "./dist/standaloneServer.d.ts",
      "import": "./dist/standaloneServer.js"
    },
    "./dock": {
      "types": "./dist/dock/creatorDock.d.ts",
      "import": "./dist/dock/creatorDock.js"
    },
    "./dock/vite": {
      "types": "./dist/dock/vite.d.ts",
      "import": "./dist/dock/vite.js"
    },
    "./dock/rsbuild": {
      "types": "./dist/dock/rsbuild.d.ts",
      "import": "./dist/dock/rsbuild.js"
    },
    "./dock/webpack": {
      "types": "./dist/dock/webpack.d.ts",
      "import": "./dist/dock/webpack.js",
      "require": "./dist/dock/webpack.js"
    },
    "./mock-agent": {
      "types": "./dist/mock-agent/index.d.ts",
      "import": "./dist/mock-agent/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json",
    "./bootstrap": {
      "types": "./dist/operator/dist/types/bootstrap/index.d.ts",
      "import": "./dist/operator/dist/bootstrap/index.js"
    },
    "./source-registry": {
      "types": "./dist/operator/dist/types/source-catalog/index.d.ts",
      "import": "./dist/operator/dist/source-catalog/index.js"
    },
    "./package.json": "./package.json",
    "./project": {
      "types": "./dist/operator/dist/types/install.d.mts",
      "import": "./dist/operator/src/install.mjs"
    },
    "./project/protocol": "./dist/operator/dist/runtime/operator-runtime.mjs",
    "./project/resources": {
      "types": "./dist/operator/dist/types/resources.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./project/dev": {
      "types": "./dist/operator/dist/types/dev.d.ts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./project/updates": {
      "types": "./dist/operator/dist/types/updates.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./project/commands": {
      "types": "./dist/operator/dist/types/commands.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./project/host": {
      "types": "./dist/operator/dist/types/host.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./creator-runtime": {
      "types": "./dist/creatorRuntimeDistribution.d.ts",
      "import": "./dist/creatorRuntimeDistribution.js"
    },
    "./cli": "./dist/cli.js",
    "./process": {
      "types": "./dist/CreatorProcessManager.d.ts",
      "import": "./dist/CreatorProcessManager.js"
    }
  },
  "files": [
    "dist",
    "skills/**/*.md",
    "docs/**/*.md",
    "docs/images/*.jpg"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-package-release-metadata.mjs creator && node operator/scripts/build.mjs && node scripts/clean-dist.mjs && node scripts/copy-operator-assets.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/build-browser.mjs && node ../../scripts/sync-package-release-metadata.mjs creator && node ../../scripts/creator-documentation.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run && node ../../scripts/run-plugin-source-views-check.mjs operator-test",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs creator && node ../../scripts/creator-documentation.mjs",
    "test:operator": "node ../../scripts/run-plugin-source-views-check.mjs operator-test",
    "typecheck:operator": "node ../../scripts/run-plugin-source-views-check.mjs operator-typecheck",
    "prepublishOnly": "node ../../scripts/sync-package-release-metadata.mjs creator --publish && node ../../scripts/creator-documentation.mjs --check"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-to-image": "1.11.13",
    "lucide-react": "1.41.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "@za38.03/agent-ui-core": "workspace:*",
    "@za38.03/agent-ui-web-component": "workspace:*",
    "typescript": "7.0.2",
    "postcss": "8.5.28",
    "zod": "4.5.4",
    "@za38.03/agent-ui-plugins": "workspace:*",
    "semver": "7.8.5",
    "langchain": "1.5.19",
    "@langchain/core": "1.3.0",
    "@langchain/openai": "1.7.0",
    "@langchain/langgraph": "1.5.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "picomatch": "4.0.7",
    "@za38.03/agent-ui-runtime": "workspace:*",
    "prettier": "3.6.2"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vite": "^6.4.5 || >=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "6.4.5",
    "vitest": "4.1.8",
    "@assistant-ui/react": "0.15.31",
    "rxjs": "7.8.1",
    "esbuild": "0.25.12",
    "@za38.03/agent-ui-renderer": "workspace:*",
    "tsx": "4.20.6",
    "react-test-renderer": "19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "@types/semver": "7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "react-hook-form": "7.88.0",
    "@assistant-ui/react-hook-form": "0.12.34",
    "typescript": "7.0.2",
    "@assistant-ui/generative-ui": "0.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentUI": {
    "schemaVersion": 1,
    "compatibility": {
      "schemaVersion": 1,
      "releases": []
    }
  }
}
