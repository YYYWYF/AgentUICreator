{
  "name": "@za38.03/agent-ui-creator",
  "version": "0.0.1",
  "description": "Python Creator Agent with a single npm installation and TypeScript Operator host",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "agent-ui-creator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vitePlugin.js"
    },
    "./ui": {
      "types": "./dist/ui/CreatorWorkbench.d.ts",
      "import": "./dist/ui/CreatorWorkbench.js"
    },
    "./runtime-diagnostics": {
      "types": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.d.ts",
      "import": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.js"
    },
    "./visual-observation": {
      "types": "./dist/visual-observation/VisualObservationReporter.d.ts",
      "import": "./dist/visual-observation/VisualObservationReporter.js"
    },
    "./ui.css": "./dist/ui/creator-workbench.css",
    "./host-preview": {
      "types": "./dist/host-preview/hostPreviewWorkbench.d.ts",
      "import": "./dist/host-preview/hostPreviewWorkbench.js"
    },
    "./host-preview/client": "./dist/host-preview/hostPreviewClient.js",
    "./host-preview/vite": {
      "types": "./dist/host-preview/vite.d.ts",
      "import": "./dist/host-preview/vite.js"
    },
    "./server": {
      "types": "./dist/standaloneServer.d.ts",
      "import": "./dist/standaloneServer.js"
    },
    "./dock": {
      "types": "./dist/dock/creatorDock.d.ts",
      "import": "./dist/dock/creatorDock.js"
    },
    "./dock/vite": {
      "types": "./dist/dock/vite.d.ts",
      "import": "./dist/dock/vite.js"
    },
    "./dock/rsbuild": {
      "types": "./dist/dock/rsbuild.d.ts",
      "import": "./dist/dock/rsbuild.js"
    },
    "./dock/webpack": {
      "types": "./dist/dock/webpack.d.ts",
      "import": "./dist/dock/webpack.js",
      "require": "./dist/dock/webpack.js"
    },
    "./mock-agent": {
      "types": "./dist/mock-agent/index.d.ts",
      "import": "./dist/mock-agent/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json",
    "./operator": {
      "types": "./dist/operator/dist/types/install.d.mts",
      "import": "./dist/operator/src/install.mjs"
    },
    "./operator/protocol": "./dist/operator/dist/runtime/operator-runtime.mjs",
    "./operator/resources": {
      "types": "./dist/operator/dist/types/resources.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./operator/dev": {
      "types": "./dist/operator/dist/types/dev.d.ts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./operator/updates": {
      "types": "./dist/operator/dist/types/updates.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./operator/commands": {
      "types": "./dist/operator/dist/types/commands.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./operator/host": {
      "types": "./dist/operator/dist/types/host.d.mts",
      "import": "./dist/operator/dist/runtime/operator-runtime.mjs"
    },
    "./bootstrap": {
      "types": "./dist/operator/dist/types/bootstrap/index.d.ts",
      "import": "./dist/operator/dist/bootstrap/index.js"
    },
    "./source-registry": {
      "types": "./dist/operator/dist/types/source-catalog/index.d.ts",
      "import": "./dist/operator/dist/source-catalog/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills/**/*.md",
    "docs/**/*.md",
    "docs/images/*.jpg"
  ],
  "scripts": {
    "build": "node ../operator/scripts/build-for-creator.mjs && node scripts/build-entry.mjs && node ../../scripts/creator-documentation.mjs",
    "typecheck": "node scripts/build-entry.mjs --check",
    "prepack": "node scripts/build-entry.mjs --check && node ../../scripts/sync-package-release-metadata.mjs creator && node ../../scripts/creator-documentation.mjs",
    "build:entry": "node scripts/build-entry.mjs && node ../../scripts/creator-documentation.mjs",
    "prepublishOnly": "node ../../scripts/sync-package-release-metadata.mjs creator --publish && node scripts/build-entry.mjs --check && node ../../scripts/creator-documentation.mjs --check"
  },
  "dependencies": {
    "@za38.03/agent-ui-operator": "workspace:*"
  },
  "optionalDependencies": {
    "@za38.03/agent-ui-creator-win32-x64": "workspace:*",
    "@za38.03/agent-ui-creator-linux-x64": "workspace:*",
    "@za38.03/agent-ui-creator-linux-arm64": "workspace:*",
    "@za38.03/agent-ui-creator-darwin-x64": "workspace:*",
    "@za38.03/agent-ui-creator-darwin-arm64": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "agentUI": {
    "schemaVersion": 1,
    "compatibility": {
      "schemaVersion": 1,
      "releases": []
    }
  }
}
