{
  "name": "@agent-ui/creator",
  "version": "0.1.0",
  "description": "Development-time host and Workbench for the Python Agent UI Creator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-ui-creator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vitePlugin.js"
    },
    "./ui": {
      "types": "./dist/ui/CreatorWorkbench.d.ts",
      "import": "./dist/ui/CreatorWorkbench.js"
    },
    "./runtime-diagnostics": {
      "types": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.d.ts",
      "import": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.js"
    },
    "./visual-observation": {
      "types": "./dist/visual-observation/VisualObservationReporter.d.ts",
      "import": "./dist/visual-observation/VisualObservationReporter.js"
    },
    "./ui.css": "./dist/ui/creator-workbench.css",
    "./host-preview": {
      "types": "./dist/host-preview/hostPreviewWorkbench.d.ts",
      "import": "./dist/host-preview/hostPreviewWorkbench.js"
    },
    "./host-preview/client": "./dist/host-preview/hostPreviewClient.js",
    "./host-preview/vite": {
      "types": "./dist/host-preview/vite.d.ts",
      "import": "./dist/host-preview/vite.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && pnpm build:ui && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python-sidecar": "vitest run tests/python-creator-sidecar.integration.test.ts",
    "cli": "node dist/cli.js",
    "prepublishOnly": "pnpm --dir ../.. verify:creator-distribution"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@agent-ui/mock-agent": "workspace:^",
    "@agent-ui/project-control": "workspace:^",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "1.11.13",
    "lucide-react": "1.41.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^27.0.0",
    "postcss": "8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
