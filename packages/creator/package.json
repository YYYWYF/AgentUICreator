{
  "name": "@za38.03/agent-ui-creator",
  "version": "0.1.0",
  "description": "Development-time Creator CLI, Workbench and AG-UI Mock service",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "agent-ui-creator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vitePlugin.d.ts",
      "import": "./dist/vitePlugin.js"
    },
    "./ui": {
      "types": "./dist/ui/CreatorWorkbench.d.ts",
      "import": "./dist/ui/CreatorWorkbench.js"
    },
    "./runtime-diagnostics": {
      "types": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.d.ts",
      "import": "./dist/runtime-diagnostics/runtimeDiagnosticReporter.js"
    },
    "./visual-observation": {
      "types": "./dist/visual-observation/VisualObservationReporter.d.ts",
      "import": "./dist/visual-observation/VisualObservationReporter.js"
    },
    "./ui.css": "./dist/ui/creator-workbench.css",
    "./host-preview": {
      "types": "./dist/host-preview/hostPreviewWorkbench.d.ts",
      "import": "./dist/host-preview/hostPreviewWorkbench.js"
    },
    "./host-preview/client": "./dist/host-preview/hostPreviewClient.js",
    "./host-preview/vite": {
      "types": "./dist/host-preview/vite.d.ts",
      "import": "./dist/host-preview/vite.js"
    },
    "./server": {
      "types": "./dist/standaloneServer.d.ts",
      "import": "./dist/standaloneServer.js"
    },
    "./dock": {
      "types": "./dist/dock/creatorDock.d.ts",
      "import": "./dist/dock/creatorDock.js"
    },
    "./dock/vite": {
      "types": "./dist/dock/vite.d.ts",
      "import": "./dist/dock/vite.js"
    },
    "./dock/rsbuild": {
      "types": "./dist/dock/rsbuild.d.ts",
      "import": "./dist/dock/rsbuild.js"
    },
    "./dock/webpack": {
      "types": "./dist/dock/webpack.d.ts",
      "import": "./dist/dock/webpack.js",
      "require": "./dist/dock/webpack.js"
    },
    "./mock-agent": {
      "types": "./dist/mock-agent/index.d.ts",
      "import": "./dist/mock-agent/index.js"
    }
  },
  "files": [
    "dist",
    "skills/**/*.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/build-browser.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:python-sidecar": "vitest run tests/python-creator-sidecar.integration.test.ts",
    "cli": "node dist/cli.js",
    "prepublishOnly": "pnpm --dir ../.. verify:creator-distribution"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@za38.03/agent-ui-operator": "workspace:*",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-to-image": "1.11.13",
    "lucide-react": "1.41.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "@za38.03/agent-ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.4.0",
    "postcss": "8.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.8",
    "@assistant-ui/react": "0.15.23",
    "rxjs": "7.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
