{
  "name": "@agent-ui/mock-agent",
  "version": "0.1.0",
  "description": "AG-UI development simulator for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/demo-attachment-adapter.d.ts",
      "import": "./dist/demo-attachment-adapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59"
  },
  "peerDependencies": {
    "vite": ">=8",
    "@assistant-ui/react": "^0.15.22"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@assistant-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@types/node": "^20.19.43",
    "rxjs": "7.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "jsdom": "^27.0.0",
    "@assistant-ui/react": "0.15.22"
  }
}
