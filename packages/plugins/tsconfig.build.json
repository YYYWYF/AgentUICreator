{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "rootDirs": [
      "src"
    ],
    "noEmitOnError": true,
    "paths": {
      "@za38.03/agent-ui-runtime": [
        "../runtime/dist/index.d.ts"
      ],
      "@za38.03/agent-ui-runtime/*": [
        "../runtime/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "tests",
    "src/experimental/**",
    "src/plugins/**",
    "src/shared/**"
  ]
}
