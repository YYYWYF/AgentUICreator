{
  "id": "foundation/core",
  "kind": "foundation",
  "description": "Public Agent UI entry and generated Plugin Registry entry",
  "requires": [
    "foundation/core-application"
  ],
  "files": [
    {
      "source": "files/application/Agent.tsx",
      "target": "application/Agent.tsx"
    },
    {
      "source": "files/application/project-config.tsx",
      "target": "application/project-config.tsx"
    },
    {
      "source": "files/application/locales.ts",
      "target": "application/locales.ts"
    },
    {
      "source": "files/index.ts",
      "target": "index.ts"
    },
    {
      "source": "files/plugins/index.ts",
      "target": "plugins/index.ts"
    },
    {
      "source": "files/application/environment.ts",
      "target": "application/environment.ts"
    },
    {
      "source": "files/application/composition-store.ts",
      "target": "application/composition-store.ts"
    },
    {
      "source": "files/application/resources.generated.ts",
      "target": "application/resources.generated.ts"
    },
    {
      "source": "files/composition-revision.generated.json",
      "target": "composition-revision.generated.json"
    },
    {
      "source": "files/application/assets.d.ts",
      "target": "application/assets.d.ts"
    }
  ],
  "packages": {
    "@za38.03/agent-ui-plugins": "0.0.9",
    "@za38.03/agent-ui-core": "0.0.9",
    "@za38.03/agent-ui-renderer": "0.0.9",
    "@za38.03/agent-ui-runtime": "0.0.9"
  }
}
