{
  "id": "foundation/core",
  "kind": "foundation",
  "description": "Public Agent UI entry and generated Plugin Registry entry",
  "requires": [
    "foundation/core-application"
  ],
  "files": [
    {
      "source": "files/application/Agent.tsx",
      "target": "application/Agent.tsx"
    },
    {
      "source": "files/application/project-config.tsx",
      "target": "application/project-config.tsx"
    },
    {
      "source": "files/application/locales.ts",
      "target": "application/locales.ts"
    },
    {
      "source": "files/index.ts",
      "target": "index.ts"
    },
    {
      "source": "files/plugins/index.ts",
      "target": "plugins/index.ts"
    }
  ],
  "packages": {
    "@za38.03/agent-ui-plugins": "0.0.1",
    "@za38.03/agent-ui-core": "0.0.1",
    "@za38.03/agent-ui-renderer": "0.0.1",
    "@za38.03/agent-ui-runtime": "0.0.1"
  }
}
