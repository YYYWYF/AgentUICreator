  "files": [
    {
      "source": "files/application/shell/AssistantShell.tsx",
      "target": "application/shell/AssistantShell.tsx"
    },
    {
      "source": "files/application/shell/AssistantRobot.tsx",
      "target": "application/shell/AssistantRobot.tsx"
    },
    {
      "source": "files/application/shell/assistant-robot-motion.ts",
      "target": "application/shell/assistant-robot-motion.ts"
    },
    {
      "source": "files/application/shell/assistant-robot-assets.d.ts",
      "target": "application/shell/assistant-robot-assets.d.ts"
    },
    {
      "source": "files/application/shell/assistant-shell.css",
      "target": "application/shell/assistant-shell.css"
    },
    {
      "source": "files/application/shell/assistant-robot-frames.ts",
      "target": "application/shell/assistant-robot-frames.ts"
