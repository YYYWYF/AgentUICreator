  "scripts": {
    "build": "node ../../scripts/sync-package-release-metadata.mjs plugins && node scripts/clean-dist.mjs && node scripts/materialize-plugin-sources.mjs && tsc -p tsconfig.build.json && node scripts/build-optional-facades.mjs && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-lexical-boundary.mjs && node scripts/prepare-source-distribution.mjs && node scripts/build-package-plugins.mjs && node scripts/check-public-boundary.mjs && node ../../scripts/sync-package-release-metadata.mjs plugins",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:assistant-ui-upstream": "node scripts/materialize-plugin-sources.mjs && node scripts/check-assistant-ui-upstream.mjs",
    "check:assistant-ui-latest": "node scripts/materialize-plugin-sources.mjs && node scripts/check-assistant-ui-latest.mjs",
    "check:assistant-ui-revision": "node scripts/materialize-plugin-sources.mjs && node scripts/check-assistant-ui-revision.mjs",
    "sync:assistant-ui-upstream": "node scripts/materialize-plugin-sources.mjs && node scripts/sync-assistant-ui-upstream.mjs",
    "typecheck": "node ../../scripts/run-plugin-source-views-check.mjs typecheck",
    "test": "node ../../scripts/run-plugin-source-views-check.mjs test",
    "check:lexical-boundary": "node scripts/check-lexical-boundary.mjs",
    "release:verify": "node scripts/verify-source-distribution.mjs && node --import tsx ../creator/operator/scripts/source-catalog/prepare-release.mjs --verify",
    "release:prepare": "node scripts/verify-source-distribution.mjs && node --import tsx ../creator/operator/scripts/source-catalog/prepare-release.mjs --verify",
    "release:record": "node scripts/verify-source-distribution.mjs && node --import tsx ../creator/operator/scripts/source-catalog/prepare-release.mjs --record",
    "sync:generative-ui-upstream": "node scripts/materialize-plugin-sources.mjs && node ../creator/operator/scripts/source-catalog/sync-generative-ui-upstream.mjs",
    "verify:sources": "node scripts/verify-source-distribution.mjs",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs plugins"
  },
