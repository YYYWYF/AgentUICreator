  },
  "devDependencies": {
    "@agent-ui/react": "workspace:^",
    "@agent-ui/runtime-core": "workspace:^",
    "react": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "esbuild": "0.25.12",
    "vite": "^8.2.2",
    "@agent-ui/runtime-react": "workspace:^"
  }
