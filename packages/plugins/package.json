{
  "name": "@za38.03/agent-ui-plugins",
  "version": "0.1.6",
  "description": "Agent UI React components and official UI plugins",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./lexical": {
      "types": "./dist/lexical.d.ts",
      "import": "./dist/lexical.js"
    },
    "./theme": {
      "types": "./dist/theme/theme-contract.d.ts",
      "import": "./dist/theme/theme-contract.js"
    },
    "./demo-attachments": {
      "types": "./dist/demo-attachments.d.ts",
      "import": "./dist/demo-attachments.js"
    },
    "./generative-ui": {
      "types": "./dist/generative-ui.d.ts",
      "import": "./dist/generative-ui.js"
    },
    "./generative-ui.css": "./dist/internal/vendor/assistant-ui/generative-ui/generative-ui.css",
    "./assistant-ui-composer": {
      "types": "./dist/assistant-ui-composer/index.d.ts",
      "import": "./dist/assistant-ui-composer/index.js",
      "default": "./dist/assistant-ui-composer/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-lexical-boundary.mjs && node scripts/build-composer.mjs && node scripts/check-public-boundary.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:assistant-ui-upstream": "node scripts/check-assistant-ui-upstream.mjs",
    "check:assistant-ui-latest": "node scripts/check-assistant-ui-latest.mjs",
    "check:assistant-ui-revision": "node scripts/check-assistant-ui-revision.mjs",
    "sync:assistant-ui-upstream": "node scripts/sync-assistant-ui-upstream.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "check:lexical-boundary": "node scripts/check-lexical-boundary.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-markdown": "0.14.16",
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.41.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15",
    "@za38.03/agent-ui-core": "workspace:*",
    "@assistant-ui/react-generative-ui": "0.0.22",
    "react-markdown": "10.1.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "@assistant-ui/react-lexical": "0.2.15",
    "lexical": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0",
    "@za38.03/agent-ui-core": "0.1.0",
    "@za38.03/agent-ui-renderer": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.8",
    "jsdom": "27.4.0",
    "zod": "4.5.4",
    "react-test-renderer": "19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "tsx": "4.20.6",
    "semver": "7.8.5",
    "@types/semver": "7.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.3.0",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "rxjs": "7.8.1",
    "react-hook-form": "7.88.0",
    "@assistant-ui/react-hook-form": "0.12.34",
    "@assistant-ui/react-lexical": "0.2.15",
    "lexical": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0",
    "@types/jsdom": "28.0.3",
    "@za38.03/agent-ui-core": "workspace:*",
    "esbuild": "0.25.12",
    "@za38.03/agent-ui-renderer": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react-lexical": {
      "optional": true
    },
    "lexical": {
      "optional": true
    },
    "@lexical/react": {
      "optional": true
    },
    "@lexical/utils": {
      "optional": true
    },
    "@lexical/history": {
      "optional": true
    },
    "@lexical/plain-text": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
