{
  "name": "@agent-ui/plugins",
  "version": "0.1.0",
  "type": "module",
  "description": "Official Agent UI plugins built from Source Registry",
  "files": [
    "dist"
  ],
  "exports": {
    "./assistant-ui-composer": {
      "types": "./dist/assistant-ui-composer/index.d.ts",
