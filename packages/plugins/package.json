{
  "name": "@za38.03/agent-ui-plugins",
  "version": "0.1.0",
  "type": "module",
  "description": "Official Agent UI plugins built from Source Registry",
  "files": [
    "dist"
  ],
  "exports": {
    "./assistant-ui-composer": {
      "types": "./dist/assistant-ui-composer/index.d.ts",
      "import": "./dist/assistant-ui-composer/index.js",
      "default": "./dist/assistant-ui-composer/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@za38.03/agent-ui-react": "0.1.6",
    "@za38.03/agent-ui-runtime-core": "0.1.0",
    "react": ">=18 <20",
    "@za38.03/agent-ui-renderer": "0.1.3"
  },
  "devDependencies": {
    "@za38.03/agent-ui-react": "workspace:*",
    "@za38.03/agent-ui-runtime-core": "workspace:*",
    "react": "19.1.1",
    "@types/react": "19.3.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "esbuild": "0.25.12",
    "vite": "8.3.0",
    "@za38.03/agent-ui-renderer": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
