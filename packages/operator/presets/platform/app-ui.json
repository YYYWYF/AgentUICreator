{
  "applicationPlugins": [
    {
      "id": "agent-conversation-data-main",
      "pluginId": "conversation-data-source",
      "enabled": true
    },
    {
      "id": "agent-conversation-service-main",
      "pluginId": "conversation-service",
      "enabled": true
    },
    {
      "id": "theme-provider-main",
      "pluginId": "theme-provider",
      "enabled": true
    },
    {
      "id": "locale-provider-main",
      "pluginId": "locale-provider",
      "enabled": true
    },
    {
      "id": "conversation-command-source-main",
      "pluginId": "conversation-command-source",
      "enabled": true
    },
    {
      "id": "context-retrieval-message-main",
      "pluginId": "context-retrieval-message",
      "enabled": true
    }
  ],
  "root": {
    "type": "sidebar",
    "defaultActive": "history",
    "items": [
      {
        "id": "history",
        "child": {
          "type": "slot",
          "plugins": [
            {
              "id": "conversation-thread-list-main",
              "pluginId": "conversation-thread-list",
              "enabled": true
            }
          ]
        }
      }
    ],
    "content": {
      "type": "row",
      "responsive": {
        "type": "trailing-drawer",
        "primaryIndex": 0,
        "drawerIndex": 1,
        "minPrimaryWidth": 320
      },
      "children": [
        {
          "type": "panel",
          "child": {
            "type": "slot",
            "plugins": [
              {
                "id": "agent-conversation-surface-main",
                "pluginId": "conversation-surface",
                "enabled": true,
                "slots": {
                  "emptySuggestions": [
                    {
                      "id": "conversation-suggestions-main",
                      "pluginId": "conversation-suggestions",
                      "enabled": true
                    }
                  ],
                  "composer": [
                    {
                      "id": "composer-main",
                      "pluginId": "composer",
                      "enabled": true,
                      "slots": {
                        "leadingActions": [
                          {
                            "id": "add-attachment-action-main",
                            "pluginId": "add-attachment-action",
                            "enabled": true
                          }
                        ],
                        "trailingActions": [
                          {
                            "id": "dictation-action-main",
                            "pluginId": "dictation-action",
                            "enabled": true
                          }
                        ],
                        "submitAction": [
                          {
                            "id": "submit-action-main",
                            "pluginId": "submit-action",
                            "enabled": true
                          }
                        ],
                        "beforeInput": [
                          {
                            "id": "conversation-quote-main",
                            "pluginId": "conversation-quote",
                            "enabled": true
                          }
                        ],
                        "triggers": [
                          {
                            "id": "mention-trigger-main",
                            "pluginId": "mention-trigger",
                            "enabled": true
                          },
                          {
                            "id": "slash-command-trigger-main",
                            "pluginId": "slash-command-trigger",
                            "enabled": true
                          }
                        ],
                        "input": [
                          {
                            "id": "lexical-composer-input-main",
                            "pluginId": "lexical-composer-input",
                            "enabled": true
                          }
                        ]
                      }
                    }
                  ],
                  "reasoningGroup": [
                    {
                      "id": "reasoning-main",
                      "pluginId": "reasoning",
                      "enabled": true
                    }
                  ],
                  "toolGroup": [
                    {
                      "id": "tool-group-main",
                      "pluginId": "tool-group",
                      "enabled": true
                    }
                  ],
                  "toolFallback": [
                    {
                      "id": "tool-fallback-main",
                      "pluginId": "tool-fallback",
                      "enabled": true
                    }
                  ],
                  "taskGroup": [
                    {
                      "id": "task-group-main",
                      "pluginId": "task-group",
                      "enabled": true
                    }
                  ],
                  "assistantResponseFooter": [
                    {
                      "id": "response-footer-main",
                      "pluginId": "response-footer",
                      "enabled": true,
                      "slots": {
                        "actions": [
                          {
                            "id": "copy-action-main",
                            "pluginId": "copy-action",
                            "enabled": true
                          },
                          {
                            "id": "reload-action-main",
                            "pluginId": "reload-action",
                            "enabled": true
                          },
                          {
                            "id": "feedback-actions-main",
                            "pluginId": "feedback-actions",
                            "enabled": true
                          },
                          {
                            "id": "export-markdown-action-main",
                            "pluginId": "export-markdown-action",
                            "enabled": true
                          }
                        ]
                      }
                    }
                  ],
                  "userEditComposer": [
                    {
                      "id": "lexical-edit-composer-main",
                      "pluginId": "lexical-edit-composer",
                      "enabled": true
                    }
                  ],
                  "toolTimeline": [
                    {
                      "id": "tool-timeline-main",
                      "pluginId": "tool-timeline",
                      "enabled": true
                    }
                  ],
                  "thinkingIndicator": [
                    {
                      "id": "thinking-indicator-main",
                      "pluginId": "thinking-indicator",
                      "enabled": true
                    }
                  ],
                  "transientMessages": [
                    {
                      "id": "transient-assistant-messages-main",
                      "pluginId": "transient-assistant-messages",
                      "enabled": true
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "gap": 0,
      "sizes": [
        "minmax(0, 1fr)"
      ]
    },
    "header": {
      "type": "slot",
      "plugins": [
        {
          "id": "agent-identity-main",
          "pluginId": "agent-identity",
          "enabled": true
        }
      ]
    }
  }
}
