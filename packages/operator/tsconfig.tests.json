{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../packages/operator/node_modules/@types/react"
      ],
      "react/*": [
        "../../packages/operator/node_modules/@types/react/*"
      ],
      "@za38.03/agent-ui-operator/bootstrap": [
        "../../packages/operator/src/bootstrap/index.ts"
      ],
      "@za38.03/agent-ui-creator/mock-agent": [
        "../../packages/creator/src/mock-agent/index.ts"
      ],
      "@za38.03/agent-ui-operator/source-registry": [
        "../../packages/operator/src/source-catalog/index.ts"
      ],
      "@za38.03/agent-ui-plugins": [
        "../../packages/plugins/src/index.ts"
      ],
      "@za38.03/agent-ui-runtime": [
        "../../packages/runtime/src/index.ts"
      ],
      "@assistant-ui/react": [
        "../../packages/plugins/node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react-generative-ui": [
        "../../packages/operator/node_modules/@assistant-ui/react-generative-ui"
      ],
      "@assistant-ui/react-ag-ui": [
        "../../packages/runtime/node_modules/@assistant-ui/react-ag-ui"
      ],
      "@za38.03/agent-ui-core": [
        "../../packages/core/src/index.ts"
      ],
      "@za38.03/agent-ui-renderer": [
        "../../packages/renderer/src/index.ts"
      ],
      "@za38.03/agent-ui-core/testing": [
        "../../packages/core/src/testing/index.ts"
      ],
      "react-markdown": [
        "../../packages/operator/node_modules/react-markdown"
      ],
      "remark-gfm": [
        "../../packages/operator/node_modules/remark-gfm"
      ],
      "@za38.03/agent-ui-plugins/catalog": [
        "../../packages/plugins/src/catalog/index.ts"
      ]
    },
    "rootDirs": [
      ".",
      "../plugins/resources/registry/items/plugin/copy-action/files",
      "../plugins/resources/registry/items/plugin/feedback-actions/files",
      "../plugins/resources/registry/items/plugin/tool-fallback/files",
      "../plugins/resources/registry/items/foundation/conversation/files",
      "../plugins/resources/registry/items/plugin/agent-status-message/files",
      "../plugins/resources/registry/items/plugin/add-attachment-action/files",
      "../plugins/resources/registry/items/plugin/reasoning/files",
      "../plugins/resources/registry/items/demo/frontend-tool-form/files",
      "../plugins/resources/registry/items/demo/human-form/files",
      "../plugins/resources/registry/items/integration/a2ui/files",
      "../plugins/resources/registry/items/plugin/conversation-service/files",
      "../plugins/resources/registry/items/integration/generative-ui/files",
      "../plugins/resources/registry/items/integration/react-hook-form/files",
      "../plugins/resources/registry/items/plugin/chart-message/files",
      "../plugins/resources/registry/items/plugin/theme-provider/files",
      "../plugins/resources/registry/items/plugin/conversation-thread-list/files",
      "../plugins/resources/registry/items/foundation/core/files",
      "../plugins/resources/registry/items/plugin/composer/files",
      "../plugins/resources/registry/items/plugin/response-footer/files",
      "../plugins/resources/registry/items/plugin/job-progress-message/files",
      "../plugins/resources/registry/items/plugin/conversation-suggestions/files",
      "../plugins/resources/registry/items/plugin/export-markdown-action/files",
      "../plugins/resources/registry/items/plugin/reload-action/files",
      "../plugins/resources/registry/items/plugin/locale-provider/files",
      "../plugins/resources/registry/items/plugin/theme-switch/files",
      "../plugins/resources/registry/items/foundation/core-runtime/files",
      "../plugins/resources/registry/items/plugin/tool-group/files",
      "../plugins/resources/registry/items/plugin/tool-timeline/files",
      "../plugins/resources/registry/items/plugin/thinking-indicator/files",
      "../plugins/resources/registry/items/plugin/task-group/files",
      "../plugins/resources/registry/items/foundation/core-adapters/files",
      "../plugins/resources/registry/items/plugin/submit-action/files",
      "../plugins/resources/registry/items/foundation/core-contracts/files",
      "../plugins/resources/registry/items/plugin/dictation-action/files",
      "../plugins/resources/registry/items/foundation/core-application/files",
      "../plugins/resources/registry/items/demo/frontend-tool-dialog/files",
      "../plugins/resources/registry/items/plugin/conversation-data-source/files",
      "../plugins/resources/registry/items/plugin/conversation-surface/files",
      "../plugins/resources/registry/items/plugin/agent-plan-message/files",
      "../operator/tests/support/typecheck-project"
    ]
  },
  "exclude": [
    "tests/fixtures"
  ],
  "include": [
    "tests/migrated/**/*.ts",
    "tests/migrated/**/*.tsx",
    "tests/host-public-entry.integration.test.ts",
    "tests/sidebar.test.ts",
    "tests/bootstrap/**/*.ts"
  ]
}
