{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../packages/operator/node_modules/@types/react"
      ],
      "react/*": [
        "../../packages/operator/node_modules/@types/react/*"
      ],
      "@za38.03/agent-ui-operator/bootstrap": [
        "../../packages/operator/src/bootstrap/index.ts"
      ],
      "@za38.03/agent-ui-creator/mock-agent": [
        "../../packages/creator/src/mock-agent/index.ts"
      ],
      "@za38.03/agent-ui-source-registry": [
        "../../packages/source-registry/src/index.ts"
      ],
      "@za38.03/agent-ui-plugins": [
        "../../packages/plugins/src/index.ts"
      ],
      "@za38.03/agent-ui-runtime": [
        "../../packages/runtime/src/index.ts"
      ],
      "@assistant-ui/react": [
        "../../packages/plugins/node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react-generative-ui": [
        "../../packages/operator/node_modules/@assistant-ui/react-generative-ui"
      ],
      "@assistant-ui/react-ag-ui": [
        "../../packages/runtime/node_modules/@assistant-ui/react-ag-ui"
      ],
      "@za38.03/agent-ui-core": [
        "../../packages/core/src/index.ts"
      ],
      "@za38.03/agent-ui-renderer": [
        "../../packages/renderer/src/index.ts"
      ],
      "@za38.03/agent-ui-core/testing": [
        "../../packages/core/src/testing/index.ts"
      ],
      "react-markdown": [
        "../../packages/operator/node_modules/react-markdown"
      ],
      "remark-gfm": [
        "../../packages/operator/node_modules/remark-gfm"
      ]
    },
    "rootDirs": [
      ".",
      "../../packages/source-registry/registry/items/integration-a2ui/files",
      "../../packages/source-registry/registry/items/integration-generative-ui/files",
      "../../packages/source-registry/registry/items/agent-component-assistant-ui-generative-ui/files"
    ]
  },
  "exclude": [
    "tests/fixtures"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
