    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/package-build-integrity.mjs begin runtime && node ../../scripts/clean-package-dist.mjs runtime && node ../../scripts/sync-package-release-metadata.mjs runtime && node ./node_modules/typescript/lib/tsc.js -p tsconfig.build.json && node scripts/copy-assets.mjs && node ../../scripts/sync-package-release-metadata.mjs runtime && node ../../scripts/package-build-integrity.mjs record runtime",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/package-build-integrity.mjs check runtime && node ../../scripts/sync-package-release-metadata.mjs runtime",
    "prepublishOnly": "node ../../scripts/package-build-integrity.mjs check runtime && node ../../scripts/sync-package-release-metadata.mjs runtime --publish"
  },
