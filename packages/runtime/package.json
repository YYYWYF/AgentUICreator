{
  "name": "@za38.03/agent-ui-runtime",
  "version": "0.0.1",
  "description": "Canonical Conversation runtime adapter for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api/index.d.ts",
      "import": "./dist/plugin-api/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs runtime && node ../../scripts/sync-package-release-metadata.mjs runtime && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node ../../scripts/sync-package-release-metadata.mjs runtime",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs runtime",
    "prepublishOnly": "node ../../scripts/sync-package-release-metadata.mjs runtime --publish"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-ag-ui": "0.1.0",
    "@assistant-ui/react-langgraph": "0.14.29",
    "rxjs": "7.8.1",
    "@assistant-ui/core": "0.3.35",
    "@ag-ui/core": "1.0.3",
    "zod": "4.5.4",
    "lucide-react": "1.41.0",
    "@za38.03/agent-ui-renderer": "workspace:*"
  },
  "peerDependencies": {
    "@za38.03/agent-ui-core": "0.0.1",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@za38.03/agent-ui-core": "workspace:*",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.1.1",
    "react-test-renderer": "19.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.8",
    "@types/react-dom": "19.3.0",
    "react-dom": "19.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentUI": {
    "schemaVersion": 1,
    "compatibility": {
      "schemaVersion": 1,
      "releases": []
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui/*": [
        "./dist/ui/*.d.ts"
      ],
      "ui": [
        "./dist/ui/index.d.ts"
      ],
      "contracts": [
        "./dist/contracts/index.d.ts"
      ],
      "plugin-api": [
        "./dist/plugin-api/index.d.ts"
      ],
      "locale": [
        "./dist/locale.d.ts"
      ],
      "presentation": [
        "./dist/presentation.d.ts"
      ]
    }
  }
}
