{
  "name": "@za38.03/agent-ui-runtime",
  "version": "0.0.1",
  "description": "Canonical Conversation runtime adapter for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-package-release-metadata.mjs runtime && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-consumer-types.mjs && node ../../scripts/sync-package-release-metadata.mjs runtime",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs runtime"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@za38.03/agent-ui-plugins": "workspace:*",
