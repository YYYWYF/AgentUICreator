{
  "name": "@za38.03/agent-ui-runtime",
  "version": "0.0.1",
  "description": "Canonical Conversation runtime adapter for Agent UI frontends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compatibility.json": "./dist/compatibility.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-package-release-metadata.mjs runtime && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-public-boundary.mjs && node scripts/check-consumer-types.mjs && node ../../scripts/sync-package-release-metadata.mjs runtime",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:consumer-types": "node scripts/check-consumer-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-release-metadata.mjs runtime",
    "prepublishOnly": "node ../../scripts/sync-package-release-metadata.mjs runtime --publish"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@za38.03/agent-ui-plugins": "workspace:*",
    "@assistant-ui/react": "0.15.29",
    "@assistant-ui/react-ag-ui": "0.0.65",
    "@assistant-ui/react-langgraph": "0.14.36",
    "rxjs": "7.8.1",
    "@assistant-ui/core": "0.3.29"
  },
  "peerDependencies": {
    "@za38.03/agent-ui-core": "0.0.1",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@za38.03/agent-ui-core": "workspace:*",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.1.1",
    "react-test-renderer": "19.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentUI": {
    "schemaVersion": 1,
    "compatibility": {
      "schemaVersion": 1,
      "releases": []
    }
  }
}
