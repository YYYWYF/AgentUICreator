    "operation": "mutate_app_ui_model",
    "input": {
      "appUIModelHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "operations": [
        {
          "type": "move_plugin",
          "instanceId": "activity-main",
          "target": {
