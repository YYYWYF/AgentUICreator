{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ui.local/contracts/project-control.schema.json",
  "title": "Creator project control protocol v2",
  "$defs": {
    "emptyInput": { "type": "object", "additionalProperties": false },
    "pluginInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId"],
      "properties": { "pluginId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "operation": { "enum": ["inspect_ui_project", "inspect_app_ui_model", "list_ui_plugins"] },
            "input": { "$ref": "#/$defs/emptyInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "operation": { "const": "inspect_ui_slots" },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "root": { "type": "string", "minLength": 1, "maxLength": 200 } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "operation": { "enum": ["inspect_ui_plugin", "inspect_ui_plugin_source_references"] },
            "input": { "$ref": "#/$defs/pluginInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "operation": { "const": "mutate_app_ui_model" },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["appUIModelHash", "operations"],
              "properties": {
                "appUIModelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": { "$ref": "app-ui-model-operation.schema.json" }
                }
              }
            }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "ok", "result"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "ok": { "const": true },
            "result": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "ok", "error"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "ok": { "const": false },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "details": true
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
