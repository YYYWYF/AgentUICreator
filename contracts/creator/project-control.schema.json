{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ui.local/contracts/project-control.schema.json",
  "title": "Creator project control protocol v3",
  "$defs": {
    "emptyInput": { "type": "object", "additionalProperties": false },
    "nonBlankString": { "type": "string", "minLength": 1, "maxLength": 200 },
    "pluginInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId"],
      "properties": { "pluginId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "layoutSlotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slotRef"],
      "properties": {
        "type": { "const": "layout_slot" },
        "slotRef": { "type": "string", "pattern": "^l[0-9]+$" }
      }
    },
    "pluginSlotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parentInstanceId", "slot"],
      "properties": {
        "type": { "const": "plugin_slot" },
        "parentInstanceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "slot": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "inspectUISlotsInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["appUIModelHash", "target"],
          "properties": {
            "appUIModelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "target": { "$ref": "#/$defs/layoutSlotTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": {
            "target": { "$ref": "#/$defs/pluginSlotTarget" }
          }
        }
      ]
    },
    "runtimeCompositionApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["bootstrapping", "resolving-gates", "blocked", "ready", "error"] },
        "activeGateInstanceId": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "runtimeCompositionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "pluginId", "slotId"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "pluginId": { "$ref": "#/$defs/nonBlankString" },
        "slotId": { "$ref": "#/$defs/nonBlankString" },
        "slotPath": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "runtimeCompositionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "widthClass"],
      "properties": {
        "slotId": { "$ref": "#/$defs/nonBlankString" },
        "widthClass": { "enum": ["unknown", "narrow", "wide"] },
        "slotPath": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "runtimeComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "appUIModelHash", "compositionRevision", "capabilityCatalogRevision", "publishedAt", "observedAt", "instances", "slots"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "appUIModelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "compositionRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "capabilityCatalogRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" },
        "application": { "$ref": "#/$defs/runtimeCompositionApplication" },
        "instances": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/runtimeCompositionInstance" }
        },
        "slots": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/runtimeCompositionSlot" }
        }
      }
    },
    "verifyRuntimeCompositionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appUIModelHash", "composition"],
      "properties": {
        "appUIModelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "composition": { "$ref": "#/$defs/runtimeComposition" }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "enum": ["inspect_ui_project", "inspect_app_ui_model", "list_ui_plugins", "inspect_ui_services", "inspect_agent_ui_sources"] },
            "input": { "$ref": "#/$defs/emptyInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "const": "inspect_ui_slots" },
            "input": { "$ref": "#/$defs/inspectUISlotsInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "enum": ["inspect_ui_plugin", "inspect_ui_plugin_source_references"] },
            "input": { "$ref": "#/$defs/pluginInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "const": "verify_runtime_composition" },
            "input": { "$ref": "#/$defs/verifyRuntimeCompositionInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "const": "mutate_app_ui_model" },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["appUIModelHash", "operations"],
              "properties": {
                "appUIModelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": { "$ref": "app-ui-model-operation.schema.json" }
                },
                "runtimeSlotWidths": {
                  "type": "object",
                  "propertyNames": { "minLength": 1, "maxLength": 200 },
                  "additionalProperties": {
                    "enum": ["unknown", "narrow", "wide"]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "operation", "input"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "operation": { "const": "apply_agent_ui_source_item" },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "expectedStateHash"],
              "properties": {
                "itemId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "expectedStateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "ok", "result"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "ok": { "const": true },
            "result": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "ok", "error"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "ok": { "const": false },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "details": true
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
