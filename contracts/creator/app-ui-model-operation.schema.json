{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ui.local/contracts/app-ui-model-operation.schema.json",
  "title": "AppUIModel operation",
  "$defs": {
    "nonBlankString": { "type": "string", "minLength": 1, "maxLength": 200 },
    "layoutRef": {
      "type": "string",
      "pattern": "^(l[0-9]+|\\$[A-Za-z][A-Za-z0-9_-]*)$"
    },
    "layoutSize": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "$ref": "#/$defs/nonBlankString" }
      ]
    },
    "layoutTrackSize": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "not": {
        "pattern": "^\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)\\s*$"
      },
      "description": "Explicit CSS Grid track size such as 280px, 1fr, minmax(0, 1fr), or 24rem. Numeric track sizes are not accepted by Creator."
    },
    "layoutNodeProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap": { "type": "number", "minimum": 0 },
        "sizes": {
          "type": "array",
          "items": { "$ref": "#/$defs/layoutTrackSize" }
        },
        "activeIndex": { "type": "integer", "minimum": 0 },
        "width": { "$ref": "#/$defs/layoutSize" },
        "height": { "$ref": "#/$defs/layoutSize" },
        "minWidth": { "type": "number", "minimum": 0 },
        "maxWidth": { "type": "number", "minimum": 0 },
        "resizable": { "type": "boolean" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pluginId", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "pluginId": { "$ref": "#/$defs/nonBlankString" },
        "enabled": { "type": "boolean" },
        "props": { "type": "object" },
        "slots": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nonBlankString" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/plugin" }
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "application" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "slotRef"],
          "properties": {
            "type": { "const": "layout_slot" },
            "slotRef": { "$ref": "#/$defs/layoutRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "parentInstanceId", "slot"],
          "properties": {
            "type": { "const": "plugin_slot" },
            "parentInstanceId": { "$ref": "#/$defs/nonBlankString" },
            "slot": { "$ref": "#/$defs/nonBlankString" }
          }
        }
      ]
    },
    "layoutNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children"],
          "properties": {
            "type": { "enum": ["row", "column"] },
            "localRef": { "type": "string", "pattern": "^\\$[A-Za-z][A-Za-z0-9_-]*$" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/layoutNode" } },
            "gap": { "type": "number", "minimum": 0 },
            "sizes": { "type": "array", "items": { "$ref": "#/$defs/layoutTrackSize" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "children"],
          "properties": {
            "type": { "const": "stack" },
            "localRef": { "type": "string", "pattern": "^\\$[A-Za-z][A-Za-z0-9_-]*$" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/layoutNode" } },
            "activeIndex": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "child"],
          "properties": {
            "type": { "const": "panel" },
            "localRef": { "type": "string", "pattern": "^\\$[A-Za-z][A-Za-z0-9_-]*$" },
            "child": { "$ref": "#/$defs/layoutNode" },
            "width": { "$ref": "#/$defs/layoutSize" },
            "height": { "$ref": "#/$defs/layoutSize" },
            "minWidth": { "type": "number", "minimum": 0 },
            "maxWidth": { "type": "number", "minimum": 0 },
            "resizable": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "plugins"],
          "properties": {
            "type": { "const": "slot" },
            "localRef": { "type": "string", "pattern": "^\\$[A-Za-z][A-Za-z0-9_-]*$" },
            "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } }
          }
        }
      ]
    },
    "index": { "type": "integer", "minimum": 0 },
    "removeKeys": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/nonBlankString" }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "plugin", "target"],
      "properties": {
        "type": { "const": "insert_plugin" },
        "plugin": { "$ref": "#/$defs/plugin" },
        "target": { "$ref": "#/$defs/target" },
        "index": { "$ref": "#/$defs/index" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "plugin"],
      "properties": {
        "type": { "const": "insert_plugin_default" },
        "plugin": {
          "$ref": "#/$defs/plugin",
          "description": "Insert this existing capability using its Host-resolved authoring-default placement. Do not include anchor, Slot, Layout, or size arguments."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId"],
      "properties": {
        "type": { "const": "remove_plugin_default" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId", "target"],
      "properties": {
        "type": { "const": "move_plugin" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "target": { "$ref": "#/$defs/target" },
        "index": { "$ref": "#/$defs/index" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId"],
      "properties": {
        "type": { "const": "remove_plugin" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "reflow": {
          "enum": ["preserve", "collapse-empty-region"],
          "default": "preserve"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId", "replacement"],
      "properties": {
        "type": { "const": "replace_plugin" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "replacement": { "$ref": "#/$defs/plugin" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId"],
      "properties": {
        "type": { "const": "update_plugin_props" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "set": { "type": "object" },
        "removeKeys": { "$ref": "#/$defs/removeKeys" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instanceId", "enabled"],
      "properties": {
        "type": { "const": "set_plugin_enabled" },
        "instanceId": { "$ref": "#/$defs/nonBlankString" },
        "enabled": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parentRef", "node"],
      "properties": {
        "type": { "const": "insert_layout_node" },
        "parentRef": { "$ref": "#/$defs/layoutRef" },
        "node": { "$ref": "#/$defs/layoutNode" },
        "index": { "$ref": "#/$defs/index" },
        "size": { "$ref": "#/$defs/layoutTrackSize" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodeRef"],
      "properties": {
        "type": { "const": "update_layout_node_props" },
        "nodeRef": { "$ref": "#/$defs/layoutRef" },
        "set": { "$ref": "#/$defs/layoutNodeProps" },
        "removeKeys": { "$ref": "#/$defs/removeKeys" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodeRef", "newParentRef"],
      "properties": {
        "type": { "const": "move_layout_node" },
        "nodeRef": { "$ref": "#/$defs/layoutRef" },
        "newParentRef": { "$ref": "#/$defs/layoutRef" },
        "index": { "$ref": "#/$defs/index" },
        "size": { "$ref": "#/$defs/layoutTrackSize" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodeRef", "node"],
      "properties": {
        "type": { "const": "replace_layout_node" },
        "nodeRef": { "$ref": "#/$defs/layoutRef" },
        "node": { "$ref": "#/$defs/layoutNode" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodeRef"],
      "properties": {
        "type": { "const": "remove_layout_node" },
        "nodeRef": { "$ref": "#/$defs/layoutRef" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "anchorRef", "direction", "node"],
      "properties": {
        "type": { "const": "insert_layout_relative" },
        "anchorRef": { "$ref": "#/$defs/layoutRef" },
        "direction": { "enum": ["left", "right", "above", "below"] },
        "node": { "$ref": "#/$defs/layoutNode" },
        "size": { "$ref": "#/$defs/layoutTrackSize" },
        "anchorSize": { "$ref": "#/$defs/layoutTrackSize" }
      }
    }
  ]
}
