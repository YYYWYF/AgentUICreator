{
  "version": "1",
  "root": {
    "type": "row",
    "id": "main-layout",
    "gap": 12,
    "sizes": ["1fr", "320px"],
    "children": [
      {
        "type": "slot",
        "id": "chat-slot-node",
        "slotId": "chat",
        "pluginInstanceIds": ["chat-main"]
      },
      {
        "type": "panel",
        "id": "file-preview-panel",
        "width": "320px",
        "minWidth": 240,
        "maxWidth": 480,
        "resizable": true,
        "child": {
          "type": "slot",
          "id": "file-preview-slot-node",
          "slotId": "file-preview",
          "pluginInstanceIds": ["file-preview-right"]
        }
      }
    ]
  },
  "pluginInstances": {
    "chat-main": {
      "id": "chat-main",
      "pluginId": "chat",
      "enabled": true
    },
    "file-preview-right": {
      "id": "file-preview-right",
      "pluginId": "file-preview",
      "enabled": true,
      "props": {
        "showHeader": true
      }
    }
  },
  "settings": {
    "theme": "system"
  }
}
