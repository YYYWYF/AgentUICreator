# Public frontend endpoint for the one AG-UI Agent Runtime.
# The dev server uses Mock AG-UI when this is empty.
# Production builds require a real endpoint and fail when this is empty.
VITE_AGENT_ENDPOINT=

# Optional Conversation / LangGraph history endpoint.
# Example: https://api.example.com/agent-history
VITE_CONVERSATION_API_ENDPOINT=

# Development-only history source: "empty" (default) or "mock".
# Mock uses /__agent-ui/mock-data with synthetic LangGraph StateSnapshot data.
VITE_CONVERSATION_DATA_MODE=empty

# Host-side visual observation uploads are disabled by default.
# VITE_ENABLE_VISUAL_OBSERVATION=true

# Do not put API keys or other secrets in VITE_ variables.
