{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@agent-ui/bootstrap": ["../../packages/bootstrap/src/index.ts"],
      "@agent-ui/mock-agent": ["../../packages/mock-agent/src/index.ts"],
      "@agent-ui/source-registry": ["../../packages/source-registry/src/index.ts"],
      "@agent-ui/react": ["../../packages/react/src/index.ts"],
      "@agent-ui/runtime-conversation": [
        "../../packages/runtime-conversation/src/index.ts"
      ],
      "@assistant-ui/react": [
        "../../packages/react/node_modules/@assistant-ui/react"
      ],
      "@assistant-ui/react-generative-ui": ["./node_modules/@assistant-ui/react-generative-ui"],
      "@assistant-ui/react-ag-ui": [
        "../../packages/runtime-conversation/node_modules/@assistant-ui/react-ag-ui"
      ],
      "@agent-ui/runtime-core": ["../../packages/runtime-core/src/index.ts"],
      "@agent-ui/runtime-react": ["../../packages/runtime-react/src/index.ts"],
      "@agent-ui/runtime-core/testing": [
        "../../packages/runtime-core/src/testing/index.ts"
      ]
    }
  },
  "exclude": ["tests/fixtures/legacy-footer-0.1.0"],
  "include": [
    "agent-ui/**/*.ts",
    "agent-ui/**/*.tsx",
    "framework/**/*.ts",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts",
    "../../packages/react/src/**/*.ts",
    "../../packages/react/src/**/*.tsx",
    "../../packages/runtime-conversation/src/**/*.ts",
    "../../packages/runtime-conversation/src/**/*.tsx"
  ]
}
