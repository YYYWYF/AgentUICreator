{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@agent-ui/mock-agent": ["../../packages/mock-agent/src/index.ts"],
      "@agent-ui/source-registry": ["../../packages/source-registry/src/index.ts"],
      "@agent-ui/runtime-assistant-ui": [
        "../../packages/runtime-assistant-ui/src/index.ts"
      ],
      "@agent-ui/runtime-core": ["../../packages/runtime-core/src/index.ts"],
      "@agent-ui/runtime-react": ["../../packages/runtime-react/src/index.ts"],
      "@agent-ui/runtime-core/testing": [
        "../../packages/runtime-core/src/testing/index.ts"
      ]
    }
  },
  "include": [
    "agent-ui/**/*.ts",
    "agent-ui/**/*.tsx",
    "framework/**/*.ts",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts"
  ]
}
