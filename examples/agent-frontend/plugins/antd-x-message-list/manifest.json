{
  "id": "antd-x-message-list",
  "name": "Ant Design X 消息流",
  "description": "使用 Agent UI Message surface 渲染共享 AG-UI 消息；Actions、FileCard 与 Sources 暂保留 legacy adapter。",
  "version": "1.1.0",
  "capabilities": ["messages", "message-renderer-host", "streaming-feedback", "message-copy", "multimodal-content", "sources"],
  "slots": {
    "children": [
      "conversation.message.reasoning",
      "conversation.message.tool-activity"
    ]
  },
  "data": {
    "messages": true
  }
}
