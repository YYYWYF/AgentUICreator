    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react-test-renderer": "19.2.8",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
