    "@assistant-ui/react": "0.15.19",
    "@assistant-ui/react-markdown": "0.14.15",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "antd": "^6.6.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.41.0",
