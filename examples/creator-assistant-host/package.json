{
  "name": "@agent-ui/creator-assistant-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "predev": "node --import tsx ../creator-host-sandbox/scripts/host-project.ts ensure assistant creator-assistant-host",
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "prebuild": "node --import tsx ../creator-host-sandbox/scripts/host-project.ts ensure assistant creator-assistant-host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ../creator-host-sandbox/tests/public-entry.test.ts",
    "reset": "node ../creator-host-sandbox/scripts/reset-agent-ui.mjs creator-assistant-host",
    "inspect": "node --import tsx ../creator-host-sandbox/scripts/host-project.ts inspect creator-assistant-host",
    "init": "node --import tsx ../creator-host-sandbox/scripts/host-project.ts init assistant creator-assistant-host"
  },
  "dependencies": {
    "@agent-ui/react": "workspace:^",
    "@agent-ui/runtime-conversation": "workspace:^",
    "@agent-ui/runtime-core": "workspace:^",
    "@agent-ui/runtime-react": "workspace:^",
    "lucide-react": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
