{
  "applicationPlugins": [
    {
      "pluginId": "conversation-data-source"
    },
    {
      "pluginId": "conversation-service"
    },
    {
      "pluginId": "theme-provider"
    },
    {
      "pluginId": "locale-provider"
    },
    {
      "pluginId": "context-retrieval-message"
    }
  ],
  "root": {
    "type": "row",
    "children": [
      {
        "type": "panel",
        "child": {
          "type": "column",
          "children": [
            {
              "type": "slot",
              "plugins": [
                {
                  "id": "navigation-main",
                  "pluginId": "navigation-menu",
                  "slots": {
                    "header": [
                      {
                        "pluginId": "agent-identity"
                      }
                    ],
                    "content": [
                      {
                        "pluginId": "conversation-thread-list",
                        "slots": {
                          "headerActions": []
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "gap": 0,
          "sizes": [
            "minmax(0, 1fr)"
          ]
        }
      },
      {
        "type": "panel",
        "child": {
          "type": "stack",
          "id": "main",
          "children": [
            {
              "type": "slot",
              "plugins": [
                {
                  "pluginId": "workbench-panel",
                  "slots": {
                    "main": [
                      {
                        "pluginId": "conversation-surface",
                        "slots": {
                          "emptySuggestions": [
                            {
                              "pluginId": "conversation-suggestions"
                            }
                          ],
                          "composer": [
                            {
                              "pluginId": "composer",
                              "slots": {
                                "leadingActions": [
                                  {
                                    "pluginId": "add-attachment-action"
                                  }
                                ],
                                "submitAction": [
                                  {
                                    "pluginId": "submit-action"
                                  }
                                ],
                                "beforeInput": [
                                  {
                                    "pluginId": "conversation-quote"
                                  }
                                ]
                              }
                            }
                          ],
                          "reasoningGroup": [
                            {
                              "pluginId": "reasoning"
                            }
                          ],
                          "toolGroup": [
                            {
                              "pluginId": "tool-group"
                            }
                          ],
                          "taskGroup": [
                            {
                              "pluginId": "task-group"
                            }
                          ],
                          "toolFallback": [
                            {
                              "pluginId": "tool-result"
                            }
                          ],
                          "assistantResponseFooter": [
                            {
                              "pluginId": "response-footer",
                              "slots": {
                                "actions": [
                                  {
                                    "pluginId": "copy-action"
                                  },
                                  {
                                    "pluginId": "reload-action"
                                  },
                                  {
                                    "pluginId": "export-markdown-action"
                                  }
                                ]
                              }
                            }
                          ],
                          "transientMessages": [
                            {
                              "pluginId": "transient-assistant-messages"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "slot",
              "plugins": [
                {
                  "id": "project-workspace-view",
                  "pluginId": "project-workspace"
                }
              ]
            }
          ],
          "viewIds": [
            "chat",
            "projects"
          ],
          "keepMounted": true
        }
      }
    ],
    "gap": 0,
    "sizes": [
      "max-content",
      "minmax(0, 1fr)"
    ],
    "responsive": {
      "type": "drawer",
      "primaryIndex": 1,
      "drawerIndex": 0,
      "minPrimaryWidth": 320
    }
  }
}
