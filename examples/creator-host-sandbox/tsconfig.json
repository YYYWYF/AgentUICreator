{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@za38.03/agent-ui-operator/bootstrap": [
        "../../packages/operator/src/bootstrap/index.ts"
      ],
      "@za38.03/agent-ui-plugins": [
        "../../packages/plugins/src/index.ts"
      ],
      "@za38.03/agent-ui-runtime": [
        "../../packages/runtime/src/index.ts"
      ],
      "@za38.03/agent-ui-core": [
        "../../packages/core/src/index.ts"
      ],
      "@za38.03/agent-ui-renderer": [
        "../../packages/renderer/src/index.ts"
      ],
      "@za38.03/agent-ui-operator/source-registry": [
        "../../packages/operator/src/source-catalog/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite-runtime-aliases.ts"
  ]
}
