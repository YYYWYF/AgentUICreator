{
  "name": "@za38.03/agent-ui-creator-embedded-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node ../../scripts/prepare-host-packages.mjs --with-mock && node --import tsx ../../scripts/host-examples/host-project.ts ensure embedded creator-embedded-host",
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "prebuild": "node ../../scripts/prepare-host-packages.mjs && node --import tsx ../../scripts/host-examples/host-project.ts ensure embedded creator-embedded-host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "reset": "node ../../scripts/host-examples/reset-agent-ui.mjs creator-embedded-host",
    "inspect": "node --import tsx ../../scripts/host-examples/host-project.ts inspect creator-embedded-host",
    "init": "node --import tsx ../../scripts/host-examples/host-project.ts init embedded creator-embedded-host",
    "verify:ui": "node --import tsx scripts/verify-ui.ts",
    "pretypecheck": "node ../../scripts/prepare-host-packages.mjs && node --import tsx ../../scripts/host-examples/host-project.ts ensure embedded creator-embedded-host",
    "preinspect": "node ../../scripts/prepare-host-packages.mjs",
    "preverify:ui": "node ../../scripts/prepare-host-packages.mjs",
    "preinit": "node ../../scripts/prepare-host-packages.mjs",
    "pretest": "node ../../scripts/prepare-host-packages.mjs && node --import tsx ../../scripts/host-examples/host-project.ts ensure embedded creator-embedded-host",
    "test": "node --import tsx ../../scripts/host-examples/test-host-example.ts embedded creator-embedded-host"
  },
  "dependencies": {
    "@za38.03/agent-ui-plugins": "workspace:*",
    "@za38.03/agent-ui-runtime": "workspace:*",
    "@za38.03/agent-ui-core": "workspace:*",
    "@za38.03/agent-ui-renderer": "workspace:*",
    "lucide-react": "1.41.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.5.4",
    "@assistant-ui/react-lexical": "0.2.15",
    "@lexical/history": "0.51.0",
    "@lexical/plain-text": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "lexical": "0.51.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@za38.03/agent-ui-operator": "workspace:*",
    "@za38.03/agent-ui-creator": "workspace:*"
  }
}
