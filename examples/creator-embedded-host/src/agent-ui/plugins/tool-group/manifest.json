{
  "id": "tool-group",
  "name": "Conversation Tool Group Renderer",
  "description": "Displays one Agent UI tool group with canonical presentation.",
  "version": "0.0.1",
  "capabilities": [
    "conversation-tool-group-renderer"
  ],
  "requiresRenderScope": true,
  "authoring": {
    "intents": [
      "show grouped tool activity",
      "restore tool group presentation"
    ],
    "visualRole": "assistant tool group presentation",
    "defaultPlacement": {
      "type": "plugin_slot",
      "parentPluginId": "conversation-surface",
      "slot": "toolGroup"
    }
  }
}
