# Copy this file to .env.local in this Host project, beside package.json.
# Set the complete AG-UI URL from the Creator Mock panel or your real backend.
# Restart THIS Host dev server after editing .env.local.
# An explicit <Agent endpoint="..." /> takes precedence over this variable.
# Leave blank only if this Host already serves its backend at /agent.
VITE_AGENT_ENDPOINT=

# Optional: change only if Creator runs at a different address.
# VITE_CREATOR_DOCK_URL=http://localhost:5174/dock.html
