{
  "id": "faq-help-card",
  "name": "FAQ Help Card",
  "description": "Collapsible FAQ card at the top of the chat area with a headerActions semantic slot.",
  "version": "0.0.1",
  "capabilities": [
    "faq-help-card"
  ],
  "authoring": {
    "intents": [
      "show a FAQ card at the chat top",
      "显示常见问题卡片",
      "在聊天区域顶部显示常见问题",
      "expand or collapse FAQ answers"
    ],
    "visualRole": "chat area collapsible FAQ card",
    "recommendedSize": {
      "height": "44px"
    },
    "defaultPlacement": {
      "type": "relative",
      "relation": "above",
      "anchorPluginId": "conversation-surface"
    }
  },
  "slots": {
    "children": {
      "headerActions": {
        "description": "Optional actions displayed in the FAQ card header.",
        "cardinality": "many",
        "optional": true,
        "accepts": {
          "anyOfCapabilities": [
            "help-dismiss-action"
          ]
        }
      }
    }
  }
}
