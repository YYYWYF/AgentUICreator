data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_aee5d8007c2443fcbf9c0588","messageId":"96dd0968-429e-438c-994f-4bad8beb48f7","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/services/composer-triggers.ts\",\"content\":\"1: import type { ConversationMentionSource, ConversationSlashCommand, ConversationSlashCommandSource } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: export type { ConversationMentionSource, ConversationSlashCommand, ConversationSlashCommandSource } from \\\"@za38.03/agent-ui-plugins\\\";\\n3: export const CONVERSATION_MENTION_SOURCE = \\\"conversation.mention-source\\\" as const;\\n4: export const CONVERSATION_COMMAND_SOURCE = \\\"conversation.slash-command-source\\\" as const;\\n5: export interface ConversationCommandRegistry extends ConversationSlashCommandSource {\\n6:   register(command: ConversationSlashCommand): () => void;\\n7: }\\n8: export function createConversationCommandRegistry(): ConversationCommandRegistry {\\n9:   const entries = new Map<string, ConversationSlashCommand>();\\n10:   const listeners = new Set<() => void>();\\n11:   let snapshot: readonly ConversationSlashCommand[] = Object.freeze([]);\\n12:   const publish = () => { snapshot = Object.freeze([...entries.values()]); listeners.forEach(listener => listener()); };\\n13:   return {\\n14:     getSnapshot: () => snapshot,\\n15:     subscribe: listener => { listeners.add(listener); return () => { listeners.delete(listener); }; },\\n16:     register(command) {\\n17:       if (!command.id || entries.has(command.id)) throw new Error(`Duplicate or invalid conversation command: ${command.id}`);\\n18:       entries.set(command.id, command); publish();\\n19:       return () => { if (entries.get(command.id) !== command) return; entries.delete(command.id); publish(); };\\n20:     },\\n21:   };\\n22: }\\n23: declare module \\\"@za38.03/agent-ui-plugins/contracts\\\" {\\n24:   interface UIPluginServiceMap {\\n25:     [CONVERSATION_MENTION_SOURCE]: ConversationMentionSource;\\n26:     [CONVERSATION_COMMAND_SOURCE]: ConversationCommandRegistry;\\n27:   }\\n28: }\\n29: \",\"hash\":\"4692633e2dc2065b83aaf6198c623bd5693e7fa402a76fc3ad5859ce7bc014dc\",\"totalLines\":29,\"nextOffset\":null}}","role":"tool"}

