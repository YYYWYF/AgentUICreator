data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_689a7d3f9e93435189087883","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":300,\"offset\":0}"}

