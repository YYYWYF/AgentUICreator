data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_d199a871fff54043bf7ee159","messageId":"b6ac953f-ccd5-480d-a682-1416058642cb","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/registry.generated.ts\",\"content\":\"1: /**\\n2:  * Generated by scripts/generate-plugin-registry.ts from plugins/* capabilities.\\n3:  * Do not edit this file by hand.\\n4:  */\\n5: import { createPluginCapabilityCatalog } from \\\"@za38.03/agent-ui-runtime/ui\\\";\\n6: \\n7: export const capabilityCatalogRevision = \\\"a2eb1933597edeac9f4954d748046d85ea87eb565d12f913263812f0338766b8\\\";\\n8: \\n9: export const pluginCapabilityCatalog = createPluginCapabilityCatalog([\\n10:   {\\n11:     manifest: {\\n12:       \\\"id\\\": \\\"add-attachment-action\\\",\\n13:       \\\"name\\\": \\\"Conversation Add Attachment Action\\\",\\n14:       \\\"description\\\": \\\"Adds Agent UI's attachment picker to the conversation composer.\\\",\\n15:       \\\"version\\\": \\\"0.0.1\\\",\\n16:       \\\"capabilities\\\": [\\n17:         \\\"conversation-composer-leading-action\\\"\\n18:       ],\\n19:       \\\"authoring\\\": {\\n20:         \\\"intents\\\": [\\n21:           \\\"add attachments to the conversation composer\\\"\\n22:         ],\\n23:         \\\"visualRole\\\": \\\"conversation composer attachment action\\\",\\n24:         \\\"defaultPlacement\\\": {\\n25:           \\\"type\\\": \\\"plugin_slot\\\",\\n26:           \\\"parentPluginId\\\": \\\"composer\\\",\\n27:           \\\"slot\\\": \\\"leadingActions\\\"\\n28:         }\\n29:       }\\n30:     },\\n31:     provides: [],\\n32:     inject: [],\\n33:     optionalInject: [],\\n34:     loadDefinition: () =>\\n35:       import(\\\"./add-attachment-action/definition\\\").then(\\n36:         ({ default: definition }) => definition,\\n37:       ),\\n38:   },\\n39:   {\\n40:     manifest: {\\n41:       \\\"id\\\": \\\"agent-identity\\\",\\n42:       \\\"name\\\": \\\"Agent Identity\\\",\\n43:       \\\"description\\\": \\\"Displays configurable Agent name, logo and optional description in a normal Layout Slot.\\\",\\n44:       \\\"version\\\": \\\"0.0.1\\\",\\n45:       \\\"capabilities\\\": [\\n46:         \\\"agent-identity\\\"\\n47:       ],\\n48:       \\\"authoring\\\": {\\n49:         \\\"intents\\\": [\\n50:           \\\"rename Agent\\\",\\n51:           \\\"change Agent name\\\",\\n52:           \\\"change Agent logo\\\",\\n53:           \\\"change Agent brand information\\\",\\n54:           \\\"把我的 Agent 改名为智能研发助手\\\",\\n55:           \\\"把 Agent 的 Logo 换成公司的标志\\\"\\n56:         ],\\n57:         \\\"visualRole\\\": \\\"Agent identity in a normal Layout Slot; edit plugins/agent-identity/config.ts for branding\\\"\\n58:       }\\n59:     },\\n60:     provides: [],\\n61:     inject: [],\\n62:     optionalInject: [\\\"agent-ui.locale\\\"],\\n63:     loadDefinition: () =>\\n64:       import(\\\"./agent-identity/definition\\\").then(\\n65:         ({ default: definition }) => definition,\\n66:       ),\\n67:   },\\n68:   {\\n69:     manifest: {\\n70:       \\\"id\\\": \\\"composer\\\",\\n71:       \\\"name\\\": \\\"Conversation Composer\\\",\\n72:       \\\"description\\\": \\\"Renders the canonical Agent UI conversation composer with composable action Slots.\\\",\\n73:       \\\"version\\\": \\\"0.0.1\\\",\\n74:       \\\"capabilities\\\": [\\n75:         \\\"conversation-composer\\\"\\n76:       ],\\n77:       \\\"authoring\\\": {\\n78:         \\\"intents\\\": [\\n79:           \\\"show the primary conversation composer\\\",\\n80:           \\\"compose conversation input actions\\\"\\n81:         ],\\n82:         \\\"visualRole\\\": \\\"conversation composer\\\",\\n83:         \\\"defaultPlacement\\\": {\\n84:           \\\"type\\\": \\\"plugin_slot\\\",\\n85:           \\\"parentPluginId\\\": \\\"conversation-surface\\\",\\n86:           \\\"slot\\\": \\\"composer\\\"\\n87:         }\\n88:       },\\n89:       \\\"slots\\\": {\\n90:         \\\"children\\\": {\\n91:           \\\"triggers\\\": {\\n92:             \\\"description\\\": \\\"Optional conversation input triggers.\\\",\\n93:             \\\"cardinality\\\": \\\"many\\\",\\n94:             \\\"optional\\\": true,\\n95:             \\\"accepts\\\": {\\n96:               \\\"anyOfCapabilities\\\": [\\n97:                 \\\"conversation-composer-trigger\\\"\\n98:               ]\\n99:             }\\n100:           },\\n101:           \\\"beforeInput\\\": {\\n102:             \\\"description\\\": \\\"Content displayed between attachments and the composer input.\\\",\\n103:             \\\"cardinality\\\": \\\"many\\\",\\n104:             \\\"optional\\\": true,\\n105:             \\\"accepts\\\": {\\n106:               \\\"anyOfCapabilities\\\": [\\n107:                 \\\"conversation-composer-before-input\\\"\\n108:               ]\\n109:             }\\n110:           },\\n111:           \\\"leadingActions\\\": {\\n112:             \\\"description\\\": \\\"Inline actions displayed on the leading side of the composer.\\\",\\n113:             \\\"cardinality\\\": \\\"many\\\",\\n114:             \\\"optional\\\": true,\\n115:             \\\"accepts\\\": {\\n116:               \\\"anyOfCapabilities\\\": [\\n117:                 \\\"conversation-composer-leading-action\\\",\\n118:                 \\\"conversation-composer-trailing-action\\\"\\n119:               ]\\n120:             }\",\"hash\":\"5cc93b1d47574bbc81d440e65af01259b74ef479e89865722d01d5ad00b0dcfc\",\"totalLines\":1031,\"nextOffset\":120}}","role":"tool"}

