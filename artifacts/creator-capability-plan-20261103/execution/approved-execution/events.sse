data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_57f29dcf0d744b068655dfff","messageId":"af9ab5c9-e12f-40aa-a189-de6d4efb6469","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/reasoning/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"reasoning\\\",\\n3:   \\\"name\\\": \\\"Conversation Reasoning Renderer\\\",\\n4:   \\\"description\\\": \\\"Displays detailed Agent UI reasoning in a collapsible group. Disable this semantic contribution for status-only presentation; collapsing still permits viewing details.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"conversation-reasoning-renderer\\\"\\n8:   ],\\n9:   \\\"requiresRenderScope\\\": true,\\n10:   \\\"authoring\\\": {\\n11:     \\\"intents\\\": [\\n12:       \\\"show the reasoning process\\\",\\n13:       \\\"restore reasoning presentation\\\",\\n14:       \\\"show deep thinking\\\"\\n15:     ],\\n16:     \\\"visualRole\\\": \\\"assistant reasoning presentation\\\",\\n17:     \\\"defaultPlacement\\\": {\\n18:       \\\"type\\\": \\\"plugin_slot\\\",\\n19:       \\\"parentPluginId\\\": \\\"conversation-surface\\\",\\n20:       \\\"slot\\\": \\\"reasoningGroup\\\"\\n21:     }\\n22:   }\\n23: }\\n24: \",\"hash\":\"5731b910826ab07270985b5eb2a75fd371252ac88213fa5b29687d0f0d0e98dd\",\"totalLines\":24,\"nextOffset\":null}}","role":"tool"}

