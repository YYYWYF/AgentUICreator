data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_15bdb95e050d4b70a1cd89f0","messageId":"b460af20-de1f-4672-8fa5-a4f2c3219905","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/copy-action/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"copy-action\\\",\\n3:   \\\"name\\\": \\\"Conversation Copy Action\\\",\\n4:   \\\"description\\\": \\\"Copies text from the complete assistant response.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"conversation-assistant-response-action\\\",\\n8:     \\\"conversation-message-action\\\"\\n9:   ],\\n10:   \\\"authoring\\\": {\\n11:     \\\"intents\\\": [\\n12:       \\\"copy assistant response content\\\"\\n13:     ],\\n14:     \\\"visualRole\\\": \\\"assistant response copy action\\\",\\n15:     \\\"defaultPlacement\\\": {\\n16:       \\\"type\\\": \\\"plugin_slot\\\",\\n17:       \\\"parentPluginId\\\": \\\"response-footer\\\",\\n18:       \\\"slot\\\": \\\"actions\\\"\\n19:     }\\n20:   }\\n21: }\\n22: \",\"hash\":\"10da5907490f71d7f54b2a4ae1ce61cdd17066696d025140154f270969a0aeb2\",\"totalLines\":22,\"nextOffset\":null}}","role":"tool"}

