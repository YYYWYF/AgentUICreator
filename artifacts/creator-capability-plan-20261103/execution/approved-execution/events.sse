data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_5bef4032a3db40698f877cc9","delta":"{\"file_path\":\"/src/agent-ui/plugins/reasoning/index.tsx\",\"limit\":80,\"offset\":0}"}

