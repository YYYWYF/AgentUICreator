data: {"type":"TOOL_CALL_RESULT","toolCallId":"setup-read-2","messageId":"e302faf8-ca48-474f-aeb2-fc8be8e0411f","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-content/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import \\\"./styles.css\\\";\\n3: \\n4: const messages: Record<string, string> = {\\n5:   \\\"zh-CN\\\": \\\"你可以提问、上传附件或查看历史记录\\\",\\n6:   \\\"en-US\\\": \\\"You can ask questions, upload attachments, or view history\\\",\\n7: };\\n8: \\n9: export function QuickHelpContentPlugin() {\\n10:   const localeCode = useAgentUILocaleCode();\\n11:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n12: \\n13:   return (\\n14:     <p className=\\\"quick-help-content\\\" role=\\\"note\\\">\\n15:       {text}\\n16:     </p>\\n17:   );\\n18: }\\n19: \",\"hash\":\"25182348a1daf0e0f62f91d745666b6d04ec9517981f72b35961992a6597059a\",\"totalLines\":19,\"nextOffset\":null}}","role":"tool"}

