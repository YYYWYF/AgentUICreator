data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_c0853cac0502473d8697103e","delta":"{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"limit\":6000,\"offset\":0,\"sectionId\":\"s5\"}"}

