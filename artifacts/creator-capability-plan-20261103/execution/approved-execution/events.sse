data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_35f368059f1e458c9b165da8","messageId":"46c86ae3-7403-4323-ba0b-680d5b4acea7","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"285dafde4c26c74541f8b87f0c52d5997b4a3660675815bd6a350ea34c1da457\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"title\":\"Scoped Renderer Plugins\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/scoped-renderer-plugin.md\",\"summary\":\"render scope、renderer 子插槽、消息/工具展示及 Lexical 编辑生命周期。\",\"sha256\":\"d3b355efeb0b076c8bd97c876a5aa1b3fa284beada0ad47078e6e8f68da1570c\",\"totalSections\":5,\"offset\":0,\"sections\":[{\"sectionId\":\"s1\",\"title\":\"Scoped Renderer Plugins\",\"level\":1,\"characters\":2253,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"公开合同\",\"level\":2,\"characters\":650,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s17\",\"title\":\"Conversation Surface\",\"level\":2,\"characters\":516,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s25\",\"title\":\"可选 Lexical 的生命周期\",\"level\":2,\"characters\":740,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s25\"}}},{\"sectionId\":\"s33\",\"title\":\"项目定制\",\"level\":2,\"characters\":164,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s33\"}}}],\"nextOffset\":null}}","role":"tool"}

