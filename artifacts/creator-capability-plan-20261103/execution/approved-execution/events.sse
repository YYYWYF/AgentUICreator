 => number) | (() => bigint)\",\"typeTruncated\":false},{\"name\":\"toLocaleString\",\"type\":\"(() => string) | { (locales?: string | string[] | undefined, options?: NumberFormatOptions | undefined): string; (locales?: LocalesArgument, options?: NumberFormatOptions | undefined): string; } | ((locales?: LocalesArgument, options?: BigIntToLocaleStringOptions | undefined) => string)\",\"typeTruncated\":false}]},{\"name\":\"suggestions\",\"type\":\"ReactNode\",\"typeTruncated\":false,\"runtimeManaged\":false,\"members\":[{\"name\":\"toString\",\"type\":\"(() => string) | (() => string) | ((radix?: number | undefined) => string) | ((radix?: number | undefined) => string)\",\"typeTruncated\":false},{\"name\":\"valueOf\",\"type\":\"(() => Object) | (() => string) | (() => boolean) | (() => number) | (() => bigint)\",\"typeTruncated\":false},{\"name\":\"toLocaleString\",\"type\":\"(() => string) | { (locales?: string | string[] | undefined, options?: NumberFormatOptions | undefined): string; (locales?: LocalesArgument, options?: NumberFormatOptions | undefined): string; } | ((locales?: LocalesArgument, options?: BigIntToLocaleStringOptions | undefined) => string)\",\"typeTruncated\":false}]},{\"name\":\"composer\",\"type\":\"ReactNode\",\"typeTruncated\":false,\"runtimeManaged\":false,\"members\":[{\"name\":\"toString\",\"type\":\"(() => string) | (() => string) | ((radix?: number | undefined) => string) | ((radix?: number | undefined) => string)\",\"typeTruncated\":false},{\"name\":\"valueOf\",\"type\":\"(() => Object) | (() => string) | (() => boolean) | (() => number) | (() => bigint)\",\"typeTruncated\":false},{\"name\":\"toLocaleString\",\"type\":\"(() => string) | { (locales?: string | string[] | undefined, options?: NumberFormatOptions | undefined): string; (locales?: LocalesArgument, options?: NumberFormatOptions | undefined): string; } | ((locales?: LocalesArgument, options?: BigIntToLocaleStringOptions | undefined) => string)\",\"typeTruncated\":false}]},{\"name\":\"className\",\"type\":\"string | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false,\"memberCount\":50,\"membersOmitted\":true},{\"name\":\"style\",\"type\":\"CSSProperties | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false,\"memberCount\":857,\"membersOmitted\":true},{\"name\":\"renderSlot\",\"type\":\"((name: string, fallback?: ReactNode) => ReactNode) | undefined\",\"typeTruncated\":false,\"runtimeManaged\":true},{\"name\":\"renderScopedSlot\",\"type\":\"((name: string, scope: { kind: string; value: unknown; }, fallback?: ReactNode) => ReactNode) | undefined\",\"typeTruncated\":false,\"runtimeManaged\":true},{\"name\":\"key\",\"type\":\"Key | null | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false,\"members\":[{\"name\":\"toString\",\"type\":\"(() => string) | ((radix?: number | undefined) => string) | ((radix?: number | undefined) => string)\",\"typeTruncated\":false},{\"name\":\"valueOf\",\"type\":\"(() => string) | (() => number) | (() => bigint)\",\"typeTruncated\":false},{\"name\":\"toLocaleString\",\"type\":\"(() => string) | { (locales?: string | string[] | undefined, options?: NumberFormatOptions | undefined): string; (locales?: LocalesArgument, options?: NumberFormatOptions | undefined): string; } | ((locales?: LocalesArgument, options?: BigIntToLocaleStringOptions | undefined) => string)\",\"typeTruncated\":false}]},{\"name\":\"ref\",\"type\":\"Ref<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"dangerouslySetInnerHTML\",\"type\":\"{ __html: string | TrustedHTML; } | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false,\"members\":[{\"name\":\"__html\",\"type\":\"string | TrustedHTML\",\"typeTruncated\":false}]},{\"name\":\"onCopy\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCopyCapture\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCut\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCutCapture\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onPaste\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onPasteCapture\",\"type\":\"ClipboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionEnd\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionEndCapture\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionStart\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionStartCapture\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionUpdate\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCompositionUpdateCapture\",\"type\":\"CompositionEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onFocus\",\"type\":\"FocusEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onFocusCapture\",\"type\":\"FocusEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onBlur\",\"type\":\"FocusEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onBlurCapture\",\"type\":\"FocusEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onChange\",\"type\":\"ChangeEventHandler<HTMLDivElement, Element> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onChangeCapture\",\"type\":\"ChangeEventHandler<HTMLDivElement, Element> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onBeforeInput\",\"type\":\"InputEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onBeforeInputCapture\",\"type\":\"InputEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onInput\",\"type\":\"InputEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onInputCapture\",\"type\":\"InputEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onReset\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onResetCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onSubmit\",\"type\":\"SubmitEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onSubmitCapture\",\"type\":\"SubmitEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onInvalid\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onInvalidCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onLoad\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onLoadCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onError\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onErrorCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyDown\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyDownCapture\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyPress\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyPressCapture\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyUp\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onKeyUpCapture\",\"type\":\"KeyboardEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onAbort\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onAbortCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlay\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayThrough\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayThroughCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onDurationChange\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onDurationChangeCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEmptied\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEmptiedCapture\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEncrypted\",\"type\":\"ReactEventHandler<HTMLDivElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false}],\"interpretation\":\"Props describe supported seams, not a guarantee that all requested behavior is implemented. Nested type text may be abbreviated. Prefer application props/composition; if a required seam is absent, explain the gap before proposing implementation takeover. Do not trace Host Runtime to infer missing public APIs.\"}},\"selected\":true,\"instances\":[{\"id\":\"p9\",\"pluginId\":\"conversation-surface\",\"enabled\":true,\"slots\":{\"emptySuggestions\":[{\"id\":\"p10\",\"pluginId\":\"conversation-suggestions\",\"enabled\":true}],\"composer\":[{\"id\":\"p11\",\"pluginId\":\"composer\",\"enabled\":true,\"slots\":{\"leadingActions\":[{\"id\":\"p12\",\"pluginId\":\"add-attachment-action\",\"enabled\":true}],\"submitAction\":[{\"id\":\"p13\",\"pluginId\":\"submit-action\",\"enabled\":true}],\"beforeInput\":[{\"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]}}],\"reasoningGroup\":[{\"id\":\"p15\",\"pluginId\":\"reasoning\",\"enabled\":true}],\"toolGroup\":[{\"id\":\"p16\",\"pluginId\":\"tool-group\",\"enabled\":true}],\"toolFallback\":[{\"id\":\"p17\",\"pluginId\":\"tool-result\",\"enabled\":true}],\"assistantResponseFooter\":[{\"id\":\"p18\",\"pluginId\":\"response-footer\",\"enabled\":true,\"slots\":{\"actions\":[{\"id\":\"p19\",\"pluginId\":\"copy-action\",\"enabled\":true},{\"id\":\"p20\",\"pluginId\":\"reload-action\",\"enabled\":true},{\"id\":\"p21\",\"pluginId\":\"export-markdown-action\",\"enabled\":true}]}}],\"transientMessages\":[{\"id\":\"p22\",\"pluginId\":\"transient-assistant-messages\",\"enabled\":true}]},\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l11\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"auto_a63bcc9af1da563c\"}],\"manifest\":{\"id\":\"conversation-surface\",\"name\":\"Conversation Surface\",\"description\":\"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\"version\":\"0.0.1\",\"capabilities\":[\"conversation-surface\"],\"authoring\":{\"intents\":[\"show the primary live and historical conversation experience\"],\"visualRole\":\"primary conversation surface\",\"recommendedSize\":{\"width\":\"minmax(0, 1fr)\"}},\"slots\":{\"children\":{\"emptyWelcome\":{\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"optional\":true},\"emptySuggestions\":{\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]}},\"headerActions\":{\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]}},\"composer\":{\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]}},\"reasoningGroup\":{\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]}},\"toolGroup\":{\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]}},\"toolFallback\":{\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]}},\"taskGroup\":{\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]}},\"assistantResponseFooter\":{\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]}},\"userEditComposer\":{\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]}},\"toolTimeline\":{\"description\":\"One tool execution timeline per assistant message.\",\"mode\":\"renderer\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]}},\"thinkingIndicator\":{\"description\":\"Message-scoped thinking placeholder.\",\"mode\":\"renderer\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]}},\"transientMessages\":{\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"optional\":true,\"mode\":\"renderer\",\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]}}}},\"data\":{\"messages\":true}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport implementation from \\\"@za38.03/agent-ui-plugins/conversation-surface\\\";\\nimport { ConversationSurfacePlugin } from \\\"./index\\\";\\nconst definition: UIPluginDefinition = { manifest: implementation.manifest, provides: [], inject: [\\\"agent-ui.conversations\\\"], optionalInject: [\\\"agent-ui.theme\\\", \\\"agent-ui.locale\\\"], Component: ConversationSurfacePlugin };\\nexport default definition;\\n\",\"truncated\":false,\"characters\":447},\"services\":{\"provides\":[],\"required\":[\"agent-ui.conversations\"],\"optional\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/conversation-surface/application.json\",\"kind\":\"file\",\"bytes\":63},{\"path\":\"src/agent-ui/plugins/conversation-surface/definition.ts\",\"kind\":\"file\",\"bytes\":447},{\"path\":\"src/agent-ui/plugins/conversation-surface/index.tsx\",\"kind\":\"file\",\"bytes\":791},{\"path\":\"src/agent-ui/plugins/conversation-surface/manifest.json\",\"kind\":\"file\",\"bytes\":4627}],\"filesTruncated\":false}}","role":"tool"}

