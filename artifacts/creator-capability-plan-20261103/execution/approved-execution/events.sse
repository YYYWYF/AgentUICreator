data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_5bef4032a3db40698f877cc9","messageId":"3a4e5285-6d41-42e2-9771-9116cc35c7c2","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/reasoning/index.tsx\",\"content\":\"1: import { ConversationReasoningPlugin as Implementation } from \\\"@za38.03/agent-ui-plugins/reasoning\\\";\\n2: import type { ComponentProps } from \\\"react\\\";\\n3: import { usePluginRenderScope } from \\\"@za38.03/agent-ui-plugins\\\";\\n4: \\n5: export function ConversationReasoningPlugin(props: ComponentProps<typeof Implementation>) {\\n6:   const scope = usePluginRenderScope<Partial<ComponentProps<typeof Implementation>>>();\\n7:   if (scope?.kind !== \\\"conversation.reasoning-group\\\") return null;\\n8:   return <Implementation {...scope.value} {...props} />;\\n9: }\\n10: \",\"hash\":\"093fa95f8ea5180fa6e71da2410256bb49ed094befa8e36a47e27e318ed78556\",\"totalLines\":10,\"nextOffset\":null}}","role":"tool"}

