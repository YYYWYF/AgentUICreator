 usage-help card at the top of the chat area with headerActions and body semantic slots.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"quick-help-card\\\"\\n8:   ],\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"show a quick help card at the chat top\\\",\\n12:       \\\"显示使用帮助卡片\\\",\\n13:       \\\"在聊天区域顶部显示帮助卡片\\\",\\n14:       \\\"expand or collapse usage help\\\"\\n15:     ],\\n16:     \\\"visualRole\\\": \\\"chat area collapsible help card\\\",\\n17:     \\\"recommendedSize\\\": {\\n18:       \\\"height\\\": \\\"44px\\\"\\n19:     },\\n20:     \\\"defaultPlacement\\\": {\\n21:       \\\"type\\\": \\\"relative\\\",\\n22:       \\\"relation\\\": \\\"above\\\",\\n23:       \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n24:     }\\n25:   },\\n26:   \\\"slots\\\": {\\n27:     \\\"children\\\": {\\n28:       \\\"headerActions\\\": {\\n29:         \\\"description\\\": \\\"Optional actions displayed in the help card header.\\\",\\n30:         \\\"cardinality\\\": \\\"many\\\",\\n31:         \\\"optional\\\": true\\n32:       },\\n33:       \\\"body\\\": {\\n34:         \\\"description\\\": \\\"Help content displayed when the card is expanded.\\\",\\n35:         \\\"cardinality\\\": \\\"one\\\",\\n36:         \\\"optional\\\": true,\\n37:         \\\"accepts\\\": {\\n38:           \\\"anyOfCapabilities\\\": [\\n39:             \\\"quick-help-content\\\"\\n40:           ]\\n41:         }\\n42:       }\\n43:     }\\n44:   }\\n45: }\\n46: \",\"hash\":\"5c1d2d1b14bc4aa2ff75404516bcc8e60b78ac8f02e39d6ee5321b27120945bd\",\"totalLines\":46,\"nextOffset\":null,\"recovery\":{\"action\":\"reuse_observed_file\",\"path\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"repeatedUnchangedReads\":4,\"instruction\":\"This unchanged range was read in this run; its evidence remains recorded and edits check current hashes. Reuse it. Query only a concrete missing public contract. New project-owned behavior may be designed within authorization and validated after implementation; its absence in current source is expected. Protected paths and takeover permissions have not changed.\"}},{\"path\":\"/src/agent-ui/plugins/quick-help-card/styles.css\",\"content\":\"1: .quick-help-card {\\n2:   box-sizing: border-box;\\n3:   width: 100%;\\n4:   min-width: 0;\\n5:   background: var(--card);\\n6:   color: var(--foreground);\\n7:   border-bottom: 1px solid var(--border);\\n8: }\\n9: \\n10: .quick-help-card__header {\\n11:   display: flex;\\n12:   align-items: center;\\n13:   gap: 8px;\\n14:   padding: 8px 12px;\\n15: }\\n16: \\n17: .quick-help-card__toggle {\\n18:   display: inline-flex;\\n19:   align-items: center;\\n20:   gap: 6px;\\n21:   flex: 1 1 auto;\\n22:   min-width: 0;\\n23:   margin: 0;\\n24:   padding: 4px 6px;\\n25:   border: none;\\n26:   border-radius: 6px;\\n27:   background: transparent;\\n28:   color: inherit;\\n29:   font: inherit;\\n30:   font-size: 13px;\\n31:   line-height: 1.5;\\n32:   text-align: left;\\n33:   cursor: pointer;\\n34: }\\n35: \\n36: .quick-help-card__toggle:hover {\\n37:   background: var(--muted);\\n38: }\\n39: \\n40: .quick-help-card__toggle:focus-visible {\\n41:   outline: 2px solid var(--ring, var(--border));\\n42:   outline-offset: 2px;\\n43: }\\n44: \\n45: .quick-help-card__title {\\n46:   font-weight: 600;\\n47:   overflow-wrap: anywhere;\\n48: }\\n49: \\n50: .quick-help-card__indicator {\\n51:   flex: 0 0 auto;\\n52:   font-size: 12px;\\n53:   opacity: 0.8;\\n54: }\\n55: \\n56: .quick-help-card__toggle-label {\\n57:   flex: 0 0 auto;\\n58:   font-size: 12px;\\n59:   opacity: 0.7;\\n60: }\\n61: \\n62: .quick-help-card__header-actions {\\n63:   display: flex;\\n64:   align-items: center;\\n65:   gap: 4px;\\n66:   flex: 0 0 auto;\\n67:   min-width: 0;\\n68: }\\n69: \\n70: .quick-help-card__body {\\n71:   box-sizing: border-box;\\n72:   min-width: 0;\\n73:   padding: 0 12px 8px;\\n74:   font-size: 13px;\\n75:   line-height: 1.5;\\n76: }