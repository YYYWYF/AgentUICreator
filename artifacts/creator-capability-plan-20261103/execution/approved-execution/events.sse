data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_09d1eb5b8b014dec8d341af0","messageId":"9183e601-e6c5-4f4f-b504-c5476996886b","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"285dafde4c26c74541f8b87f0c52d5997b4a3660675815bd6a350ea34c1da457\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"title\":\"Scope\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/plugin-authoring-contract.md\",\"summary\":\"自定义插件 authoring、默认放置、容器子插槽、renderer、样式隔离和校验合同。\",\"sha256\":\"e09945ea7269cd43caabbf18eb2a96fce0f127db8abd03a001cde12119c91e22\",\"sectionId\":\"s20\",\"offset\":0,\"totalCharacters\":543,\"content\":\"## Scope\\n\\nThe existing `UIPluginManifest.authoring` fields are the contract. This phase\\ndoes not add a `creatorReady` flag, a readiness score, or another manifest\\nschema. The Host derives readiness from the manifest, capabilities, and child\\nSlot declarations. It never reads React source to infer placement.\\n\\nThe contract is optional. A Plugin without `authoring` is still a valid Runtime\\nPlugin and may be configured manually in `app-ui/app-ui.json`; it simply makes\\nno promise that Creator can discover or automatically add and restore it.\\n\\n\",\"nextOffset\":null}}","role":"tool"}

