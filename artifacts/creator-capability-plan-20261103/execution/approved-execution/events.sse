data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_bf225b93335448a6885ad066","messageId":"9509ee63-7856-4baa-bb2f-b5a070995826","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"c0190ce0113c44c938a625422461d3efdd634b35615c74e3efac8127bbf73c37\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"directory\":\"quick-help-card\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"显示使用帮助卡片\",\"在聊天区域顶部显示帮助卡片\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"44px\"}},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true}},\"dataMessageUINames\":[],\"selected\":true},\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":2,\"resolved\":2,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/contracts\",\"symbols\":[{\"name\":\"UIPluginComponentProps\",\"status\":\"available\",\"type\":\"UIPluginComponentProps\",\"truncated\":false,\"memberNames\":[\"renderSlot\",\"renderScopedSlot\"],\"memberNamesTruncated\":false,\"parameterQueries\":[\"UIPluginComponentProps.renderSlot.$parameter0\",\"UIPluginComponentProps.renderScopedSlot.$parameter0\"],\"parameterContracts\":[{\"query\":\"UIPluginComponentProps.renderSlot.$parameter0\",\"type\":\"string\",\"truncated\":false,\"propNames\":[],\"propNamesTruncated\":false,\"members\":[],\"membersTruncated\":false}],\"parameterContractsTruncated\":true,\"nextEvidence\":\"Invocation parameters are included in parameterContracts. Truncation flags identify omitted details; parameterQueries expand exact parameter paths.\",\"members\":[{\"name\":\"renderSlot\",\"type\":\"(localSlotName: string, fallback?: ReactNode, options?: UIPluginRenderSlotOptions | undefined) => ReactNode\",\"truncated\":false},{\"name\":\"renderScopedSlot\",\"type\":\"(localSlotName: string, scope: UIPluginRenderScope<unknown>, fallback?: ReactNode) => ReactNode\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false},{\"name\":\"UIPluginRenderScope\",\"status\":\"available\",\"type\":\"UIPluginRenderScope<T>\",\"truncated\":false,\"memberNames\":[\"kind\",\"value\"],\"memberNamesTruncated\":false,\"members\":[{\"name\":\"kind\",\"type\":\"string\",\"truncated\":false},{\"name\":\"value\",\"type\":\"T\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"p24\",\"pluginId\":\"quick-help-card\",\"enabled\":true,\"slots\":{\"body\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true}]},\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l10\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p24\"}],\"manifest\":{\"id\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"version\":\"0.0.1\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"显示使用帮助卡片\",\"在聊天区域顶部显示帮助卡片\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"recommendedSize\":{\"height\":\"44px\"},\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"}},\"slots\":{\"children\":{\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true},\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}}}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpCardPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpCardPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":400},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"kind\":\"file\",\"bytes\":400},{\"path\":\"src/agent-ui/plugins/quick-help-card/index.tsx\",\"kind\":\"file\",\"bytes\":188