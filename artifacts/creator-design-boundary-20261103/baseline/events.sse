ace\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"ç»Ÿä¸€ Plugins åŒ…ã€å†…ç½®æºç ç›®å½•ä¸ŽæŒ‰éœ€æºç æ‰˜ç®¡\",\"source\":\"internal\",\"topic\":\"èŒè´£ä¸Žæ‰€æœ‰æƒ\",\"path\":\"references/docs/architecture/npm-default-plugin-source-ownership.md\",\"summary\":\"npm é»˜è®¤äº¤ä»˜ã€é¡¹ç›®è–„åº”ç”¨å±‚ã€æºç æŽ¥ç®¡æŽˆæƒã€BASE/LOCAL/TARGET ä¸Žæ›´æ–°ä¿æŠ¤ã€‚\",\"sha256\":\"cbc8052587ee42d67d634c94f1fd9dac8ace5603ec4d4e92bf10e191af808eb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s69\",\"title\":\"5. è–„åº”ç”¨å±‚ä¸Žè¯­ä¹‰æŽ¥çº¿\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s69\"}}},{\"sectionId\":\"s1\",\"title\":\"ç»Ÿä¸€ Plugins åŒ…ã€å†…ç½®æºç ç›®å½•ä¸ŽæŒ‰éœ€æºç æ‰˜ç®¡\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s158\",\"title\":\"11. éªŒè¯ä¸Žå½“å‰æ”¯æŒèŒƒå›´\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s158\"}}}]},{\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"title\":\"Conversation Domain æž¶æž„\",\"source\":\"internal\",\"topic\":\"èŒè´£ä¸Žæ‰€æœ‰æƒ\",\"path\":\"references/docs/architecture/p3r-0-assistant-ui-conversation-domain-rebaseline.md\",\"summary\":\"Conversation Domain å½“å‰æ‰€æœ‰æƒï¼›assistant-ui Runtimeã€æ¶ˆæ¯æ³¨å†Œä¸Ž Custom Event è¾¹ç•Œã€‚\",\"sha256\":\"b2b0b4d9fc70734ea3ee03799137bfd83827b8a827c8b032008991dab1337b48\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\"}},\"matchingSections\":[{\"sectionId\":\"s19\",\"title\":\"æ¸²æŸ“ä¸Žè¯­ä¹‰ç»„åˆ\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s19\"}}},{\"sectionId\":\"s1\",\"title\":\"Conversation Domain æž¶æž„\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s39\",\"title\":\"Frontend Tool ä¸Ž HITL\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s39\"}}}]},{\"documentId\":\"internal:architecture/assistant-response-footer\",\"title\":\"Assistant Response Group and Footer\",\"source\":\"internal\",\"topic\":\"ä¼šè¯ä¸Žäº¤äº’\",\"path\":\"references/docs/architecture/assistant-response-footer.md\",\"summary\":\"å›žå¤ç»„ä¸Žæ“ä½œæ ï¼›å¤šæ¶ˆæ¯å›žå¤åªåœ¨æœ€ç»ˆæ¶ˆæ¯ä¸‹å‘ˆçŽ°ä¸€æ¬¡ footerã€‚\",\"sha256\":\"db252dcada36c6f5e724f897c6f1070a258264db936c27b2751a1da22a3191f5\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/assistant-response-footer\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Assistant Response Group and Footer\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/assistant-response-footer\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"title\":\"Generic Sidebar Layout\",\"source\":\"internal\",\"topic\":\"æ’ä»¶å¼€å‘ä¸Žç»„åˆ\",\"path\":\"references/docs/architecture/generic-sidebar-layout.md\",\"summary\":\"Sidebar å¸ƒå±€ã€å·¦å³åŒºåŸŸã€å°ºå¯¸ä¸Žè¯­ä¹‰ç»„åˆã€‚\",\"sha256\":\"c92dc7ccf3c65ac4eb711c1251a3d485f0ebb128b5a5a36facc855dd27d8b996\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Generic Sidebar Layout\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s31\",\"title\":\"Product adapter differences\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s42\",\"title\":\"Creator and templates\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s42\"}}}]}],\"nextOffset\":8}}","role":"tool"}

