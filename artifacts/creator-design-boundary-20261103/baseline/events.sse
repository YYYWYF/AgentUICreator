data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_84dQe78nFBrSJByFgWkb7781","messageId":"caa1a892-1cf9-488c-9207-1705620734c0","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-card/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"quick-help-card\\\",\\n3:   \\\"name\\\": \\\"Quick Help Card\\\",\\n4:   \\\"description\\\": \\\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"quick-help-card\\\"\\n8:   ],\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"show a quick help card at the chat top\\\",\\n12:       \\\"æ˜¾ç¤ºä½¿ç”¨å¸®åŠ©å¡ç‰‡\\\",\\n13:       \\\"åœ¨èŠå¤©åŒºåŸŸé¡¶éƒ¨æ˜¾ç¤ºå¸®åŠ©å¡ç‰‡\\\",\\n14:       \\\"expand or collapse usage help\\\"\\n15:     ],\\n16:     \\\"visualRole\\\": \\\"chat area collapsible help card\\\",\\n17:     \\\"recommendedSize\\\": {\\n18:       \\\"height\\\": \\\"44px\\\"\\n19:     },\\n20:     \\\"defaultPlacement\\\": {\\n21:       \\\"type\\\": \\\"relative\\\",\\n22:       \\\"relation\\\": \\\"above\\\",\\n23:       \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n24:     }\\n25:   },\\n26:   \\\"slots\\\": {\\n27:     \\\"children\\\": {\\n28:       \\\"headerActions\\\": {\\n29:         \\\"description\\\": \\\"Optional actions displayed in the help card header.\\\",\\n30:         \\\"cardinality\\\": \\\"many\\\",\\n31:         \\\"optional\\\": true\\n32:       },\\n33:       \\\"body\\\": {\\n34:         \\\"description\\\": \\\"Help content displayed when the card is expanded.\\\",\\n35:         \\\"cardinality\\\": \\\"one\\\",\\n36:         \\\"optional\\\": true,\\n37:         \\\"accepts\\\": {\\n38:           \\\"anyOfCapabilities\\\": [\\n39:             \\\"quick-help-content\\\"\\n40:           ]\\n41:         }\\n42:       }\\n43:     }\\n44:   }\\n45: }\\n46: \",\"hash\":\"5c1d2d1b14bc4aa2ff75404516