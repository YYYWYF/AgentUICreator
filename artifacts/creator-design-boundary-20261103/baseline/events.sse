data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_ap03Z9zkYqJlKo1SttLJ7733","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":400,\"offset\":0}"}

