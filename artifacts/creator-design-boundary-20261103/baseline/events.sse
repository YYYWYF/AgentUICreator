data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_hJvVXxhBOxjjKUupxJan6592","messageId":"0675805a-f671-4006-a232-0606d39f7ac2","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"9130fc9dbe139ddf8b8a07f221ffe9201199bdd9bb4fcb76047b661fb466adf1\",\"query\":\"scoped slot renderScopedSlot usePluginRenderScope\",\"total\":26,\"offset\":0,\"entries\":[{\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"title\":\"Scoped Renderer Plugins\",\"source\":\"internal\",\"topic\":\"æ’ä»¶å¼€å‘ä¸Žç»„åˆ\",\"path\":\"references/docs/architecture/scoped-renderer-plugin.md\",\"summary\":\"render scopeã€renderer å­æ’æ§½ã€æ¶ˆæ¯/å·¥å…·å±•ç¤ºåŠ Lexical ç¼–è¾‘ç”Ÿå‘½å‘¨æœŸã€‚\",\"sha256\":\"d3b355efeb0b076c8bd97c876a5aa1b3fa284beada0ad47078e6e8f68da1570c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Scoped Renderer Plugins\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"å…¬å¼€åˆåŒ\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s5\"}}}]},{\"documentId\":\"public:development/component-customization\",\"title\":\"ç»„ä»¶å±žæ€§ä¸Žç»„åˆå®šåˆ¶\",\"source\":\"public\",\"topic\":\"å¼€å‘æ–‡æ¡£\",\"path\":\"development/component-customization.md\",\"summary\":\"ä¿®æ”¹å·²æœ‰æ’ä»¶æ—¶ï¼Œå…ˆæ‰“å¼€é¡¹ç›®ä¸­çš„ plugins/<æ’ä»¶å>/index.tsxã€‚å®ƒæ˜¯é¡¹ç›®è‡ªå·±çš„å®šåˆ¶å…¥å£ï¼Œå¯ä»¥ç»™å…¬å¼€ç»„ä»¶ä¼ å±žæ€§ã€æ›¿æ¢å­ç»„ä»¶æˆ–è‡ªå®šä¹‰æ¸²æŸ“å‡½æ•°ã€‚å®Œæˆè¿™äº›ä¿®æ”¹ä¸éœ€è¦æŽ¥ç®¡å®˜æ–¹æºç ã€‚ å„æ’ä»¶é¡µé¢çš„â€œæ‰‹åŠ¨å¼€å‘ â†’ å±žæ€§â€åˆ—å‡ºå®Œæ•´å±žæ€§ã€ç±»åž‹ã€é»˜è®¤è¡Œä¸ºä¸ŽåµŒå¥—é…ç½®ã€‚é¡µé¢ä¼šåˆ†åˆ«è¯´æ˜Žå¯ä¿®æ”¹çš„å±•ç¤ºå±žæ€§ï¼Œä»¥åŠä¼šè¯è‡ªåŠ¨ä¼ å…¥çš„æ•°æ®å’Œæ–¹æ³•ã€‚è°ƒæ•´å¤–è§‚æ—¶ï¼Œä¿ç•™åŽŸæœ‰ä¼ å‚å’Œå‡½æ•°è°ƒç”¨ã€‚\",\"sha256\":\"e8f9ff31359c913cec4518990775e1e1bc05bd1b71a2f98bf7a69076668f8129\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/component-customization\"}},\"matchingSections\":[{\"sectionId\":\"s49\",\"title\":\"é€‰æ‹©åˆé€‚çš„å®šåˆ¶æ–¹å¼\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/component-customization\",\"sectionId\":\"s49\"}}},{\"sectionId\":\"s1\",\"title\":\"ç»„ä»¶å±žæ€§ä¸Žç»„åˆå®šåˆ¶\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/component-customization\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s7\",\"title\":\"ç¤ºä¾‹ï¼šè°ƒæ•´è¾“å…¥æ¡†\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/component-customization\",\"sectionId\":\"s7\"}}}]},{\"documentId\":\"public:development/plugin-api\",\"title\":\"æ’ä»¶å¼€å‘æŽ¥å£\",\"source\":\"public\",\"topic\":\"å¼€å‘æ–‡æ¡£\",\"path\":\"development/plugin-api.md\",\"summary\":\"é¡¹ç›®æ’ä»¶ç”±èƒ½åŠ›å£°æ˜Žã€ç»„ä»¶å’Œå¯é€‰çš„æœåŠ¡ç”Ÿå‘½å‘¨æœŸç»„æˆã€‚åˆ›å»ºæ–‡ä»¶ä¸Žæ³¨å†Œæ­¥éª¤è§åˆ›å»ºè‡ªå®šä¹‰æ’ä»¶ã€‚ä¿®æ”¹å·²æœ‰å®˜æ–¹æ’ä»¶å¤–è§‚æ—¶ï¼Œå…ˆä½¿ç”¨ç»„ä»¶å…¬å¼€å±žæ€§ã€‚\",\"sha256\":\"cd30e68bc788dd22fdccc937313217ed5e3c3816b86e84f9138f758709423720\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugi