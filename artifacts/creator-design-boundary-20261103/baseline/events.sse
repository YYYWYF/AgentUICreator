data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_9uf4Fm0jy93btCClRk3M0974","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

