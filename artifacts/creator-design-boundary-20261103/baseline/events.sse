\"æ˜¾ç¤ºå¸®åŠ©æ­£æ–‡\",\"åœ¨å¸®åŠ©å¡ç‰‡æ­£æ–‡æ˜¾ç¤ºæç¤º\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpContentPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpContentPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":406},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"kind\":\"file\",\"bytes\":406},{\"path\":\"src/agent-ui/plugins/quick-help-content/index.tsx\",\"kind\":\"file\",\"bytes\":515},{\"path\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"kind\":\"file\",\"bytes\":554},{\"path\":\"src/agent-ui/plugins/quick-help-content/styles.css\",\"kind\":\"file\",\"bytes\":168}],\"filesTruncated\":false}}","role":"tool"}

