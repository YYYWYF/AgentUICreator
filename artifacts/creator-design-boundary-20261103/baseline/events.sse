data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_mvk94xQahH74nBdqTSvX1568","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":200,\"offset\":0}"}

