data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_bNQ8HTdw4xGpVs5E7rus3568","messageId":"34bb45ee-b614-42cd-9301-3edbdfd30d88","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-content/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"quick-help-content\\\",\\n3:   \\\"name\\\": \\\"Quick Help Content\\\",\\n4:   \\\"description\\\": \\\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"quick-help-content\\\"\\n8:   ],\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"show quick help body text\\\",\\n12:       \\\"æ˜¾ç¤ºå¸®åŠ©æ­£æ–‡\\\",\\n13:       \\\"åœ¨å¸®åŠ©å¡ç‰‡æ­£æ–‡æ˜¾ç¤ºæç¤º\\\"\\n14:     ],\\n15:     \\\"visualRole\\\": \\\"help card body content\\\",\\n16:     \\\"defaultPlacement\\\": {\\n17:       \\\"type\\\": \\\"plugin_slot\\\",\\n18:       \\\"parentPluginId\\\": \\\"quick-help-card\\\",\\n19:       \\\"slot\\\": \\\"body\\\"\\n20:     }\\n21:   }\\n22: }\\n23: \",\"hash\":\"3d6af5731c6eeb7e934124b73fa0c8cbe3e3daf2e2002a3a3af5a591ef4a5fbf\",\"totalLines\":23,\"nextOffset\":null}}","role":"tool"}

