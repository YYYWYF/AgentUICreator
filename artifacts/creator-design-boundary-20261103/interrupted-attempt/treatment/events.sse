data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_03_HmGXzV1uLfEnnBDfiVVw8392","messageId":"c07666f7-fcd3-4a53-b308-81951899c427","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/test-notice/styles.css\",\"content\":\"1: .test-notice {\\n2:   box-sizing: border-box;\\n3:   width: 100%;\\n4:   min-width: 0;\\n5:   padding: 8px 12px;\\n6:   background: var(--muted);\\n7:   color: var(--foreground);\\n8:   border-bottom: 1px solid var(--border);\\n9: }\\n10: \\n11: .test-notice__text {\\n12:   margin: 0;\\n13:   font-size: 13px;\\n14:   line-height: 1.5;\\n15:   word-break: break-word;\\n16: }\\n17: \",\"hash\":\"712df76a57ba4d7a18cadc8058fea7f73db93add1d42e6c6f73c0da92ac0970e\",\"totalLines\":17,\"nextOffset\":null}}","role":"tool"}

