data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_95bb5e1a5a78478ab7fae1c0","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"offset\":0,\"limit\":400}"}

