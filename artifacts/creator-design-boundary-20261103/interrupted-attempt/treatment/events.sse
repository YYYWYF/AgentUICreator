data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_NZn5bVKpKk4SU3KvN3nh3542","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

