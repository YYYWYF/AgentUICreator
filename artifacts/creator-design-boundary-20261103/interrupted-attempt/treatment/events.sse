data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_losbQ8LqFAEWdDSTTy3a5349","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/default-ui-composition.md\",\"limit\":120,\"offset\":0}"}

