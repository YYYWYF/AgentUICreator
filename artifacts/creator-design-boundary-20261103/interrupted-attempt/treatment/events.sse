data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_Ex8EbHIJLz98PttuCJTx4981","messageId":"26766346-73d4-4928-b9a9-411ddfd293aa","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/theme-switch/index.tsx\",\"content\":\"1: import { usePluginService } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { AGENT_UI_THEME_SERVICE, type AgentUIThemeService } from \\\"@za38.03/agent-ui-runtime/ui/services/agent-ui-theme\\\";\\n3: import { ThemeSwitchPlugin as Implementation } from \\\"@za38.03/agent-ui-plugins/theme-switch\\\";\\n4: import type { ComponentProps } from \\\"react\\\";\\n5: import {usePluginInstance} from \\\"@za38.03/agent-ui-plugins\\\";\\n6: \\n7: export function ThemeSwitchPlugin(props: ComponentProps<typeof Implementation>) {\\n8:   const instance=usePluginInstance();\\n9:   const service = usePluginService<AgentUIThemeService>(AGENT_UI_THEME_SERVICE);\\n10:   return <Implementation service={service} contextId={instance.id} {...props} />;\\n11: }\\n12: \",\"hash\":\"4b3dc3405510cd856abb35d5c06173fe8fc9ec21da3103d0f5d094bf61fae222\",\"totalLines\":12,\"nextOffset\":null}}","role":"tool"}

