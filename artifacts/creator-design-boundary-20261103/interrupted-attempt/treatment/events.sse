\\": {\\n17:       \\\"type\\\": \\\"plugin_slot\\\",\\n18:       \\\"parentPluginId\\\": \\\"quick-help-card\\\",\\n19:       \\\"slot\\\": \\\"body\\\"\\n20:     }\\n21:   }\\n22: }\\n23: \",\"hash\":\"3d6af5731c6eeb7e934124b73fa0c8cbe3e3daf2e2002a3a3af5a591ef4a5fbf\",\"totalLines\":23,\"nextOffset\":null},{\"path\":\"/src/agent-ui/plugins/quick-help-content/styles.css\",\"content\":\"1: .quick-help-content {\\n2:   box-sizing: border-box;\\n3:   min-width: 0;\\n4:   margin: 0;\\n5:   color: var(--muted);\\n6:   font-size: 13px;\\n7:   line-height: 1.5;\\n8:   overflow-wrap: anywhere;\\n9: }\\n10: \",\"hash\":\"8f21352dcfdb468fd730daca939baf6bae41168ecfb16e095005cb38883bc89b\",\"totalLines\":10,\"nextOffset\":null},{\"path\":\"/src/agent-ui/plugins/quick-help-content/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import \\\"./styles.css\\\";\\n3: \\n4: const messages: Record<string, string> = {\\n5:   \\\"zh-CN\\\": \\\"ä½ å¯ä»¥æé—®ã€ä¸Šä¼ é™„ä»¶æˆ–æŸ¥çœ‹åŽ†å²è®°å½•\\\",\\n6:   \\\"en-US\\\": \\\"You can ask questions, upload attachments, or view history\\\",\\n7: };\\n8: \\n9: export function QuickHelpContentPlugin() {\\n10:   const localeCode = useAgentUILocaleCode();\\n11:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n12: \\n13:   return (\\n14:     <p className=\\\"quick-help-content\\\" role=\\\"note\\\">\\n15:       {text}\\n16:     </p>\\n17:   );\\n18: }\\n19: \",\"hash\":\"25182348a1daf0e0f62f91d745666b6d04ec9517981f72b35961992a6597059a\",\"totalLines\":19,\"nextOffset\":null}],\"unavailableFiles\":[],\"plugin\":{\"pluginId\":\"quick-help-content\",\"instances\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"body\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p25\"}],\"manifest\":{\"id\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"version\":\"0.0.1\",\"capabilities\":[\"quick-help-content\"],\"authoring\":{\"intents\":[\"show quick help body text\",\"æ˜¾ç¤ºå¸®åŠ©æ­£æ–‡\",\"åœ¨å¸®åŠ©å¡ç‰‡æ­£æ–‡æ˜¾ç¤ºæç¤º\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpContentPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpContentPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":406},\"implementationOwnership\":\"project\",\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"compositionParents\":[{\"instanceId\":\"p24\",\"slot\":\"body\",\"pluginId\":\"quick-help-card\",\"interpretation\":\"Current mounted parent boundary, not a selected mutation target or authority. A child action API does not describe append/replacement behavior in its parent. Use the parent's composition contract only if that boundary answers the requested change; preserve existing actions and permission checks.\"}]},\"references\":{\"publicApi\":{\"status\":\"project_source\",\"interpretation\":\"This Plugin is implemented by project source. Read its definition, component and local types; the absence of an official catalog component is not missing API evidence or a takeover requirement.\"},\"documentation\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"entries\":[{\"documentId\":\"internal:architecture/mention-backend-context\",\"title\":\"Mention Backend Context Reference\",\"source\":\"internal\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/mention-backend-context\"}},\"matchingSections\":[{\"sectionId\":\"s25\",\"title\":\"Internal backend reference\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/mention-backend-context\",\"sectionId\":\"s25\"}}},{\"sectionId\":\"s1\",\"title\":\"Mention Backend Context Reference\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/mention-backend-context\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"ç»Ÿä¸€ Plugins åŒ…ã€å†…ç½®æºç ç›®å½•ä¸ŽæŒ‰éœ€æºç æ‰˜ç®¡\",\"source\":\"internal\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"ç»Ÿä¸€ Plugins åŒ…ã€å†…ç½®æºç ç›®å½•ä¸ŽæŒ‰éœ€æºç æ‰˜ç®¡\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s145\",\"title\":\"10. æ¨¡æ¿ä¸Žä¸šåŠ¡ç¤ºä¾‹\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s145\"}}}]},{\"documentId\":\"internal:i18n/README\",\"title\":\"Product localization ownership\",\"source\":\"internal\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:i18n/README\"}},\"matchingSections\":[{\"sectionId\":\"s10\",\"title\":\"Message owners\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:i18n/README\",\"sectionId\":\"s10\"}}},{\"sectionId\":\"s1\",\"title\":\"Product localization ownership\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:i18n/README\",\"sectionId\":\"s1\"}}}]}],\"interpretation\":\"Versioned documentation navigation, not source reads, installed target API facts or permission. Read relevant sections on demand; ordinary coding and inspection remain available.\"}},\"coverage\":{\"sourcesComplete\":true,\"sourceReadCount\":4,\"fileNavigation\":[{\"path\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"role\":\"entry\",\"status\":\"read\"},{\"role\":\"module\",\"from\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"specifier\":\"@za38.03/agent-ui-plugins\",\"status\":\"external\"},{\"path\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"role\":\"manifest\",\"status\":\"read\"},{\"path\":\"src/agent-ui/plugins/quick-help-content/styles.css\",\"role\":\"style\",\"status\":\"read\"},{\"path\":\"src/agent-ui/plugins/quick-help-content/index.tsx\",\"from\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"specifier\":\"./index\",\"role\":\"local_dependency\",\"status\":\"read\"},{\"role\":\"module\",\"from\":\"src/agent-ui/plugins/quick-help-content/index.tsx\",\"specifier\":\"@za38.03/agent-ui-plugins\",\"status\":\"external\"}],\"interpretation\":\"Source pages are bounded. Follow nextRead for unread/truncated files. Only literal relative imports were followed; package imports and aliases remain navigation, not an assertion of a complete dependency graph.\"},\"interpretation\":\"Returned source files are fresh read evidence in this run. Definition/manifest, services, instances and parents describe the actual Plugin, including custom project Plugins. References preserve available installed API and shared types; unknown/omitted detail is not evidence of an unsupported feature. Read relevant documentation sections on demand. This read grants no write/development/takeover authority. Application edits affect all instances using that application; use composition inspection for layout/instance changes.\"}}","role":"tool"}

