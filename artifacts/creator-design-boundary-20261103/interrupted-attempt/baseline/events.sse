data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_0b8104f985b34d709a5f68fa","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

