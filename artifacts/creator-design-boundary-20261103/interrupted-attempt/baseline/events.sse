data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_0ee3b179fb5e4a3194dda59b","messageId":"1f1529e7-34ff-4c4a-81e4-9b606928522f","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/theme-provider/definition.ts\",\"content\":\"1: import implementation from \\\"@za38.03/agent-ui-plugins/theme-provider\\\";\\n2: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n3: import { parseUIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n4: import { ThemeProviderPlugin } from \\\"./index\\\";\\n5: import manifestJson from \\\"./manifest.json\\\";\\n6: import { AGENT_UI_THEME_SERVICE } from \\\"@za38.03/agent-ui-runtime/ui/services/agent-ui-theme\\\";\\n7: import { createAgentUIThemeService } from \\\"@za38.03/agent-ui-plugins/theme-provider\\\";\\n8: \\n9: export const themeProviderPlugin: UIPluginDefinition = {\\n10:   manifest: implementation.manifest,\\n11:   provides: [AGENT_UI_THEME_SERVICE],\\n12:   setup: implementation.bindSetup(({ services }: Parameters<NonNullable<UIPluginDefinition[\\\"setup\\\"]>>[0]) => {\\n13:     const theme = createAgentUIThemeService();\\n14: \\n15:     services.provide(AGENT_UI_THEME_SERVICE, theme);\\n16:   }),\\n17:   Component: ThemeProviderPlugin,\\n18: };\\n19: \\n20: export default themeProviderPlugin;\\n21: \",\"hash\":\"335c2acfc74c74780dc2e43fa4b3585e92db803bd81ffe17203891f5f9e493a7\",\"totalLines\":21,\"nextOffset\":null}}","role":"tool"}

