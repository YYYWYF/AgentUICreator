data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_b90c97e537564ef685b7f56a","messageId":"8b5dabf5-6f98-4cd6-8206-b89d772d4801","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"9130fc9dbe139ddf8b8a07f221ffe9201199bdd9bb4fcb76047b661fb466adf1\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"title\":\"Scope\",\"source\":\"internal\",\"topic\":\"æ’ä»¶å¼€å‘ä¸Žç»„åˆ\",\"path\":\"references/docs/architecture/plugin-authoring-contract.md\",\"summary\":\"è‡ªå®šä¹‰æ’ä»¶ authoringã€é»˜è®¤æ”¾ç½®ã€å®¹å™¨å­æ’æ§½ã€rendererã€æ ·å¼éš”ç¦»å’Œæ ¡éªŒåˆåŒã€‚\",\"sha256\":\"e09945ea7269cd43caabbf18eb2a96fce0f127db8abd03a001cde12119c91e22\",\"sectionId\":\"s20\",\"offset\":0,\"totalCharacters\":543,\"content\":\"## Scope\\n\\nThe existing `UIPluginManifest.authoring` fields are the contract. This phase\\ndoes not add a `creatorReady` flag, a readiness score, or another manifest\\nschema. The Host derives readiness from the manifest, capabilities, and child\\nSlot declarations. It never reads React source to infer placement.\\n\\nThe contract is optional. A Plugin without `authoring` is still a valid Runtime\\nPlugin and may be configured manually in `app-ui/app-ui.json`; it simply makes\\nno promise that Creator can discover or automatically add and restore it.\\n\\n\",\"nextOffset\":null}}","role":"tool"}

