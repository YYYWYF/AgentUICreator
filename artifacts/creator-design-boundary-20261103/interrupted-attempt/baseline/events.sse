data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_0894e59b67354974b28e0081","messageId":"a1c29242-c206-4dbe-8e0a-f51aab13fe9d","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-content/definition.ts\",\"content\":\"1: import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import manifestJson from \\\"./manifest.json\\\";\\n3: import { QuickHelpContentPlugin } from \\\"./index\\\";\\n4: \\n5: const definition: UIPluginDefinition = {\\n6:   manifest: manifestJson as UIPluginManifest,\\n7:   provides: [],\\n8:   inject: [],\\n9:   optionalInject: [\\\"agent-ui.locale\\\"],\\n10:   Component: QuickHelpContentPlugin,\\n11: };\\n12: \\n13: export default definition;\\n14: \",\"hash\":\"a3d7c0161a565789604aaa2e74c358ffaee3c0d8e74ce24ff3bf025967466169\",\"totalLines\":14,\"nextOffset\":null}}","role":"tool"}

