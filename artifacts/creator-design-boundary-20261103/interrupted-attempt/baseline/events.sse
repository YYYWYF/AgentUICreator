data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_c5edc080428c4838844a8011","messageId":"ab162bb2-f99a-4ed1-97ca-3a57cacf93de","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/theme-switch/definition.ts\",\"content\":\"1: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import implementation from \\\"@za38.03/agent-ui-plugins/theme-switch\\\";\\n3: import { ThemeSwitchPlugin } from \\\"./index\\\";\\n4: const definition: UIPluginDefinition = { manifest: implementation.manifest, provides: [], inject: [\\\"agent-ui.theme\\\"], optionalInject: [\\\"agent-ui.locale\\\"], Component: ThemeSwitchPlugin };\\n5: export default definition;\\n6: \",\"hash\":\"db9f02fa88bbc8736683e7ae0dd28a8bb27a90e4114679c92bac89dfd3d08f58\",\"totalLines\":6,\"nextOffset\":null}}","role":"tool"}

