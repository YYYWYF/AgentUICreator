data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_53398fde804c45a1b8f8c2af","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

