data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_e269a595a5f24df896487e38","messageId":"d5b96895-8756-4684-8b3d-9386abb36834","content":"{\"ok\":true,\"result\":[\"src/agent-ui/plugins/add-attachment-action/definition.ts\",\"src/agent-ui/plugins/agent-identity/definition.ts\",\"src/agent-ui/plugins/composer/definition.ts\",\"src/agent-ui/plugins/context-retrieval-message/definition.ts\",\"src/agent-ui/plugins/conversation-data-source/definition.ts\",\"src/agent-ui/plugins/conversation-new/definition.ts\",\"src/agent-ui/plugins/conversation-quote/definition.ts\",\"src/agent-ui/plugins/conversation-service/definition.ts\",\"src/agent-ui/plugins/conversation-suggestions/definition.ts\",\"src/agent-ui/plugins/conversation-surface/definition.ts\",\"src/agent-ui/plugins/conversation-thread-list/definition.ts\",\"src/agent-ui/plugins/copy-action/definition.ts\",\"src/agent-ui/plugins/export-markdown-action/definition.ts\",\"src/agent-ui/plugins/locale-provider/definition.ts\",\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"src/agent-ui/plugins/reasoning/definition.ts\",\"src/agent-ui/plugins/registry.generated.ts\",\"src/agent-ui/plugins/reload-action/definition.ts\",\"src/agent-ui/plugins/response-footer/definition.ts\",\"src/agent-ui/plugins/submit-action/definition.ts\",\"src/agent-ui/plugins/test-notice/definition.ts\",\"src/agent-ui/plugins/theme-provider/definition.ts\",\"src/agent-ui/plugins/theme-switch/definition.ts\",\"src/agent-ui/plugins/tool-group/definition.ts\",\"src/agent-ui/plugins/tool-result/definition.ts\",\"src/agent-ui/plugins/transient-assistant-messages/definition.ts\"]}","role":"tool"}

