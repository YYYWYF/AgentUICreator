ation\":\"above\",\"anchorPluginId\":\"conversation-surface\"}},\"slots\":{\"children\":{\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true},\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}}}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpCardPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpCardPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":400},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"kind\":\"file\",\"bytes\":400},{\"path\":\"src/agent-ui/plugins/quick-help-card/index.tsx\",\"kind\":\"file\",\"bytes\":1887},{\"path\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"kind\":\"file\",\"bytes\":1178},{\"path\":\"src/agent-ui/plugins/quick-help-card/styles.css\",\"kind\":\"file\",\"bytes\":1352}],\"filesTruncated\":false}}","role":"tool"}

