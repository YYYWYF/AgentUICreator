     {expanded ? \\\"â–¾\\\" : \\\"â–¸\\\"}\\n37:           </span>\\n38:           <span className=\\\"quick-help-card__toggle-label\\\">\\n39:             {expanded ? text.collapse : text.expand}\\n40:           </span>\\n41:         </button>\\n42:         {headerActions ? (\\n43:           <div className=\\\"quick-help-card__header-actions\\\">{headerActions}</div>\\n44:         ) : null}\\n45:       </div>\\n46:       <div className=\\\"quick-help-card__body\\\" id={bodyId} hidden={!expanded}>\\n47:         {body}\\n48:       </div>\\n49:     </section>\\n50:   );\\n51: }\\n52: \",\"hash\":\"a6683db910567a47c85e7fb786d29ad4492e84d2b892bd2466738f2a75c8d0ca\",\"totalLines\":52,\"nextOffset\":null,\"recovery\":{\"action\":\"reuse_observed_file\",\"path\":\"src/agent-ui/plugins/quick-help-card/index.tsx\",\"repeatedUnchangedReads\":2,\"instruction\":\"This unchanged range was read in this run; its evidence remains recorded and edits check current hashes. Reuse it. Query only a concrete missing public contract. New project-owned behavior may be designed within authorization and validated after implementation; its absence in current source is expected. Protected paths and takeover permissions have not changed.\"}}}","role":"tool"}

