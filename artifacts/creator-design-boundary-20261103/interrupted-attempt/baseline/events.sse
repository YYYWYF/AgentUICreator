data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_f38542942c394a99a1e71a6c","messageId":"4c746284-5a0d-4eb2-8a90-fee7bb8a2d4f","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"9130fc9dbe139ddf8b8a07f221ffe9201199bdd9bb4fcb76047b661fb466adf1\",\"query\":\"plugin service cross-plugin shared state\",\"total\":113,\"offset\":0,\"entries\":[{\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"title\":\"Agent UI Plugin Creator æž¶æž„ä¸Žæ‰§è¡Œè¾¹ç•Œ\",\"source\":\"internal\",\"topic\":\"èŒè´£ä¸Žæ‰€æœ‰æƒ\",\"path\":\"references/docs/agent-ui-plugin-creator-launch-plan.md\",\"summary\":\"å½“å‰æž¶æž„ï¼šCreatorã€AppUIModelã€Pluginã€Runtimeã€AG-UIã€Service å’Œäº¤ä»˜è¾¹ç•Œã€‚\",\"sha256\":\"2a7020bd5c6879c9c1e4d472051e485251bacf4fb88172a7fdcacd9df56d492e\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\"}},\"matchingSections\":[{\"sectionId\":\"s38\",\"title\":\"Plugin Services\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"s38\"}}},{\"sectionId\":\"s1\",\"title\":\"Agent UI Plugin Creator æž¶æž„ä¸Žæ‰§è¡Œè¾¹ç•Œ\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s53\",\"title\":\"ä¼šè¯ä¸Ž Agent äº¤äº’\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"