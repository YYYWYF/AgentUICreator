data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_679a82cc47c84a24a54ccfd0","delta":"{\"file_path\":\"/src/agent-ui/plugins/quick-help-card/index.tsx\",\"limit\":120,\"offset\":0}"}

