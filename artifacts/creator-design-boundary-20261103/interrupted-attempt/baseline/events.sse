data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_5882e68fbfd347bbbb7e1b81","messageId":"1faa823d-eff8-44c8-a17a-fa74ac78cd27","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"c0190ce0113c44c938a625422461d3efdd634b35615c74e3efac8127bbf73c37\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"directory\":\"quick-help-card\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"æ˜¾ç¤ºä½¿ç”¨å¸®åŠ©å¡ç‰‡\",\"åœ¨èŠå¤©åŒºåŸŸé¡¶éƒ¨æ˜¾ç¤ºå¸®åŠ©å¡ç‰‡\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"44px\"}},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true}},\"dataMessageUINames\":[],\"selected\":true},\"selected\":true,\"instances\":[{\"id\":\"p24\",\"pluginId\":\"quick-help-card\",\"enabled\":true,\"slots\":{\"body\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true}]},\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l10\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p24\"}],\"manifest\":{\"id\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"version\":\"0.0.1\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"æ˜¾ç¤ºä½¿ç”¨å¸®åŠ©å¡ç‰‡\",\"åœ¨èŠå¤©åŒºåŸŸé¡¶éƒ¨æ˜¾ç¤ºå¸®åŠ©å¡ç‰‡\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"recommendedSize\":{\"height\":\"44px\"},\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"}},\"slots\":{\"children\":{\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true},\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}}}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpCardPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpCardPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":400},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"kind\":\"file\",\"bytes\":400},{\"path\":\"src/agent-ui/plugins/quick-help-card/index.tsx\",\"kind\":\"file\",\"bytes\":1887},{\"path\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"kind\":\"file\",\"bytes\":1178},{\"path\":\"src/agent-ui/plugins/quick-help-card/styles.css\",\"kind\":\"file\",\"bytes\":1352}],\"filesTruncated\":false}}","role":"tool"}

