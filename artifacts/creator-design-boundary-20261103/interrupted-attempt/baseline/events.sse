data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_0215f7e1985a4e969c14752e","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

