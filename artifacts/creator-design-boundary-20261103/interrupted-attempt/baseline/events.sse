data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_16209d3afb2d40599edea323","messageId":"11cef92e-2bdd-4fda-a3e7-260202e96de9","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-card/definition.ts\",\"content\":\"1: import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import manifestJson from \\\"./manifest.json\\\";\\n3: import { QuickHelpCardPlugin } from \\\"./index\\\";\\n4: \\n5: const definition: UIPluginDefinition = {\\n6:   manifest: manifestJson as UIPluginManifest,\\n7:   provides: [],\\n8:   inject: [],\\n9:   optionalInject: [\\\"agent-ui.locale\\\"],\\n10:   Component: QuickHelpCardPlugin,\\n11: };\\n12: \\n13: export default definition;\\n14: \",\"hash\":\"929e9d6f8d685cedf00eb4fcc030db3a61a7b042100e0a71a1aa6daf4fad23b7\",\"totalLines\":14,\"nextOffset\":null}}","role":"tool"}

