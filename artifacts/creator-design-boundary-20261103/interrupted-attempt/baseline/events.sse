ation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"å…¬å¼€åˆåŒ\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s33\",\"title\":\"é¡¹ç›®å®šåˆ¶\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"sectionId\":\"s33\"}}}]},{\"documentId\":\"internal:creator-plugin-delivery\",\"title\":\"Creator Plugin Delivery\",\"source\":\"internal\",\"topic\":\"æ’ä»¶å¼€å‘ä¸Žç»„åˆ\",\"path\":\"references/docs/creator-plugin-delivery.md\",\"summary\":\"æ’ä»¶å¼€å‘äº¤ä»˜ã€é™æ€éªŒè¯ä¸Žæµè§ˆå™¨éªŒæ”¶çš„è¯æ®è¦æ±‚ã€‚\",\"sha256\":\"33240b1aee2345f08644585f7047075fe8c70ed1f92be65ab9919e5cc7c4597b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-delivery\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Creator Plugin Delivery\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-delivery\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"èƒ½åŠ›å‘çŽ°\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-delivery\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s31\",\"title\":\"Runtime ä¸Žäº¤äº’éªŒè¯\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-delivery\",\"sectionId\":\"s31\"}}}]},{\"documentId\":\"internal:creator-plugin-development-decision-contract\",\"title\":\"Creator UI Plugin å¤ç”¨ä¸Žå¼€å‘å†³ç­–å¥‘çº¦\",\"source\":\"internal\",\"topic\":\"æ’ä»¶å¼€å‘ä¸Žç»„åˆ\",\"path\":\"references/docs/creator-plugin-development-decision-contract.md\",\"summary\":\"å¤ç”¨ä¸Žæ–°å¼€å‘å†³ç­–ã€çœŸå®žç”¨æˆ·æŽˆæƒã€æ–¹æ¡ˆèŒƒå›´ã€UI åº“é€‰æ‹©å’Œä¾èµ–å®‰è£…ã€‚\",\"sha256\":\"01601234ad0b00b3c9a2c76355b4fa101edf09c0d9f24fa30ddf0be5f2d93e8e\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-development-decision-contract\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Creator UI Plugin å¤ç”¨ä¸Žå¼€å‘å†³ç­–å¥‘çº¦\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-development-decision-contract\",\"sectionId\":\"s1\"}}}]}],\"nextOffset\":8}}","role":"tool"}

