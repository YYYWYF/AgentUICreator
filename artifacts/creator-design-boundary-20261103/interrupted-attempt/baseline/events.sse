data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_3d3abd2b4fea4ef8bb87692c","messageId":"8cf128f3-486f-4b13-bd9d-85754e5bd4cf","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"c0190ce0113c44c938a625422461d3efdd634b35615c74e3efac8127bbf73c37\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"directory\":\"quick-help-card\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"æ˜¾ç¤ºä½¿ç”¨å¸®åŠ©å¡ç‰‡\",\"åœ¨èŠå¤©åŒºåŸŸé¡¶éƒ¨æ˜¾ç¤ºå¸®åŠ©å¡ç‰‡\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"44px\"}},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true}},\"dataMessageUINames\":[],\"selected\":true},\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":4,\"resolved\":4,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/contracts\",\"symbols\":[{\"name\":\"UIPluginComponentProps\",\"status\":\"available\",\"type\":\"UIPluginComponentProps\",\"truncated\":false,\"memberNames