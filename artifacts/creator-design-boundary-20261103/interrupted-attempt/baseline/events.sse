data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_a6e70c8a21044c67b6f50096","messageId":"3cb80ccb-a903-4630-9a5d-9ed6be26018a","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/copy-action/definition.ts\",\"content\":\"1: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import implementation from \\\"@za38.03/agent-ui-plugins/copy-action\\\";\\n3: import { ConversationCopyActionPlugin } from \\\"./index\\\";\\n4: const definition: UIPluginDefinition = { manifest: implementation.manifest, provides: [], inject: [], optionalInject: [], Component: ConversationCopyActionPlugin };\\n5: export default definition;\\n6: \",\"hash\":\"d71d9de7e124989c711496646f8b289e7200f747bba2273fb02117a5723d2532\",\"totalLines\":6,\"nextOffset\":null}}","role":"tool"}

