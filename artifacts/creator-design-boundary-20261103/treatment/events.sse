data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_OVTiet508FMwfkjgDMkf7123","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":200,\"offset\":0}"}

