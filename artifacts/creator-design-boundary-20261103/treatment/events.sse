data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_CWIyzHjlkmSXQjPqUXgc2454","messageId":"40ceb523-9783-40b6-b5ac-2356077a4406","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/conversation-service/definition.ts\",\"content\":\"1: import implementation from \\\"@za38.03/agent-ui-plugins/conversation-service\\\";\\n2: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n3: import { parseUIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n4: import {\\n5:   AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE,\\n6:   AGENT_UI_CONVERSATION_SERVICE,\\n7:   createConversationService,\\n8: } from \\\"../../services/conversations\\\";\\n9: import { ConversationServicePlugin } from \\\"./index\\\";\\n10: import manifestJson from \\\"./manifest.json\\\";\\n11: \\n12: export const conversationServicePlugin: UIPluginDefinition = {\\n13:   manifest: implementation.manifest,\\n14:   inject: [AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE],\\n15:   provides: [AGENT_UI_CONVERSATION_SERVICE],\\n16:   setup: implementation.bindSetup(({ services }: Parameters<NonNullable<UIPluginDefinition[\\\"setup\\\"]>>[0]) => {\\n17:     const dataSource = services.get(\\n18:       AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE,\\n19:     );\\n20:     if (dataSource === undefined) {\\n21:       throw new Error(\\\"Conversation DataSource is unavailable.\\\");\\n22:     }\\n23:     const service = createConversationService({\\n24:       dataSource,\\n25:     });\\n26:     services.provide(AGENT_UI_CONVERSATION_SERVICE, service);\\n27:     void service.refresh();\\n28:     return () => {\\n29:       service.dispose();\\n30:     };\\n31:   }),\\n32:   Component: ConversationServicePlugin,\\n33: };\\n34: \\n35: export default conversationServicePlugin;\\n36: \",\"hash\":\"b8de83fc588ca9e8b4af6dd09657d1f79eb012da1980fa49be477ba2824e692e\",\"totalLines\":36,\"nextOffset\":null}}","role":"tool"}

