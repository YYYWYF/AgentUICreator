data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_N0iGwrK9TpKj6e1D4D1n4352","messageId":"806d8878-779d-4682-be4c-1b5c247e9db9","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/conversation-data-source/definition.ts\",\"content\":\"1: import implementation from \\\"@za38.03/agent-ui-plugins/conversation-data-source\\\";\\n2: import { getPreviewAgentEnvironment } from \\\"@za38.03/agent-ui-runtime/ui/application/preview-environment\\\";\\n3: import { createAgentBackendTransport } from \\\"@za38.03/agent-ui-runtime/ui/application/agent-backend-transport\\\";\\n4: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n5: import { parseUIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n6: import {\\n7:   AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE,\\n8:   createEmptyConversationDataSource,\\n9:   createHttpConversationDataSource,\\n10:   resolveConversationDataEndpoint,\\n11: } from \\\"../../services/conversations\\\";\\n12: import { ConversationDataSourcePlugin } from \\\"./index\\\";\\n13: import manifestJson from \\\"./manifest.json\\\";\\n14: \\n15: export const conversationDataSourcePlugin: UIPluginDefinition = {\\n16:   manifest: implementation.manifest,\\n17:   provides: [AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE],\\n18:   setup: implementation.bindSetup(({ services }: Parameters<NonNullable<UIPluginDefinition[\\\"setup\\\"]>>[0]) => {\\n19:     const endpoint = resolveConversationDataEndpoint({\\n20:       configuredEndpoint: getPreviewAgentEnvironment(import.meta.env.DEV)?.conversationDataEndpointOverride,\\n21:     });\\n22:     const source = endpoint === undefined\\n23:       ? createEmptyConversationDataSource()\\n24:       : createHttpConversationDataSource({ endpoint, fetch: createAgentBackendTransport({ development: import.meta.env.DEV }).fetch });\\n25:     services.provide(AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE, source);\\n26:   }),\\n27:   Component: ConversationDataSourcePlugin,\\n28: };\\n29: \\n30: export default conversationDataSourcePlugin;\\n31: \",\"hash\":\"941bd205576637686596d199ee700e5a55ebb4c2b8a88c1f3b92219bff8f7bd9\",\"totalLines\":31,\"nextOffset\":null}}","role":"tool"}

