data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_AtA0UtNEWGImRo2wGWVU9315","messageId":"6a46b51f-0e69-465f-a31a-071f1eac4d65","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"9130fc9dbe139ddf8b8a07f221ffe9201199bdd9bb4fcb76047b661fb466adf1\",\"documentId\":\"public:development/plugin-api\",\"title\":\"è‡ªå®šä¹‰æœåŠ¡\",\"source\":\"public\",\"topic\":\"å¼€å‘æ–‡æ¡£\",\"path\":\"development/plugin-api.md\",\"summary\":\"é¡¹ç›®æ’ä»¶ç”±èƒ½åŠ›å£°æ˜Žã€ç»„ä»¶å’Œå¯é€‰çš„æœåŠ¡ç”Ÿå‘½å‘¨æœŸç»„æˆã€‚åˆ›å»ºæ–‡ä»¶ä¸Žæ³¨å†Œæ­¥éª¤è§åˆ›å»ºè‡ªå®šä¹‰æ’ä»¶ã€‚ä¿®æ”¹å·²æœ‰å®˜æ–¹æ’ä»¶å¤–è§‚æ—¶ï¼Œå…ˆä½¿ç”¨ç»„ä»¶å…¬å¼€å±žæ€§ã€‚\",\"sha256\":\"cd30e68bc788dd22fdccc937313217ed5e3c3816b86e84f9138f758709423720\",\"sectionId\":\"s240\",\"offset\":0,\"totalCharacters\":3118,\"content\":\"### è‡ªå®šä¹‰æœåŠ¡\\n\\næœåŠ¡ç”¨äºŽå…±äº«é¡¹ç›®ä¸šåŠ¡èƒ½åŠ›ã€‚æ’ä»¶å®šä¹‰ä¸­çš„ä¾èµ–å£°æ˜Žä¸Žæ¶ˆè´¹æŽ¥å£å¦‚ä¸‹ï¼š\\n\\n| æŽ¥å£æˆ–å­—æ®µ                                         | è¡Œä¸º                                                      |\\n| --------------------------------------------- | ------------------------------------------------------- |\\n| `provides: ['tickets.selection']`             | å£°æ˜Žæœ¬å®žä¾‹ä¼šæä¾›çš„æœåŠ¡ï¼›åœ¨ `setup` ä¸­è°ƒç”¨ `services.provide()` æ³¨å†Œ       |\\n| `inject: ['tickets.selection']`               | å¿…éœ€ä¾èµ–ï¼›æœåŠ¡ç¼ºå¤±æ—¶å®žä¾‹æ— æ³•å¯ç”¨                                        |\\n| `optionalInject: ['tickets.selection']`       | å¯é€‰ä¾èµ–ï¼›ç¼ºå¤±æ—¶ç»„ä»¶è‡ªè¡Œé™çº§                                          |\\n| `services.get<T>(name)`                       | `setup` ä¸­è¯»å–å·²å£°æ˜Žçš„ `inject` / `optionalInject` æœåŠ¡          |\\n| `usePluginService<T>(name)`                   | ç»„ä»¶ä¸­è¯»å–å·²å£°æ˜Žçš„æœåŠ¡ï¼›ä¹Ÿå¯è¯»å–æœ¬å®žä¾‹ `provides` çš„æœåŠ¡                      |\\n| `usePluginServiceSnapshot(service, fallback)` | è®¢é˜…å®žçŽ° `getSnapshot()` / `subscribe()` çš„æœåŠ¡ï¼›ç¼ºå¤±æ—¶è¿”å›ž fallback |\\n\\nä¾‹å¦‚ï¼Œåœ¨ç”Ÿæˆç›®å½•çš„ `services/ticket-selection.ts` ä¸­å®žçŽ°ä¸€ä¸ªé¡µé¢å†…çš„å·¥å•é€‰æ‹©æœåŠ¡ï¼š\\n\\n```ts\\nimport type { UIPluginObservableService } from '@za38.03/agent-ui-plugins/contracts';\\n\\nexport interface TicketSelectionSnapshot {\\n  selectedId: string | null;\\n}\\n\\nexport interface TicketSelectionService\\n  extends UIPluginObservableService<TicketSelectionSnapshot> {\\n  select(id: string): void;\\n}\\n\\nexport function createTicketSelectionService(): TicketSelectionService {\\n  let snapshot: TicketSelectionSnapshot = { selectedId: null };\\n  const listeners = new Set<() => void>();\\n  return {\\n    getSnapshot: () => snapshot,\\n    subscribe(listener) {\\n      listeners.add(listener);\\n      return () => { listeners.delete(listener); };\\n    },\\n    select(id) {\\n      if (snapshot.selectedId === id) return;\\n      snapshot = { selectedId: id };\\n      for (const listener of listeners) listener();\\n    },\\n  };\\n}\\n```\\n\\nåœ¨æ¶ˆè´¹æ’ä»¶çš„å®šä¹‰ä¸­åŠ å…¥ `optionalInject: ['tickets.selection']`ï¼Œç»„ä»¶å³å¯è®¢é˜…ï¼š\\n\\n```tsx\\nimport { usePluginService, usePluginServiceSnapshot } from '@za38.03/agent-ui-plugins';\\nimport type { TicketSelectionService, TicketSelectionSnapshot } from '../../services/ticket-selection';\\n\\nconst EMPTY_SELECTION: TicketSelectionSnapshot = { selectedId: null };\\n\\nexport function SelectedTicket() {\\n  const service = usePluginService<TicketSelectionService>('tickets.selection');\\n  const snapshot = usePluginServiceSnapshot(service, EMPTY_SELECTION);\\n  return snapshot.selectedId ? <output>{snapshot.selectedId}</output> : null;\\n}\\n```\\n\\næœåŠ¡å®žçŽ°çš„ `getSnapshot()` åœ¨æ•°æ®æœªå˜åŒ–æ—¶åº”è¿”å›žåŒä¸€ä¸ªå¯¹è±¡ï¼›æ•°æ®å˜åŒ–åŽå†æ›¿æ¢å¿«ç…§å¹¶é€šçŸ¥è®¢é˜…è€…ã€‚`subscribe(listener)` è¿”å›žå–æ¶ˆå‡½æ•°ã€‚fallback ä¹Ÿä¿æŒç¨³å®šï¼Œé¿å…æ¯æ¬¡æ¸²æŸ“æ–°å»ºå¯¹è±¡ã€‚\\n\\næä¾›æ–¹åœ¨è‡ªå·±çš„å®šä¹‰ä¸­åŠ å…¥ `provides: ['tickets.selection']` å’Œ `setup: setupTicketSelection`ï¼Œé€šè¿‡ `setup` æ³¨å†Œä¸Šé¢çš„æœåŠ¡ï¼š\\n\\n```ts\\nimport type { UIPluginSetupContext } from '@za38.03/agent-ui-plugins/contracts';\\nimport { createTicketSelectionService } from '../../services/ticket-selection';\\n\\nexport function setupTicketSelection({ services }: UIPluginSetupContext) {\\n  const selection = createTicketSelectionService();\\n  return services.provide('tickets.selection', selection);\\n}\\n```\\n\\næä¾›æ–¹å’Œæ¶ˆè´¹æ–¹éƒ½éœ€è¦åœ¨ AppUIModel ä¸­å¯ç”¨ã€‚ç¤ºä¾‹åªä¿å­˜åœ¨é¡µé¢å†…ï¼Œåˆ·æ–°åŽä¸ä¼šæ¢å¤ï¼›éœ€è¦æŒä¹…åŒ–æ—¶æŽ¥å…¥é¡¹ç›®è‡ªå·±çš„æ•°æ®æºã€‚è‹¥æœåŠ¡è¿˜æŒæœ‰è¿žæŽ¥æˆ–å®šæ—¶å™¨ï¼Œæ¸…ç†æ—¶åŒæ—¶é‡Šæ”¾è¿™äº›èµ„æºã€‚ç›¸åŒæœåŠ¡ååªèƒ½æœ‰ä¸€ä¸ªæ´»åŠ¨æä¾›å®žä¾‹ï¼›ä¸è¦ç»™å¤šä¸ªå®žä¾‹é‡å¤æ³¨å†ŒåŒåæœåŠ¡ã€‚ä¹Ÿå¯é€šè¿‡æ‰©å±• `UIPluginServiceMap` ä¸ºæœåŠ¡åå…³è”ç±»åž‹ã€‚\\n\\n\",\"nextOffset\":null}}","role":"tool"}

