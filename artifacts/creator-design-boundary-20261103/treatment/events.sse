data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_0lmv16AVKWbQlbS2iB7i9712","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":200,\"offset\":0}"}

