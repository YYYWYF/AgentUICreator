\":[]},\"optionalServices\":{\"names\":[\"auth.session\",\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"auth-gate\",\"name\":\"Authentication Gate\",\"description\":\"Authentication Gate\",\"capabilities\":[\"authentication\",\"plugin-service-provider\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add login authentication\",\"ç»™ Agent åŠ ä¸Šç™»å½•åŠŸèƒ½\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"chart-message\",\"name\":\"Chart Message\",\"description\":\"Renders named chart data inside assistant messages.\",\"capabilities\":[],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render structured chart data in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"composer\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/composer\",\"component\":\"ConversationComposerPlugin\",\"facts\":{\"presentation\":\"The editable text field is a textarea by default. data-slot=aui_composer-input is its containing div; data-slot=aui_composer-shell is the outer surface containing input and actions. Container height is distinct from editable field height.\",\"composition\":\"The public component prop type is ConversationCanonicalComposerProps, exported from @za38.03/agent-ui-plugins. The /composer entry exports the Plugin component. inputProps forwards textarea props including rows, style, className and onChange; preserve existing handlers. Other root props configure the outer form. Root rows and maxLength configure the default textarea; a defined root maxLength wins over inputProps.maxLength. The input prop replaces the default input; inspect an existing replacement before changing it. For a live character count that follows typing, send and programmatic clears, query useConversationComposer from the public root module and observe its text; this hook uses the existing canonical Composer and does not create a Runtime. The default shell is a column: input and aui_composer-actions are separate children; the actions row contains leading/trailing actions, with submitAction in trailing-actions.\",\"interaction\":\"A direct placeholder prop overrides composer.placeholder, including Host locale overrides; a fixed string also persists when the locale changes. Generated Agent accepts locales with per-locale overrides, for example zh-CN and en-US entries containing composer.placeholder; preserve existing Host overrides when adding project defaults. The public useAgentUILocale('composer') reads this shared namespace, and useAgentUILocaleCode() reads the same current locale. Custom project business labels may use a small project-owned en-US/zh-CN message dictionary selected by that unified locale code; do not create another language state/Context or add fields to the closed npm AgentUILocaleMessages type. Keep the existing Composer and its native event handlers.\",\"styles\":\"inputProps.style.minHeight sizes the textarea, not the shell. Project CSS may target [data-slot=aui_composer-input] textarea. The package's styled outer shell uses :is(.agent-ui-root, .agent-ui-conversation)[data-theme] [data-slot=\\\"aui_composer-shell\\\"] with border-radius:18px; :hover and :focus-within add border/shadow rules. A bare [data-slot=\\\"aui_composer-shell\\\"] override has lower specificity and can lose even when imported later. Use that full scoped selector and corresponding focus state in later project CSS for radius/border overrides, then inspect computed borderRadius/borderColor in the actual Host. Button wrapping belongs to the actions row and leading/trailing action groups; flex-basis on a child of the column shell can instead change input height. Preserve textarea, attachments and submit behavior.\"}},\"name\":\"Conversation Composer\",\"description\":\"Renders the canonical Agent UI conversation composer with composable action Slots.\",\"capabilities\":[\"conversation-composer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p11\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"composer\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary conversation composer\",\"compose conversation input actions\"],\"visualRole\":\"conversation composer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"composer\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"beforeInput\":{\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]}},\"input\":{\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]}},\"leadingActions\":{\"description\":\"Inline actions displayed on the leading side of the composer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-leading-action\",\"conversation-composer-trailing-action\"]}},\"submitAction\":{\"description\":\"The primary send or stop action for the composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-submit-action\"]}},\"trailingActions\":{\"description\":\"Inline actions displayed before the compos