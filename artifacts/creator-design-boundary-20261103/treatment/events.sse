data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_02_eXpqOoGLdXnO945e1nbz7748","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":200,\"offset\":0}"}

