data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_02_sMIehTPBtGYVaXw6XV5f7781","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":200,\"offset\":0}"}

