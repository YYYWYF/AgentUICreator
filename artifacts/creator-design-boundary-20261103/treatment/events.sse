data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_U2CoA8nxVNPASkJrsPmq4616","messageId":"d25bd9b7-4cb0-4852-b2d8-fe5560fe4493","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/theme-provider/definition.ts\",\"content\":\"1: import implementation from \\\"@za38.03/agent-ui-plugins/theme-provider\\\";\\n2: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n3: import { parseUIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n4: import { ThemeProviderPlugin } from \\\"./index\\\";\\n5: import manifestJson from \\\"./manifest.json\\\";\\n6: import { AGENT_UI_THEME_SERVICE } from \\\"@za38.03/agent-ui-runtime/ui/services/agent-ui-theme\\\";\\n7: import { createAgentUIThemeService } from \\\"@za38.03/agent-ui-plugins/theme-provider\\\";\\n8: \\n9: export const themeProviderPlugin: UIPluginDefinition = {\\n10:   manifest: implementation.manifest,\\n11:   provides: [AGENT_UI_THEME_SERVICE],\\n12:   setup: implementation.bindSetup(({ services }: Parameters<NonNullable<UIPluginDefinition[\\\"setup\\\"]>>[0]) => {\\n13:     const theme = createAgentUIThemeService();\\n14: \\n15:     services.provide(AGENT_UI_THEME_SERVICE, theme);\\n16:   }),\\n17:   Component: ThemeProviderPlugin,\\n18: };\\n19: \\n20: export default themeProviderPlugin;\\n21: \",\"hash\":\"335c2acfc74c74780dc2e43fa4b3585e92db803bd81ffe17203891f5f9e493a7\",\"totalLines\":21,\"nextOffset\":null}}","role":"tool"}

