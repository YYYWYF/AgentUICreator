.quick-help-card__header {\\n11:   display: flex;\\n12:   align-items: center;\\n13:   gap: 8px;\\n14:   padding: 8px 12px;\\n15: }\\n16: \\n17: .quick-help-card__toggle {\\n18:   display: inline-flex;\\n19:   align-items: center;\\n20:   gap: 6px;\\n21:   flex: 1 1 auto;\\n22:   min-width: 0;\\n23:   margin: 0;\\n24:   padding: 4px 6px;\\n25:   border: none;\\n26:   border-radius: 6px;\\n27:   background: transparent;\\n28:   color: inherit;\\n29:   font: inherit;\\n30:   font-size: 13px;\\n31:   line-height: 1.5;\\n32:   text-align: left;\\n33:   cursor: pointer;\\n34: }\\n35: \\n36: .quick-help-card__toggle:hover {\\n37:   background: var(--muted);\\n38: }\\n39: \\n40: .quick-help-card__toggle:focus-visible {\\n41:   outline: 2px solid var(--ring, var(--border));\\n42:   outline-offset: 2px;\\n43: }\\n44: \\n45: .quick-help-card__title {\\n46:   font-weight: 600;\\n47:   overflow-wrap: anywhere;\\n48: }\\n49: \\n50: .quick-help-card__indicator {\\n51:   flex: 0 0 auto;\\n52:   font-size: 12px;\\n53:   opacity: 0.8;\\n54: }\\n55: \\n56: .quick-help-card__toggle-label {\\n57:   flex: 0 0 auto;\\n58:   font-size: 12px;\\n59:   opacity: 0.7;\\n60: }\\n61: \\n62: .quick-help-card__header-actions {\\n63:   display: flex;\\n64:   align-items: center;\\n65:   gap: 4px;\\n66:   flex: 0 0 auto;\\n67:   min-width: 0;\\n68: }\\n69: \\n70: .quick-help-card__body {\\n71:   box-sizing: border-box;\\n72:   min-width: 0;\\n73:   padding: 0 12px 8px;\\n74:   font-size: 13px;\\n75:   line-height: 1.5;\\n76: }\\n77: \\n78: .quick-help-card__body[hidden] {\\n79:   display: none;\\n80: }\\n81: \",\"hash\":\"09b62afa881fff99d184e369aef8375b29bee0baeb74f31d2e47c8a46079d1fc\",\"totalLines\":81,\"nextOffset\":null},{\"path\":\"/src/agent-ui/plugins/quick-help-card/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { useId, useState } from \\\"react\\\";\\n3: import type { ReactNode } from \\\"react\\\";\\n4: import \\\"./styles.css\\\";\\n5: \\n6: type QuickHelpCardProps = {\\n7:   renderSlot?: (name: string, fallback?: ReactNode) => ReactNode;\\n8: };\\n9: \\n10: const messages: Record<string, { title: string; expand: string; collapse: string }> = {\\n11:   \\\"zh-CN\\\": { title: \\\"ä½¿ç”¨å¸®åŠ©\\\", expand: \\\"å±•å¼€\\\", collapse: \\\"æŠ˜å \\\" },\\n12:   \\\"en-US\\\": { title: \\\"Usage Help\\\", expand: \\\"Expand\\\", collapse: \\\"Collapse\\\" },\\n13: };\\n14: \\n15: export function QuickHelpCardPlugin(props: QuickHelpCardProps) {\\n16:   const localeCode = useAgentUILocaleCode();\\n17:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n18:   const [expanded, setExpanded] = useState(true);\\n19:   const bodyId = useId();\\n20: \\n21:   const headerActions = props.renderSlot ? props.renderSlot(\\\"headerActions\\\", null) : null;\\n22:   const body = props.renderSlot ? props.renderSlot(\\\"body\\\", null) : null;\\n23: \\n24:   return (\\n25:     <section className=\\\"quick-help-card\\\" aria-label={text.title}>\\n26:       <div className=\\\"quick-help-card__header\\\">\\n27:         <button\\n28:           type=\\\"button\\\"\\n29:           className=\\\"quick-help-card__toggle\\\"\\n30:           aria-expanded={expanded}\\n31:           aria-controls={bodyId}\\n32:           onClick={() => setExpanded((value) => !value)}\\n33:         >\\n34:           <span className=\\\"quick-help-card__title\\\">{text.title}</span>\\n35:           <span className=\\\"quick-help-card__indicator\\\" aria-hidden=\\\"true\\\">\\n36:             {expanded ? \\\"â–¾\\\" : \\\"â–¸\\\"}\\n37:           </span>\\n38:           <span className=\\\"quick-help-card__toggle-label\\\">\\n39:             {expanded ? text.collapse : text.expand}\\n40:           </span>\\n41:         </button>\\n42:         {headerActions ? (\\n43:           <div className=\\\"quick-help-card__header-actions\\\">{headerActions}</div>\\n44:         ) : null}\\n45:       </div>\\n46:       <div className=\\\"quick-help-card__body\\\" id={bodyId} hidden={!expanded}>\\n47:         {body}\\n48:       </div>\\n49:     </section>\\n50:   );\\n51: }\\n52: \",\"hash\":\"a6683db910567a47c85e7fb786d29ad4492e84d2b892bd2466738f2a75c8d0ca\",\"totalLines\":52,\"nextOffset\":null,\"recovery\":{\"action\":\"reuse_observed_file\",\"path\":\"src/agent-ui/plugins/quick-help-card/index.tsx\",\"repeatedUnchangedReads\":2,\"instruction\":\"This unchanged range was read in this run; its evidence remains recorded and edits check current hashes. Reuse it. Query only a concrete missing public contract. New project-owned behavior may be designed within authorization and validated after implementation; its absence in current source is expected. Protected paths and takeover permissions have not changed.\"}}],\"unavailableFiles\":[],\"plugin\":{\"pluginId\":\"quick-help-card\",\"instances\":[{\"id\":\"p24\",\"pluginId\":\"quick-help-card\",\"enabled\":true,\"slots\":{\"body\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true}]},\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l10\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p24\"}],\"manifest\":{\"id\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"version\":\"0.0.1\",\"capabilities\":[\"quick-help-card\"],\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"æ˜¾ç¤ºä½¿ç”¨å¸®åŠ©å¡ç‰‡\",\"åœ¨èŠå¤©åŒºåŸŸé¡¶éƒ¨æ˜¾ç¤ºå¸®åŠ©å¡ç‰‡\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"recommendedSize\":{\"height\":\"44px\"},\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"}},\"slots\":{\"children\":{\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true},\"body\":{\"description\":\"Help content 