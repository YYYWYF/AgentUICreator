data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_ZKr6mU9Bs4D5iOCwG5ur0682","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":400,\"offset\":0}"}

