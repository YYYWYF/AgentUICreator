data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_7eWDe4GOteIoN1nvj4PH5108","messageId":"d0dcad91-6d30-432c-b087-1037370d9012","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-content/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import \\\"./styles.css\\\";\\n3: \\n4: const messages: Record<string, string> = {\\n5:   \\\"zh-CN\\\": \\\"ä½ å¯ä»¥æé—®ã€ä¸Šä¼ é™„ä»¶æˆ–æŸ¥çœ‹åŽ†å²è®°å½•\\\",\\n6:   \\\"en-US\\\": \\\"You can ask questions, upload attachments, or view history\\\",\\n7: };\\n8: \\n9: export function QuickHelpContentPlugin() {\\n10:   const localeCode = useAgentUILocaleCode();\\n11:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n12: \\n13:   return (\\n14:     <p className=\\\"quick-help-content\\\" role=\\\"note\\\">\\n15:       {text}\\n16:     </p>\\n17:   );\\n18: }\\n19: \",\"hash\":\"25182348a1daf0e0f62f91d745666b6d04ec9517981f72b35961992a6597059a\",\"totalLines\":19,\"nextOffset\":null}}","role":"tool"}

