data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_dl1jDfPmLkjPfUBWTlkD8961","messageId":"069014d9-8154-4dd5-9e63-76e3d07afcf4","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/theme-switch/definition.ts\",\"content\":\"1: import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import implementation from \\\"@za38.03/agent-ui-plugins/theme-switch\\\";\\n3: import { ThemeSwitchPlugin } from \\\"./index\\\";\\n4: const definition: UIPluginDefinition = { manifest: implementation.manifest, provides: [], inject: [\\\"agent-ui.theme\\\"], optionalInject: [\\\"agent-ui.locale\\\"], Component: ThemeSwitchPlugin };\\n5: export default definition;\\n6: \",\"hash\":\"db9f02fa88bbc8736683e7ae0dd28a8bb27a90e4114679c92bac89dfd3d08f58\",\"totalLines\":6,\"nextOffset\":null}}","role":"tool"}

