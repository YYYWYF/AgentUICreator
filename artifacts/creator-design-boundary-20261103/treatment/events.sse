data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_89oMDwXYeExewbKil1jB1355","messageId":"ef54a261-52d6-4ab5-8de5-b038bfd05752","content":"{\"ok\":true,\"result\":[{\"name\":\"add-attachment-action\",\"directory\":true},{\"name\":\"agent-identity\",\"directory\":true},{\"name\":\"composer\",\"directory\":true},{\"name\":\"context-retrieval-message\",\"directory\":true},{\"name\":\"conversation-data-source\",\"directory\":true},{\"name\":\"conversation-new\",\"directory\":true},{\"name\":\"conversation-quote\",\"directory\":true},{\"name\":\"conversation-service\",\"directory\":true},{\"name\":\"conversation-suggestions\",\"directory\":true},{\"name\":\"conversation-surface\",\"directory\":true},{\"name\":\"conversation-thread-list\",\"directory\":true},{\"name\":\"copy-action\",\"directory\":true},{\"name\":\"export-markdown-action\",\"directory\":true},{\"name\":\"index.ts\",\"directory\":false},{\"name\":\"locale-provider\",\"directory\":true},{\"name\":\"quick-help-card\",\"directory\":true},{\"name\":\"quick-help-content\",\"directory\":true},{\"name\":\"reasoning\",\"directory\":true},{\"name\":\"registry.generated.ts\",\"directory\":false},{\"name\":\"reload-action\",\"directory\":true},{\"name\":\"response-footer\",\"directory\":true},{\"name\":\"submit-action\",\"directory\":true},{\"name\":\"test-notice\",\"directory\":true},{\"name\":\"theme-provider\",\"directory\":true},{\"name\":\"theme-switch\",\"directory\":true},{\"name\":\"tool-group\",\"directory\":true},{\"name\":\"tool-result\",\"directory\":true},{\"name\":\"transient-assistant-messages\",\"directory\":true}]}","role":"tool"}

