data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_bogtrS3EbZOfkNSL8vr06321","delta":"{\"file_path\":\"/skills/ui-layout/SKILL.md\",\"offset\":0,\"limit\":200}"}

