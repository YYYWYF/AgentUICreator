inition.ts\",\"manifestPath\":\"src/agent-ui/plugins/theme-provider/manifest.json\",\"pluginId\":\"theme-provider\",\"relatedPluginIds\":[\"theme-provider\"]},{\"targetId\":\"official-plugin-reference:theme-switch\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"theme-switch\",\"relatedPluginIds\":[\"theme-switch\"]},{\"targetId\":\"official-plugin-reference:thinking-indicator\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"thinking-indicator\",\"relatedPluginIds\":[\"thinking-indicator\"]},{\"targetId\":\"official-plugin-reference:tool-fallback\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"tool-fallback\",\"relatedPluginIds\":[\"tool-fallback\"]},{\"targetId\":\"plugin-source:tool-group\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/tool-group/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/tool-group\",\"definitionPath\":\"src/agent-ui/plugins/tool-group/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/tool-group/manifest.json\",\"pluginId\":\"tool-group\",\"relatedPluginIds\":[\"tool-group\"]},{\"targetId\":\"plugin-source:tool-result\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/tool-result/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/tool-result\",\"definitionPath\":\"src/agent-ui/plugins/tool-result/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/tool-result/manifest.json\",\"pluginId\":\"tool-result\",\"relatedPluginIds\":[\"tool-result\"]},{\"targetId\":\"official-plugin-reference:tool-timeline\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"tool-timeline\",\"relatedPluginIds\":[\"tool-timeline\"]},{\"targetId\":\"plugin-source:transient-assistant-messages\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/transient-assistant-messages/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/transient-assistant-messages\",\"definitionPath\":\"src/agent-ui/plugins/transient-assistant-messages/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/transient-assistant-messages/manifest.json\",\"pluginId\":\"transient-assistant-messages\",\"relatedPluginIds\":[\"transient-assistant-messages\"]},{\"targetId\":\"official-plugin-reference:web-search\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"web-search\",\"relatedPluginIds\":[\"web-search\"]}]},\"layoutConstraints\":{\"refs\":\"snapshot-scoped\",\"pluginTargets\":[\"application\",\"layout_slot\",\"plugin_slot\"],\"sizedContainerInsertion\":{\"rule\":\"size-required\",\"operations\":[\"insert_layout_node\",\"move_layout_node\",\"insert_layout_relative\"]},\"relativeWrapperSizing\":{\"rule\":\"size-and-anchorSize-together\",\"operation\":\"insert_layout_relative\"},\"operationApplication\":\"sequential-atomic\"},\"hostGuarantees\":{\"mutation\":\"mutate_app_ui_model\",\"admission\":\"deterministic-atomic\",\"checks\":[\"app-ui-model-hash\",\"operation-and-model-schema\",\"capability-and-definition-resolution\",\"active-composition-compile\",\"layout-width-compatibility\",\"plugin-child-slot-contract\"],\"commit\":\"all-or-nothing\",\"postCommitVerificationRequired\":true,\"guidance\":\"Use this snapshot to form the semantic delta. Do not preflight facts covered by these admission checks with manifest, source, CSS, Service, or generated-file reads. Admission success commits static AppUIModel state only; post-commit verification is still required against the current revision.\"},\"runtimeObservation\":{\"tool\":\"inspect_runtime_layout\",\"toolGroup\":\"debugging\",\"enableIfNeeded\":{\"tool\":\"enable_creator_tools\",\"input\":{\"groups\":[\"debugging\"]}},\"input\":{\"nodeRefs\":[\"l0\"]},\"useWhen\":\"Actual dimensions, wrapping, container structure or mode-attribute locations are needed. Use the live observation instead of tracing framework/npm implementations to guess rendered DOM.\",\"coverage\":\"Fresh rectangles, bounded semantic-region structure, attribute locations and computed layout styles. No text, input values, arbitrary selectors or JavaScript.\",\"evidenceBoundary\":\"Tool availability is not proof that the preview is connected or the goal is satisfied. Explicit geometry outcomes need fresh relevant rectangles before completion; a static pass alone is insufficient. Enable a tool group alone before using its tools.\"}}}","role":"tool"}

