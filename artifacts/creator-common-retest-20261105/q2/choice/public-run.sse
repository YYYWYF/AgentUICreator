data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_yncPRMBo0LE5j7gp9NiH2261","delta":"{\"steps\":[{\"id\":\"api-shape\",\"question\":\"你的历史接口返回结构属于哪种？（选最后一项也行，直接把响应示例贴给我最快）\",\"options\":[{\"id\":\"matches-convention\",\"label\":\"与现有约定一致\",\"description\":\"列表 { conversations: [{ id, title }] }，详情 { id, title, state }（或 { id, title, state, agentState }）。只需改基础地址和鉴权。\"},{\"id\":\"business-envelope\",\"label\":\"业务包装格式\",\"description\":\"返回 { returnCode: \\\"SUC0000\\\", errorMsg, body }，body 里是 thread_id / max_message_checkpoint。项目目前已支持该格式。\"},{\"id\":\"custom-fields\",\"label\":\"字段名不同，需要映射\",\"description\":\"例如 data.records、sessionId、messageList 等自有字段名，需要我在 HTTP 适配层做字段映射。\"},{\"id\":\"paste-doc\",\"label\":\"我贴接口文档/响应示例\",\"description\":\"你提供真实示例后，我按它精确适配请求路径、请求体和响应映射。\"}],\"selectionMode\":\"single\",\"minSelections\":1,\"maxSelections\":1},{\"id\":\"auth\",\"question\":\"这些历史请求怎么鉴权？\",\"options\":[{\"id\":\"same-origin-cookie\",\"label\":\"同源 Cookie\",\"description\":\"沿用当前 credentials: 'same-origin'，登录态由浏览器 Cookie 携带。\"},{\"id\":\"bearer-token\",\"label\":\"Bearer Token\",\"description\":\"从现有登录/存储中取 token，放入 Authorization: Bearer <token>。\"},{\"id\":\"custom-header\",\"label\":\"自定义请求头\",\"description\":\"例如 X-Api-Key、X-Tenant-Id 等，需要我按你的约定写入 headers()。\"},{\"id\":\"none\",\"label\":\"暂不需要鉴权\",\"description\":\"内网或已由网关处理，请求不带鉴权信息。\"}],\"selectionMode\":\"single\",\"minSelections\":1,\"maxSelections\":1},{\"id\":\"base-url\",\"question\":\"基础地址（endpoint）怎么确定？\",\"options\":[{\"id\":\"env-override\",\"label\":\"已有环境变量注入\",\"description\":\"沿用现有 conversationDataEndpointOverride 机制，我只改路由与字段适配。\"},{\"id\":\"fixed-url\",\"label\":\"我给你固定 URL\",\"description\":\"在项目里写死或通过一个明确的配置项提供，我会按你给的地址接入。\"},{\"id\":\"same-origin-api\",\"label\":\"同源 /api 前缀\",\"description\":\"走同源代理，例如 /api，由网关转发到你的服务。\"},{\"id\":\"unsure\",\"label\":\"还不确定\",\"description\":\"先按现有机制保留可配置方式，地址稍后再给。\"}],\"selectionMode\":\"single\",\"minSelections\":1,\"maxSelections\":1}]}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_00_yncPRMBo0LE5j7gp9NiH2261"}

