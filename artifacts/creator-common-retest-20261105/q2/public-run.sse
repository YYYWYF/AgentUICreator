data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_QD6R6nnWqfnkg2pxc1Zk6369","delta":"{\"file_path\":\"/src/agent-ui/services/conversations/endpoint.ts\",\"offset\":0,\"limit\":60}"}

