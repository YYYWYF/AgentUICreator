data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_QD6R6nnWqfnkg2pxc1Zk6369","messageId":"b26ebac1-c5a8-4eec-a5ef-6d94e596debc","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/services/conversations/endpoint.ts\",\"content\":\"1: export interface ResolveConversationDataEndpointOptions {\\n2:   configuredEndpoint?: string | undefined;\\n3: }\\n4: \\n5: /**\\n6:  * Project-owned fixed base URL of the business conversation history API.\\n7:  *\\n8:  * Fill in your history service base, for example 'https://history.example.com/api'.\\n9:  * List, detail, delete, rename, archive and unarchive paths stay in\\n10:  * `./http-data-source.ts` (`conversationRequests`).\\n11:  * Requests send no business credentials: `credentials` stays 'same-origin', so a\\n12:  * cross-origin history service receives no cookies.\\n13:  *\\n14:  * While this stays empty and no preview override is provided, history falls back to\\n15:  * the empty data source and the conversation list remains empty.\\n16:  */\\n17: export const CONVERSATION_HISTORY_ENDPOINT = '';\\n18: \\n19: export function resolveConversationDataEndpoint({\\n20:   configuredEndpoint,\\n21: }: ResolveConversationDataEndpointOptions): string | undefined {\\n22:   // A preview override still wins so a test service can be targeted temporarily.\\n23:   const configured = configuredEndpoint?.trim() || CONVERSATION_HISTORY_ENDPOINT.trim();\\n24:   return configured || undefined;\\n25: }\\n26: \",\"hash\":\"1078d89aaa87761fd5100eb5c7ad9e9cd094aa243b947185ce5a0d19880b7dc7\",\"totalLines\":26,\"nextOffset\":null}}","role":"tool"}

