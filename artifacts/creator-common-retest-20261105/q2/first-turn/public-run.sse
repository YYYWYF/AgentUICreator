data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_zh6X6zcAl9LvzJqfR9qt7432","messageId":"b5fe44ef-d11a-4295-8975-47e2897fd36e","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/services/conversations/http-data-source.ts\",\"content\":\"1: import { z } from 'zod';\\n2: \\n3: import {\\n4:   conversationDetailResponseSchema,\\n5:   conversationListResponseSchema,\\n6:   langGraphStateSnapshotSchema,\\n7:   type ConversationDetail,\\n8:   type ConversationDetailResponse,\\n9:   type ConversationSummary,\\n10: } from '@za38.03/agent-ui-runtime/ui/services/conversations/contract';\\n11: import type { ConversationDataSource } from '@za38.03/agent-ui-runtime/ui/services/conversations/data-source';\\n12: \\n13: export interface HttpConversationDataSourceOptions {\\n14:   endpoint: string;\\n15:   fetch?: typeof globalThis.fetch | undefined;\\n16: }\\n17: \\n18: // Project-owned request implementation. Creator adapts these routes and reads\\n19: // current user credentials here when connecting a business history service.\\n20: const conversationRequests = {\\n21:   listUrl: (base: string) => `${base}/conversations`,\\n22:   detailUrl: (base: string, id: string) => `${base}/conversation/${encodeURIComponent(id)}`,\\n23:   deleteUrl: (base: string, id: string) => `${base}/conversations/${encodeURIComponent(id)}`,\\n24:   renameUrl: (base: string, id: string) => `${base}/conversations/${encodeURIComponent(id)}`,\\n25:   archiveUrl: (base: string, id: string) => `${base}/conversations/${encodeURIComponent(id)}/archive`,\\n26:   unarchiveUrl: (base: string, id: string) => `${base}/conversations/${encodeURIComponent(id)}/unarchive`,\\n27:   headers: (): HeadersInit => ({}),\\n28:   credentials: 'same-origin' as RequestCredentials,\\n29: };\\n30: \\n31: function requestInit(method: string, signal?: AbortSignal): RequestInit {\\n32:   return {\\n33:     method,\\n34:     headers: conversationRequests.headers(),\\n35:     credentials: conversationRequests.credentials,\\n36:     ...(signal === undefined ? {} : { signal }),\\n37:   };\\n38: }\\n39: \\n40: function normalizeEndpoint(endpoint: string): string {\\n41:   const normalized = endpoint.trim().replace(/\\\\/+$/, '');\\n42:   if (normalized.length === 0) {\\n43:     throw new Error('Conversation API endpoint must not be blank.');\\n44:   }\\n45:   return normalized;\\n46: }\\n47: \\n48: async function assertResponseOk(response: Response): Promise<void> {\\n49:   if (!response.ok) {\\n50:     let detail = '';\\n51:     try {\\n52:       const body: unknown = await response.json();\\n53:       if (typeof body === 'object' && body !== null && 'error' in body && typeof body.error === 'string') {\\n54:         detail = `: ${body.error}`;\\n55:       }\\n56:     } catch {\\n57:       // The HTTP status remains authoritative when no JSON body exists.\\n58:     }\\n59:     throw new Error(`Conversation API request failed (${response.status})${detail}`);\\n60:   }\\n61: }\\n62: \\n63: async function readResponseJson(response: Response): Promise<unknown> {\\n64:   await assertResponseOk(response);\\n65:   return response.json();\\n66: }\\n67: \\n68: const conversationApiEnvelopeSchema = z.object({\\n69:   returnCode: z.string(),\\n70:   errorMsg: z.string().nullish(),\\n71:   body: z.unknown().optional(),\\n72: });\\n73: \\n74: const conversationApiListBodySchema = z.object({\\n75:   conversations: z.array(\\n76:     z.object({\\n77:       thread_id: z.string(),\\n78:       title: z.string(),\\n79:       status: z.enum(['regular', 'archived']).optional(),\\n80:       last_message_time: z.string().nullish(),\\n81:     }),\\n82:   ),\\n83: });\\n84: \\n85: const conversationApiDetailBodySchema = z.object({\\n86:   thread_id: z.string().trim().min(1),\\n87:   title: z.string().trim().min(1).optional(),\\n88:   max_message_checkpoint: z\\n89:     .object({\\n90:       values: z.unknown().optional(),\\n91:       channel_values: z.unknown().optional(),\\n92:     })\\n93:     .catchall(z.unknown()),\\n94:   agentState: z.unknown().optional(),\\n95: });\\n96: \\n97: function readConversationApiBody(value: unknown): unknown {\\n98:   const envelope = conversationApiEnvelopeSchema.parse(value);\\n99:   if (envelope.returnCode !== 'SUC0000') {\\n100:     const detail = envelope.errorMsg ? `: ${envelope.errorMsg}` : '';\\n101:     throw new Error(`Conversation API request failed (${envelope.returnCode})${detail}`);\\n102:   }\\n103:   return envelope.body;\\n104: }\\n105: \\n106: function normalizeConversationListResponse(value: unknown): ConversationSummary[] {\\n107:   if (typeof value !== 'object' || value === null || !('returnCode' in value)) {\\n108:     return conversationListResponseSchema.parse(value).conversations;\\n109:   }\\n110:   const body = conversationApiListBodySchema.parse(readConversationApiBody(value));\\n111:   return conversationListResponseSchema.parse({\\n112:     conversations: body.conversations.map((item) => {\\n113:       const updatedAt = item.last_message_time?.trim();\\n114:       return {\\n115:         id: item.thread_id,\\n116:         title: item.title,\\n117:         ...(item.status === undefined ? {} : { status: item.status }),\\n118:         ...(updatedAt ? { updatedAt } : {}),\\n119:       };\\n120:     }),\\n121:   }).conversations;\\n122: }\\n123: \\n124: function normalizeConversationDetailResponse(value: unknown): ConversationDetailResponse {\\n125:   // Existing Mock providers and generated projects may still return the direct DTO.\\n126:   if (typeof value !== 'object' || value === null || !('returnCode' in value)) {\\n127:     return conversationDetailResponseSchema.parse(value);\\n128:   }\\n129:   const body = conversationApiDetailBodySchema.parse(readConversationApiBody(value));\\n130:   const checkpoint = body.max_message_checkpoint;\\n131:   // Normalize the storage field name at the HTTP boundary. The current snapshot\\n132:   // schema and LangChain message conversion remain authoritative.\\n133:   const state = langGraphStateSnapshotSchema.parse({\\n134:     ...checkpoint,\\n135:     values: checkpoint.values === undefined ? checkpoint.channel_values : checkpoint.values,\\n136:   });\\n137:   return {\\n138:     id: body.thread_id,\\n139:     title: body.title ?? body.thread_id,\\n140:     state,\\n141:     ...(body.agentState === undefined ? {} : { agentState: body.agentState }),\\n142:   };\\n143: }\\n144: \\n145: function toConversationDetail(response: ConversationDetailResponse): ConversationDetail {\\n146:   return {\\n147:     id: response.id,\\n148:     title: response.title,\\n149:     history: {\\n150:       format: 'langchain',\\n151:       messages: response.state.values.messages ?? [],\\n152:     },\\n153:     ...(response.agentState === undefined ? {} : { agentState: response.agentState }),\\n154:   };\\n155: }\\n156: \\n157: export function createHttpConversationDataSource({\\n158:   endpoint,\\n159:   fetch: fetchImplementation = globalThis.fetch,\\n160: }: HttpConversationDataSourceOptions): ConversationDataSource {\\n161:   const baseEndpoint = normalizeEndpoint(endpoint);\\n162: \\n163:   return {\\n164:     async rename(id, title, options) {\\n165:       const init = requestInit('PATCH', options?.signal);\\n166:       const headers = new Headers(init.headers);\\n167:       headers.set('Content-Type', 'application/json');\\n168:       const response = await fetchImplementation(conversationRequests.renameUrl(baseEndpoint, id), {\\n169:         ...init,\\n170:         headers,\\n171:         body: JSON.stringify({ title }),\\n172:       });\\n173:       await assertResponseOk(response);\\n174:     },\\n175:     async archive(id, options) {\\n176:       const response = await fetchImplementation(\\n177:         conversationRequests.archiveUrl(baseEndpoint, id),\\n178:         requestInit('POST', options?.signal),\\n179:       );\\n180:       await assertResponseOk(response);\\n181:     },\\n182:     async unarchive(id, options) {\\n183:       const response = await fetchImplementation(\\n184:         conversationRequests.unarchiveUrl(baseEndpoint, id),\\n185:         requestInit('POST', options?.signal),\\n186:       );\\n187:       await assertResponseOk(response);\\n188:     },\\n189:     async delete(id, options) {\\n190:       const response = await fetchImplementation(\\n191:         conversationRequests.deleteUrl(baseEndpoint, id),\\n192:         requestInit('DELETE', options?.signal),\\n193:       );\\n194:       await assertResponseOk(response);\\n195:     },\\n196:     async list(options) {\\n197:       const response = await fetchImplementation(\\n198:         conversationRequests.listUrl(baseEndpoint),\\n199:         requestInit('GET', options?.signal),\\n200:       );\",\"hash\":\"9476dbafff815042ea554d4870128016dd6ed77e4f40a08802d0a20c80844872\",\"totalLines\":212,\"nextOffset\":200}}","role":"tool"}

