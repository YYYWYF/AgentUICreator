data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_02_xFZYMuMdXfNzuc2eMNWU9686","delta":"{\"action\":\"read\",\"documentId\":\"public:development/history-backend\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s42\"}"}

