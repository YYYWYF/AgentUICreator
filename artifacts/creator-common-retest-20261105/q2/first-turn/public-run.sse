data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_PwBpxfmm4Bon5QiUmT275797","messageId":"20c19c25-f7e0-4c6e-a164-e7bb7a97bd0b","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/conversation-data-source/definition.ts\",\"content\":\"1: import type { UIPluginDefinition } from '@za38.03/agent-ui-plugins';\\n2: import implementation from '@za38.03/agent-ui-plugins/conversation-data-source';\\n3: import { createAgentBackendTransport } from '@za38.03/agent-ui-runtime/ui/application/agent-backend-transport';\\n4: import { getPreviewAgentEnvironment } from '@za38.03/agent-ui-runtime/ui/application/preview-environment';\\n5: \\n6: import {\\n7:   AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE,\\n8:   createEmptyConversationDataSource,\\n9:   createHttpConversationDataSource,\\n10:   resolveConversationDataEndpoint,\\n11: } from '../../services/conversations';\\n12: import { ConversationDataSourcePlugin } from './index';\\n13: \\n14: export const conversationDataSourcePlugin: UIPluginDefinition = {\\n15:   manifest: implementation.manifest,\\n16:   provides: [AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE],\\n17:   setup: implementation.bindSetup(({ services }: Parameters<NonNullable<UIPluginDefinition['setup']>>[0]) => {\\n18:     const endpoint = resolveConversationDataEndpoint({\\n19:       configuredEndpoint: getPreviewAgentEnvironment(import.meta.env.DEV)?.conversationDataEndpointOverride,\\n20:     });\\n21:     const source =\\n22:       endpoint === undefined\\n23:         ? createEmptyConversationDataSource()\\n24:         : createHttpConversationDataSource({\\n25:             endpoint,\\n26:             fetch: createAgentBackendTransport({ development: import.meta.env.DEV }).fetch,\\n27:           });\\n28:     services.provide(AGENT_UI_CONVERSATION_DATA_SOURCE_SERVICE, source);\\n29:   }),\\n30:   Component: ConversationDataSourcePlugin,\\n31: };\\n32: \\n33: export default conversationDataSourcePlugin;\\n34: \",\"hash\":\"b3b28a15514c6d2fe728c0dc9fb353722bb85c4450ce8fdeaaf2ffe1384d1463\",\"totalLines\":34,\"nextOffset\":null}}","role":"tool"}

