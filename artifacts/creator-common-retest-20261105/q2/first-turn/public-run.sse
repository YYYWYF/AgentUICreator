data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_DzRagFPLX61wum0ALWDy4286","delta":"{\"action\":\"read\",\"documentId\":\"public:development/history-backend\",\"limit\":3000,\"offset\":0,\"sectionId\":\"s5\"}"}

