ser-input\",\"relatedPluginIds\":[\"lexical-composer-input\"]},{\"targetId\":\"official-plugin-reference:lexical-edit-composer\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"lexical-edit-composer\",\"relatedPluginIds\":[\"lexical-edit-composer\"]},{\"targetId\":\"plugin-source:locale-provider\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/locale-provider/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/locale-provider\",\"definitionPath\":\"src/agent-ui/plugins/locale-provider/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/locale-provider/manifest.json\",\"pluginId\":\"locale-provider\",\"relatedPluginIds\":[\"locale-provider\"]},{\"targetId\":\"official-plugin-reference:locale-switch\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"locale-switch\",\"relatedPluginIds\":[\"locale-switch\"]},{\"targetId\":\"official-plugin-reference:mention-trigger\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"mention-trigger\",\"relatedPluginIds\":[\"mention-trigger\"]},{\"targetId\":\"plugin-source:quick-help-card\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"ownerRoot\":\"src/agent-ui/plugins/quick-help-card\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"pluginId\":\"quick-help-card\",\"relatedPluginIds\":[\"quick-help-card\"]},{\"targetId\":\"plugin-source:quick-help-content\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"ownerRoot\":\"src/agent-ui/plugins/quick-help-content\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"pluginId\":\"quick-help-content\",\"relatedPluginIds\":[\"quick-help-content\"]},{\"targetId\":\"plugin-source:reasoning\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/reasonin