data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-90fc3921a90b59f9","messageId":"2a90ff60-4c0c-4656-b5a1-0dffddb540e1","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-card/styles.css\",\"content\":\"1: .quick-help-card {\\n2:   box-sizing: border-box;\\n3:   width: 100%;\\n4:   min-width: 0;\\n5:   background: var(--card);\\n6:   color: var(--foreground);\\n7:   border-bottom: 1px solid var(--border);\\n8: }\\n9: \\n10: .quick-help-card__header {\\n11:   display: flex;\\n12:   align-items: center;\\n13:   gap: 8px;\\n14:   padding: 8px 12px;\\n15: }\\n16: \\n17: .quick-help-card__toggle {\\n18:   display: inline-flex;\\n19:   align-items: center;\\n20:   gap: 6px;\\n21:   flex: 1 1 auto;\\n22:   min-width: 0;\\n23:   margin: 0;\\n24:   padding: 4px 6px;\\n25:   border: none;\\n26:   border-radius: 6px;\\n27:   background: transparent;\\n28:   color: inherit;\\n29:   font: inherit;\\n30:   font-size: 13px;\\n31:   line-height: 1.5;\\n32:   text-align: left;\\n33:   cursor: pointer;\\n34: }\\n35: \\n36: .quick-help-card__toggle:hover {\\n37:   background: var(--muted);\\n38: }\\n39: \\n40: .quick-help-card__toggle:focus-visible {\\n41:   outline: 2px solid var(--ring, var(--border));\\n42:   outline-offset: 2px;\\n43: }\\n44: \\n45: .quick-help-card__title {\\n46:   font-weight: 600;\\n47:   overflow-wrap: anywhere;\\n48: }\\n49: \\n50: .quick-help-card__indicator {\\n51:   flex: 0 0 auto;\\n52:   font-size: 12px;\\n53:   opacity: 0.8;\\n54: }\\n55: \\n56: .quick-help-card__toggle-label {\\n57:   flex: 0 0 auto;\\n58:   font-size: 12px;\\n59:   opacity: 0.7;\\n60: }\\n61: \\n62: .quick-help-card__header-actions {\\n63:   display: flex;\\n64:   align-items: center;\\n65:   gap: 4px;\\n66:   flex: 0 0 auto;\\n67:   min-width: 0;\\n68: }\\n69: \\n70: .quick-help-card__body {\\n71:   box-sizing: border-box;\\n72:   min-width: 0;\\n73:   padding: 0 12px 8px;\\n74:   font-size: 13px;\\n75:   line-height: 1.5;\\n76: }\\n77: \\n78: .quick-help-card__body[hidden] {\\n79:   display: none;\\n80: }\\n81: \",\"hash\":\"09b62afa881fff99d184e369aef8375b29bee0baeb74f31d2e47c8a46079d1fc\",\"totalLines\":81,\"nextOffset\":null}}","role":"tool"}

