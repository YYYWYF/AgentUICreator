data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-bb17a60ed64281b3","delta":"{\"file_path\":\"/skills/ag-ui-frontend/SKILL.md\",\"limit\":200,\"offset\":0}"}

