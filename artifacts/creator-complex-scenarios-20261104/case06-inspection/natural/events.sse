data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-86911dcbaaa4e604","delta":"{\"pluginId\":\"inspection-result-message\",\"changes\":[{\"type\":\"create\",\"relativePath\":\"locale.ts\",\"content\":\"import type { AgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n\\n/** Copy shown by the inspection result card. */\\nexport type InspectionResultLabels = {\\n  heading: string;\\n  targetLabel: string;\\n  passedHeading: string;\\n  failedHeading: string;\\n  otherHeading: string;\\n  passedLabel: string;\\n  failedLabel: string;\\n  expandReason: string;\\n  collapseReason: string;\\n  copyDetail: string;\\n  copied: string;\\n  copyFailed: string;\\n  code: string;\\n  message: string;\\n  duration: string;\\n  milliseconds: string;\\n  invalidData: string;\\n};\\n\\nconst enUS: InspectionResultLabels = {\\n  heading: \\\"Inspection result\\\",\\n  targetLabel: \\\"Target\\\",\\n  passedHeading: \\\"Passed\\\",\\n  failedHeading: \\\"Failed\\\",\\n  otherHeading: \\\"Other statuses\\\",\\n  passedLabel: \\\"Passed\\\",\\n  failedLabel: \\\"Failed\\\",\\n  expandReason: \\\"Expand reason\\\",\\n  collapseReason: \\\"Collapse reason\\\",\\n  copyDetail: \\\"Copy error details\\\",\\n  copied: \\\"Copied\\\",\\n  copyFailed: \\\"Copy failed\\\",\\n  code: \\\"Code\\\",\\n  message: \\\"Message\\\",\\n  duration: \\\"Duration\\\",\\n  milliseconds: \\\"ms\\\",\\n  invalidData: \\\"The inspection result payload could not be read, so it was not rendered.\\\",\\n};\\n\\nconst zhCN: InspectionResultLabels = {\\n  heading: \\\"检查结果\\\",\\n  targetLabel: \\\"目标\\\",\\n  passedHeading: \\\"通过\\\",\\n  failedHeading: \\\"失败\\\",\\n  otherHeading: \\\"其他状态\\\",\\n  passedLabel: \\\"通过\\\",\\n  failedLabel: \\\"失败\\\",\\n  expandReason: \\\"展开原因\\\",\\n  collapseReason: \\\"收起原因\\\",\\n  copyDetail: \\\"复制错误详情\\\",\\n  copied: \\\"已复制\\\",\\n  copyFailed: \\\"复制失败\\\",\\n  code: \\\"错误码\\\",\\n  message: \\\"错误信息\\\",\\n  duration: \\\"耗时\\\",\\n  milliseconds: \\\"毫秒\\\",\\n  invalidData: \\\"检查结果数据格式无法识别，已跳过渲染。\\\",\\n};\\n\\n/** Complete dictionaries keyed by the central Agent UI locale codes. */\\nexport const inspectionResultLocale: Record<AgentUILocaleCode, InspectionResultLabels> = {\\n  \\\"en-US\\\": enUS,\\n  \\\"zh-CN\\\": zhCN,\\n};\\n\\nexport const inspectionResultFallback: InspectionResultLabels = enUS;\\n\"},{\"type\":\"edit\",\"relativePath\":\"index.tsx\",\"edits\":[{\"oldText\":\"import { parseInspectionResult, type InspectionCheck } from \\\"./schema\\\";\",\"newText\":\"import {\\n  inspectionResultFallback,\\n  inspectionResultLocale,\\n  type InspectionResultLabels,\\n} from \\\"./locale\\\";\\nimport { parseInspectionResult, type InspectionCheck } from \\\"./schema\\\";\"},{\"oldText\":\"type InspectionLabels = {\\n  heading: string;\\n  targetLabel: string;\\n  passedHeading: string;\\n  failedHeading: string;\\n  otherHeading: string;\\n  passedLabel: string;\\n  failedLabel: string;\\n  expandReason: string;\\n  collapseReason: string;\\n  copyDetail: string;\\n  copied: string;\\n  copyFailed: string;\\n  code: string;\\n  message: string;\\n  duration: string;\\n  milliseconds: string;\\n  invalidData: string;\\n};\\n\\nconst zhCN: InspectionLabels = {\\n  heading: \\\"检查结果\\\",\\n  targetLabel: \\\"目标\\\",\\n  passedHeading: \\\"通过\\\",\\n  failedHeading: \\\"失败\\\",\\n  otherHeading: \\\"其他状态\\\",\\n  passedLabel: \\\"通过\\\",\\n  failedLabel: \\\"失败\\\",\\n  expandReason: \\\"展开原因\\\",\\n  collapseReason: \\\"收起原因\\\",\\n  copyDetail: \\\"复制错误详情\\\",\\n  copied: \\\"已复制\\\",\\n  copyFailed: \\\"复制失败\\\",\\n  code: \\\"错误码\\\",\\n  message: \\\"错误信息\\\",\\n  duration: \\\"耗时\\\",\\n  milliseconds: \\\"毫秒\\\",\\n  invalidData: \\\"检查结果数据格式无法识别，已跳过渲染。\\\",\\n};\\n\\nconst enUS: InspectionLabels = {\\n  heading: \\\"Inspection result\\\",\\n  targetLabel: \\\"Target\\\",\\n  passedHeading: \\\"Passed\\\",\\n  failedHeading: \\\"Failed\\\",\\n  otherHeading: \\\"Other statuses\\\",\\n  passedLabel: \\\"Passed\\\",\\n  failedLabel: \\\"Failed\\\",\\n  expandReason: \\\"Expand reason\\\",\\n  collapseReason: \\\"Collapse reason\\\",\\n  copyDetail: \\\"Copy error details\\\",\\n  copied: \\\"Copied\\\",\\n  copyFailed: \\\"Copy failed\\\",\\n  code: \\\"Code\\\",\\n  message: \\\"Message\\\",\\n  duration: \\\"Duration\\\",\\n  milliseconds: \\\"ms\\\",\\n  invalidData: \\\"The inspection result payload could not be read, so it was not rendered.\\\",\\n};\\n\\nconst messages: Record<string, InspectionLabels> = {\\n  \\\"zh-CN\\\": zhCN,\\n  \\\"en-US\\\": enUS,\\n};\\n\\nfunction useInspectionLabels(): InspectionLabels {\\n  const localeCode = useAgentUILocaleCode();\\n  return messages[localeCode] ?? enUS;\\n}\\n\\ntype DetailField\",\"newText\":\"type DetailField\"},{\"oldText\":\"function FailedCheck({ check, labels }: { check: InspectionCheck; labels: InspectionLabels }) {\",\"newText\":\"function FailedCheck({\\n  check,\\n  labels,\\n}: {\\n  check: InspectionCheck;\\n  labels: InspectionResultLabels;\\n}) {\"},{\"oldText\":\"  const labels = useInspectionLabels();\",\"newText\":\"  const labels = inspectionResultLocale[useAgentUILocaleCode()] ?? inspectionResultFallback;\"}]}]}"}

