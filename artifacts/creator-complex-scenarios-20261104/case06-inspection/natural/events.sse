data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-8889afd4e49be54d","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":8000,\"offset\":0,\"sectionId\":\"s34\"}"}

