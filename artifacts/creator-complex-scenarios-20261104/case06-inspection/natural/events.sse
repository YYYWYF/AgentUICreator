data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-b36a7c7df30bce6a","messageId":"85e903a6-82c9-4a13-bcd6-d7c53caa6d2d","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"e9c91f9c348bc13fd89ed13d50882bf1b94fa2d27605e51451172c88898ea925\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"inspection-result-message\",\"name\":\"Inspection Result Message\",\"description\":\"Renders system inspection results carried by the app.inspection.result CUSTOM event.\",\"directory\":\"inspection-result-message\",\"manifestPath\":\"src/agent-ui/plugins/inspection-result-message/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/inspection-result-message/definition.ts\",\"capabilities\":[],\"authoring\":{\"intents\":[\"render inspection results inside assistant messages\"]},\"childSlots\":{},\"dataMessageUINames\":[\"app.inspection.result\"],\"selected\":true},\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":1,\"resolved\":1,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-runtime/ui\",\"symbols\":[{\"name\":\"AgentProps\",\"status\":\"available\",\"type\":\"AgentProps\",\"truncated\":false,\"memberNames\":[\"appEventSchemas\",\"locales\",\"defaultLocale\",\"welcome\",\"suggestions\",\"enableMessageQueue\",\"assistantPanelWidth\",\"conversationDataSource\",\"toolkit\",\"frontendToolUIs\",\"integrations\",\"frontendTools\",\"getRunContext\",\"theme\",\"onThemeChange\",\"user\",\"transientMessages\",\"locale\",\"onLocaleChange\",\"endpoint\",\"observability\",\"onError\",\"runResumeProvider\",\"initialThreadId\",\"attachments\",\"dictation\",\"feedback\",\"attachmentAdapter\",\"dictationAdapter\",\"feedbackAdapter\"],\"memberNamesTruncated\":false,\"parameterQueries\":[\"AgentProps.integrations.$parameter0\",\"AgentProps.getRunContext.$parameter0\",\"AgentProps.onThemeChange.$parameter0\",\"AgentProps.onLocaleChange.$parameter0\",\"AgentProps.onError.$parameter0\",\"AgentProps.runResumeProvider.$parameter0\"],\"parameterContracts\":[{\"query\":\"AgentProps.integrations.$parameter0\",\"type\":\"{ children: ReactNode; }\",\"truncated\":false,\"propNames\":[\"children\"],\"propNamesTruncated\":false,\"members\":[{\"name\":\"children\",\"type\":\"ReactNode\",\"truncated\":false}],\"membersTruncated\":false}],\"parameterContractsTruncated\":true,\"nextEvidence\":\"Invocation parameters are included in parameterContracts. Truncation flags identify omitted details; parameterQueries expand exact parameter paths.\",\"members\":[{\"name\":\"appEventSchemas\",\"type\":\"Readonly<Record<string, ZodTypeAny<unknown, unknown, $ZodTypeInternals<unknown, unknown>>>> | undefined\",\"truncated\":false},{\"name\":\"locales\",\"type\":\"Partial<Record<AgentUILocaleCode, AgentUILocaleOverrides>> | undefined\",\"truncated\":false},{\"name\":\"defaultLocale\",\"type\":\"AgentUILocaleCode | undefined\",\"truncated\":false},{\"name\":\"welcome\",\"type\":\"ConversationWelcomeConfig | undefined\",\"truncated\":false},{\"name\":\"suggestions\",\"type\":\"readonly ConversationStarterSuggestion[] | ((locale: AgentUILocaleCode) => readonly ConversationStarterSuggestion[]) | undefined\",\"truncated\":false},{\"name\":\"enableMessageQueue\",\"type\":\"boolean | undefined\",\"truncated\":false},{\"name\":\"assistantPanelWidth\",\"type\":\"number | undefined\",\"truncated\":false},{\"name\":\"conversationDataSource\",\"type\":\"ConversationDataSource | undefined\",\"truncated\":false},{\"name\":\"toolkit\",\"type\":\"Readonly<Record<string, ConversationToolkitEntry>> | undefined\",\"truncated\":false},{\"name\":\"frontendToolUIs\",\"type\":\"Readonly<Record<string, ConversationFrontendToolUIEntry>> | undefined\",\"truncated\":false},{\"name\":\"integrations\",\"type\":\"ComponentType<{ children: ReactNode; }> | undefined\",\"truncated\":false},{\"name\":\"frontendTools\",\"type\":\"AgentFrontendToolSource | undefined\",\"truncated\":false},{\"name\":\"getRunContext\",\"type\":\"ConversationRunContextGetter | undefined\",\"truncated\":false},{\"name\":\"theme\",\"type\":\"\\\"dark\\\" | \\\"light\\\" | \\\"violet\\\" | undefined\",\"truncated\":false},{\"name\":\"onThemeChange\",\"type\":\"((theme: \\\"dark\\\" | \\\"light\\\" | \\\"violet\\\") => void) | undefined\",\"truncated\":false},{\"name\":\"user\",\"type\":\"AgentUIUser | null | undefined\",\"truncated\":false},{\"name\":\"transientMessages\",\"type\":\"ConversationTransientMessageService | undefined\",\"truncated\":false},{\"name\":\"locale\",\"type\":\"AgentUILocaleCode | undefined\",\"truncated\":false},{\"name\":\"onLocaleChange\",\"type\":\"((locale: AgentUILocaleCode) => void) | undefined\",\"truncated\":false},{\"name\":\"endpoint\",\"type\":\"string | undefined\",\"truncated\":false},{\"name\":\"observability\",\"type\":\"AgentObservability | undefined\",\"truncated\":false},{\"name\":\"onError\",\"type\":\"((error: Error) => void) | undefined\",\"truncated\":false},{\"name\":\"runResumeProvider\",\"type\":\"ConversationRunResumeProvider<AppAgentState> | undefined\",\"truncated\":false},{\"name\":\"initialThreadId\",\"type\":\"string | undefined\",\"truncated\":false},{\"name\":\"attachments\",\"type\":\"false | AttachmentConfig | undefined\",\"truncated\":false},{\"name\":\"dictation\",\"type\":\"false | DictationConfig | undefined\",\"truncated\":false},{\"name\":\"feedback\",\"type\":\"false | FeedbackConfig | undefined\",\"truncated\":false},{\"name\":\"attachmentAdapter\",\"type\":\"AttachmentAdapter | undefined\",\"truncated\":false},{\"name\":\"dictationAdapter\",\"type\":\"DictationAdapter | undefined\",\"truncated\":false},{\"name\":\"feedbackAdapter\",\"type\":\"ConversationFeedbackAdapter | undefined\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"p27\",\"pluginId\":\"inspection-result-message\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":5,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p27\"}],\"manifest\":{\"id\":\"inspection-result-message\",\"name\":\"Inspection Result Message\",\"description\":\"Renders system inspection results carried by the app.inspection.result CUSTOM event.\",\"version\":\"0.0.1\",\"data\":{\"messageUI\":true},\"authoring\":{\"intents\":[\"render inspection results inside assistant messages\"]}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { InspectionResultMessage } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      // Static literal required: the registry generator reads this name at build time.\\n      name: \\\"app.inspection.result\\\",\\n      render: InspectionResultMessage,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":692},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/inspection-result-message/definition.ts\",\"kind\":\"file\",\"bytes\":692},{\"path\":\"src/agent-ui/plugins/inspection-result-message/index.tsx\",\"kind\":\"file\",\"bytes\":9414},{\"path\":\"src/agent-ui/plugins/inspection-result-message/manifest.json\",\"kind\":\"file\",\"bytes\":350},{\"path\":\"src/agent-ui/plugins/inspection-result-message/schema.ts\",\"kind\":\"file\",\"bytes\":768},{\"path\":\"src/agent-ui/plugins/inspection-result-message/styles.css\",\"kind\":\"file\",\"bytes\":4073}],\"filesTruncated\":false}}","role":"tool"}

