data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-929596b28f3bc78b","messageId":"01e2284c-0932-4968-acda-6dbd7ce82020","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"query\":\"appEventSchemas CUSTOM event data message UI\",\"total\":127,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}},{\"sectionId\":\"s48\",\"title\":\"运行上下文回调\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s48\"}}},{\"sectionId\":\"s139\",\"title\":\"订阅 Agent 业务事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s139\"}}}]},{\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path