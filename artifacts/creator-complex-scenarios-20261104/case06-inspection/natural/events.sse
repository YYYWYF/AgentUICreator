data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-82251d60593b5227","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\",\"offset\":0,\"limit\":8000}"}

