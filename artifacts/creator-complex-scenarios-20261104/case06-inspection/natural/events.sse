data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-9741ac9841ed3f54","messageId":"0346ae3a-c352-4c76-8a1a-88c3b1a20556","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/inspection-result-message/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { useState } from \\\"react\\\";\\n3: \\n4: import { parseInspectionResult, type InspectionCheck } from \\\"./schema\\\";\\n5: import \\\"./styles.css\\\";\\n6: \\n7: type InspectionLabels = {\\n8:   heading: string;\\n9:   targetLabel: string;\\n10:   passedHeading: string;\\n11:   failedHeading: string;\\n12:   otherHeading: string;\\n13:   passedLabel: string;\\n14:   failedLabel: string;\\n15:   expandReason: string;\\n16:   collapseReason: string;\\n17:   copyDetail: string;\\n18:   copied: string;\\n19:   copyFailed: string;\\n20:   code: string;\\n21:   message: string;\\n22:   duration: string;\\n23:   milliseconds: string;\\n24:   invalidData: string;\\n25: };\\n26: \\n27: const zhCN: InspectionLabels = {\\n28:   heading: \\\"检查结果\\\",\\n29:   targetLabel: \\\"目标\\\",\\n30:   passedHeading: \\\"通过\\\",\\n31:   failedHeading: \\\"失败\\\",\\n32:   otherHeading: \\\"其他状态\\\",\\n33:   passedLabel: \\\"通过\\\",\\n34:   failedLabel: \\\"失败\\\",\\n35:   expandReason: \\\"展开原因\\\",\\n36:   collapseReason: \\\"收起原因\\\",\\n37:   copyDetail: \\\"复制错误详情\\\",\\n38:   copied: \\\"已复制\\\",\\n39:   copyFailed: \\\"复制失败\\\",\\n40:   code: \\\"错误码\\\",\\n41:   message: \\\"错误信息\\\",\\n42:   duration: \\\"耗时\\\",\\n43:   milliseconds: \\\"毫秒\\\",\\n44:   invalidData: \\\"检查结果数据格式无法识别，已跳过渲染。\\\",\\n45: };\\n46: \\n47: const enUS: InspectionLabels = {\\n48:   heading: \\\"Inspection result\\\",\\n49:   targetLabel: \\\"Target\\\",\\n50:   passedHeading: \\\"Passed\\\",\\n51:   failedHeading: \\\"Failed\\\",\\n52:   otherHeading: \\\"Other statuses\\\",\\n53:   passedLabel: \\\"Passed\\\",\\n54:   failedLabel: \\\"Failed\\\",\\n55:   expandReason: \\\"Expand reason\\\",\\n56:   collapseReason: \\\"Collapse reason\\\",\\n57:   copyDetail: \\\"Copy error details\\\",\\n58:   copied: \\\"Copied\\\",\\n59:   copyFailed: \\\"Copy failed\\\",\\n60:   code: \\\"Code\\\",\\n61:   message: \\\"Message\\\",\\n62:   duration: \\\"Duration\\\",\\n63:   milliseconds: \\\"ms\\\",\\n64:   invalidData: \\\"The inspection result payload could not be read, so it was not rendered.\\\",\\n65: };\\n66: \\n67: const messages: Record<string, InspectionLabels> = {\\n68:   \\\"zh-CN\\\": zhCN,\\n69:   \\\"en-US\\\": enUS,\\n70: };\\n71: \\n72: function useInspectionLabels(): InspectionLabels {\\n73:   const localeCode = useAgentUILocaleCode();\\n74:   return messages[localeCode] ?? enUS;\\n75: }\\n76: \\n77: type DetailField = \\\"code\\\" | \\\"message\\\" | \\\"duration\\\";\\n78: \\n79: function readDetailFields(detail: unknown): Array<{ field: DetailField; value: string }> {\\n80:   if (!detail || typeof detail !== \\\"object\\\") return [];\\n81:   const record = detail as Record<string, unknown>;\\n82:   const fields: Array<{ field: DetailField; value: string }> = [];\\n83: \\n84:   const code = record.code;\\n85:   if (typeof code === \\\"string\\\" && code.trim().length > 0) {\\n86:     fields.push({ field: \\\"code\\\", value: code });\\n87:   }\\n88: \\n89:   const message = record.message;\\n90:   if (typeof message === \\\"string\\\" && message.trim().length > 0) {\\n91:     fields.push({ field: \\\"message\\\", value: message });\\n92:   }\\n93: \\n94:   const duration = record.duration_ms;\\n95:   if (typeof duration === \\\"number\\\" && Number.isFinite(duration)) {\\n96:     fields.push({ field: \\\"duration\\\", value: String(duration) });\\n97:   }\\n98: \\n99:   return fields;\\n100: }\\n101: \\n102: function rawDetailText(detail: unknown): string {\\n103:   if (detail === undefined || detail === null) return \\\"\\\";\\n104:   if (typeof detail === \\\"string\\\") return detail;\\n105:   try {\\n106:     return JSON.stringify(detail, null, 2) ?? \\\"\\\";\\n107:   } catch {\\n108:     return String(detail);\\n109:   }\\n110: }\\n111: \\n112: async function copyToClipboard(text: string): Promise<boolean> {\\n113:   try {\\n114:     if (typeof navigator !== \\\"undefined\\\" && navigator.clipboard?.writeText) {\\n115:       await navigator.clipboard.writeText(text);\\n116:       return true;\\n117:     }\\n118:   } catch {\\n119:     // fall through to the selection based fallback\\n120:   }\\n121: \\n122:   try {\\n123:     const textarea = document.createElement(\\\"textarea\\\");\\n124:     textarea.value = text;\\n125:     textarea.setAttribute(\\\"readonly\\\", \\\"true\\\");\\n126:     textarea.style.position = \\\"fixed\\\";\\n127:     textarea.style.top = \\\"0\\\";\\n128:     textarea.style.opacity = \\\"0\\\";\\n129:     document.body.appendChild(textarea);\\n130:     textarea.select();\\n131:     const copied = document.execCommand(\\\"copy\\\");\\n132:     document.body.removeChild(textarea);\\n133:     return copied;\\n134:   } catch {\\n135:     return false;\\n136:   }\\n137: }\\n138: \\n139: type CopyState = \\\"idle\\\" | \\\"copied\\\" | \\\"failed\\\";\\n140: \\n141: function FailedCheck({ check, labels }: { check: InspectionCheck; labels: InspectionLabels }) {\\n142:   const [expanded, setExpanded] = useState(false);\\n143:   const [copyState, setCopyState] = useState<CopyState>(\\\"idle\\\");\\n144: \\n145:   const fields = readDetailFields(check.detail);\\n146:   const raw = rawDetailText(check.detail);\\n147:   const fieldLabels: Record<DetailField, string> = {\\n148:     code: labels.code,\\n149:     message: labels.message,\\n150:     duration: labels.duration,\\n151:   };\\n152: \\n153:   const handleCopy = async () => {\\n154:     const text = raw.length > 0 ? `${check.name}\\\\n${raw}` : check.name;\\n155:     const copied = await copyToClipboard(text);\\n156:     setCopyState(copied ? \\\"copied\\\" : \\\"failed\\\");\\n157:   };\\n158: \\n159:   return (\\n160:     <li className=\\\"inspection-result__failed-item\\\">\\n161:       <button\\n162:         type=\\\"button\\\"\\n163:         className=\\\"inspection-result__failed-toggle\\\"\\n164:         aria-expanded={expanded}\\n165:         aria-label={`${check.name} · ${labels.failedLabel} · ${expanded ? labels.collapseReason : labels.expandReason}`}\\n166:         onClick={() => setExpanded((previous) => !previous)}\\n167:       >\\n168:         <span className=\\\"inspection-result__mark\\\" aria-hidden=\\\"true\\\">\\n169:           !\\n170:         </span>\\n171:         <span className=\\\"inspection-result__check-name\\\">{check.name}</span>\\n172:         <span className=\\\"inspection-result__failed-label\\\">{labels.failedLabel}</span>\\n173:         <span className=\\\"inspection-result__indicator\\\" aria-hidden=\\\"true\\\">\\n174:           {expanded ? \\\"▾\\\" : \\\"▸\\\"}\\n175:         </span>\\n176:       </button>\\n177:       {expanded ? (\\n178:         <div className=\\\"inspection-result__detail\\\">\\n179:           {fields.length > 0 ? (\\n180:             <dl className=\\\"inspection-result__detail-list\\\">\\n181:               {fields.map((entry) => (\\n182:                 <div key={entry.field} className=\\\"inspection-result__detail-row\\\">\\n183:                   <dt>{fieldLabels[entry.field]}</dt>\\n184:                   <dd>\\n185:                     {entry.field === \\\"duration\\\"\\n186:                       ? `${entry.value} ${labels.milliseconds}`\\n187:                       : entry.value}\\n188:                   </dd>\\n189:                 </div>\\n190:               ))}\\n191:             </dl>\\n192:           ) : null}\\n193:           {fields.length === 0 && raw.length > 0 ? (\\n194:             <pre className=\\\"inspection-result__detail-raw\\\">{raw}</pre>\\n195:           ) : null}\\n196:           <div className=\\\"inspection-result__detail-actions\\\">\\n197:             <button type=\\\"button\\\" className=\\\"inspection-result__copy\\\" onClick={handleCopy}>\\n198:               {labels.copyDetail}\\n199:             </button>\\n200:             <span className=\\\"inspection-result__copy-status\\\" role=\\\"status\\\">\\n201:               {copyState === \\\"copied\\\" ? labels.copied : null}\\n202:               {copyState === \\\"failed\\\" ? labels.copyFailed : null}\\n203:             </span>\\n204:           </div>\\n205:         </div>\\n206:       ) : null}\\n207:     </li>\\n208:   );\\n209: }\\n210: \\n211: export function InspectionResultMessage({ data }: { data: unknown }) {\\n212:   const labels = useInspectionLabels();\\n213:   const parsed = parseInspectionResult(data);\\n214: \\n215:   if (!parsed.success) {\\n216:     return (\\n217:       <p className=\\\"inspection-result inspection-result--invalid\\\" role=\\\"alert\\\">\\n218:         {labels.invalidData}\\n219:       </p>\\n220:     );\\n221:   }\\n222: \\n223:   const { target, checks } = parsed.data;\\n224:   const passed = checks.filter((check) => check.status === \\\"passed\\\");\\n225:   const failed = checks.filter((check) => check.status === \\\"failed\\\");\\n226:   const other = checks.filter(\\n227:     (check) => check.status !== \\\"passed\\\" && check.status !== \\\"failed\\\",\\n228:   );\\n229: \\n230:   return (\\n231:     <section className=\\\"inspection-result\\\" aria-label={labels.heading}>\\n232:       <header className=\\\"inspection-result__header\\\">\\n233:         <h3 className=\\\"inspection-result__heading\\\">{labels.heading}</h3>\\n234:         <p className=\\\"inspection-result__target\\\">\\n235:           <span className=\\\"inspection-result__target-label\\\">{labels.targetLabel}</span>\\n236:           <span className=\\\"inspection-result__target-value\\\">{target}</span>\\n237:         </p>\\n238:       </header>\\n239: \\n240:       {passed.length > 0 ? (\\n241:         <div className=\\\"inspection-result__group\\\">\\n242:           <p className=\\\"inspection-result__group-title\\\">\\n243:             {labels.passedHeading} · {passed.length}\\n244:           </p>\\n245:           <ul className=\\\"inspection-result__passed-list\\\">\\n246:             {passed.map((check, index) => (\\n247:               <li key={`${check.name}-${index}`} className=\\\"inspection-result__passed-item\\\">\\n248:                 <span className=\\\"inspection-result__mark\\\" aria-hidden=\\\"true\\\">\\n249:                   ✓\\n250:                 </span>\\n251:                 <span className=\\\"inspection-result__check-name\\\">{check.name}</span>\\n252:               </li>\\n253:             ))}\\n254:           </ul>\\n255:         </div>\\n256:       ) : null}\\n257: \\n258:       {failed.length > 0 ? (\\n259:         <div className=\\\"inspection-result__group\\\">\\n260:           <p className=\\\"inspection-result__group-title\\\">\\n261:             {labels.failedHeading} · {failed.length}\\n262:           </p>\\n263:           <ul className=\\\"inspection-result__failed-list\\\">\\n264:             {failed.map((check, index) => (\\n265:               <FailedCheck key={`${check.name}-${index}`} check={check} labels={labels} />\\n266:             ))}\\n267:           </ul>\\n268:         </div>\\n269:       ) : null}\\n270: \\n271:       {other.length > 0 ? (\\n272:         <div className=\\\"inspection-result__group\\\">\\n273:           <p className=\\\"inspection-result__group-title\\\">\\n274:             {labels.otherHeading} · {other.length}\\n275:           </p>\\n276:           <ul className=\\\"inspection-result__other-list\\\">\\n277:             {other.map((check, index) => (\\n278:               <li key={`${check.name}-${index}`} className=\\\"inspection-result__other-item\\\">\\n279:                 <span className=\\\"inspection-result__check-name\\\">{check.name}</span>\\n280:                 <span className=\\\"inspection-result__other-status\\\">{check.status}</span>\\n281:               </li>\\n282:             ))}\\n283:           </ul>\\n284:         </div>\\n285:       ) : null}\\n286:     </section>\\n287:   );\\n288: }\\n289: \",\"hash\":\"d007ebf176d3ab39cea4e0f16427f9f85d62015df48d089c38d7ed74941f4dea\",\"totalLines\":289,\"nextOffset\":null}}","role":"tool"}

