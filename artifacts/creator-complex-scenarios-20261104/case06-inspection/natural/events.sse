data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-aecfd61da6ecd390","messageId":"1a6c5301-8e17-4507-aeed-d772d3762ceb","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"2. 编写解析函数并配置事件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"sectionId\":\"s34\",\"offset\":0,\"totalCharacters\":840,\"content\":\"## 2. 编写解析函数并配置事件\\n\\n新建 `plugins/ticket-summary-message/schema.ts`，校验数据并转换字段：\\n\\n```ts\\nimport { z } from 'zod';\\n\\nexport const TICKET_SUMMARY_EVENT = 'app.ticket.summary';\\n\\nexport const ticketSummarySchema = z.object({\\n  ticket_id: z.string().min(1),\\n  title: z.string().min(1),\\n}).transform(value => ({\\n  ticketId: value.ticket_id,\\n  title: value.title,\\n}));\\n\\nexport function parseTicketSummary(data: unknown) {\\n  return ticketSummarySchema.safeParse(data);\\n}\\n```\\n\\n在使用 `Agent` 的页面（例如 `src/App.tsx`）传入事件配置：\\n\\n```tsx\\nimport { Agent } from './agent-ui';\\nimport { TICKET_SUMMARY_EVENT, ticketSummarySchema } from './agent-ui/plugins/ticket-summary-message/schema';\\n\\nconst appEventSchemas = { [TICKET_SUMMARY_EVENT]: ticketSummarySchema };\\n\\nexport function App() {\\n  return <Agent appEventSchemas={appEventSchemas} />;\\n}\\n```\\n\\n消息组件仍需调用解析函数处理收到的原始数据。\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"chatcmpl-tool-a1f93075d61f15ac","toolCallName":"read_creator_documentation"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-a1f93075d61f15ac","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s71\"}"}

data: {"type":"TOOL_CALL_END","toolCallId":"chatcmpl-tool-a1f93075d61f15ac"}

data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-a1f93075d61f15ac","messageId":"70a7b460-eca7-43a8-a829-3eca3eea41fa","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"3. 编写消息组件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"sectionId\":\"s71\",\"offset\":0,\"totalCharacters\":941,\"content\":\"## 3. 编写消息组件\\n\\n新建同目录的 `index.tsx`，放入组件和中英文文案：\\n\\n```tsx\\nimport { defineDataMessageUI, useAgentUILocaleCode } from '@za38.03/agent-ui-plugins';\\nimport { TICKET_SUMMARY_EVENT, parseTicketSummary } from './schema';\\n\\nconst messages = {\\n  'zh-CN': { heading: '工单摘要', invalid: '工单数据格式不正确。' },\\n  'en-US': { heading: 'Ticket summary', invalid: 'Invalid ticket data.' },\\n};\\n\\nexport function TicketSummaryMessage({ data }: { data: unknown }) {\\n  const labels = messages[useAgentUILocaleCode()];\\n  const result = parseTicketSummary(data);\\n  if (!result.success) return <p role=\\\"alert\\\">{labels.invalid}</p>;\\n\\n  return <section aria-label={labels.heading}>\\n    <h3>{labels.heading}</h3>\\n    <p>{result.data.ticketId}：{result.data.title}</p>\\n  </section>;\\n}\\n\\nexport const ticketSummaryUI = defineDataMessageUI<unknown>({\\n  name: TICKET_SUMMARY_EVENT,\\n  render: TicketSummaryMessage,\\n});\\n```\\n\\n这里的 `name` 必须与后端事件名一致。组件通过 `parseTicketSummary(data)` 取得解析结果后渲染。\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"chatcmpl-tool-ae42c06c79f0d6ad","toolCallName":"read_creator_documentation"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-ae42c06c79f0d6ad","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s103\"}"}

