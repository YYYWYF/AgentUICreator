ng; scrollToBottom: string; welcome: string; working: string; moreActions: string; exportMarkdown: string; reasoning: string; reasoningDuration: string; editCancel: string\",\"truncated\":true},{\"name\":\"threadList\",\"type\":\"Partial<{ historyTitle: string; retry: string; newChat: string; moreOptions: string; running: string; rename: string; archive: string; unarchive: string; archived: string; delete: string; loading: string; ... 8 more ...; earlier: string; }>\",\"truncated\":true},{\"name\":\"serviceAdapters\",\"type\":\"Partial<{ requestFailed: string; invalidResponse: string; invalidUploadUrl: string; invalidConfig: string; fileTypeRejected: string; fileTooLarge: string; dictationFailed: string; recordingUnavailable: string; }> | undefined\",\"truncated\":false},{\"name\":\"attachments\",\"type\":\"Partial<{ previewNamed: string; removeNamed: string; tileNamed: string; named: string; namedUploading: string; namedFailed: string; preview: string; previewFailed: string; imagePreview: string; ... 12 more ...; demoReadFailed: string; }> | \",\"truncated\":true},{\"name\":\"images\",\"type\":\"Partial<{ content: string; newTab: string; preview: string; zoom: string; zoomed: string; closeZoom: string; generating: string; generationFailed: string; regenerate: string; download: string; copy: string; blocked: string; }> | undefined\",\"truncated\":false},{\"name\":\"quote\",\"type\":\"Partial<{ quote: string; dismiss: string; }> | undefined\",\"truncated\":false},{\"name\":\"tasks\",\"type\":\"Partial<{ title: string; running: string; waiting: string; failed: string; done: string; working: string; waitingState: string; failedState: string; childFailed: string; doneState: string; cancelledState: string; ... 7 more ...; groupFailed\",\"truncated\":true},{\"name\":\"triggers\",\"type\":\"Partial<{ noItems: string; noResults: string; suggestions: string; back: string; empty: string; loading: string; searchFailed: string; retry: string; commandFailed: string; invalidItem: string; items: string; }> | undefined\",\"truncated\":false},{\"name\":\"accessibility\",\"type\":\"Partial<{ sidebar: string; sidebarDescription: string; toggleSidebar: string; language: string; chineseName: string; englishName: string; }> | undefined\",\"truncated\":false},{\"name\":\"searchTools\",\"type\":\"Partial<{ searching: string; sources: string; retrieving: string; passages: string; relevance: string; score: string; contextKnowledgeBase: string; contextLongTermMemory: string; contextCount: string; contextQuery: string; contextEmpty: str\",\"truncated\":true},{\"name\":\"search\",\"type\":\"Partial<{ searching: string; readSources: string; searchFiles: string; searchedFiles: string; noFiles: string; oneFile: string; manyFiles: string; }> | undefined\",\"truncated\":false},{\"name\":\"examples\",\"type\":\"Partial<{ hostAnalyzeButton: string; hostAnalyzePrompt: string; hostCloseAssistant: string; hostOpenAssistant: string; hostSendFailed: string; presentationEditor: string; presentationDocument: string; ... 85 more ...; embeddedAssistant: str\",\"truncated\":true},{\"name\":\"runtime\",\"type\":\"Partial<{ pluginRenderFailed: string; assistant: string; openAssistant: string; closeAssistant: string; startupFailed: string; unknownGateError: string; gateCannotRender: string; pluginNotifications: string; ... 5 more ...; missingInstance:\",\"truncated\":true},{\"name\":\"themeShowcase\",\"type\":\"Partial<{ title: string; theme: string; light: string; dark: string; violet: string; welcome: string; welcomeText: string; user: string; assistant: string; composer: string; send: string; stop: string; primary: string; ... 26 more ...; resu\",\"truncated\":true},{\"name\":\"media\",\"type\":\"Partial<{ audio: string; video: string; play: string; pause: string; seek: string; position: string; audioError: string; }> | undefined\",\"truncated\":false},{\"name\":\"files\",\"type\":\"Partial<{ unnamed: string; download: string; }> | undefined\",\"truncated\":false}],\"membersTruncated\":true,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"p27\",\"pluginId\":\"inspection-result-message\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":5,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p27\"}],\"manifest\":{\"id\":\"inspection-result-message\",\"name\":\"Inspection Result Message\",\"description\":\"Renders system inspection results carried by the app.inspection.result CUSTOM event.\",\"version\":\"0.0.1\",\"data\":{\"messageUI\":true},\"authoring\":{\"intents\":[\"render inspection results inside assistant messages\"]}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { InspectionResultMessage } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      // Static literal required: the registry generator reads this name at build time.\\n      name: \\\"app.inspection.result\\\",\\n      render: InspectionResultMessage,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":692},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/inspection-result-message/definition.ts\",\"kind\":\"file\",\"bytes\":692},{\"path\":\"src/agent-ui/plugins/inspection-result-message/index.tsx\",\"kind\":\"file\",\"bytes\":9414},{\"path\":\"src/agent-ui/plugins/inspection-result-message/manifest.json\",\"kind\":\"file\",\"bytes\":350},{\"path\":\"src/agent-ui/plugins/inspection-result-message/schema.ts\",\"kind\":\"file\",\"bytes\":768},{\"path\":\"src/agent-ui/plugins/inspection-result-message/styles.css\",\"kind\":\"file\",\"bytes\":4073}],\"filesTruncated\":false}}","role":"tool"}

