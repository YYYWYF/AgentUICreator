data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-bf762dffd5dc7bda","messageId":"7f181cb5-9ceb-475a-925f-565f883c955a","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"totalSections\":6,\"offset\":0,\"sections\":[{\"sectionId\":\"s1\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"level\":1,\"characters\":3444,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s17\",\"title\":\"1. 让 Agent 返回事件\",\"level\":2,\"characters\":219,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s34\",\"title\":\"2. 编写解析函数并配置事件\",\"level\":2,\"characters\":840,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\"}}},{\"sectionId\":\"s71\",\"title\":\"3. 编写消息组件\",\"level\":2,\"characters\":941,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s103\",\"title\":\"4. 注册并启用插件\",\"level\":2,\"characters\":943,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s103\"}}},{\"sectionId\":\"s149\",\"title\":\"5. 检查结果\",\"level\":2,\"characters\":187,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s149\"}}}],\"nextOffset\":null}}","role":"tool"}

