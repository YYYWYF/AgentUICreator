data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-88b5ef658218894b","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":8000,\"offset\":0,\"sectionId\":\"s103\"}"}

