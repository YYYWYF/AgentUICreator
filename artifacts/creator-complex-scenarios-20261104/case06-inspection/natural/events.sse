data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-acaac8db90a4f163","messageId":"7fb78b55-377a-4170-ab28-63849c7bc848","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/composer/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode, useConversationComposer } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { ConversationComposerPlugin as Composer } from \\\"@za38.03/agent-ui-plugins/composer\\\";\\n3: import type { ComponentProps } from \\\"react\\\";\\n4: \\n5: const MAX_COMPOSER_LENGTH = 200;\\n6: \\n7: /** Project-owned counter messages keyed by the unified Agent UI locale code. */\\n8: const composerCounterMessages = {\\n9:   \\\"zh-CN\\\": { limitReached: \\\"已达到字数上限\\\" },\\n10:   \\\"en-US\\\": { limitReached: \\\"Character limit reached\\\" },\\n11: } as const;\\n12: \\n13: export function ConversationComposerPlugin(props: ComponentProps<typeof Composer>) {\\n14:   const { inputProps, ...rest } = props;\\n15:   const { text } = useConversationComposer();\\n16:   const localeCode = useAgentUILocaleCode();\\n17:   const usedLength = text.length;\\n18:   const atLimit = usedLength >= MAX_COMPOSER_LENGTH;\\n19:   const messages = composerCounterMessages[localeCode];\\n20: \\n21:   return (\\n22:     <div className=\\\"aui-composer-counter-root\\\">\\n23:       <Composer {...rest} inputProps={{ ...inputProps, maxLength: MAX_COMPOSER_LENGTH }} />\\n24:       <div className=\\\"aui-composer-counter\\\" data-at-limit={atLimit}>\\n25:         <span className=\\\"aui-composer-counter-value\\\">\\n26:           {usedLength}/{MAX_COMPOSER_LENGTH}\\n27:         </span>\\n28:         {atLimit ? (\\n29:           <span className=\\\"aui-composer-counter-limit\\\" role=\\\"status\\\">\\n30:             {messages.limitReached}\\n31:           </span>\\n32:         ) : null}\\n33:       </div>\\n34:     </div>\\n35:   );\\n36: }\\n37: \",\"hash\":\"3f03d21bea33f4ffae5411031d32e109fb84112d16e4aeeb0e79dd05d367d1f0\",\"totalLines\":37,\"nextOffset\":null}}","role":"tool"}

