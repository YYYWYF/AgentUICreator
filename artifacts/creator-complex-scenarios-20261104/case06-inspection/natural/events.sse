data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-bc514b3c8d7a242c","messageId":"e70e602d-44a5-4726-893c-308440df0cc3","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/inspection-result-message/schema.ts\",\"content\":\"1: import { z } from \\\"zod\\\";\\n2: \\n3: /** Exact AG-UI CUSTOM event name produced by the backend inspection run. */\\n4: export const INSPECTION_RESULT_EVENT = \\\"app.inspection.result\\\";\\n5: \\n6: export const inspectionCheckSchema = z.object({\\n7:   name: z.string().min(1),\\n8:   status: z.string().min(1),\\n9:   detail: z.unknown().optional(),\\n10: });\\n11: \\n12: export const inspectionResultSchema = z.object({\\n13:   target: z.string().min(1),\\n14:   checks: z.array(inspectionCheckSchema),\\n15: });\\n16: \\n17: export type InspectionCheck = z.infer<typeof inspectionCheckSchema>;\\n18: export type InspectionResult = z.infer<typeof inspectionResultSchema>;\\n19: \\n20: /** Validate the event payload without inventing fields the backend may not send. */\\n21: export function parseInspectionResult(data: unknown) {\\n22:   return inspectionResultSchema.safeParse(data);\\n23: }\\n24: \",\"hash\":\"d959a7ce273e8e90c392185ff32ecff7376f82956a9bc54be96fae5d746d8f96\",\"totalLines\":24,\"nextOffset\":null}}","role":"tool"}

