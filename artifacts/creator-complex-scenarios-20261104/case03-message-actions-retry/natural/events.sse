tId\":\"public:development/layout-and-composition\",\"sectionId\":\"s77\"}}},{\"sectionId\":\"s168\",\"title\":\"启停与实例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s168\"}}},{\"sectionId\":\"s132\",\"title\":\"插件放置与组合\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s132\"}}}]},{\"documentId\":\"public:plugins/default-plugins\",\"title\":\"插件默认启用情况\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/default-plugins.md\",\"summary\":\"查看三种模板中默认启用和按需启用的官方插件。\",\"sha256\":\"50271d5039236a45132b9e1afa0542984f5ef7af25f719afa9efa40b51bbd40b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/default-plugins\"}},\"matchingSections\":[{\"sectionId\":\"s31\",\"title\":\"回复操作\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/default-plugins\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s17\",\"title\":\"消息输入与编辑\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/default-plugins\",\"sectionId\":\"s17\"}}}]},{\"documentId\":\"public:plugins/response-footer\",\"title\":\"回复操作栏（response-footer）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/response-footer.md\",\"summary\":\"同一次回复即使分成多段，也只在最后显示一组操作。具体显示哪些按钮，由项目选择的操作插件决定。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"8155c7a2ea647b09e7054de469971bc388a08c50f673e69198f80b1c9b008b1d\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/response-footer\"}},\"matchingSections\":[{\"sectionId\":\"s26\",\"title\":\"需求示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":