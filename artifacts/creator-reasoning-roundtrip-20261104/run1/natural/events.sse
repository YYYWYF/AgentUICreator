"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]}}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"emptySuggestions\"},\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p10\",\"pluginId\":\"conversation-suggestions\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"emptyWelcome\"},\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"headerActions\"},\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"reasoningGroup\"},\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p15\",\"pluginId\":\"reasoning\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"taskGroup\"},\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"thinkingIndicator\"},\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolFallback\"},\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p17\",\"pluginId\":\"tool-result\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolGroup\"},\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p16\",\"pluginId\":\"tool-group\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolTimeline\"},\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"transientMessages\"},\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p22\",\"pluginId\":\"transient-assistant-messages\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"userEditComposer\"},\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"beforeInput\"},\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p11\",\"pluginId\":\"composer\"},\"plugins\":[{\"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"input\"},\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p11\",\"pluginId\":\"composer\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"leadingActions\"},\"description\":\"Inline actions displayed on the leading side of the c