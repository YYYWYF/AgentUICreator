data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_lnIA14vJmPhdoN4Ssbmp1568","delta":"{\"path\":\"/src/agent-ui/hooks/useQuickHelpCardExpanded.ts\",\"content\":\"import { useSyncExternalStore } from \\\"react\\\";\\n\\n/**\\n * Shared expansion state for the quick help card.\\n *\\n * The card itself and the actions placed in its `headerActions` slot are\\n * separate Plugin instances, so the state lives in one tiny project-owned\\n * store outside React. Theme switching only re-renders the tree, the module\\n * (and therefore this state) keeps its value.\\n */\\nlet expanded = true;\\nconst listeners = new Set<() => void>();\\n\\nfunction subscribe(listener: () => void): () => void {\\n  listeners.add(listener);\\n  return () => {\\n    listeners.delete(listener);\\n  };\\n}\\n\\nfunction getSnapshot(): boolean {\\n  return expanded;\\n}\\n\\nfunction notify(): void {\\n  for (const listener of listeners) {\\n    listener();\\n  }\\n}\\n\\nexport function setQuickHelpCardExpanded(next: boolean): void {\\n  if (expanded === next) {\\n    return;\\n  }\\n  expanded = next;\\n  notify();\\n}\\n\\nexport function toggleQuickHelpCardExpanded(): void {\\n  setQuickHelpCardExpanded(!expanded);\\n}\\n\\n/** Collapse the card body, e.g. from a \\\"知道了\\\" header action. */\\nexport function collapseQuickHelpCard(): void {\\n  setQuickHelpCardExpanded(false);\\n}\\n\\n/** Read the current expansion state outside React. */\\nexport function getQuickHelpCardExpanded(): boolean {\\n  return expanded;\\n}\\n\\n/** Subscribe a component to the shared expansion state. */\\nexport function useQuickHelpCardExpanded(): boolean {\\n  return useSyncExternalStore(subscribe, getSnapshot, getSnapshot);\\n}\\n\"}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_00_lnIA14vJmPhdoN4Ssbmp1568"}

data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_lnIA14vJmPhdoN4Ssbmp1568","messageId":"ce2fd198-bb3a-4729-89b0-4ffb836975f7","content":"{\"ok\":true,\"result\":{\"path\":\"src/agent-ui/hooks/useQuickHelpCardExpanded.ts\",\"revision\":1}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"chatcmpl-tool-a89221ec5fe31478","toolCallName":"mutate_ui_plugin_source"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-a89221ec5fe31478","delta":"{\"pluginId\":\"quick-help-card\",\"changes\":[{\"type\":\"edit\",\"relativePath\":\"index.tsx\",\"edits\":[{\"oldText\":\"import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { useId, useState } from \\\"react\\\";\",\"newText\":\"import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { useId } from \\\"react\\\";\\nimport {\\n  toggleQuickHelpCardExpanded,\\n  useQuickHelpCardExpanded,\\n} from \\\"../../hooks/useQuickHelpCardExpanded\\\";\"},{\"oldText\":\"  const [expanded, setExpanded] = useState(true);\",\"newText\":\"  // Shared with header actions such as the \\\"知道了\\\" action, so both plugins\\n  // control the same expansion state and it survives theme switching.\\n  const expanded = useQuickHelpCardExpanded();\"},{\"oldText\":\"          onClick={() => setExpanded((value) => !value)}\",\"newText\":\"          onClick={toggleQuickHelpCardExpanded}\"}]}]}"}

data: {"type":"TOOL_CALL_END","toolCallId":"chatcmpl-tool-a89221ec5fe31478"}

