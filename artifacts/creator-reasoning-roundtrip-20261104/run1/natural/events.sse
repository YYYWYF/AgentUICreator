data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_OudkkVre87i3pZ8WfUWD8062","messageId":"f1bf5ec0-e7a9-4015-bf2b-bedb1fa751c2","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/help-dismiss-action/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import {\\n3:   collapseQuickHelpCard,\\n4:   useQuickHelpCardExpanded,\\n5: } from \\\"../../hooks/useQuickHelpCardExpanded\\\";\\n6: import \\\"./styles.css\\\";\\n7: \\n8: const messages: Record<string, string> = {\\n9:   \\\"zh-CN\\\": \\\"知道了\\\",\\n10:   \\\"en-US\\\": \\\"Got it\\\",\\n11: };\\n12: \\n13: export function HelpDismissActionPlugin() {\\n14:   const localeCode = useAgentUILocaleCode();\\n15:   const expanded = useQuickHelpCardExpanded();\\n16:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n17: \\n18:   // Nothing to dismiss once the body is collapsed; the card title expands it again.\\n19:   if (!expanded) {\\n20:     return null;\\n21:   }\\n22: \\n23:   return (\\n24:     <button\\n25:       type=\\\"button\\\"\\n26:       className=\\\"help-dismiss-action\\\"\\n27:       onClick={collapseQuickHelpCard}\\n28:     >\\n29:       {text}\\n30:     </button>\\n31:   );\\n32: }\\n33: \",\"hash\":\"e57f5e62a74641dce27d59f947d581dec59108fdb3654270f4d20d15a9387e6c\",\"totalLines\":33,\"nextOffset\":null}}","role":"tool"}

