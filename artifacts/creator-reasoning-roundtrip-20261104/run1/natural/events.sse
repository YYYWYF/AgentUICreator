\":true}]}}]},{\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l11\"},\"nodeRef\":\"l11\",\"plugins\":[{\"id\":\"p9\",\"pluginId\":\"conversation-surface\",\"enabled\":true,\"slots\":{\"emptySuggestions\":[{\"id\":\"p10\",\"pluginId\":\"conversation-suggestions\",\"enabled\":true}],\"composer\":[{\"id\":\"p11\",\"pluginId\":\"composer\",\"enabled\":true,\"slots\":{\"leadingActions\":[{\"id\":\"p12\",\"pluginId\":\"add-attachment-action\",\"enabled\":true}],\"submitAction\":[{\"id\":\"p13\",\"pluginId\":\"submit-action\",\"enabled\":true}],\"beforeInput\":[{\"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]}}],\"reasoningGroup\":[{\"id\":\"p15\",\"pluginId\":\"reasoning\",\"enabled\":true}],\"toolGroup\":[{\"id\":\"p16\",\"pluginId\":\"tool-group\",\"enabled\":true}],\"toolFallback\":[{\"id\":\"p17\",\"pluginId\":\"tool-result\",\"enabled\":true}],\"assistantResponseFooter\":[{\"id\":\"p18\",\"pluginId\":\"response-footer\",\"enabled\":true,\"slots\":{\"actions\":[{\"id\":\"p19\",\"pluginId\":\"copy-action\",\"enabled\":true},{\"id\":\"p20\",\"pluginId\":\"reload-action\",\"enabled\":true},{\"id\":\"p21\",\"pluginId\":\"export-markdown-action\",\"enabled\":true}]}}],\"transientMessages\":[{\"id\":\"p22\",\"pluginId\":\"transient-assistant-messages\",\"enabled\":true}]}}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"headerActions\"},\"description\":\"Optional conversation navigation actions displayed above search and history.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-create\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p7\",\"pluginId\":\"conversation-thread-list\"},\"plugins\":[{\"id\":\"p8\",\"pluginId\":\"conversation-new\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"body\"},\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p24\",\"pluginId\":\"quick-help-card\"},\"plugins\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"headerActions\"},\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p24\",\"pluginId\":\"quick-help-card\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"assistantResponseFooter\"},\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p18\",\"pluginId\":\"response-footer\",\"enabled\":true,\"slots\":{\"actions\":[{\"id\":\"p19\",\"pluginId\":\"copy-action\",\"enabled\":true},{\"id\":\"p20\",\"pluginId\":\"reload-action\",\"enabled\":true},{\"id\":\"p21\",\"pluginId\":\"export-markdown-action\",\"enabled\":true}]}}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"composer\"},\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p11\",\"pluginId\":\"composer\",\"enabled\":true,\"slots\":{\"leadingActions\":[{\"id\":\"p12\",\"pluginId\":\"add-attachment-action\",\"enabled\":true}],\"submitAction\":[{\"id\":\"p13\",\"pluginId\":\"submit-action\",\"enabled\":true}],\"beforeInput\":[{\"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]}}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"emptySuggestions\"},\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p10\",\"pluginId\":\"conversation-suggestions\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"emptyWelcome\"},\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"headerActions\"},\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"reasoningGroup\"},\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p15\",\"pluginId\":\"reasoning\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"taskGroup\"},\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"thinkingIndicator\"},\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolFallback\"},\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p17\",\"pluginId\":\"tool-result\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolGroup\"},\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p16\",\"pluginId\":\"tool-group\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolTimeline\"},\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"transientMessages\"},\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p22\",\"pluginId\":\"transient-assistant-messages\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"userEditComposer\"},\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p9\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"beforeInput\"},\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p11\",\"pluginId\":\"composer\"},\"plugins\":[{\"id\":\"p14\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"input\"},\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p11\",\"pluginId\":\"composer\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"leadingActions\"},\"description\":\"Inline actions displayed on the leading side of the c