s\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"agent-plan-message\",\"name\":\"Agent Plan\",\"description\":\"Renders authoritative AG-UI agent-plan activity in assistant messages.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render agent plan in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"agent-status-message\",\"name\":\"Agent Status\",\"description\":\"Renders mock_agent_status tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render agent status in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"ask-user-question\",\"name\":\"Ask User Question\",\"description\":\"Collect structured choices or text answers inside the conversation.\",\"capabilities\":[\"human-input\",\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"ask the user to choose options or provide text before continuing\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"auth-account\",\"name\":\"Account\",\"description\":\"Account\",\"capabilities\":[\"account\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add login authentication\",\"给 Agent 加上登录功能\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"auth.session\",\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"auth-gate\",\"name\":\"Authentication Gate\",\"description\":\"Authentication Gate\",\"capabilities\":[\"authentication\",\"plugin-service-provider\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add login authentication\",\"给 Agent 加上登录功能\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"chart-message\",\"name\":\"Chart Message\",\"description\":\"Renders named chart data inside assistant messages.\",\"capabilities\":[],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render structured chart data in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"composer\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/composer\",\"component\":\"ConversationComposerPlugin\",\"facts\":{\"presentation\":\"The editable text field is a textarea by default. data-slot=aui_composer-input is its containing div; data-slot=aui_composer-shell is the outer surface containing input and actions. Container height is distinct from editable field height.\",\"composition\":\"The public component prop type is ConversationCanonicalComposerProps, exported from @za38.03/agent-ui-plugins. The /composer entry exports the Plugin component. inputProps forwards textarea props including rows, style, className and onChange; preserve existing handlers. Other root props configure the outer form. Root rows and maxLength configure the default textarea; a defined root maxLength wins over inputProps.maxLength. The input prop replaces the default input; inspect an existing replacement before changing it. For a live character count that follows typing, send and programmatic clears, query useConversationComposer from the public root module and observe its text; this hook uses the existing canonical Composer and does not create a Runtime. The default shell is a column: input and aui_composer-actions are separate children; the actions row contains leading/trailing actions, with submitAction in trailing-actions.\",\"interaction\":\"A direct placeholder prop overrides composer.placeholder, including Host locale overrides; a fixed string also persists when the locale changes. Generated Agent accepts locales with per-locale overrides, for example zh-CN and en-US entries containing composer.placeholder; preserve existing Host overrides when adding project defaults. The public useAgentUILocale('composer') reads this shared namespace, and useAgentUILocaleCode() reads the same current locale. Custom project business labels may use a small project-owned en-US/zh-CN message dictionary selected by that unified locale code; do not create another language state/Context or add fields to the closed npm AgentUILocaleMessages type. Keep the existing Composer and its native event handlers.\",\"styles\":\"inputProps.style.minHeight sizes the textarea, not the shell. Project CSS may target [data-slot=aui_composer-input] textarea. The package's styled outer shell uses :is(.agent-ui-root, .agent-ui-conversation)[data-theme] [data-slot=\\\"aui_composer-shell\\\"] with border-radius:18px; :hover and :focus-within add border/shadow rules. A bare [data-slot=\\\"aui_composer-shell\\\"] override has lower specificity and can lose even when imported later. Use that full scoped selector and corresponding focus state in later project CSS for radius/border overrides, then inspect computed borderRadius/borderColor in the actual Host. Button wrapping belongs to the actions row and leading/trailing action groups; flex-basis on a child of the column shell can instead change input height. Preserve textarea, attachments and submit behavior.\"}},\"name\":\"Conversation Composer\",\"description\":\"Renders the canonical Agent UI conversation composer with composable action Slots.\",\"capabilities\":[\"conversation-composer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p11\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"composer\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary conversation composer\",\"compose conversation input actions\"],\"visualRole\":\"conversation composer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"composer\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"beforeInput\":{\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]}},\"input\":{\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]}},\"leadingActions\":{\"description\":\"Inline actions displayed on the leading side of the composer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-leading-action\",\"conversation-composer-trailing-action\"]}},\"submitAction\":{\"description\":\"The primary send or stop action for the composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-submit-action\"]}},\"trailingActions\":{\"description\":\"Inline actions displayed before the composer submit action.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trailing-action\",\"conversation-composer-leading-action\"]}},\"triggers\":{\"description\":\"Optional conversation input triggers.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trigger\"]}}}},{\"pluginId\":\"context-retrieval-message\",\"name\":\"Context Retrieval Message\",\"description\":\"Renders context retrieval results carried by AG-UI CUSTOM events.\",\"capabilities\":[],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p4\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":4}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render context retrieval results inside assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-command-source\",\"name\":\"Conversation Command Source\",\"description\":\"Provides project-owned slash commands through the existing Plugin Service lifecycle.\",\"capabilities\":[\"headless\",\"plugin-service-provider\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"Provide frontend conversation commands\"],\"cleanup\":{\"removeWhenUnused\":true}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-data-source\",\"name\":\"Conversation Data Source\",\"description\":\"Provides conversation history data through an application-owned API.\",\"capabilities\":[\"headless\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p0\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide persistent conversation history data to conversation capabilities\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-new\",\"name\":\"New Conversation\",\"description\":\"Starts a new conversation independently of history management.\",\"capabilities\":[\"conversation-create\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p8\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"headerActions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"start a new conversation\"],\"visualRole\":\"conversation header action\"},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-quote\",\"name\":\"Conversation Quote\",\"description\":\"Quote assistant passages with an optional composer preview and selection toolbar. Sent quotes remain conversation history.\",\"capabilities\":[\"conversation-composer-before-input\",\"conversation-quote\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p14\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"beforeInput\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"quote part of an assistant response\",\"reply to a specific passage\",\"引用回答中的一段内容\",\"加上引用功能\"],\"visualRole\":\"conversation quote creation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"beforeInput\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-service\",\"name\":\"Conversation Service\",\"description\":\"Provides shared application conversation state and history navigation independently from presentation plugins.\",\"capabilities\":[\"conversation-service\",\"headless\",\"plugin-service-provider\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p1\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":1}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide shared conversation management state and history navigation\"]},\"requiredServices\":{\"names\":[\"agent-ui.conversation-data-source\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-suggestions\",\"name\":\"Conversation Suggestions\",\"description\":\"Renders starter prompts through the Conversation public surface.\",\"capabilities\":[\"conversation-suggestions\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p10\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"emptySuggestions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show starter prompts and suggested conversation actions\"],\"visualRole\":\"conversation empty-state suggestions\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"emptySuggestions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-surface\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/conversation-surface\",\"component\":\"ConversationSurfacePlugin\",\"facts\":{\"presentation\":\"The canonical empty conversation centers its welcome content and composer. A populated conversation pins its viewport footer toward the bottom. Resizing the outer AppUIModel track alone does not change this internal empty-state alignment.\",\"composition\":\"Keep the existing canonical Conversation Adapter, renderer slots and Composer. Layout changes inside this surface belong in project application composition or scoped CSS, without replacing the Runtime or adding component props to AppUIModel.\",\"styles\":\"The internal content has data-slot=agent-ui-thread-content and flex:1 with a column layout; the composer container has class aui-thread-viewport-footer. To keep the composer at the bottom even in an empty conversation, project CSS can override the content's justify-content and give its footer margin-top:auto. Scope selectors to this conversation surface and verify the actual desktop and narrow Host, including overflow, welcome content and messages.\"}},\"name\":\"Conversation Surface\",\"description\":\"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\"capabilities\":[\"conversation-surface\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p9\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l11\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary live and historical conversation experience\"],\"visualRole\":\"primary conversation surface\",\"recommendedSize\":{\"width\":\"minmax(0, 1fr)\"}},\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"childSlots\":{\"assistantResponseFooter\":{\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]}},\"composer\":{\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]}},\"emptySuggestions\":{\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]}},\"emptyWelcome\":{\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"optional\":true},\"headerActions\":{\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]}},\"reasoningGroup\":{\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]}},\"taskGroup\":{\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]}},\"thinkingIndicator\":{\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]}},\"toolFallback\":{\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]}},\"toolGroup\":{\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]}},\"toolTimeline\":{\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]}},\"transientMessages\":{\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]}},\"userEditComposer\":{\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]}}}},{\"pluginId\":\"conversation-thread-list\",\"name\":\"Conversation Thread List\",\"description\":\"Uses the public Conversation thread list with AgentUICreator policy and data binding.\",\"capabilities\":[\"conversation-history\",\"conversation-selection\",\"plugin-service-consumer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p7\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l4\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add conversation management\",\"browse conversation history\",\"select an existing conversation\"],\"visualRole\":\"conversation navigation\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"before\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"width\":\"280px\"}},\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"sidebar\":{\"icon\":\"messages-square\",\"labels\":{\"en-US\":\"History\",\"zh-CN\":\"历史会话\"}},\"childSlots\":{\"headerActions\":{\"description\":\"Optional conversation navigation actions displayed above search and history.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-create\"]}}}},{\"pluginId\":\"copy-action\",\"name\":\"Conversation Copy Action\",\"description\":\"Copies text from the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p19\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p18\",\"slot\":\"actions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"copy assistant response content\"],\"visualRole\":\"assistant response copy action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"dictation-action\",\"name\":\"Conversation Dictation Action\",\"description\":\"Adds Agent UI dictation controls to the conversation composer.\",\"capabilities\":[\"conversation-composer-trailing-action\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add voice dictation to the conversation composer\"],\"visualRole\":\"conversation composer dictation action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"trailingActions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"export-markdown-action\",\"name\":\"Conversation Export Markdown Action\",\"description\":\"Renders More with a Markdown export item for the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p21\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p18\",\"slot\":\"actions\"},\"index\":2}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"export an assistant response as Markdown\"],\"visualRole\":\"assistant response Markdown export action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"feedback-actions\",\"name\":\"Conversation Feedback Actions\",\"description\":\"Submits helpful or not helpful feedback for the response tail.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"rate assistant response\"],\"visualRole\":\"assistant response feedback actions\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"generated-file-message\",\"name\":\"Generated File\",\"description\":\"Renders successful generate_file backend results with the official File element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render generated file tool results in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"job-progress-message\",\"name\":\"Job Progress\",\"description\":\"Renders run_ci_job tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render job progress in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-composer-input\",\"name\":\"Conversation Lexical Composer Input\",\"description\":\"Optional plain text input with atomic directive chips.\",\"capabilities\":[\"conversation-composer-input\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show atomic mention and command chips in the composer\"],\"visualRole\":\"conversation input\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"input\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-edit-composer\",\"name\":\"Conversation Lexical Edit Composer\",\"description\":\"Rich editing of existing directives in historical user messages.\",\"capabilities\":[\"conversation-user-edit-composer-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show atomic directive chips when editing historical messages\"],\"visualRole\":\"historical message edit composer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"userEditComposer\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/locale-provider\",\"component\":\"LocaleProviderPlugin\",\"facts\":{\"presentation\":\"Generated Agent applications and createAgentUILocaleService() default to zh-CN. Standalone presentation components without the generated Runtime bridge default to en-US. The supported locale codes are zh-CN and en-US; do not search protected implementation source to infer the generated default.\",\"composition\":\"Keep the existing locale-provider service and Runtime locale bridge. Agent locale is controlled, defaultLocale initializes an uncontrolled instance, onLocaleChange observes selection, and locales supplies per-locale partial message overrides. For example, locales['zh-CN'].composer.placeholder customizes the existing Chinese input hint. Supply the English counterpart. Merge project defaults and Host overrides at both locale and domain-field levels: spreading locales only at the top level replaces entire locale dictionaries, losing project defaults when the Host overrides an unrelated domain. Host values win for the exact fields they supply. LocaleProviderPlugin itself only renders children, with no locale/message props.\",\"interaction\":\"The public useAgentUILocale(namespace) reads existing shared domain messages; useAgentUILocaleCode() reads the same current code. For custom project business messages use a small en-US/zh-CN project dictionary keyed by that unified code, without another language state or Context. AgentUILocaleMessages and Overrides describe the package's existing namespaces; unrelated new business keys do not require extending those closed npm types.\"}},\"name\":\"Headless Locale Service Provider\",\"description\":\"Provides the shared application locale service to UI plugins.\",\"capabilities\":[\"headless\",\"locale\",\"plugin-service-provider\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p3\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":3}],\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-switch\",\"name\":\"Locale Switch\",\"description\":\"Selects the application language through the shared locale service.\",\"capabilities\":[\"locale-control\",\"plugin-service-consumer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"let the user switch between Chinese and English\"],\"visualRole\":\"language control\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"headerActions\"}},\"requiredServices\":{\"names\":[\"agent-ui.locale\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"mention-trigger\",\"name\":\"Conversation Mention Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"mention a person or resource\",\"add mention search to the composer\",\"添加提及功能\",\"输入 @ 搜索对象\"],\"visualRole\":\"conversation input trigger\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"triggers\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.mention-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"capabilities\":[\"quick-help-card\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p24\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l10\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"显示使用帮助卡片\",\"在聊天区域顶部显示帮助卡片\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"44px\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true}}},{\"pluginId\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"capabilities\":[\"quick-help-content\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p25\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"body\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show quick help body text\",\"显示帮助正文\",\"在帮助卡片正文显示提示\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"reasoning\",\"name\":\"Conversation Reasoning Renderer\",\"description\":\"Displays detailed Agent UI reasoning in a collapsible group. Disable this semantic contribution for status-only presentation; collapsing still permits viewing details.\",\"capabilities\":[\"conversation-reasoning-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p15\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"reasoningGroup\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the reasoning process\",\"restore reasoning presentation\",\"show deep thinking\"],\"visualRole\":\"assistant reasoning presentation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"reasoningGroup\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"reload-action\",\"name\":\"Conversation Reload Action\",\"description\":\"Regenerates the current assistant response through Agent UI.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p20\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p18\",\"slot\":\"actions\"},\"index\":1}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"regenerate an assistant response\"],\"visualRole\":\"assistant response reload action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"response-footer\",\"name\":\"Conversation Response Footer\",\"description\":\"Renders the canonical assistant response footer and its composable actions.\",\"capabilities\":[\"conversation-assistant-response-footer-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p18\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"assistantResponseFooter\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show assistant response branch and action controls\",\"compose assistant response footer actions\"],\"visualRole\":\"assistant response footer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"assistantResponseFooter\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{\"actions\":{\"description\":\"Actions displayed in the assistant response footer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-action\"]}}}},{\"pluginId\":\"retrieval-chunks\",\"name\":\"RetrievalChunks\",\"description\":\"Render search_docs backend tool calls with the official Agent UI Element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"display retrieval-chunks tool results\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"slash-command-trigger\",\"name\":\"Conversation Slash Command Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add slash commands to the composer\",\"run a frontend action or insert an agent command\",\"添加斜杠命令\"],\"visualRole\":\"conversation input trigger\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"triggers\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.slash-command-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"source-citations-message\",\"name\":\"Source Citations\",\"description\":\"Renders validated search_sources backend results with the official Sources element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render search_sources tool results as source citations\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"submit-action\",\"name\":\"Conversation Submit Action\",\"description\":\"Adds Agent UI send and stop controls to the conversation composer.\",\"capabilities\":[\"conversation-composer-submit-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p13\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p11\",\"slot\":\"submitAction\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add the conversation composer send and stop action\"],\"visualRole\":\"conversation composer submit action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"submitAction\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"task-group\",\"name\":\"Task Group\",\"description\":\"Renders nested agent work as expandable task cards.\",\"capabilities\":[\"conversation-task-group-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show agent tasks\",\"show nested agent work\",\"show delegated agent tasks\",\"group nested tool tasks\"],\"visualRole\":\"conversation task group\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"taskGroup\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"test-notice\",\"name\":\"Test Notice\",\"description\":\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\",\"capabilities\":[\"test-notice\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p23\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l8\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a test notice at the chat top\",\"显示测试提示\",\"在聊天区域顶部显示提示\"],\"visualRole\":\"chat area top notice\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"40px\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"theme-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/theme-provider\",\"component\":\"ThemeProviderPlugin\",\"facts\":{\"presentation\":\"The built-in theme keys are light, dark and violet; the default is violet. A custom brand color such as blue is a project CSS palette customization, not a new theme enum value. ThemeProviderPlugin renders its children and does not accept palette/color props.\",\"composition\":\"Keep the existing theme service and AgentUIRoot. Agent theme props or createAgentUIThemeService(initialTheme) select a built-in preset; AppUIModel does not configure component props. Do not add another theme Runtime or edit npm implementation files.\",\"styles\":\"Import @za38.03/agent-ui-plugins/styles.css before project overrides. Scoped palette selectors are :is(.agent-ui-root, .agent-ui-conversation)[data-theme=\\\"violet\\\"] for the default preset. Override --agent-brand and --agent-brand-solid for the brand and solid actions; --primary, --ring, --sidebar-primary and --sidebar-ring are semantic control/sidebar colors. Violet derives --primary and sidebar/focus colors from --agent-brand-solid; neutral light/dark derive --agent-brand from --primary, so override both when customizing those presets. Other public tokens include --background, --foreground, --card, --muted, --border, --input, --primary-foreground, --sidebar and --sidebar-foreground. Keep surfaces/readability coherent and verify rendered colors and theme switching. These names describe this installed package; project CSS overrides need no source takeover.\"}},\"name\":\"Headless Theme Service Provider\",\"description\":\"Provides the shared Agent UI theme preset service to other UI plugins.\",\"capabilities\":[\"headless\",\"plugin-service-provider\",\"theme\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p2\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":2}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide shared light, dark, and violet theme preset state\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"theme-switch\",\"name\":\"Theme Switch\",\"description\":\"Calls the shared theme service exposed by another UI plugin.\",\"capabilities\":[\"plugin-service-consumer\",\"theme-control\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p5\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l3\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"let the user select light, dark, or violet theme presets\"],\"visualRole\":\"theme control\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"headerActions\"}},\"requiredServices\":{\"names\":[\"agent-ui.theme\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"thinking-indicator\",\"name\":\"Conversation Thinking Indicator\",\"description\":\"Message-scoped live status placeholder. Yields to visible reasoning or tool activity; does not disable the separate reasoning renderer.\",\"capabilities\":[\"conversation-thinking-indicator-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a thinking status placeholder\",\"show a placeholder before reasoning details arrive\",\"显示正在思考状态提示\",\"详细推理到达前显示占位提示\"],\"visualRole\":\"assistant status placeholder; does not control reasoning detail visibility\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"thinkingIndicator\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-fallback\",\"name\":\"Conversation Tool Fallback Renderer\",\"description\":\"Displays an unregistered tool call with canonical Agent UI presentation.\",\"capabilities\":[\"conversation-tool-fallback-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show unregistered tool calls\",\"restore tool fallback presentation\"],\"visualRole\":\"assistant tool fallback presentation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"toolFallback\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-group\",\"name\":\"Conversation Tool Group Renderer\",\"description\":\"Displays one Agent UI tool group with canonical presentation.\",\"capabilities\":[\"conversation-tool-group-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p16\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p9\",\"slot\":\"toolGroup\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show grouped tool activity\",\"restore tool group presentation\"],\"visualRole\":\"assistant tool group presentation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"toolGroup\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-result\",\"name