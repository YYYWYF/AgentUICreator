data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-b760ad35a462d6a7","messageId":"b34fb80a-9faa-41b1-919d-9d26da88874d","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/hooks/useQuickHelpCardExpanded.ts\",\"content\":\"1: import { useSyncExternalStore } from \\\"react\\\";\\n2: \\n3: /**\\n4:  * Shared expansion state for the quick help card.\\n5:  *\\n6:  * The card itself and the actions placed in its `headerActions` slot are\\n7:  * separate Plugin instances, so the state lives in one tiny project-owned\\n8:  * store outside React. Theme switching only re-renders the tree, the module\\n9:  * (and therefore this state) keeps its value.\\n10:  */\\n11: let expanded = true;\\n12: const listeners = new Set<() => void>();\\n13: \\n14: function subscribe(listener: () => void): () => void {\\n15:   listeners.add(listener);\\n16:   return () => {\\n17:     listeners.delete(listener);\\n18:   };\\n19: }\\n20: \\n21: function getSnapshot(): boolean {\\n22:   return expanded;\\n23: }\\n24: \\n25: function notify(): void {\\n26:   for (const listener of listeners) {\\n27:     listener();\\n28:   }\\n29: }\\n30: \\n31: export function setQuickHelpCardExpanded(next: boolean): void {\\n32:   if (expanded === next) {\\n33:     return;\\n34:   }\\n35:   expanded = next;\\n36:   notify();\\n37: }\\n38: \\n39: export function toggleQuickHelpCardExpanded(): void {\\n40:   setQuickHelpCardExpanded(!expanded);\\n41: }\\n42: \\n43: /** Collapse the card body, e.g. from a \\\"知道了\\\" header action. */\\n44: export function collapseQuickHelpCard(): void {\\n45:   setQuickHelpCardExpanded(false);\\n46: }\\n47: \\n48: /** Read the current expansion state outside React. */\\n49: export function getQuickHelpCardExpanded(): boolean {\\n50:   return expanded;\\n51: }\\n52: \\n53: /** Subscribe a component to the shared expansion state. */\\n54: export function useQuickHelpCardExpanded(): boolean {\\n55:   return useSyncExternalStore(subscribe, getSnapshot, getSnapshot);\\n56: }\\n57: \",\"hash\":\"1dda0a27e93079f2baecc6e1c41a53322501f81cc2c955c9b0b556167a12b7e9\",\"totalLines\":57,\"nextOffset\":null}}","role":"tool"}

