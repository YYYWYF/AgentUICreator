data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_4AcAXdI3ZY4xZKXiV6Dw8643","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"limit\":200,\"offset\":0}"}

