data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-a90a7ea70908c8cc","messageId":"3c4a17e8-5b4f-4a51-a806-63b952841960","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"query\":\"defaultPlacement plugin_slot manifest authoring\",\"total\":22,\"offset\":0,\"entries\":[{\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"title\":\"Plugin Authoring Contract\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/plugin-authoring-contract.md\",\"summary\":\"自定义插件 authoring、默认放置、容器子插槽、renderer、样式隔离和校验合同。\",\"sha256\":\"e09945ea7269cd43caabbf18eb2a96fce0f127db8abd03a001cde12119c91e22\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\"}},\"matchingSections\":[{\"sectionId\":\"s31\",\"title\":\"Plugin categories\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s68\",\"title\":\"`defaultPlacement`\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s68\"}}},{\"sectionId\":\"s97\",\"title\":\"Readiness states\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s97\"}}}]},{\"documentId\":\"public:development/create-plugin\",\"title\":\"创建自定义插件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/create-plugin.md\",\"summary\":\"已有插件的属性和组合无法满足需求时，可以在项目中编写新的 React 插件。先到插件检查可复用能力；只需让 Creator 帮你新增功能时，见增加新的界面功能。 以下路径相对于生成目录，默认为 src/agent-ui/。 开发时可以直接复用会话操作、状态 Hook、服务、事件、子插槽和消息展示接口。先查公共能力速查，各项提供使用前提和代码示例；插件组件和业务页面的接口入口也在其中区分。\",\"sha256\":\"e1ab2ce129fe251b39a7fa05e9fe0af74f01eeb50f4b8ef372781cc5f928fbbf\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\"}},\"matchingSections\":[{\"sectionId\":\"s9\",\"title\":\"1. 声明插件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s9\"}}},{\"sectionId\":\"s25\",\"title\":\"2. 编写组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s25\"}}}]},{\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\"}},\"matchingSections\":[{\"sectionId\":\"s103\",\"title\":\"4. 注册并启用插件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s103\"}}},{\"sectionId\":\"s1\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:development/layout-and-composition\",\"title\":\"布局与插件组合\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/layout-and-composition.md\",\"summary\":\"Agent UI 把会话列表、输入框、附件、复制等功能做成了插件。你可以按需启用、调整位置，也可以把多个插件组合起来。 本页说明如何手动修改布局配置。界面排列、插件实例及组合保存在 app-ui.json 中，组件属性和渲染代码放在项目插件入口。 日常调整可以直接把需求告诉 Creator，见布局调整示例。自己编辑时，先找到下文的配置文件，保留现有实例 ID，再按需修改位置、尺寸和组合。\",\"sha256\":\"472d2f6ae3449c0e8c1ef05791cfaf3213aab0fcb226ba8eda9037c9ef804047\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\"}},\"matchingSections\":[{\"sectionId\":\"s236\",\"title\":\"新增页面或内部插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s236\"}}},{\"sectionId\":\"s77\",\"title\":\"常用插件插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s77\"}}}]},{\"documentId\":\"public:development/plugin-api\",\"title\":\"插件开发接口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/plugin-api.md\",\"summary\":\"项目插件由能力声明、组件和可选的服务生命周期组成。创建文件与注册步骤见创建自定义插件。修改已有官方插件外观时，先使用组件公开属性。\",\"sha256\":\"cd30e68bc788dd22fdccc937313217ed5e3c3816b86e84f9138f758709423720\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\"}},\"matchingSections\":[{\"sectionId\":\"s50\",\"title\":\"插件定义\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s50\"}}},{\"sectionId\":\"s342\",\"title\":\"消息与工具结果展示\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s342\"}}},{\"sectionId\":\"s72\",\"title\":\"组件与子插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s72\"}}}]},{\"documentId\":\"public:development/project-structure\",\"title\":\"工程结构与修改入口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/project-structure.md\",\"summary\":\"初始化后，Agent UI 源码默认放在 src/agent-ui/。以下路径都相对于这个目录；初始化时选择了其他目录，就在实际目录中找同名文件。 不同版本或历史工程的目录可能不同，先检查已有组件的导入和导出。官方插件通常由项目入口导入 npm 实现；已经接管的插件则引用本地实现。 新工程只生成布局中选用的插件入口，以及读取服务、传入数据和显示子插件所需的代码，添加插件时再生成对应入口。已经存在的项目入口会保留。 服务相关 Hook 统一放在 services/hooks/ 下：useConversations.ts、useConversationActions.ts 和按需生成的 useAu\",\"sha256\":\"d12f5d52751a6ac2fdd49c8a308ac1b080e59b0cf6076e91bbf7ffaa729b73db\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"工程结构与修改入口\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:start/index\",\"title\":\"开始使用\",\"source\":\"public\",\"topic\":\"开始使用\",\"path\":\"start/index.md\",\"summary\":\"为你的产品加入 AI 助理，用自然语言调整界面。从现有 React 工程出发，完成接入、首次对话和第一次定制。\",\"sha256\":\"11355dee8e8f6d796be9f50499c23a9ba7a038530da015a286f66070a752a125\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\"}},\"matchingSections\":[{\"sectionId\":\"s163\",\"title\":\"生成了哪些文件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\",\"sectionId\":\"s163\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"统一 Plugins 包、内置源码目录与按需源码托管\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/architecture/npm-default-plugin-source-ownership.md\",\"summary\":\"npm 默认交付、项目薄应用层、源码接管授权、BASE/LOCAL/TARGET 与更新保护。\",\"sha256\":\"cbc8052587ee42d67d634c94f1fd9dac8ace5603ec4d4e92bf10e191af808eb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s49\",\"title\":\"4. Canonical 实现、元数据与构建\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s49\"}}},{\"sectionId\":\"s87\",\"title\":\"6. 首次源码接管\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s87\"}}},{\"sectionId\":\"s158\",\"title\":\"11. 验证与当前支持范围\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s158\"}}}]}],\"nextOffset\":8}}","role":"tool"}

