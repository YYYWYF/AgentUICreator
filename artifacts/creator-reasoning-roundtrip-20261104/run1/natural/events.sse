data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_NZ24ZchuyTEUXM937ORy3172","delta":"{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"offset\":0,\"limit\":4000,\"sectionId\":\"s68\"}"}

