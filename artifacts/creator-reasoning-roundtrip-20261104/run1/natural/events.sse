data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_fd16a26a96c243bb86efd97c","messageId":"9c525bda-fabe-4a01-bca9-9cd41f20ac5f","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/test-notice/definition.ts\",\"content\":\"1: import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import manifestJson from \\\"./manifest.json\\\";\\n3: import { TestNoticePlugin } from \\\"./index\\\";\\n4: \\n5: const definition: UIPluginDefinition = {\\n6:   manifest: manifestJson as UIPluginManifest,\\n7:   provides: [],\\n8:   inject: [],\\n9:   optionalInject: [\\\"agent-ui.locale\\\"],\\n10:   Component: TestNoticePlugin,\\n11: };\\n12: \\n13: export default definition;\\n14: \",\"hash\":\"bba53cc3ebca46f9183dfca07295b5b29e48346c82e0dbcebc1d97585759e5ff\",\"totalLines\":14,\"nextOffset\":null}}","role":"tool"}

