data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_vwQ3jx53Y2ucEP0sOxkB1122","delta":"{\"file_path\":\"/src/agent-ui/application/Agent.tsx\",\"limit\":40,\"offset\":0}"}

