data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_Da7dnU26kFNlgF16j7Qi1697","messageId":"1617a55b-2777-460f-9730-7c721466ea67","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"94a13413ebe7fd333795d6853a92ea9f6d658adb20a98abaf014d7aac5288d5c\",\"query\":\"ConversationWelcomeFallback 欢迎区 welcome 文案 默认\",\"total\":105,\"offset\":0,\"entries\":[{\"documentId\":\"public:plugins/conversation-surface\",\"title\":\"会话界面（conversation-surface）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-surface.md\",\"summary\":\"用户可以在同一区域阅读已有对话、查看新回复并继续提问；工具结果、计划等内容会显示在对应的消息中。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"cb9a7212f21a1f1e94e3f22365bd88ac21a7638cc4d0b6b9c50c48c97925fc4c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s23\",\"title\":\"需求示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s23\"}}},{\"sectionId\":\"s15\",\"title\":\"定制选项\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s15\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}}]},{\"documentId\":\"public:guide/examples/brand-copy\",\"title\":\"修改名称与欢迎内容\",\"source\":\"public\",\"topic\":\"Creator\",\"path\":\"guide/examples/brand-copy.md\",\"summary\":\"实际修改名称、欢迎语和推荐问题，核对页面与点击结果。\",\"sha256\":\"53651d06ce6a5d351b10466499aefd6ab0796b765b179750a11aa1bdd24835b7\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/examples/brand-copy\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"修改名称与欢迎内容\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/examples/brand-copy\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"本次怎么说\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/examples/brand-copy\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s17\",\"title\":\"页面发生了什么变化\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/examples/brand-copy\",\"sectionId\":\"s17\"}}}]},{\"documentId\":\"public:development/styling-and-localization\",\"title\":\"样式与文案开发\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/styling-and-localization.md\",\"summary\":\"样式和文案在项目中定制，沿用工程已有的 UI 库、样式方案和版本。需要 Creator 帮你修改时，见主题与样式需求和语言与文案需求。\",\"sha256\":\"07565c50b9b15f2c07e5c7e173c79b7bdf6232fd28ab3aef8295afba07e9a68a\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/styling-and-localization\"}},\"matchingSections\":[{\"sectionId\":\"s33\",\"title\":\"修改已有文案\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/styling-and-localization\",\"sectionId\":\"s33\"}}},{\"sectionId\":\"s1\",\"title\":\"样式与文案开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/styling-and-localization\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"默认主题\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/styling-and-localization\",\"sectionId\":\"s5\"}}}]},{\"documentId\":\"internal:i18n/README\",\"title\":\"Product localization ownership\",\"source\":\"internal\",\"topic\":\"主题与本地化\",\"path\":\"references/docs/i18n/README.md\",\"summary\":\"统一 locale、领域 namespace、英文/中文对齐与产品文案所有权。\",\"sha256\":\"b1727ce17453992f5e4d95857a88879eb08b9296c4a0e49d9bc4df5fa63bc503\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:i18n/README\"}},\"matchingSections\":[{\"sectionId\":\"s10\",\"title\":\"Message owners\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:i18n/README\",\"sectionId\":\"s10\"}}}]},{\"documentId\":\"public:development/layout-and-composition\",\"title\":\"布局与插件组合\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/layout-and-composition.md\",\"summary\":\"Agent UI 把会话列表、输入框、附件、复制等功能做成了插件。你可以按需启用、调整位置，也可以把多个插件组合起来。 本页说明如何手动修改布局配置。界面排列、插件实例及组合保存在 app-ui.json 中，组件属性和渲染代码放在项目插件入口。 日常调整可以直接把需求告诉 Creator，见布局调整示例。自己编辑时，先找到下文的配置文件，保留现有实例 ID，再按需修改位置、尺寸和组合。\",\"sha256\":\"472d2f6ae3449c0e8c1ef05791cfaf3213aab0fcb226ba8eda9037c9ef804047\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\"}},\"matchingSections\":[{\"sectionId\":\"s77\",\"title\":\"常用插件插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s77\"}}},{\"sectionId\":\"s228\",\"title\":\"插槽扩展\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s228\"}}},{\"sectionId\":\"s256\",\"title\":\"定制、更新与检查\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s256\"}}}]},{\"documentId\":\"internal:architecture/plugin-public-props\",\"title\":\"官方插件公开 props 约定与逐项核对\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/plugin-public-props.md\",\"summary\":\"官方插件公开 props、children、组件组合与应用层定制；类型和运行转发核对。\",\"sha256\":\"eda555c423379ca297d3aaf9ec102e61655b92273f016582cef9d4afff682a0c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-public-props\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"官方插件公开 props 约定与逐项核对\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-public-props\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:guide/adjustments/localization\",\"title\":\"语言与文案定制\",\"source\":\"public\",\"topic\":\"Creator\",\"path\":\"guide/adjustments/localization.md\",\"summary\":\"把要替换的文字和中英文内容直接告诉 Creator。本页记录 2026 年 10 月 27 日的实际测试，没有向它提供代码位置或参数名称。\",\"sha256\":\"a9588bbae15d846e78097be91efe1a9c61e268810243a1cddeb972e0292d26ac\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/adjustments/localization\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"语言与文案定制\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/adjustments/localization\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s11\",\"title\":\"Creator 实际怎样处理\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/adjustments/localization\",\"sectionId\":\"s11\"}}},{\"sectionId\":\"s5\",\"title\":\"本次怎么说\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/adjustments/localization\",\"sectionId\":\"s5\"}}}]}],\"nextOffset\":8}}","role":"tool"}

