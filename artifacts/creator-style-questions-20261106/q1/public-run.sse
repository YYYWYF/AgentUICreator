data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_5AD6IPh3ZPq7SDy2qhBc2255","messageId":"bba75bc4-f6e6-4469-8e3e-10ee60e0c30c","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"94a13413ebe7fd333795d6853a92ea9f6d658adb20a98abaf014d7aac5288d5c\",\"documentId\":\"public:plugins/conversation-surface\",\"title\":\"会话界面（conversation-surface）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-surface.md\",\"summary\":\"用户可以在同一区域阅读已有对话、查看新回复并继续提问；工具结果、计划等内容会显示在对应的消息中。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"cb9a7212f21a1f1e94e3f22365bd88ac21a7638cc4d0b6b9c50c48c97925fc4c\",\"totalSections\":7,\"offset\":0,\"sections\":[{\"sectionId\":\"s1\",\"title\":\"会话界面（conversation-surface）\",\"level\":1,\"characters\":3408,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s9\",\"title\":\"启用与使用\",\"level\":2,\"characters\":191,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s9\"}}},{\"sectionId\":\"s15\",\"title\":\"定制选项\",\"level\":2,\"characters\":190,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s15\"}}},{\"sectionId\":\"s23\",\"title\":\"需求示例\",\"level\":2,\"characters\":118,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s23\"}}},{\"sectionId\":\"s31\",\"title\":\"手动开发\",\"level\":2,\"characters\":2703,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s35\",\"title\":\"属性\",\"level\":3,\"characters\":2205,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s54\",\"title\":\"类型查询\",\"level\":3,\"characters\":380,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s54\"}}}],\"nextOffset\":null}}","role":"tool"}

