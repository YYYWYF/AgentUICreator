data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_sBY3nNFw26xO43tP7h8m4682","delta":"{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s5\"}"}

