data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_lTfZwKs1R2sTM8aXrHmZ7978","messageId":"8f3c1c72-5c52-4697-b93b-f5543b3e318f","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"94a13413ebe7fd333795d6853a92ea9f6d658adb20a98abaf014d7aac5288d5c\",\"query\":\"welcome 欢迎语 empty state title\",\"total\":50,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}},{\"sectionId\":\"s103\",\"title\":\"状态与事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s103\"}}},{\"sectionId\":\"s92\",\"title\":\"Hooks 与界面组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s92\"}}}]},{\"documentId\":\"public:plugins/conversation-surface\",\"title\":\"会话界面（conversation-surface）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-surface.md\",\"summary\":\"用户可以在同一区域阅读已有对话、查看新回复并继续提问；工具结果、计划等内容会显示在对应的消息中。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"cb9a7212f21a1f1e94e3f22365bd88ac21a7638cc4d0b6b9c50c48c97925fc4c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s23\",\"title\":\"需求示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s23\"}}},{\"sectionId\":\"s15\",\"title\":\"定制选项\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s15\"}}}]},{\"documentId\":\"public:development/history-backend\",\"title\":\"接入历史会话\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/history-backend.md\",\"summary\":\"历史服务提供会话列表和聊天记录。读取历史与继续对话是不同能力：要继续提问，还需相应的 Agent 数据和接口。相关参数见Agent 参数与配置。\",\"sha256\":\"061f11b5e18fdacab7879aa91e650bda0492e4bea4cb6cc628337113639c1fb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/history-backend\"}},\"matchingSections\":[{\"sectionId\":\"s42\",\"title\":\"HTTP 数据源\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/history-backend\",\"sectionId\":\"s42\"}}},{\"sectionId\":\"s102\",\"title\":\"重命名、归档与取消归档\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/history-backend\",\"sectionId\":\"s102\"}}}]},{\"documentId\":\"public:plugins/auth-gate\",\"title\":\"登录认证（auth-gate）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/auth-gate.md\",\"summary\":\"检查登录状态时显示等待；未登录时显示账号、密码和登录按钮。认证成功后，应用再显示允许访问的聊天内容。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"edf8c46b83dc8f2360db4e2532ce983c9ff8c96316cde069dba7193900114343\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/auth-gate\"}},\"matchingSections\":[{\"sectionId\":\"s43\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/auth-gate\",\"sectionId\":\"s43\"}}}]},{\"documentId\":\"public:plugins/job-progress-message\",\"title\":\"后台任务进度（job-progress-message）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/job-progress-message.md\",\"summary\":\"例如一次 CI 作业依次经过拉取代码、安装依赖、构建和测试。卡片显示当前阶段、进度及最终结果；业务支持取消时，还会提供取消按钮。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"a57ae87cf297cec2a243929ff784e4be439a204c773d0254b3bda50dd86567c1\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\"}},\"matchingSections\":[{\"sectionId\":\"s36\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\",\"sectionId\":\"s36\"}}}]},{\"documentId\":\"public:development/agent-options\",\"title\":\"Agent 参数与配置\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/agent-options.md\",\"summary\":\"通过 Agent 参数设置服务地址、主题、语言，以及打开已有会话。首次挂载见 React 接入，完整类型见 React 页面参数与方法。\",\"sha256\":\"18e73f1fc5f6d6c600c8d53a420c6cb838e07ad28ba1d01b74c082bb21e1e16c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\"}},\"matchingSections\":[{\"sectionId\":\"s5\",\"title\":\"页面参数\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s35\",\"title\":\"传入业务上下文\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s87\",\"title\":\"界面语言切换\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s87\"}}}]},{\"documentId\":\"public:plugins/mention-trigger\",\"title\":\"@ 提及搜索（mention-trigger）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/mention-trigger.md\",\"summary\":\"例如输入「@产品」后选择「产品说明文档」。选择结果会带上对象 ID，方便 Agent 按项目约定识别引用的是哪一份资料。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"1071d49e47c32d0d6afc47362253e62cec0de690db92e89bbff5689c9fef6156\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/mention-trigger\"}},\"matchingSections\":[{\"sectionId\":\"s37\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/mention-trigger\",\"sectionId\":\"s37\"}}}]},{\"documentId\":\"public:plugins/slash-command-trigger\",\"title\":\"/ 快捷命令（slash-command-trigger）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/slash-command-trigger.md\",\"summary\":\"用户可以搜索并选择项目已提供的命令。操作类命令会执行相应动作；指令类命令会加入草稿，随问题一起发送。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"27c6049250aa364ebe9acd73c95591543353aea446e4758c7455911379b46da3\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/slash-command-trigger\"}},\"matchingSections\":[{\"sectionId\":\"s36\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/slash-command-trigger\",\"sectionId\":\"s36\"}}}]}],\"nextOffset\":8}}","role":"tool"}

