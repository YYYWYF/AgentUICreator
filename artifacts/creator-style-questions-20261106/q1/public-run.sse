data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_TbrC64vRXwoih1f984Rv8513","messageId":"8173bf2d-f739-46a9-9c25-f229d1e96014","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"94a13413ebe7fd333795d6853a92ea9f6d658adb20a98abaf014d7aac5288d5c\",\"query\":\"emptyWelcome 插槽 welcome title description 空会话\",\"total\":102,\"offset\":0,\"entries\":[{\"documentId\":\"public:plugins/conversation-surface\",\"title\":\"会话界面（conversation-surface）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-surface.md\",\"summary\":\"用户可以在同一区域阅读已有对话、查看新回复并继续提问；工具结果、计划等内容会显示在对应的消息中。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"cb9a7212f21a1f1e94e3f22365bd88ac21a7638cc4d0b6b9c50c48c97925fc4c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s1\",\"title\":\"会话界面（conversation-surface）\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s31\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s31\"}}}]},{\"documentId\":\"public:development/layout-and-composition\",\"title\":\"布局与插件组合\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/layout-and-composition.md\",\"summary\":\"Agent UI 把会话列表、输入框、附件、复制等功能做成了插件。你可以按需启用、调整位置，也可以把多个插件组合起来。 本页说明如何手动修改布局配置。界面排列、插件实例及组合保存在 app-ui.json 中，组件属性和渲染代码放在项目插件入口。 日常调整可以直接把需求告诉 Creator，见布局调整示例。自己编辑时，先找到下文的配置文件，保留现有实例 ID，再按需修改位置、尺寸和组合。\",\"sha256\":\"472d2f6ae3449c0e8c1ef05791cfaf3213aab0fcb226ba8eda9037c9ef804047\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\"}},\"matchingSections\":[{\"sectionId\":\"s77\",\"title\":\"常用插件插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s77\"}}},{\"sectionId\":\"s42\",\"title\":\"插槽定义与分类\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s42\"}}},{\"sectionId\":\"s236\",\"title\":\"新增页面或内部插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s236\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}},{\"sectionId\":\"s48\",\"title\":\"运行上下文回调\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s48\"}}},{\"sectionId\":\"s61\",\"title\":\"会话方法\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s61\"}}}]},{\"documentId\":\"public:plugins/agent-plan-message\",\"title\":\"任务计划与完成状态（agent-plan-message）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/agent-plan-message.md\",\"summary\":\"例如依次列出「检查代码」「修改界面」「执行验证」。Agent 更新计划时，卡片里的当前步骤和完成标记随之变化。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"eea498376d0597268250e94932ba1a72ac55dbdc88321a92d73a203ccd7116e8\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/agent-plan-message\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/agent-plan-message\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s31\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/agent-plan-message\",\"sectionId\":\"s31\"}}}]},{\"documentId\":\"public:plugins/conversation-suggestions\",\"title\":\"开场建议（conversation-suggestions）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-suggestions.md\",\"summary\":\"例如显示「查询账单」「了解转账流程」等入口。点击后按项目配置填入输入框或直接发起提问。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"e6b3e208102555069e7333a9b8ebfdd4620a366ac5e9374a7a9e6a548cd6b1de\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-suggestions\"}},\"matchingSections\":[{\"sectionId\":\"s38\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-suggestions\",\"sectionId\":\"s38\"}}},{\"sectionId\":\"s57\",\"title\":\"设置建议内容\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-suggestions\",\"sectionId\":\"s57\"}}},{\"sectionId\":\"s34\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-suggestions\",\"sectionId\":\"s34\"}}}]},{\"documentId\":\"public:plugins/job-progress-message\",\"title\":\"后台任务进度（job-progress-message）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/job-progress-message.md\",\"summary\":\"例如一次 CI 作业依次经过拉取代码、安装依赖、构建和测试。卡片显示当前阶段、进度及最终结果；业务支持取消时，还会提供取消按钮。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"a57ae87cf297cec2a243929ff784e4be439a204c773d0254b3bda50dd86567c1\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\"}},\"matchingSections\":[{\"sectionId\":\"s36\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\",\"sectionId\":\"s36\"}}},{\"sectionId\":\"s73\",\"title\":\"当前工具调用的数据与操作\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\",\"sectionId\":\"s73\"}}},{\"sectionId\":\"s32\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/job-progress-message\",\"sectionId\":\"s32\"}}}]},{\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\",\"title\":\"Authoritative Agent Plan Activity\",\"source\":\"internal\",\"topic\":\"会话与交互\",\"path\":\"references/docs/architecture/authoritative-agent-plan-activity.md\",\"summary\":\"Agent Plan Activity 的权威数据、计划状态与展示合同。\",\"sha256\":\"a5331bcb1c5f26c63a544cf76c4c0aab1d395225328e91d805deae2e29490a7b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\"}},\"matchingSections\":[{\"sectionId\":\"s7\",\"title\":\"Contract and presentation\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\",\"sectionId\":\"s7\"}}}]},{\"documentId\":\"public:development/agent-options\",\"title\":\"Agent 参数与配置\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/agent-options.md\",\"summary\":\"通过 Agent 参数设置服务地址、主题、语言，以及打开已有会话。首次挂载见 React 接入，完整类型见 React 页面参数与方法。\",\"sha256\":\"18e73f1fc5f6d6c600c8d53a420c6cb838e07ad28ba1d01b74c082bb21e1e16c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"传入业务上下文\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s5\",\"title\":\"页面参数\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s103\",\"title\":\"打开已有会话\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\",\"sectionId\":\"s103\"}}}]}],\"nextOffset\":8}}","role":"tool"}

