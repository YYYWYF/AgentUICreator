data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_13HbvS0lFTtZXg02Dl3O8911","delta":"{\"file_path\":\"/src/agent-ui/application/Agent.tsx\",\"new_string\":\"/** 空会话欢迎语，中英文保持一致。 */\\nconst welcomeCopy = {\\n  'zh-CN': '今天心情好吗',\\n  'en-US': 'How are you feeling today?',\\n} as const;\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const locales: AgentProps['locales'] = {\",\"old_string\":\"/** 空会话欢迎语，中英文保持一致。 */\\nconst welcomeCopy = {\\n  'zh-CN': '今天心情好吗',\\n  'en-US': 'How are you feeling today?',\\n} as const;\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const currentLocale = props.locale ?? props.defaultLocale ?? 'zh-CN';\\n  const welcome: AgentProps['welcome'] = { title: welcomeCopy[currentLocale] ?? welcomeCopy['zh-CN'] };\\n  const locales: AgentProps['locales'] = {\",\"replace_all\":false}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_00_13HbvS0lFTtZXg02Dl3O8911"}

