data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_U8Ekt289PK09zBBNfxho9473","delta":"{\"file_path\":\"/src/agent-ui/application/Agent.tsx\",\"old_string\":\"export type { AgentProps } from '@za38.03/agent-ui-runtime/ui';\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const suggestions: AgentProps['suggestions'] = (locale) => {\",\"new_string\":\"export type { AgentProps } from '@za38.03/agent-ui-runtime/ui';\\n\\n/** 空会话欢迎语，按界面语言提供一致文案。 */\\nconst welcomeTitles: Record<string, string> = {\\n  'zh-CN': '今天心情好吗',\\n  'en-US': 'How are you feeling today?',\\n};\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const welcome: AgentProps['welcome'] = {\\n    title: welcomeTitles[props.locale ?? props.defaultLocale ?? 'zh-CN'] ?? welcomeTitles['zh-CN'],\\n  };\\n  const suggestions: AgentProps['suggestions'] = (locale) => {\",\"replace_all\":false}"}

