data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_rZ3xS8QvQDn8MJcE6uCd4064","delta":"{\"file_path\":\"/src/agent-ui/application/Agent.tsx\",\"new_string\":\"/** 空会话欢迎语，中英文保持一致。 */\\nconst welcomeCopy = {\\n  'zh-CN': '今天心情好吗',\\n  'en-US': 'How are you feeling today?',\\n} as const;\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const currentLocale = props.locale ?? props.defaultLocale ?? 'zh-CN';\\n  const welcome: AgentProps['welcome'] = { title: welcomeCopy[currentLocale] ?? welcomeCopy['zh-CN'] };\\n  const locales: AgentProps['locales'] = {\\n    ...props.locales,\\n    'zh-CN': {\\n      ...props.locales?.['zh-CN'],\\n      conversation: { ...props.locales?.['zh-CN']?.conversation, welcome: welcomeCopy['zh-CN'] },\\n    },\\n    'en-US': {\\n      ...props.locales?.['en-US'],\\n      conversation: { ...props.locales?.['en-US']?.conversation, welcome: welcomeCopy['en-US'] },\\n    },\\n  };\\n  const suggestions: AgentProps['suggestions'] = (locale) => {\",\"old_string\":\"/** 空会话欢迎语，按界面语言提供一致文案。 */\\nconst welcomeTitles: Record<string, string> = {\\n  'zh-CN': '今天心情好吗',\\n  'en-US': 'How are you feeling today?',\\n};\\n\\nexport function Agent(props: AgentProps = {}) {\\n  const welcome: AgentProps['welcome'] = {\\n    title: welcomeTitles[props.locale ?? props.defaultLocale ?? 'zh-CN'] ?? welcomeTitles['zh-CN'],\\n  };\\n  const suggestions: AgentProps['suggestions'] = (locale) => {\",\"replace_all\":false}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_00_rZ3xS8QvQDn8MJcE6uCd4064"}

