th\":280,\"height\":784},\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l7\"}},{\"instanceId\":\"p10\",\"pluginId\":\"conversation-quote\",\"rect\":{\"x\":33,\"y\":451,\"width\":646,\"height\":0},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"beforeInput\"}},{\"instanceId\":\"p8\",\"pluginId\":\"add-attachment-action\",\"rect\":{\"x\":33,\"y\":511,\"width\":32,\"height\":32},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"leadingActions\"}},{\"instanceId\":\"p9\",\"pluginId\":\"submit-action\",\"rect\":{\"x\":651,\"y\":513,\"width\":28,\"height\":28},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"submitAction\"}},{\"instanceId\":\"p22\",\"pluginId\":\"conversation-new\",\"rect\":{\"x\":720,\"y\":52,\"width\":264,\"height\":44},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p21\",\"slot\":\"headerActions\"}},{\"instanceId\":\"p7\",\"pluginId\":\"composer\",\"rect\":{\"x\":20,\"y\":440,\"width\":672,\"height\":114},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p5\",\"slot\":\"composer\"}},{\"instanceId\":\"p6\",\"pluginId\":\"conversation-suggestions\",\"rect\":{\"x\":20,\"y\":348,\"width\":672,\"height\":76},\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p5\",\"slot\":\"emptySuggestions\"}}],\"layoutNodes\":[{\"type\":\"row\",\"rect\":{\"x\":0,\"y\":0,\"width\":992,\"height\":836},\"trackWidths\":[712,280],\"nodeRef\":\"l0\",\"presentation\":{\"nodes\":[{\"relation\":\"self\",\"depth\":0,\"tag\":\"div\",\"classes\":[\"app-ui-layout-node\",\"app-ui-layout-row\"],\"rect\":{\"x\":0,\"y\":0,\"width\":992,\"height\":836},\"styles\":{\"display\":\"grid\",\"position\":\"static\",\"width\":\"992px\",\"minWidth\":\"0px\",\"maxWidth\":\"none\",\"height\":\"836px\",\"flexDirection\":\"row\",\"flexWrap\":\"nowrap\",\"flexBasis\":\"auto\",\"flexGrow\":\"0\",\"flexShrink\":\"1\",\"gridTemplateColumns\":\"712px 280px\",\"overflowX\":\"visible\",\"overflo