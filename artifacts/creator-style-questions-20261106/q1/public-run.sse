data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_tWUbw0ca4mB8vhr2XHyr1360","messageId":"9f9f7bf3-9a5c-4475-99f4-6b77e52c80a6","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"94a13413ebe7fd333795d6853a92ea9f6d658adb20a98abaf014d7aac5288d5c\",\"documentId\":\"public:plugins/conversation-surface\",\"title\":\"手动开发\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/conversation-surface.md\",\"summary\":\"用户可以在同一区域阅读已有对话、查看新回复并继续提问；工具结果、计划等内容会显示在对应的消息中。 日常调整可以交给 Creator；需要自己写代码时，直接查看手动开发。\",\"sha256\":\"cb9a7212f21a1f1e94e3f22365bd88ac21a7638cc4d0b6b9c50c48c97925fc4c\",\"sectionId\":\"s31\",\"offset\":0,\"totalCharacters\":118,\"childSections\":[{\"sectionId\":\"s35\",\"title\":\"属性\",\"level\":3,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s35\"}}},{\"sectionId\":\"s54\",\"title\":\"类型查询\",\"level\":3,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/conversation-surface\",\"sectionId\":\"s54\"}}}],\"content\":\"## 手动开发\\n\\n打开项目中的 `plugins/conversation-surface/index.tsx`，在已有公开组件调用处设置属性或调整组合。修改外观时，保留文件中读取会话状态、调用服务、显示子插件和注册消息组件的代码。\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"call_01_uQo9YukYm9Mai1rgw0Mt1977","toolCallName":"read_creator_documentation"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_uQo9YukYm9Mai1rgw0Mt1977","delta":"{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"limit\":5000,\"offset\":0,\"sectionId\":\"s14\"}"}

