import {createModel,hostEnvironment} from '../../../packages/creator/src/agent/config.ts';
import {reasoningContent} from '../../../packages/creator/src/agent/reasoning-content.ts';
import {writeFile} from 'node:fs/promises';
import {createRequire} from 'node:module';
import {randomUUID} from 'node:crypto';
import assert from 'node:assert/strict';
const require=createRequire(new URL('../../../packages/creator/package.json',import.meta.url));
const {HumanMessage,ToolMessage}=require('@langchain/core/messages');
const {tool}=require('@langchain/core/tools');
const {z}=require('zod');
const started=Date.now();
const probe=tool(async()=> '7',{name:'acceptance_probe',description:'Return the fixed acceptance test value.',schema:z.object({})});
const model=createModel(hostEnvironment(process.cwd()),'windows-acceptance-'+randomUUID());
const messages=[new HumanMessage('Call acceptance_probe once, then reply with the returned number only.')];
const first=await model.bindTools([probe],{tool_choice:'acceptance_probe'}).invoke(messages);
assert.equal(first.tool_calls?.length,1);
assert.equal(first.tool_calls[0].name,'acceptance_probe');
const final=await model.bindTools([probe]).invoke([...messages,first,new ToolMessage({content:'7',tool_call_id:first.tool_calls[0].id})]);
const text=typeof final.content==='string'?final.content:final.content.filter((part:any)=>part.type==='text').map((part:any)=>part.text).join('');
assert.match(text,/7/);
const result={status:'passed',model:'deepseek-v4.1-flash',seconds:(Date.now()-started)/1000,firstToolCall:first.tool_calls[0].name,reasoningCharacters:reasoningContent(first)?.length??0,answer:text,firstUsage:first.usage_metadata,finalUsage:final.usage_metadata};
await writeFile(new URL('../local-runs/provider-roundtrip.json',import.meta.url),JSON.stringify(result,null,2));
console.log(JSON.stringify(result));
