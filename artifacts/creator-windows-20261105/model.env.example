# Tool Host only: copy to workspace .agent-ui/creator/.env.local and supply the key locally.
CREATOR_MODEL_PROVIDER=openai
CREATOR_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
CREATOR_MODEL_API_KEY=
CREATOR_MODEL_NAME=deepseek-v4.1-flash
CREATOR_MODEL_OPENCODE_SESSION_HEADER=1
CREATOR_MODEL_MAX_TOKENS=16384
CREATOR_CONTEXT_MAX_TOKENS=262144
CREATOR_CONTEXT_KEEP_TOKENS=12000
CREATOR_CONTEXT_SUMMARY_MAX_TOKENS=8192
CREATOR_MODEL_TIMEOUT_SECONDS=120
CREATOR_MODEL_TEMPERATURE=0.2
CREATOR_HOT_RELOAD=0
