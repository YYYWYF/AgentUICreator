data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_f731bbb06f6b499a8ee86813","delta":"{\"file_path\":\"/skills/ag-ui-frontend/SKILL.md\",\"limit\":200,\"offset\":0}"}

