data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_58ed8dd283f14aeeb3a170d1","messageId":"69625d86-1f52-46aa-8f5d-759b947dc7b6","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/job-progress-panel/index.tsx\",\"content\":\"1: import { useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n2: import { useAgentUILocaleCode, usePluginEvents } from \\\"@za38.03/agent-ui-plugins\\\";\\n3: import \\\"./styles.css\\\";\\n4: \\n5: /** Name of the business event published by the Agent for task progress. */\\n6: export const JOB_PROGRESS_EVENT_NAME = \\\"app.job.progress\\\";\\n7: \\n8: type JobPhase = \\\"running\\\" | \\\"completed\\\" | \\\"failed\\\";\\n9: \\n10: interface JobErrorInfo {\\n11:   code?: string;\\n12:   message?: string;\\n13: }\\n14: \\n15: interface JobRecord {\\n16:   jobId: string;\\n17:   title: string;\\n18:   status: string;\\n19:   completed: number;\\n20:   total: number;\\n21:   error: JobErrorInfo | null;\\n22: }\\n23: \\n24: const COMPLETED_STATUSES = new Set([\\\"completed\\\", \\\"complete\\\", \\\"done\\\", \\\"succeeded\\\", \\\"success\\\", \\\"finished\\\", \\\"ok\\\"]);\\n25: const FAILED_STATUSES = new Set([\\\"failed\\\", \\\"failure\\\", \\\"error\\\", \\\"errored\\\", \\\"cancelled\\\", \\\"canceled\\\", \\\"aborted\\\", \\\"timeout\\\", \\\"rejected\\\"]);\\n26: \\n27: function normalizeStatus(value: unknown): string {\\n28:   return typeof value === \\\"string\\\" ? value.trim().toLowerCase() : \\\"\\\";\\n29: }\\n30: \\n31: function readCount(value: unknown, fallback: number): number {\\n32:   if (typeof value === \\\"number\\\" && Number.isFinite(value)) return Math.max(0, value);\\n33:   if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") {\\n34:     const parsed = Number(value);\\n35:     if (Number.isFinite(parsed)) return Math.max(0, parsed);\\n36:   }\\n37:   return fallback;\\n38: }\\n39: \\n40: function readText(value: unknown): string | undefined {\\n41:   return typeof value === \\\"string\\\" && value.trim() !== \\\"\\\" ? value : undefined;\\n42: }\\n43: \\n44: function readError(value: unknown): JobErrorInfo | null {\\n45:   if (!value || typeof value !== \\\"object\\\") return null;\\n46:   const record = value as Record<string, unknown>;\\n47:   const code = readText(record.code);\\n48:   const message = readText(record.message);\\n49:   if (!code && !message) return null;\\n50:   return { code, message };\\n51: }\\n52: \\n53: function resolvePhase(job: JobRecord): JobPhase {\\n54:   const status = normalizeStatus(job.status);\\n55:   if (job.error) return \\\"failed\\\";\\n56:   if (FAILED_STATUSES.has(status)) return \\\"failed\\\";\\n57:   if (COMPLETED_STATUSES.has(status)) return \\\"completed\\\";\\n58:   if (job.total > 0 && job.completed >= job.total) return \\\"completed\\\";\\n59:   return \\\"running\\\";\\n60: }\\n61: \\n62: function mergeJob(previous: JobRecord | undefined, payload: Record<string, unknown>): JobRecord {\\n63:   const completed = readCount(payload.completed, previous ? previous.completed : 0);\\n64:   const total = readCount(payload.total, previous ? previous.total : 0);\\n65:   const error = \\\"error\\\" in payload ? readError(payload.error) : previous ? previous.error : null;\\n66:   return {\\n67:     jobId: previous ? previous.jobId : String(payload.job_id),\\n68:     title: readText(payload.title) ?? (previous ? previous.title : \\\"\\\"),\\n69:     status: readText(payload.status) ?? (previous ? previous.status : \\\"\\\"),\\n70:     completed,\\n71:     total,\\n72:     error,\\n73:   };\\n74: }\\n75: \\n76: function upsertJob(previous: JobRecord[], payload: Record<string, unknown>): JobRecord[] {\\n77:   const jobId = String(payload.job_id);\\n78:   const index = previous.findIndex((job) => job.jobId === jobId);\\n79:   if (index === -1) return [...previous, mergeJob(undefined, payload)];\\n80:   const next = previous.slice();\\n81:   next[index] = mergeJob(previous[index], payload);\\n82:   return next;\\n83: }\\n84: \\n85: interface LocaleMessages {\\n86:   title: string;\\n87:   empty: string;\\n88:   active: (count: number) => string;\\n89:   progress: (completed: number, total: number) => string;\\n90:   errorSummary: string;\\n91:   errorCode: string;\\n92:   errorMessage: string;\\n93:   errorUnknown: string;\\n94:   status: Record<JobPhase, string>;\\n95: }\\n96: \\n97: const localeMessages: Record<string, LocaleMessages> = {\\n98:   \\\"zh-CN\\\": {\\n99:     title: \\\"任务进度\\\",\\n100:     empty: \\\"暂无任务进度\\\",\\n101:     active: (count) => `进行中 ${count} 项`,\\n102:     progress: (completed, total) => (total > 0 ? `${completed} / ${total}` : `${completed} 步`),\\n103:     errorSummary: \\\"查看错误原因\\\",\\n104:     errorCode: \\\"错误代码\\\",\\n105:     errorMessage: \\\"错误说明\\\",\\n106:     errorUnknown: \\\"未提供\\\",\\n107:     status: { running: \\\"进行中\\\", completed: \\\"已完成\\\", failed: \\\"失败\\\" },\\n108:   },\\n109:   \\\"en-US\\\": {\\n110:     title: \\\"Task progress\\\",\\n111:     empty: \\\"No task progress yet\\\",\\n112:     active: (count) => `${count} running`,\\n113:     progress: (completed, total) => (total > 0 ? `${completed} / ${total}` : `${completed} steps`),\\n114:     errorSummary: \\\"Show error reason\\\",\\n115:     errorCode: \\\"Error code\\\",\\n116:     errorMessage: \\\"Error message\\\",\\n117:     errorUnknown: \\\"Not provided\\\",\\n118:     status: { running: \\\"Running\\\", completed: \\\"Completed\\\", failed: \\\"Failed\\\" },\\n119:   },\\n120: };\\n121: \\n122: export function JobProgressPanelPlugin() {\\n123:   const localeCode = useAgentUILocaleCode();\\n124:   const messages = localeMessages[localeCode] ?? localeMessages[\\\"zh-CN\\\"]!;\\n125:   const [jobs, setJobs] = useState<JobRecord[]>([]);\\n126:   const events = usePluginEvents();\\n127:   const eventsRef = useRef(events);\\n128:   eventsRef.current = events;\\n129: \\n130:   useEffect(() => {\\n131:     const current = eventsRef.current;\\n132:     if (!current || typeof current.subscribe !== \\\"function\\\") return;\\n133:     const unsubscribe = current.subscribe<Record<string, unknown>>(JOB_PROGRESS_EVENT_NAME, (event) => {\\n134:       const payload = event ? (event.payload as Record<string, unknown> | undefined) : undefined;\\n135:       if (!payload || typeof payload !== \\\"object\\\") return;\\n136:       const jobId = payload.job_id;\\n137:       if (jobId === undefined || jobId === null || jobId === \\\"\\\") return;\\n138:       setJobs((previous) => upsertJob(previous, payload));\\n139:     });\\n140:     return () => {\\n141:       if (typeof unsubscribe === \\\"function\\\") unsubscribe();\\n142:     };\\n143:   }, []);\\n144: \\n145:   const runningCount = useMemo(() => jobs.filter((job) => resolvePhase(job) === \\\"running\\\").length, [jobs]);\\n146: \\n147:   return (\\n148:     <section className=\\\"job-progress-panel\\\" aria-label={messages.title}>\\n149:       <header className=\\\"job-progress-panel__header\\\">\\n150:         <h2 className=\\\"job-progress-panel__title\\\">{messages.title}</h2>\\n151:         {runningCount > 0 ? <span className=\\\"job-progress-panel__badge\\\">{messages.active(runningCount)}</span> : null}\\n152:       </header>\\n153:       {jobs.length === 0 ? (\\n154:         <p className=\\\"job-progress-panel__empty\\\" role=\\\"status\\\">\\n155:           {messages.empty}\\n156:         </p>\\n157:       ) : (\\n158:         <ul className=\\\"job-progress-panel__list\\\">\\n159:           {jobs.map((job) => {\\n160:             const phase = resolvePhase(job);\\n161:             const percent =\\n162:               job.total > 0\\n163:                 ? Math.min(100, Math.round((job.completed / job.total) * 100))\\n164:                 : phase === \\\"completed\\\"\\n165:                   ? 100\\n166:                   : 0;\\n167:             const label = job.title || job.jobId;\\n168:             return (\\n169:               <li className=\\\"job-progress-panel__item\\\" data-phase={phase} key={job.jobId}>\\n170:                 <div className=\\\"job-progress-panel__item-head\\\">\\n171:                   <span className=\\\"job-progress-panel__item-title\\\" title={label}>\\n172:                     {label}\\n173:                   </span>\\n174:                   <span className=\\\"job-progress-panel__status\\\" data-phase={phase}>\\n175:                     {messages.status[phase]}\\n176:                   </span>\\n177:                 </div>\\n178:                 <div className=\\\"job-progress-panel__meta\\\">\\n179:                   <span className=\\\"job-progress-panel__counts\\\">{messages.progress(job.completed, job.total)}</span>\\n180:                   <span className=\\\"job-progress-panel__percent\\\">{percent}%</span>\\n181:                 </div>\\n182:                 <div\\n183:                   aria-label={label}\\n184:                   aria-valuemax={100}\\n185:                   aria-valuemin={0}\\n186:                   aria-valuenow={percent}\\n187:                   className=\\\"job-progress-panel__track\\\"\\n188:                   role=\\\"progressbar\\\"\\n189:                 >\\n190:                   <div className=\\\"job-progress-panel__bar\\\" data-phase={phase} style={{ width: `${percent}%` }} />\\n191:                 </div>\\n192:                 {phase === \\\"failed\\\" ? (\\n193:                   <details className=\\\"job-progress-panel__error\\\">\\n194:                     <summary className=\\\"job-progress-panel__error-summary\\\">{messages.errorSummary}</summary>\\n195:                     <dl className=\\\"job-progress-panel__error-detail\\\">\\n196:                       <div className=\\\"job-progress-panel__error-row\\\">\\n197:                         <dt>{messages.errorCode}</dt>\\n198:                         <dd>\\n199:                           <code>{job.error?.code ?? messages.errorUnknown}</code>\\n200:                         </dd>\\n201:                       </div>\\n202:                       <div className=\\\"job-progress-panel__error-row\\\">\\n203:                         <dt>{messages.errorMessage}</dt>\\n204:                         <dd>{job.error?.message ?? messages.errorUnknown}</dd>\\n205:                       </div>\\n206:                     </dl>\\n207:                   </details>\\n208:                 ) : null}\\n209:               </li>\\n210:             );\\n211:           })}\\n212:         </ul>\\n213:       )}\\n214:     </section>\\n215:   );\\n216: }\\n217: \",\"hash\":\"bfb7ed9c1013b5759a9b48e9fad776b7ab8f41140b7b5ac831e4c2c90147a412\",\"totalLines\":217,\"nextOffset\":null}}","role":"tool"}

