red\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"dictation-action\",\"name\":\"Conversation Dictation Action\",\"description\":\"Adds Agent UI dictation controls to the conversation composer.\",\"capabilities\":[\"conversation-composer-trailing-action\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add voice dictation to the conversation composer\"],\"visualRole\":\"conversation composer dictation action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"trailingActions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"export-markdown-action\",\"name\":\"Conversation Export Markdown Action\",\"description\":\"Renders More with a Markdown export item for the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p22\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p19\",\"slot\":\"actions\"},\"index\":2}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"export an assistant response as Markdown\"],\"visualRole\":\"assistant response Markdown export action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"feedback-actions\",\"name\":\"Conversation Feedback Actions\",\"description\":\"Submits helpful or not helpful feedback for the response tail.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":fals