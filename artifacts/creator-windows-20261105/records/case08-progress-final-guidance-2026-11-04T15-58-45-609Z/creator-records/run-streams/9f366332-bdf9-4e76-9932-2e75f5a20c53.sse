data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_d508e34bd24048d1818d2ea6","messageId":"56fb17a3-9b73-4ca4-9a2d-cb46efa41021","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/test-notice/definition.ts\",\"content\":\"1: import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import manifestJson from \\\"./manifest.json\\\";\\n3: import { TestNoticePlugin } from \\\"./index\\\";\\n4: \\n5: const definition: UIPluginDefinition = {\\n6:   manifest: manifestJson as UIPluginManifest,\\n7:   provides: [],\\n8:   inject: [],\\n9:   optionalInject: [\\\"agent-ui.locale\\\"],\\n10:   Component: TestNoticePlugin,\\n11: };\\n12: \\n13: export default definition;\\n14: \",\"hash\":\"bba53cc3ebca46f9183dfca07295b5b29e48346c82e0dbcebc1d97585759e5ff\",\"totalLines\":14,\"nextOffset\":null,\"recovery\":{\"action\":\"reuse_observed_file\",\"path\":\"src/agent-ui/plugins/test-notice/definition.ts\",\"repeatedUnchangedReads\":3,\"instruction\":\"This unchanged range was read in this run; its evidence remains recorded and edits check current hashes. Reuse it. Query only a concrete missing public contract. New project-owned behavior may be designed within authorization and validated after implementation; its absence in current source is expected. Protected paths and takeover permissions have not changed.\"}}}","role":"tool"}

