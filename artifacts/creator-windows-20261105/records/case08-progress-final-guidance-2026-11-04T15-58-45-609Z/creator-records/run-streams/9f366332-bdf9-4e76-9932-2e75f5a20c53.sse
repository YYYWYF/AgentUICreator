data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_b102775ae1bc4836b4c4f28a","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":250,\"offset\":0}"}

