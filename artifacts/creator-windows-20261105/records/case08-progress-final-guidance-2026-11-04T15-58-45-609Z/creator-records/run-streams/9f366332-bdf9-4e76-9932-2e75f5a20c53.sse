data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_21402121b19343519e1d4f17","messageId":"fbd20357-092c-42a2-bde2-b29197f4e2c3","content":"{\"ok\":true,\"result\":{\"eligible\":false,\"appUIModelHash\":\"ec814f21d2857a86f24a3cd35ae3cbc8d079f4b634bd7553dc7738d8ba4c5d7c\",\"capabilityCatalogRevision\":\"03f888fce2d7783381854d8fa83978107fd642ae60dcbaa150c148f5a1ac9769\",\"diagnostic\":{\"code\":\"AUTHORING_DEFAULT_PLACEMENT_UNSUPPORTED\",\"message\":\"Anchor region for \\\"auto_a63bcc9af1da563c\\\" is not a direct child of a supported row.\",\"details\":{\"anchorInstanceId\":\"auto_a63bcc9af1da563c\",\"expectedParentType\":\"row\",\"actualParentType\":\"column\",\"parentKind\":\"children\"}}}}","role":"tool"}

