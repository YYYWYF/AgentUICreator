n-surface\",\"slot\":\"emptySuggestions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-surface\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/conversation-surface\",\"component\":\"ConversationSurfacePlugin\",\"facts\":{\"presentation\":\"The canonical empty conversation centers its welcome content and composer. A populated conversation pins its viewport footer toward the bottom. Resizing the outer AppUIModel track alone does not change this internal empty-state alignment.\",\"composition\":\"Keep the existing canonical Conversation Adapter, renderer slots and Composer. Layout changes inside this surface belong in project application composition or scoped CSS, without replacing the Runtime or adding component props to AppUIModel.\",\"styles\":\"The internal content has data-slot=agent-ui-thread-content and flex:1 with a column layout; the composer container has class aui-thread-viewport-footer. To keep the composer at the bottom even in an empty conversation, project CSS can override the content's justify-content and give its footer margin-top:auto. Scope selectors to this conversation surface and verify the actual desktop and narrow Host, including overflow, welcome content and messages.\"}},\"name\":\"Conversation Surface\",\"description\":\"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\"capabilities\":[\"conversation-surface\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p10\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l11\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary live and historical conversation experience\"],\"visualRole\":\"primary conversation surface\",\"recommendedSize\":{\"width\":\"minmax(0, 1fr)\"}},\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"childSlots\":{\"assistantResponseFooter\":{\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]}},\"composer\":{\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]}},\"emptySuggestions\":{\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]}},\"emptyWelcome\":{\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"optional\":true},\"headerActions\":{\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]}},\"reasoningGroup\":{\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]}},\"taskGroup\":{\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]}},\"thinkingIndicator\":{\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]}},\"toolFallback\":{\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\