data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_9060abb9bf8a440093da5588","messageId":"13fb2bb7-f13b-491e-a21b-a596a36ab24a","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"373e8784ed400aa3d4982d94a83cffc45fb4fede729b539cc5b62ef39947bfd9\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"title\":\"Plugin Authoring Contract\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/plugin-authoring-contract.md\",\"summary\":\"自定义插件 authoring、默认放置、容器子插槽、renderer、样式隔离和校验合同。\",\"sha256\":\"e09945ea7269cd43caabbf18eb2a96fce0f127db8abd03a001cde12119c91e22\",\"totalSections\":11,\"offset\":0,\"sections\":[{\"sectionId\":\"s1\",\"title\":\"Plugin Authoring Contract\",\"level\":1,\"characters\":7282,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s20\",\"title\":\"Scope\",\"level\":2,\"characters\":543,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s20\"}}},{\"sectionId\":\"s31\",\"title\":\"Plugin categories\",\"level\":2,\"characters\":794,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s44\",\"title\":\"Authoring fields\",\"level\":2,\"characters\":1665,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s44\"}}},{\"sectionId\":\"s46\",\"title\":\"`intents`\",\"level\":3,\"characters\":338,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s46\"}}},{\"sectionId\":\"s62\",\"title\":\"`visualRole`\",\"level\":3,\"characters\":197,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s62\"}}},{\"sectionId\":\"s68\",\"title\":\"`defaultPlacement`\",\"level\":3,\"characters\":906,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s68\"}}},{\"sectionId\":\"s91\",\"title\":\"`recommendedSize`\",\"level\":3,\"characters\":203,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s91\"}}},{\"sectionId\":\"s97\",\"title\":\"Readiness states\",\"level\":2,\"characters\":1272,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s97\"}}},{\"sectionId\":\"s127\",\"title\":\"Style Isolation Contract\",\"level\":2,\"characters\":1539,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s127\"}}},{\"sectionId\":\"s154\",\"title\":\"Validation boundary\",\"level\":2,\"characters\":882,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s154\"}}}],\"nextOffset\":null}}","role":"tool"}

