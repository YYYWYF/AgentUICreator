data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_0b85d934bfe44a29934824b8","messageId":"b0ca6918-d0d5-40e5-bf5d-1a614a00c0a0","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"373e8784ed400aa3d4982d94a83cffc45fb4fede729b539cc5b62ef39947bfd9\",\"query\":\"resizable panel width resize\",\"total\":12,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/layout-and-composition\",\"title\":\"布局与插件组合\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/layout-and-composition.md\",\"summary\":\"Agent UI 把会话列表、输入框、附件、复制等功能做成了插件。你可以按需启用、调整位置，也可以把多个插件组合起来。 本页说明如何手动修改布局配置。界面排列、插件实例及组合保存在 app-ui.json 中，组件属性和渲染代码放在项目插件入口。 日常调整可以直接把需求告诉 Creator，见布局调整示例。自己编辑时，先找到下文的配置文件，保留现有实例 ID，再按需修改位置、尺寸和组合。\",\"sha256\":\"472d2f6ae3449c0e8c1ef05791cfaf3213aab0fcb226ba8eda9037c9ef804047\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\"}},\"matchingSections\":[{\"sectionId\":\"s187\",\"title\":\"布局与尺寸\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/layout-and-composition\",\"sectionId\":\"s187\"}}}]},{\"documentId\":\"public:start/index\",\"title\":\"开始使用\",\"source\":\"public\",\"topic\":\"开始使用\",\"path\":\"start/index.md\",\"summary\":\"为你的产品加入 AI 助理，用自然语言调整界面。从现有 React 工程出发，完成接入、首次对话和第一次定制。\",\"sha256\":\"11355dee8e8f6d796be9f50499c23a9ba7a038530da015a286f66070a752a125\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\"}},\"matchingSections\":[{\"sectionId\":\"s89\",\"title\":\"选择模板和源码位置\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\",\"sectionId\":\"s89\"}}}]},{\"documentId\":\"public:development/react-host-control\",\"title\":\"业务页面与 Agent 联动\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-control.md\",\"summary\":\"\",\"sha256\":\"a854709abc89e1b39e9dba85a5afbded4b307d50e199d08609d57f81a16281c6\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\"}},\"matchingSections\":[{\"sectionId\":\"s45\",\"title\":\"示例代码：业务按钮联动\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\",\"sectionId\":\"s45\"}}}]},{\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"title\":\"Plugin Authoring Contract\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/plugin-authoring-contract.md\",\"summary\":\"自定义插件 authoring、默认放置、容器子插槽、renderer、样式隔离和校验合同。\",\"sha256\":\"e09945ea7269cd43caabbf18eb2a96fce0f127db8abd03a001cde12119c91e22\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\"}},\"matchingSections\":[{\"sectionId\":\"s68\",\"title\":\"`defaultPlacement`\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/plugin-authoring-contract\",\"sectionId\":\"s68\"}}}]},{\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"title\":\"Generic Sidebar Layout\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/architecture/generic-sidebar-layout.md\",\"summary\":\"Sidebar 布局、左右区域、尺寸与语义组合。\",\"sha256\":\"c92dc7ccf3c65ac4eb711c1251a3d485f0ebb128b5a5a36facc855dd27d8b996\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\"}},\"matchingSections\":[{\"sectionId\":\"s31\",\"title\":\"Product adapter differences\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s31\"}}},{\"sectionId\":\"s48\",\"title\":\"Optional identity Header\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s48\"}}},{\"sectionId\":\"s42\",\"title\":\"Creator and templates\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/generic-sidebar-layout\",\"sectionId\":\"s42\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s170\",\"title\":\"外壳定制\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s170\"}}},{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"统一 Plugins 包、内置源码目录与按需源码托管\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/architecture/npm-default-plugin-source-ownership.md\",\"summary\":\"npm 默认交付、项目薄应用层、源码接管授权、BASE/LOCAL/TARGET 与更新保护。\",\"sha256\":\"cbc8052587ee42d67d634c94f1fd9dac8ace5603ec4d4e92bf10e191af808eb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s29\",\"title\":\"2. 项目外壳\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s29\"}}}]},{\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"title\":\"Frontend Tool lifecycle\",\"source\":\"internal\",\"topic\":\"会话与交互\",\"path\":\"references/docs/architecture/frontend-tool-lifecycle.md\",\"summary\":\"Frontend Tool 注册、执行、审批、中断恢复、取消与历史副作用隔离。\",\"sha256\":\"a85582fdaf1e1290ec823ca5c9f7e61609ef3c3b2a5e6c181058d63d24d1367b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\"}},\"matchingSections\":[{\"sectionId\":\"s44\",\"title\":\"Execute versus render\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"sectionId\":\"s44\"}}}]}],\"nextOffset\":8}}","role":"tool"}

