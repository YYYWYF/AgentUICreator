data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_08f3e684c2024fa1be2676c4","messageId":"7f747af1-d37e-4ba4-8df3-de0b93de6285","content":"{\"ok\":true,\"result\":{\"hash\":\"ec814f21d2857a86f24a3cd35ae3cbc8d079f4b634bd7553dc7738d8ba4c5d7c\",\"source\":\"{\\n  \\\"applicationPlugins\\\": [\\n    {\\n      \\\"pluginId\\\": \\\"conversation-data-source\\\"\\n    },\\n    {\\n      \\\"pluginId\\\": \\\"conversation-service\\\"\\n    },\\n    {\\n      \\\"pluginId\\\": \\\"theme-provider\\\"\\n    },\\n    {\\n      \\\"pluginId\\\": \\\"locale-provider\\\"\\n    },\\n    {\\n      \\\"pluginId\\\": \\\"context-retrieval-message\\\"\\n    }\\n  ],\\n  \\\"root\\\": {\\n    \\\"type\\\": \\\"row\\\",\\n    \\\"children\\\": [\\n      {\\n        \\\"type\\\": \\\"panel\\\",\\n        \\\"child\\\": {\\n          \\\"type\\\": \\\"column\\\",\\n          \\\"children\\\": [\\n            {\\n              \\\"type\\\": \\\"slot\\\",\\n              \\\"plugins\\\": [\\n                {\\n                  \\\"pluginId\\\": \\\"theme-switch\\\"\\n                },\\n                {\\n                  \\\"pluginId\\\": \\\"agent-identity\\\"\\n                }\\n              ]\\n            },\\n            {\\n              \\\"type\\\": \\\"slot\\\",\\n              \\\"plugins\\\": [\\n                {\\n                  \\\"pluginId\\\": \\\"conversation-thread-list\\\",\\n                  \\\"slots\\\": {\\n                    \\\"headerActions\\\": [\\n                      {\\n                        \\\"pluginId\\\": \\\"conversation-new\\\"\\n                      }\\n                    ]\\n                  }\\n                }\\n              ]\\n            }\\n          ],\\n          \\\"gap\\\": 0,\\n          \\\"sizes\\\": [\\n            \\\"52px\\\",\\n            \\\"minmax(0, 1fr)\\\"\\n          ]\\n        }\\n      },\\n      {\\n        \\\"type\\\": \\\"panel\\\",\\n        \\\"child\\\": {\\n          \\\"type\\\": \\\"column\\\",\\n          \\\"children\\\": [\\n            {\\n              \\\"type\\\": \\\"panel\\\",\\n              \\\"child\\\": {\\n                \\\"type\\\": \\\"slot\\\",\\n                \\\"plugins\\\": [\\n                  {\\n                    \\\"id\\\": \\\"p23\\\",\\n                    \\\"pluginId\\\": \\\"test-notice\\\"\\n                  }\\n                ]\\n              }\\n            },\\n            {\\n              \\\"type\\\": \\\"panel\\\",\\n              \\\"child\\\": {\\n                \\\"type\\\": \\\"slot\\\",\\n                \\\"plugins\\\": [\\n                  {\\n                    \\\"id\\\": \\\"p24\\\",\\n                    \\\"pluginId\\\": \\\"quick-help-card\\\",\\n                    \\\"slots\\\": {\\n                      \\\"body\\\": [\\n                        {\\n                          \\\"id\\\": \\\"p25\\\",\\n                          \\\"pluginId\\\": \\\"quick-help-content\\\"\\n                        }\\n                      ],\\n                      \\\"headerActions\\\": [\\n                        {\\n                          \\\"pluginId\\\": \\\"help-dismiss-action\\\"\\n                        }\\n                      ]\\n                    }\\n                  }\\n                ]\\n              }\\n            },\\n            {\\n              \\\"type\\\": \\\"slot\\\",\\n              \\\"plugins\\\": [\\n                {\\n                  \\\"pluginId\\\": \\\"conversation-surface\\\",\\n                  \\\"slots\\\": {\\n                    \\\"emptySuggestions\\\": [\\n                      {\\n                        \\\"pluginId\\\": \\\"conversation-suggestions\\\"\\n                      }\\n                    ],\\n                    \\\"composer\\\": [\\n                      {\\n                        \\\"pluginId\\\": \\\"composer\\\",\\n                        \\\"slots\\\": {\\n                          \\\"leadingActions\\\": [\\n                           