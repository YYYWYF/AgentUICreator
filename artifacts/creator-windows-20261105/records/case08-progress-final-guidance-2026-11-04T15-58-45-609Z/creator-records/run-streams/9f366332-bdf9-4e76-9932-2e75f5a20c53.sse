data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_38352e15b9a94d6194cc62ea","delta":"{\"pluginId\":\"job-progress-panel\",\"files\":[{\"relativePath\":\"manifest.json\",\"content\":\"{\\n  \\\"id\\\": \\\"job-progress-panel\\\",\\n  \\\"name\\\": \\\"Job Progress Panel\\\",\\n  \\\"description\\\": \\\"Subscribes to live app.job.progress business events and shows task progress rows merged by job_id at the right side of the chat area.\\\",\\n  \\\"version\\\": \\\"0.0.1\\\",\\n  \\\"capabilities\\\": [\\n    \\\"job-progress-panel\\\"\\n  ],\\n  \\\"layout\\\": {\\n    \\\"width\\\": \\\"narrow\\\"\\n  },\\n  \\\"data\\\": {\\n    \\\"events\\\": [\\n      \\\"app.job.progress\\\"\\n    ]\\n  },\\n  \\\"authoring\\\": {\\n    \\\"intents\\\": [\\n      \\\"show task progress at the right of the chat area\\\",\\n      \\\"显示任务进度面板\\\",\\n      \\\"在聊天区域右侧显示任务进度\\\"\\n    ],\\n    \\\"visualRole\\\": \\\"chat area right task progress panel\\\",\\n    \\\"recommendedSize\\\": {\\n      \\\"width\\\": \\\"320px\\\"\\n    },\\n    \\\"defaultPlacement\\\": {\\n      \\\"type\\\": \\\"relative\\\",\\n      \\\"relation\\\": \\\"after\\\",\\n      \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n    }\\n  }\\n}\\n\"},{\"relativePath\":\"definition.ts\",\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { JobProgressPanelPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: JobProgressPanelPlugin,\\n};\\n\\nexport default definition;\\n\"},{\"relativePath\":\"events.ts\",\"content\":\"import { z } from \\\"zod\\\";\\n\\n/** Error object carried by a failed job progress event. */\\nexport const jobProgressErrorSchema = z.object({\\n  code: z.string(),\\n  message: z.string(),\\n});\\n\\n/**\\n * Payload of the \\\"app.job.progress\\\" business event:\\n * { job_id, title, status, completed, total, error }\\n */\\nexport const jobProgressEventSchema = z.object({\\n  job_id: z.union([z.string(), z.number()]).transform((value) => String(value)),\\n  title: z.string().optional(),\\n  status: z.string().optional(),\\n  completed: z.union([z.number(), z.string()]).optional(),\\n  total: z.union([z.number(), z.string()]).optional(),\\n  error: z.union([jobProgressErrorSchema, z.null()]).optional(),\\n});\\n\\nexport type JobProgressEventPayload = z.infer<typeof jobProgressEventSchema>;\\n\\n/** Event schemas registered with the Conversation Runtime through AgentProps.appEventSchemas. */\\nexport const jobProgressAppEventSchemas = {\\n  \\\"app.job.progress\\\": jobProgressEventSchema,\\n} as const;\\n\"},{\"relativePath\":\"index.tsx\",\"content\":\"import { useEffect, useMemo, useRef, useState } from \\\"react\\\";\\nimport { useAgentUILocaleCode, usePluginEvents } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport \\\"./styles.css\\\";\\n\\n/** Name of the business event published by the Agent for task progress. */\\nexport const JOB_PROGRESS_EVENT_NAME = \\\"app.job.progress\\\";\\n\\ntype JobPhase = \\\"running\\\" | \\\"completed\\\" | \\\"failed\\\";\\n\\ninterface JobErrorInfo {\\n  code?: string;\\n  message?: string;\\n}\\n\\ninterface JobRecord {\\n  jobId: string;\\n  title: string;\\n  status: string;\\n  completed: number;\\n  total: number;\\n  error: JobErrorInfo | null;\\n}\\n\\nconst COMPLETED_STATUSES = new Set([\\\"completed\\\", \\\"complete\\\", \\\"done\\\", \\\"succeeded\\\", \\\"success\\\", \\\"finished\\\", \\\"ok\\\"]);\\nconst FAILED_STATUSES = new Set([\\\"failed\\\", \\\"failure\\\", \\\"error\\\", \\\"errored\\\", \\\"cancelled\\\", \\\"canceled\\\", \\\"aborted\\\", \\\"timeout\\\", \\\"rejected\\\"]);\\n\\nfunction normalizeStatus(value: unknown): string {\\n  return typeof value === \\\"string\\\" ? value.trim().toLowerCase() : \\\"\\\";\\n}\\n\\nfunction readCount(value: unknown, fallback: number): number {\\n  if (typeof value === \\\"number\\\" && Number.isFinite(value)) return Math.max(0, value);\\n  if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") {\\n    const parsed = Number(value);\\n    if (Number.isFinite(parsed)) return Math.max(0, parsed);\\n  }\\n  return fallback;\\n}\\n\\nfunction readText(value: unknown): string | undefined {\\n  return typeof value === \\\"string\\\" && value.trim() !== \\\"\\\" ? value : undefined;\\n}\\n\\nfunction readError(value: unknown): JobErrorInfo | null {\\n  if (!value || typeof value !== \\\"object\\\") return null;\\n  const record = value as Record<string, unknown>;\\n  const code = readText(record.code);\\n  const message = readText(record.message);\\n  if (!code && !message) return null;\\n  return { code, message };\\n}\\n\\nfunction resolvePhase(job: JobRecord): JobPhase {\\n  const status = normalizeStatus(job.status);\\n  if (job.error) return \\\"failed\\\";\\n  if (FAILED_STATUSES.has(status)) return \\\"failed\\\";\\n  if (COMPLETED_STATUSES.has(status)) return \\\"completed\\\";\\n  if (job.total > 0 && job.completed >= job.total) return \\\"completed\\\";\\n  return \\\"running\\\";\\n}\\n\\nfunction mergeJob(previous: JobRecord | undefined, payload: Record<string, unknown>): JobRecord {\\n  const completed = readCount(payload.completed, previous ? previous.completed : 0);\\n  const total = readCount(payload.total, previous ? previous.total : 0);\\n  const error = \\\"error\\\" in payload ? readError(payload.error) : previous ? previous.error : null;\\n  return {\\n    jobId: previous ? previous.jobId : String(payload.job_id),\\n    title: readText(payload.title) ?? (previous ? previous.title : \\\"\\\"),\\n    status: readText(payload.status) ?? (previous ? previous.status : \\\"\\\"),\\n    completed,\\n    total,\\n    error,\\n  };\\n}\\n\\nfunction upsertJob(previous: JobRecord[], payload: Record<string, unknown>): JobRecord[] {\\n  const jobId = String(payload.job_id);\\n  const index = previous.findIndex((job) => job.jobId === jobId);\\n  if (index === -1) return [...previous, mergeJob(undefined, payload)];\\n  const next = previous.slice();\\n  next[index] = mergeJob(previous[index], payload);\\n  return next;\\n}\\n\\ninterface LocaleMessages {\\n  title: string;\\n  empty: string;\\n  active: (count: number) => string;\\n  progress: (completed: number, total: number) => string;\\n  errorSummary: string;\\n  errorCode: string;\\n  errorMessage: string;\\n  errorUnknown: string;\\n  status: Record<JobPhase, string>;\\n}\\n\\nconst localeMessages: Record<string, LocaleMessages> = {\\n  \\\"zh-CN\\\": {\\n    title: \\\"任务进度\\\",\\n    empty: \\\"暂无任务进度\\\",\\n    active: (count) => `进行中 ${count} 项`,\\n    progress: (completed, total) => (total > 0 ? `${completed} / ${total}` : `${completed} 步`),\\n    errorSummary: \\\"查看错误原因\\\",\\n    errorCode: \\\"错误代码\\\",\\n    errorMessage: \\\"错误说明\\\",\\n    errorUnknown: \\\"未提供\\\",\\n    status: { running: \\\"进行中\\\", completed: \\\"已完成\\\", failed: \\\"失败\\\" },\\n  },\\n  \\\"en-US\\\": {\\n    title: \\\"Task progress\\\",\\n    empty: \\\"No task progress yet\\\",\\n    active: (count) => `${count} running`,\\n    progress: (completed, total) => (total > 0 ? `${completed} / ${total}` : `${completed} steps`),\\n    errorSummary: \\\"Show error reason\\\",\\n    errorCode: \\\"Error code\\\",\\n    errorMessage: \\\"Error message\\\",\\n    errorUnknown: \\\"Not provided\\\",\\n    status: { running: \\\"Running\\\", completed: \\\"Completed\\\", failed: \\\"Failed\\\" },\\n  },\\n};\\n\\nexport function JobProgressPanelPlugin() {\\n  const localeCode = useAgentUILocaleCode();\\n  const messages = localeMessages[localeCode] ?? localeMessages[\\\"zh-CN\\\"]!;\\n  const [jobs, setJobs] = useState<JobRecord[]>([]);\\n  const events = usePluginEvents();\\n  const eventsRef = useRef(events);\\n  eventsRef.current = events;\\n\\n  useEffect(() => {\\n    const current = eventsRef.current;\\n    if (!current || typeof current.subscribe !== \\\"function\\\") return;\\n    const unsubscribe = current.subscribe<Record<string, unknown>>(JOB_PROGRESS_EVENT_NAME, (event) => {\\n      const payload = event ? (event.payload as Record<string, unknown> | undefined) : undefined;\\n      if (!payload || typeof payload !== \\\"object\\\") return;\\n      const jobId = payload.job_id;\\n      if (jobId === undefined || jobId === null || jobId === \\\"\\\") return;\\n      setJobs((previous) => upsertJob(previous, payload));\\n    });\\n    return () => {\\n      if (typeof unsubscribe === \\\"function\\\") unsubscribe();\\n    };\\n  }, []);\\n\\n  const runningCount = useMemo(() => jobs.filter((job) => resolvePhase(job) === \\\"running\\\").length, [jobs]);\\n\\n  return (\\n    <section className=\\\"job-progress-panel\\\" aria-label={messages.title}>\\n      <header className=\\\"job-progress-panel__header\\\">\\n        <h2 className=\\\"job-progress-panel__title\\\">{messages.title}</h2>\\n        {runningCount > 0 ? <span className=\\\"job-progress-panel__badge\\\">{messages.active(runningCount)}</span> : null}\\n      </header>\\n      {jobs.length === 0 ? (\\n        <p className=\\\"job-progress-panel__empty\\\" role=\\\"status\\\">\\n          {messages.empty}\\n        </p>\\n      ) : (\\n        <ul className=\\\"job-progress-panel__list\\\">\\n          {jobs.map((job) => {\\n            const phase = resolvePhase(job);\\n            const percent =\\n              job.total > 0\\n                ? Math.min(100, Math.round((job.completed / job.total) * 100))\\n                : phase === \\\"completed\\\"\\n                  ? 100\\n                  : 0;\\n            const label = job.title || job.jobId;\\n            return (\\n              <li className=\\\"job-progress-panel__item\\\" data-phase={phase} key={job.jobId}>\\n                <div className=\\\"job-progress-panel__item-head\\\">\\n                  <span className=\\\"job-progress-panel__item-title\\\" title={label}>\\n                    {label}\\n                  </span>\\n                  <span className=\\\"job-progress-panel__status\\\" data-phase={phase}>\\n                    {messages.status[phase]}\\n                  </span>\\n                </div>\\n                <div className=\\\"job-progress-panel__meta\\\">\\n                  <span className=\\\"job-progress-panel__counts\\\">{messages.progress(job.completed, job.total)}</span>\\n                  <span className=\\\"job-progress-panel__percent\\\">{percent}%</span>\\n                </div>\\n                <div\\n                  aria-label={label}\\n                  aria-valuemax={100}\\n                  aria-valuemin={0}\\n                  aria-valuenow={percent}\\n                  className=\\\"job-progress-panel__track\\\"\\n                  role=\\\"progressbar\\\"\\n                >\\n                  <div className=\\\"job-progress-panel__bar\\\" data-phase={phase} style={{ width: `${percent}%` }} />\\n                </div>\\n                {phase === \\\"failed\\\" ? (\\n                  <details className=\\\"job-progress-panel__error\\\">\\n                    <summary className=\\\"job-progress-panel__error-summary\\\">{messages.errorSummary}</summary>\\n                    <dl className=\\\"job-progress-panel__error-detail\\\">\\n                      <div className=\\\"job-progress-panel__error-row\\\">\\n                        <dt>{messages.errorCode}</dt>\\n                        <dd>\\n                          <code>{job.error?.code ?? messages.errorUnknown}</code>\\n                        </dd>\\n                      </div>\\n                      <div className=\\\"job-progress-panel__error-row\\\">\\n                        <dt>{messages.errorMessage}</dt>\\n                        <dd>{job.error?.message ?? messages.errorUnknown}</dd>\\n                      </div>\\n                    </dl>\\n                  </details>\\n                ) : null}\\n              </li>\\n            );\\n          })}\\n        </ul>\\n      )}\\n    </section>\\n  );\\n}\\n\"},{\"relativePath\":\"styles.css\",\"content\":\".job-progress-panel {\\n  box-sizing: border-box;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  width: 100%;\\n  min-width: 0;\\n  height: 100%;\\n  min-height: 0;\\n  padding: 12px 12px 8px;\\n  background: var(--background, #ffffff);\\n  color: var(--foreground, #111111);\\n  border-left: 1px solid var(--border, #e5e7eb);\\n  overflow: hidden;\\n}\\n\\n.job-progress-panel__header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 8px;\\n  flex: 0 0 auto;\\n  min-width: 0;\\n}\\n\\n.job-progress-panel__title {\\n  margin: 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  line-height: 1.4;\\n  min-width: 0;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.job-progress-panel__badge {\\n  flex: 0 0 auto;\\n  padding: 1px 8px;\\n  border-radius: 999px;\\n  font-size: 11px;\\n  line-height: 1.6;\\n  background: var(--muted, #f3f4f6);\\n  color: var(--foreground, #111111);\\n  opacity: 0.85;\\n}\\n\\n.job-progress-panel__empty {\\n  margin: 0;\\n  font-size: 12px;\\n  line-height: 1.6;\\n  color: var(--foreground, #111111);\\n  opacity: 0.6;\\n  word-break: break-word;\\n}\\n\\n.job-progress-panel__list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  flex: 1 1 auto;\\n  min-height: 0;\\n  margin: 0;\\n  padding: 0 2px 0 0;\\n  list-style: none;\\n  overflow-y: auto;\\n  overscroll-behavior: contain;\\n}\\n\\n.job-progress-panel__item {\\n  box-sizing: border-box;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n  min-width: 0;\\n  padding: 8px 10px;\\n  border: 1px solid var(--border, #e5e7eb);\\n  border-radius: 8px;\\n  background: var(--background, #ffffff);\\n}\\n\\n.job-progress-panel__item-head {\\n  display: flex;\\n  align-items: baseline;\\n  justify-content: space-between;\\n  gap: 8px;\\n  min-width: 0;\\n}\\n\\n.job-progress-panel__item-title {\\n  flex: 1 1 auto;\\n  min-width: 0;\\n  font-size: 13px;\\n  font-weight: 500;\\n  line-height: 1.5;\\n  overflow-wrap: anywhere;\\n}\\n\\n.job-progress-panel__status {\\n  flex: 0 0 auto;\\n  font-size: 11px;\\n  line-height: 1.6;\\n  padding: 0 6px;\\n  border-radius: 999px;\\n  background: var(--muted, #f3f4f6);\\n}\\n\\n.job-progress-panel__status[data-phase=\\\"completed\\\"] {\\n  color: #15803d;\\n}\\n\\n.job-progress-panel__status[data-phase=\\\"failed\\\"] {\\n  color: var(--destructive, #b42318);\\n}\\n\\n.job-progress-panel__meta {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 8px;\\n  font-size: 11px;\\n  line-height: 1.5;\\n  opacity: 0.7;\\n  min-width: 0;\\n}\\n\\n.job-progress-panel__track {\\n  position: relative;\\n  width: 100%;\\n  height: 4px;\\n  border-radius: 999px;\\n  background: var(--muted, #f3f4f6);\\n  overflow: hidden;\\n}\\n\\n.job-progress-panel__bar {\\n  height: 100%;\\n  border-radius: inherit;\\n  background: var(--primary, #2563eb);\\n  transition: width 160ms ease-out;\\n}\\n\\n.job-progress-panel__bar[data-phase=\\\"completed\\\"] {\\n  background: #15803d;\\n}\\n\\n.job-progress-panel__bar[data-phase=\\\"failed\\\"] {\\n  background: var(--destructive, #b42318);\\n}\\n\\n.job-progress-panel__error {\\n  min-width: 0;\\n  font-size: 11px;\\n  line-height: 1.6;\\n}\\n\\n.job-progress-panel__error-summary {\\n  cursor: pointer;\\n  color: var(--destructive, #b42318);\\n  word-break: break-word;\\n}\\n\\n.job-progress-panel__error-detail {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n  margin: 6px 0 0;\\n  padding: 6px 8px;\\n  border-radius: 6px;\\n  background: var(--muted, #f3f4f6);\\n}\\n\\n.job-progress-panel__error-row {\\n  display: flex;\\n  gap: 6px;\\n  min-width: 0;\\n}\\n\\n.job-progress-panel__error-row dt {\\n  flex: 0 0 auto;\\n  opacity: 0.65;\\n}\\n\\n.job-progress-panel__error-row dd {\\n  flex: 1 1 auto;\\n  min-width: 0;\\n  margin: 0;\\n  overflow-wrap: anywhere;\\n}\\n\\n.job-progress-panel__error-row code {\\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\\n  overflow-wrap: anywhere;\\n}\\n\"}]}"}

