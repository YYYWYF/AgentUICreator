data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_0743c7db1db642b0bd03fc7d","messageId":"38c8112d-7b2d-4ab1-92c4-6bc15bb531cb","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/job-progress-panel/styles.css\",\"content\":\"1: .job-progress-panel {\\n2:   box-sizing: border-box;\\n3:   display: flex;\\n4:   flex-direction: column;\\n5:   gap: 8px;\\n6:   width: 100%;\\n7:   min-width: 0;\\n8:   height: 100%;\\n9:   min-height: 0;\\n10:   padding: 12px 12px 8px;\\n11:   background: var(--background, #ffffff);\\n12:   color: var(--foreground, #111111);\\n13:   border-left: 1px solid var(--border, #e5e7eb);\\n14:   overflow: hidden;\\n15: }\\n16: \\n17: .job-progress-panel__header {\\n18:   display: flex;\\n19:   align-items: center;\\n20:   justify-content: space-between;\\n21:   gap: 8px;\\n22:   flex: 0 0 auto;\\n23:   min-width: 0;\\n24: }\\n25: \\n26: .job-progress-panel__title {\\n27:   margin: 0;\\n28:   font-size: 14px;\\n29:   font-weight: 600;\\n30:   line-height: 1.4;\\n31:   min-width: 0;\\n32:   overflow: hidden;\\n33:   text-overflow: ellipsis;\\n34:   white-space: nowrap;\\n35: }\\n36: \\n37: .job-progress-panel__badge {\\n38:   flex: 0 0 auto;\\n39:   padding: 1px 8px;\\n40:   border-radius: 999px;\\n41:   font-size: 11px;\\n42:   line-height: 1.6;\\n43:   background: var(--muted, #f3f4f6);\\n44:   color: var(--foreground, #111111);\\n45:   opacity: 0.85;\\n46: }\\n47: \\n48: .job-progress-panel__empty {\\n49:   margin: 0;\\n50:   font-size: 12px;\\n51:   line-height: 1.6;\\n52:   color: var(--foreground, #111111);\\n53:   opacity: 0.6;\\n54:   word-break: break-word;\\n55: }\\n56: \\n57: .job-progress-panel__list {\\n58:   display: flex;\\n59:   flex-direction: column;\\n60:   gap: 8px;\\n61:   flex: 1 1 auto;\\n62:   min-height: 0;\\n63:   margin: 0;\\n64:   padding: 0 2px 0 0;\\n65:   list-style: none;\\n66:   overflow-y: auto;\\n67:   overscroll-behavior: contain;\\n68: }\\n69: \\n70: .job-progress-panel__item {\\n71:   box-sizing: border-box;\\n72:   display: flex;\\n73:   flex-direction: column;\\n74:   gap: 6px;\\n75:   min-width: 0;\\n76:   padding: 8px 10px;\\n77:   border: 1px solid var(--border, #e5e7eb);\\n78:   border-radius: 8px;\\n79:   background: var(--background, #ffffff);\\n80: }\\n81: \\n82: .job-progress-panel__item-head {\\n83:   display: flex;\\n84:   align-items: baseline;\\n85:   justify-content: space-between;\\n86:   gap: 8px;\\n87:   min-width: 0;\\n88: }\\n89: \\n90: .job-progress-panel__item-title {\\n91:   flex: 1 1 auto;\\n92:   min-width: 0;\\n93:   font-size: 13px;\\n94:   font-weight: 500;\\n95:   line-height: 1.5;\\n96:   overflow-wrap: anywhere;\\n97: }\\n98: \\n99: .job-progress-panel__status {\\n100:   flex: 0 0 auto;\\n101:   font-size: 11px;\\n102:   line-height: 1.6;\\n103:   padding: 0 6px;\\n104:   border-radius: 999px;\\n105:   background: var(--muted, #f3f4f6);\\n106: }\\n107: \\n108: .job-progress-panel__status[data-phase=\\\"completed\\\"] {\\n109:   color: #15803d;\\n110: }\\n111: \\n112: .job-progress-panel__status[data-phase=\\\"failed\\\"] {\\n113:   color: var(--destructive, #b42318);\\n114: }\\n115: \\n116: .job-progress-panel__meta {\\n117:   display: flex;\\n118:   align-items: center;\\n119:   justify-content: space-between;\\n120:   gap: 8px;\\n121:   font-size: 11px;\\n122:   line-height: 1.5;\\n123:   opacity: 0.7;\\n124:   min-width: 0;\\n125: }\\n126: \\n127: .job-progress-panel__track {\\n128:   position: relative;\\n129:   width: 100%;\\n130:   height: 4px;\\n131:   border-radius: 999px;\\n132:   background: var(--muted, #f3f4f6);\\n133:   overflow: hidden;\\n134: }\\n135: \\n136: .job-progress-panel__bar {\\n137:   height: 100%;\\n138:   border-radius: inherit;\\n139:   background: var(--primary, #2563eb);\\n140:   transition: width 160ms ease-out;\\n141: }\\n142: \\n143: .job-progress-panel__bar[data-phase=\\\"completed\\\"] {\\n144:   background: #15803d;\\n145: }\\n146: \\n147: .job-progress-panel__bar[data-phase=\\\"failed\\\"] {\\n148:   background: var(--destructive, #b42318);\\n149: }\\n150: \\n151: .job-progress-panel__error {\\n152:   min-width: 0;\\n153:   font-size: 11px;\\n154:   line-height: 1.6;\\n155: }\\n156: \\n157: .job-progress-panel__error-summary {\\n158:   cursor: pointer;\\n159:   color: var(--destructive, #b42318);\\n160:   word-break: break-word;\\n161: }\\n162: \\n163: .job-progress-panel__error-detail {\\n164:   display: flex;\\n165:   flex-direction: column;\\n166:   gap: 4px;\\n167:   margin: 6px 0 0;\\n168:   padding: 6px 8px;\\n169:   border-radius: 6px;\\n170:   background: var(--muted, #f3f4f6);\\n171: }\\n172: \\n173: .job-progress-panel__error-row {\\n174:   display: flex;\\n175:   gap: 6px;\\n176:   min-width: 0;\\n177: }\\n178: \\n179: .job-progress-panel__error-row dt {\\n180:   flex: 0 0 auto;\\n181:   opacity: 0.65;\\n182: }\\n183: \\n184: .job-progress-panel__error-row dd {\\n185:   flex: 1 1 auto;\\n186:   min-width: 0;\\n187:   margin: 0;\\n188:   overflow-wrap: anywhere;\\n189: }\\n190: \\n191: .job-progress-panel__error-row code {\\n192:   font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\\n193:   overflow-wrap: anywhere;\\n194: }\\n195: \",\"hash\":\"751e5065b2a995f2554d3715abc5c9da9f4af3c29d9879fa96d059a05a30a216\",\"totalLines\":195,\"nextOffset\":null}}","role":"tool"}

