data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_f513883c3036407a87417cd7","messageId":"ceb475da-c32c-4a3e-a1f4-c8a957d627ab","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/test-notice/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"test-notice\\\",\\n3:   \\\"name\\\": \\\"Test Notice\\\",\\n4:   \\\"description\\\": \\\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"test-notice\\\"\\n8:   ],\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"show a test notice at the chat top\\\",\\n12:       \\\"显示测试提示\\\",\\n13:       \\\"在聊天区域顶部显示提示\\\"\\n14:     ],\\n15:     \\\"visualRole\\\": \\\"chat area top notice\\\",\\n16:     \\\"recommendedSize\\\": {\\n17:       \\\"height\\\": \\\"40px\\\"\\n18:     },\\n19:     \\\"defaultPlacement\\\": {\\n20:       \\\"type\\\": \\\"relative\\\",\\n21:       \\\"relation\\\": \\\"above\\\",\\n22:       \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n23:     }\\n24:   }\\n25: }\\n26: \",\"hash\":\"864de9d03879b8ea7eb672e7e9b33c5e8b1f62c0e98edf7ba77b06059e858be9\",\"totalLines\":26,\"nextOffset\":null}}","role":"tool"}

