data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_611cc04acc74431b913624c8","messageId":"90dc86b6-4ac7-42a3-a5c6-5711af2682cb","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/job-progress-panel/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"job-progress-panel\\\",\\n3:   \\\"name\\\": \\\"Job Progress Panel\\\",\\n4:   \\\"description\\\": \\\"Subscribes to live app.job.progress business events and shows task progress rows merged by job_id at the right side of the chat area.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"job-progress-panel\\\"\\n8:   ],\\n9:   \\\"layout\\\": {\\n10:     \\\"width\\\": \\\"narrow\\\"\\n11:   },\\n12:   \\\"data\\\": {\\n13:     \\\"events\\\": [\\n14:       \\\"app.job.progress\\\"\\n15:     ]\\n16:   },\\n17:   \\\"authoring\\\": {\\n18:     \\\"intents\\\": [\\n19:       \\\"show task progress at the right of the chat area\\\",\\n20:       \\\"显示任务进度面板\\\",\\n21:       \\\"在聊天区域右侧显示任务进度\\\"\\n22:     ],\\n23:     \\\"visualRole\\\": \\\"chat area right task progress panel\\\",\\n24:     \\\"recommendedSize\\\": {\\n25:       \\\"width\\\": \\\"320px\\\"\\n26:     },\\n27:     \\\"defaultPlacement\\\": {\\n28:       \\\"type\\\": \\\"relative\\\",\\n29:       \\\"relation\\\": \\\"after\\\",\\n30:       \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n31:     }\\n32:   }\\n33: }\\n34: \",\"hash\":\"99b71b1fa25fb6fa296ddce27bae558992ef6d36e414d4c5a3fe31de57aecc16\",\"totalLines\":34,\"nextOffset\":null}}","role":"tool"}

