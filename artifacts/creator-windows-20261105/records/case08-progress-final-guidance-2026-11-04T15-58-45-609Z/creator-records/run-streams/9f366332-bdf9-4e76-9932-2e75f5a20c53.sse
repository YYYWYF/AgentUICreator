data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_f3dc1251907945fc99ce5a4b","messageId":"3235c315-8621-4311-8c23-7f299078194f","content":"{\"ok\":true,\"result\":{\"artifactId\":\"ctx-fc07be247edbd4ae2cff000f5ab43e7f04b4833e1569ac678361698c03b96aa7\",\"historical\":true,\"grantsFreshness\":false,\"originalTool\":\"inspect_ui_project\",\"path\":[\"result\",\"appUIModel\"],\"kind\":\"object\",\"keys\":[\"hash\",\"layout\",\"slots\"],\"keyCount\":3,\"content\":\"{\\n  \\\"hash\\\": \\\"fdb44a4c1f7327863c95e16878c6a3e1210f93c643be8f61d01253bebca9e064\\\",\\n  \\\"layout\\\": {\\n    \\\"nodeRef\\\": \\\"l0\\\",\\n    \\\"type\\\": \\\"row\\\",\\n    \\\"sizes\\\": [\\n      \\\"300px\\\",\\n      \\\"minmax(0, 1fr)\\\"\\n    ],\\n    \\\"gap\\\": 0,\\n    \\\"children\\\": [\\n      {\\n        \\\"nodeRef\\\": \\\"l1\\\",\\n        \\\"type\\\": \\\"panel\\\",\\n        \\\"child\\\": {\\n          \\\"nodeRef\\\": \\\"l2\\\",\\n          \\\"type\\\": \\\"column\\\",\\n          \\\"sizes\\\": [\\n            \\\"52px\\\",\\n            \\\"minmax(0, 1fr)\\\"\\n          ],\\n          \\\"gap\\\": 0,\\n          \\\"children\\\": [\\n            {\\n              \\\"nodeRef\\\": \\\"l3\\\",\\n              \\\"type\\\": \\\"slot\\\",\\n              \\\"plugins\\\": [\\n                {\\n                  \\\"id\\\": \\\"p5\\\",\\n                  \\\"pluginId\\\": \\\"theme-switch\\\",\\n                  \\\"enabled\\\": true\\n                },\\n                {\\n                  \\\"id\\\": \\\"p6\\\",\\n                  \\\"pluginId\\\": \\\"agent-identity\\\",\\n                  \\\"enabled\\\": true\\n                }\\n              ]\\n            },\\n            {\\n              \\\"nodeRef\\\": \\\"l4\\\",\\n              \\\"type\\\": \\\"slot\\\",\\n              \\\"plugins\\\": [\\n                {\\n                  \\\"id\\\": \\\"p7\\\",\\n                  \\\"pluginId\\\": \\\"conversation-thread-list\\\",\\n                  \\\"enabled\\\": true,\\n                  \\\"slots\\\": {\\n                    \\\"headerActions\\\": [\\n                      {\\n                        \\\"id\\\": \\\"p8\\\",\\n                        \\\"pluginId\\\": \\\"conversation-new\\\",\\n                        \\\"enabled\\\": true\\n                      }\\n                    ]\\n                  }\\n                }\\n              ]\\n            }\\n          ]\\n        }\\n      },\\n      {\\n        \\\"nodeRef\\\": \\\"l5\\\",\\n        \\\"type\\\": \\\"panel\\\",\\n        \\\"child\\\": {\\n          \\\"nodeRef\\\": \\\"l6\\\",\\n          \\\"type\\\": \\\"column\\\",\\n          \\\"sizes\\\": [\\n            \\\"40px\\\",\\n            \\\"44px\\\",\\n            \\\"minmax(0, 1fr)\\\"\\n          ],\\n          \\\"gap\\\": 0,\\n          \\\"children\\\": [\\n            {\\n              \\\"nodeRef\\\": \\\"l7\\\",\\n              \\\"type\\\": \\\"panel\\\",\\n              \\\"child\\\": {\\n                \\\"nodeRef\\\": \\\"l8\\\",\\n                \\\"type\\\": \\\"slot\\\",\\n                \\\"plugins\\\": [\\n                  {\\n                    \\\"id\\\": \\\"p23\\\",\\n                    \\\"pluginId\\\": \\\"test-notice\\\",\\n                    \\\"enabled\\\": true\\n                  }\\n                ]\\n              }\\n            },\\n            {\\n              \\\"nodeRef\\\": \\\"l9\\\",\\n              \\\"type\\\": \\\"panel\\\",\\n              \\\"child\\\": {\\n                \\\"nodeRef\\\": \\\"l10\\\",\\n                \\\"type\\\": \\\"slot\\\",\\n                \\\"plugins\\\": [\\n                  {\\n                    \\\"id\\\": \\\"p24\\\",\\n                    \\\"pluginId\\\": \\\"quick-help-card\\\",\\n                    \\\"enabled\\\": true,\\n                    \\\"slots\\\": {\\n                      \\\"body\\\": [\\n                        {\\n                          \\\"id\\\": \\\"p25\\\",\\n                          \\\"pluginId\\\": \\\"quick-help-content\\\",\\n                          \\\"enabled\\\": true\\n                        }\\n                      ],\\n                      \\\"headerActions\\\": [\\n                        {\\n                          \\\"id\\\": \\\"p9\\\",\\n                          \\\"pluginId\\\": \\\"help-dismiss-action\\\",\\n                          \\\"enabled\\\": true\\n                        }\\n                      ]\\n                    }\\n                  }\\n                ]\\n              }\\n            },\\n            {\\n              \\\"nodeRef\\\": \\\"l11\\\",\\n              \\\"type\\\": \\\"row\\\",\\n              \\\"sizes\\\": [\\n                \\\"minmax(0, 1fr)\\\",\\n                \\\"320px\\\"\\n              ],\\n              \\\"children\\\": [\\n                {\\n                  \\\"nodeRef\\\": \\\"l12\\\",\\n                  \\\"type\\\": \\\"slot\\\",\\n                  \\\"plugins\\\": [\\n                    {\\n                      \\\"id\\\": \\\"p10\\\",\\n                      \\\"pluginId\\\": \\\"conversation-surface\\\",\\n                      \\\"enabled\\\": true,\\n                      \\\"slots\\\": {\\n                        \\\"emptySuggestions\\\": [\\n                          {\\n                            \\\"id\\\": \\\"p11\\\",\\n                            \\\"pluginId\\\": \\\"conversation-suggestions\\\",\\n                            \\\"enabled\\\": true\\n                          }\\n                        ],\\n                        \\\"composer\\\": [\\n                          {\\n                            \\\"id\\\": \\\"p12\\\",\\n                            \\\"pluginId\\\": \\\"composer\\\",\\n                            \\\"enabled\\\": true,\\n                            \\\"slots\\\": {\\n                              \\\"leadingActions\\\": [\\n                                {\\n                                  \\\"id\\\": \\\"p13\\\",\\n                                  \\\"pluginId\\\": \\\"add-attachment-action\\\",\\n                                  \\\"enabled\\\": true\\n                                }\\n                              ],\\n                              \\\"submitAction\\\": [\\n                                {\\n                                  \\\"id\\\": \\\"p14\\\",\\n                                  \\\"pluginId\\\": \\\"submit-action\\\",\\n                                  \\\"enabled\\\": true\\n                                }\\n                              ],\\n                              \\\"beforeInput\\\": [\\n                                {\\n                                  \\\"id\\\": \\\"p15\\\",\\n                                  \\\"pluginId\\\": \\\"conversation-quote\\\",\\n                                  \\\"enabled\\\": true\\n                                }\\n                              ]\\n                            }\\n                          }\\n                        ],\\n                        \\\"reasoningGroup\\\": [\\n                          {\\n                            \\\"id\\\": \\\"p16\\\",\\n                            \\\"pluginId\\\": \\\"reasoning\\\",\\n                            \\\"enabled\\\": true\\n                          }\\n                        ],\\n                        \\\"toolGroup\\\": [\\n                          {\\n                            \\\"id\\\": \\\"p17\\\",\\n                            \\\"pluginId\\\": \\\"tool-group\\\",\\n                            \\\"enabled\\\": true\\n                          }\\n                        ],\\n                        \\\"toolFallback\\\": [\\n                          {\\n                            \\\"id\\\": \\\"p18\\\",\\n                            \\\"pluginId\\\": \\\"tool-result\\\",\\n                            \\\"enabled\\\": true\\n                          }\\n      \",\"offset\":0,\"nextOffset\":6000,\"to