data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_3c64f604a61c4f0fa9b11c82","delta":"{\"targetPluginId\":\"job-progress-panel\",\"desiredOutcome\":\"在聊天区域右侧新增“任务进度”面板：订阅 Agent 实时发送的 CUSTOM 业务事件 app.job.progress（value: job_id/title/status/completed/total/error），以 job_id 为键合并，同一 job_id 就地更新，不同任务分行展示；完成后显示完成态，失败时可展开查看 error.code 与 error.message。空状态与 zh-CN / en-US 文案齐备。\",\"workKind\":\"create-plugin\",\"missingCapabilities\":[\"没有订阅 app.job.progress 业务事件的插件\",\"聊天区右侧没有任务进度面板\"],\"deliveryContract\":{\"capability\":\"订阅 app.job.progress 实时业务事件并按 job_id 归并展示任务进度\",\"renderingCategory\":\"panel\",\"placement\":\"聊天区域右侧的固定宽度可调整 Panel（conversation-surface 同排右侧）\",\"lifecycle\":\"组件内 useEffect 订阅，返回取消函数；不使用 Service，不持久化历史\",\"dependencies\":[\"@za38.03/agent-ui-plugins (usePluginEvents, useAgentUILocaleCode)\",\"zod (应用事件 Schema)\",\"React\"],\"verificationMethod\":\"runtime\",\"interactions\":[\"同一 job_id 连续事件原地更新进度\",\"不同 job_id 分别显示\",\"status=completed 显示完成态\",\"status 失败时可展开查看 error.code 与 error.message\",\"空状态下显示占位文案\"],\"geometry\":[{\"instanceId\":\"job-progress-panel\",\"property\":\"width\",\"expected\":320,\"tolerance\":10}]}}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_3c64f604a61c4f0fa9b11c82"}

