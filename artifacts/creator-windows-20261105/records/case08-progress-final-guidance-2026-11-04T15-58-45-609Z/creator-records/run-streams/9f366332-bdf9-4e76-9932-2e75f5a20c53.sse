data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_2baf1376c9b34e9c974a0948","messageId":"5458a760-0341-4ecd-9563-ee0684862ee3","content":"{\"ok\":true,\"result\":{\"pluginId\":\"conversation-surface\",\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":1,\"resolved\":1,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-runtime/ui\",\"symbols\":[{\"name\":\"AgentProps.appEventSchemas\",\"status\":\"available\",\"type\":\"Readonly<Record<string, ZodTypeAny<unknown, unknown, $ZodTypeInternals<unknown, unknown>>>> | undefined\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"union\":{\"commonMembersOnly\":true,\"variants\":[{\"query\":\"AgentProps.appEventSchemas.$variant0\",\"queryAvailable\":true,\"type\":\"undefined\",\"truncated\":false,\"discriminants\":[],\"members\":[],\"membersTruncated\":false},{\"query\":\"AgentProps.appEventSchemas.$variant1\",\"queryAvailable\":true,\"type\":\"Readonly<Record<string, ZodTypeAny<unknown, unknown, $ZodTypeInternals<unknown, unknown>>>>\",\"truncated\":false,\"discriminants\":[],\"members\":[],\"membersTruncated\":false}],\"variantsTruncated\":false,\"interpretation\":\"Top-level members are shared by all union branches. A member absent there may exist in a variant. Query the returned exact variant path to inspect its members and invocation parameters.\"},\"members\":[],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"projection\":{\"kind\":\"installed_public_api\",\"referenceOnly\":true,\"pluginDetails\":{\"tool\":\"inspect_ui_plugin\",\"input\":{\"pluginId\":\"conversation-surface\"}},\"guidance\":\"API signatures only. For a large exported type, query the required export.member instead of reading all domains. This query does not select an editing target or grant source ownership.\"}}}","role":"tool"}

