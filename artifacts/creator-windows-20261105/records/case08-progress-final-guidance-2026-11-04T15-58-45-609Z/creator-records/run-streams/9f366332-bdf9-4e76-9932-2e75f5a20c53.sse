data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_0167186d74ea4318bc82661a","messageId":"b6a253ec-0c29-4099-91d8-460bca8e27a4","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/job-progress-panel/events.ts\",\"content\":\"1: import { z } from \\\"zod\\\";\\n2: \\n3: /** Error object carried by a failed job progress event. */\\n4: export const jobProgressErrorSchema = z.object({\\n5:   code: z.string(),\\n6:   message: z.string(),\\n7: });\\n8: \\n9: /**\\n10:  * Payload of the \\\"app.job.progress\\\" business event:\\n11:  * { job_id, title, status, completed, total, error }\\n12:  */\\n13: export const jobProgressEventSchema = z.object({\\n14:   job_id: z.union([z.string(), z.number()]).transform((value) => String(value)),\\n15:   title: z.string().optional(),\\n16:   status: z.string().optional(),\\n17:   completed: z.union([z.number(), z.string()]).optional(),\\n18:   total: z.union([z.number(), z.string()]).optional(),\\n19:   error: z.union([jobProgressErrorSchema, z.null()]).optional(),\\n20: });\\n21: \\n22: export type JobProgressEventPayload = z.infer<typeof jobProgressEventSchema>;\\n23: \\n24: /** Event schemas registered with the Conversation Runtime through AgentProps.appEventSchemas. */\\n25: export const jobProgressAppEventSchemas = {\\n26:   \\\"app.job.progress\\\": jobProgressEventSchema,\\n27: } as const;\\n28: \",\"hash\":\"6ace8433847b9ea19a0229346ff12370ff519f17c8e57f22b70a1216790672ea\",\"totalLines\":28,\"nextOffset\":null}}","role":"tool"}

