data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_c29bb4222bd44dac8ad6efaf","delta":"{\"file_path\":\"/skills/ui-layout/SKILL.md\",\"limit\":400,\"offset\":0}"}

