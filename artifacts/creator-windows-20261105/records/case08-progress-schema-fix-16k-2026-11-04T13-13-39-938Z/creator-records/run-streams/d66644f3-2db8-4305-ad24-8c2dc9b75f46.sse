data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_8a2d7e6c5c2d46869af154ad","messageId":"c2f82000-95cc-4532-adba-4e1e035bbde3","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"query\":\"应用事件 appEventSchemas application events\",\"total\":70,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s14\",\"title\":\"Agent 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s14\"}}},{\"sectionId\":\"s170\",\"title\":\"外壳定制\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s170\"}}},{\"sectionId\":\"s103\",\"title\":\"状态与事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s103\"}}}]},{\"documentId\":\"public:development/plugin-api\",\"title\":\"插件开发接口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/plugin-api.md\",\"s