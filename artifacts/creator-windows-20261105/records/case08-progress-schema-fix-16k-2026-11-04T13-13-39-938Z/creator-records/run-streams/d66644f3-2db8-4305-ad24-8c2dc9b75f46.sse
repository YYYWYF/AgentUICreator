sation-tool-fallback-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p18\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"toolFallback\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render tool result content parts\",\"show tool output images audio video and documents\"],\"visualRole\":\"assistant tool result presentation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"toolFallback\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-timeline\",\"name\":\"Conversation Tool Timeline\",\"description\":\"Message-level tool execution timeline with actions, targets and file-change statistics.\",\"capabilities\":[\"conversation-tool-timeline-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"summarize tool execution\",\"show a collapsible tool timeline\",\"展示工具执行时间线\",\"折叠工具执行过程\"],\"visualRole\":\"assistant message tool execution summary\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"toolTimeline\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"transient-assistant-messages\",\"name\":\"Transient Messages\",\"description\":\"Page-memory user and assistant bubbles without Agent runs, persistence or model context.\",\"capabilities\":[\"conversation-transient-messages-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p26\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"transientMessages\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add temporary user or