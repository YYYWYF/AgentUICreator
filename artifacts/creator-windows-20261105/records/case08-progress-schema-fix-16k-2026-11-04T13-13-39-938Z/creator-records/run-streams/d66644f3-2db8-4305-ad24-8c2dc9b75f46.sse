data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_d091ad5016fe4ccfb400c62a","messageId":"06b7b0eb-3622-4924-a28e-78dce810047e","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"ec814f21d2857a86f24a3cd35ae3cbc8d079f4b634bd7553dc7738d8ba4c5d7c\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"test-notice\",\"name\":\"Test Notice\",\"description\":\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\",\"directory\":\"test-notice\",\"manifestPath\":\"src/agent-ui/plugins/test-notice/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/test-notice/definition.ts\",\"capabilities\":[\"test-notice\"],\"authoring\":{\"intents\":[\"show a test notice at the chat top\",\"显示测试提示\",\"在聊天区域顶部显示提示\"],\"visualRole\":\"chat area top notice\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"40px\"}},\"childSlots\":{},\"dataMessageUINames\":[],\"selected\":true},\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":2,\"resolved\":2,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/contracts\",\"symbols\":[{\"name\":\"AgentApplicationEvent\",\"status\":\"available\",\"type\":\"AgentApplicationEvent<TPayload>\",\"truncated\":false,\"memberNames\":[\"name\",\"payload\",\"producer\"],\"memberNamesTruncated\":false,\"members\":[{\"name\":\"name\",\"type\":\"string\",\"truncated\":false},{\"name\":\"payload\",\"type\":\"TPayload\",\"truncated\":false},{\"name\":\"producer\",\"type\":\"AgentProducer\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false},{\"name\":\"UIPluginEvents\",\"status\":\"available\",\"type\":\"UIPluginEvents\",\"truncated\":false,\"memberNames\":[\"subscribe\"],\"memberNamesTruncated\":false,\"parameterQueries\":[\"UIPluginEvents.subscribe.$parameter0\"],\"parameterContracts\":[{\"query\":\"UIPluginEvents.subscribe.$parameter0\",\"type\":\"string\",\"truncated\":false,\"propNames\":[],\"propNamesTruncated\":false,\"members\":[],\"membersTruncated\":false}],\"parameterContractsTruncated\":false,\"nextEvidence\":\"Invocation parameters are included in parameterContracts. Truncation flags identify omitted details; parameterQueries expand exact parameter paths.\",\"members\":[{\"name\":\"subscribe\",\"type\":\"<TPayload = unknown>(name: string, listener: (event: AgentApplicationEvent<TPayload>) => void | Promise<void>) => () => void\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"p23\",\"pluginId\":\"test-notice\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l8\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p23\"}],\"manifest\":{\"id\":\"test-notice\",\"name\":\"Test Notice\",\"description\":\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\",\"version\":\"0.0.1\",\"capabilities\":[\"test-notice\"],\"authoring\":{\"intents\":[\"show a test notice at the chat top\",\"显示测试提示\",\"在聊天区域顶部显示提示\"],\"visualRole\":\"chat area top notice\",\"recommendedSize\":{\"height\":\"40px\"},\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { TestNoticePlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: TestNoticePlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":394},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/test-notice/definition.ts\",\"kind\":\"file\",\"bytes\":394},{\"path\":\"src/agent-ui/plugins/test-notice/index.tsx\",\"kind\":\"file\",\"bytes\":522},{\"path\":\"src/agent-ui/plugins/test-notice/manifest.json\",\"kind\":\"file\",\"bytes\":634},{\"path\":\"src/agent-ui/plugins/test-notice/styles.css\",\"kind\":\"file\",\"bytes\":295}],\"filesTruncated\":false}}","role":"tool"}

