"}},\"matchingSections\":[{\"sectionId\":\"s11\",\"title\":\"1. 通用基础设施与应用配置\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s11\"}}},{\"sectionId\":\"s145\",\"title\":\"10. 模板与业务示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s145\"}}},{\"sectionId\":\"s87\",\"title\":\"6. 首次源码接管\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s87\"}}}]},{\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"title\":\"Agent UI Plugin Creator 架构与执行边界\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/agent-ui-plugin-creator-launch-plan.md\",\"summary\":\"当前架构：Creator、AppUIModel、Plugin、Runtime、AG-UI、Service 和交付边界。\",\"sha256\":\"2a7020bd5c6879c9c1e4d472051e485251bacf4fb88172a7fdcacd9df56d492e\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\"}},\"matchingSections\":[{\"sectionId\":\"s30\",\"title\":\"项目应用层、实现与 Shell\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"s30\"}}},{\"sectionId\":\"s53\",\"title\":\"会话与 Agent 交互\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"s53\"}}},{\"sectionId\":\"s5\",\"title\":\"职责与交付\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:agent-ui-plugin-creator-launch-plan\",\"sectionId\":\"s5\"}}}]},{\"documentId\":\"public:development/frontend-tools\",\"title\":\"前端工具与自定义工具 UI\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/frontend-tools.md\",\"summary\":\"前端工具让 Agent 请求执行页面动作，例如打开弹窗或填写表单。业务应用决定哪些动作可用，并提供执行方法；工具 UI 只显示参数、状态和结果。\",\"sha256\":\"550e6db69213972586b6cd11791825e70f39e2bd6dc2a0832e4f6b6ca832f142\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/frontend-tools\"}},\"matchingSections\":[{\"sectionId\":\"s13\",\"title\":\"宿主页面操作接入\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/frontend-tools\",\"sectionId\":\"s13\"}}},{\"sectionId\":\"s1\",\"title\":\"前端工具与自定义工具 UI\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/frontend-tools\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"title\":\"Creator 开发控制面实现\",\"source\":\"internal\",\"topic\":\"更新与开发工具\",\"path\":\"references/docs/creator-control-plane-implementation-plan.md\",\"summary\":\"Creator 工具控制面、命令、Host guards、上下文及 Mock 管理。\",\"sha256\":\"a55d71bc0dd2f6b4e8fa93b849f6abb6244a8d2d7c8528f16b3857638764526b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\"}},\"matchingSections\":[{\"sectionId\":\"s27\",\"title\":\"2. 工程与 Runtime 边界\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s27\"}}},{\"sectionId\":\"s137\",\"title\":\"按需文档索引\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s137\"}}},{\"sectionId\":\"s105\",\"title\":\"8. 开发预览与运行诊断\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"ac