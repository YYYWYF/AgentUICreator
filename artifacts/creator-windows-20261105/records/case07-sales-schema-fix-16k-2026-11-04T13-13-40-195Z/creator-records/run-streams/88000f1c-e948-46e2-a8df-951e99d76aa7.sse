data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_igIo1OlqTIN0pD6fAAM72605","messageId":"1a871635-12fb-4311-b19d-e66094c19180","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-card/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { useId } from \\\"react\\\";\\n3: import {\\n4:   toggleQuickHelpCardExpanded,\\n5:   useQuickHelpCardExpanded,\\n6: } from \\\"../../hooks/useQuickHelpCardExpanded\\\";\\n7: import type { ReactNode } from \\\"react\\\";\\n8: import \\\"./styles.css\\\";\\n9: \\n10: type QuickHelpCardProps = {\\n11:   renderSlot?: (name: string, fallback?: ReactNode) => ReactNode;\\n12: };\\n13: \\n14: const messages: Record<string, { title: string; expand: string; collapse: string }> = {\\n15:   \\\"zh-CN\\\": { title: \\\"使用帮助\\\", expand: \\\"展开\\\", collapse: \\\"折叠\\\" },\\n16:   \\\"en-US\\\": { title: \\\"Usage Help\\\", expand: \\\"Expand\\\", collapse: \\\"Collapse\\\" },\\n17: };\\n18: \\n19: export function QuickHelpCardPlugin(props: QuickHelpCardProps) {\\n20:   const localeCode = useAgentUILocaleCode();\\n21:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n22:   // Shared with header actions such as the \\\"知道了\\\" action, so both plugins\\n23:   // control the same expansion state and it survives theme switching.\\n24:   const expanded = useQuickHelpCardExpanded();\\n25:   const bodyId = useId();\\n26: \\n27:   const headerActions = props.renderSlot ? props.renderSlot(\\\"headerActions\\\", null) : null;\\n28:   const body = props.renderSlot ? props.renderSlot(\\\"body\\\", null) : null;\\n29: \\n30:   return (\\n31:     <section className=\\\"quick-help-card\\\" aria-label={text.title}>\\n32:       <div className=\\\"quick-help-card__header\\\">\\n33:         <button\\n34:           type=\\\"button\\\"\\n35:           className=\\\"quick-help-card__toggle\\\"\\n36:           aria-expanded={expanded}\\n37:           aria-controls={bodyId}\\n38:           onClick={toggleQuickHelpCardExpanded}\\n39:         >\\n40:           <span className=\\\"quick-help-card__title\\\">{text.title}</span>\\n41:           <span className=\\\"quick-help-card__indicator\\\" aria-hidden=\\\"true\\\">\\n42:             {expanded ? \\\"▾\\\" : \\\"▸\\\"}\\n43:           </span>\\n44:           <span className=\\\"quick-help-card__toggle-label\\\">\\n45:             {expanded ? text.collapse : text.expand}\\n46:           </span>\\n47:         </button>\\n48:         {headerActions ? (\\n49:           <div className=\\\"quick-help-card__header-actions\\\">{headerActions}</div>\\n50:         ) : null}\\n51:       </div>\\n52:       <div className=\\\"quick-help-card__body\\\" id={bodyId} hidden={!expanded}>\\n53:         {body}\\n54:       </div>\\n55:     </section>\\n56:   );\\n57: }\\n58: \",\"hash\":\"51a44dbe9638f0fbb537545c5f215d9428d27d9570a383744624d52e8109cadf\",\"totalLines\":58,\"nextOffset\":null}}","role":"tool"}

