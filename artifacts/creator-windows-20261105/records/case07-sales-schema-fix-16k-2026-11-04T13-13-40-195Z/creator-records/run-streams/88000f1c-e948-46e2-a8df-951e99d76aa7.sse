data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_11rTxKFIJftafy2D0zzn1131","messageId":"3975dba1-8e60-4f7a-bc01-53b36a8406e7","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"2. 编写解析函数并配置事件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"sectionId\":\"s34\",\"offset\":0,\"totalCharacters\":840,\"content\":\"## 2. 编写解析函数并配置事件\\n\\n新建 `plugins/ticket-summary-message/schema.ts`，校验数据并转换字段：\\n\\n```ts\\nimport { z } from 'zod';\\n\\nexport const TICKET_SUMMARY_EVENT = 'app.ticket.summary';\\n\\nexport const ticketSummarySchema = z.object({\\n  ticket_id: z.string().min(1),\\n  title: z.string().min(1),\\n}).transform(value => ({\\n  ticketId: value.ticket_id,\\n  title: value.title,\\n}));\\n\\nexport function parseTicketSummary(data: unknown) {\\n  return ticketSummarySchema.safeParse(data);\\n}\\n```\\n\\n在使用 `Agent` 的页面（例如 `src/App.tsx`）传入事件配置：\\n\\n```tsx\\nimport { Agent } from './agent-ui';\\nimport { TICKET_SUMMARY_EVENT, ticketSummarySchema } from './agent-ui/plugins/ticket-summary-message/schema';\\n\\nconst appEventSchemas = { [TICKET_SUMMARY_EVENT]: ticketSummarySchema };\\n\\nexport function App() {\\n  return <Agent appEventSchemas={appEventSchemas} />;\\n}\\n```\\n\\n消息组件仍需调用解析函数处理收到的原始数据。\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"call_00_BX3FfUGrXNiJt6hBZUL76916","toolCallName":"read_creator_documentation"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_BX3FfUGrXNiJt6hBZUL76916","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s71\"}"}

