data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_NEtVg8po5TMVvM68d9Lb4243","messageId":"f94e43e2-3589-4c5a-9aac-0413336df43e","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"sectionId\":\"s1\",\"offset\":0,\"totalCharacters\":314,\"childSections\":[{\"sectionId\":\"s17\",\"title\":\"1. 让 Agent 返回事件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s34\",\"title\":\"2. 编写解析函数并配置事件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\"}}},{\"sectionId\":\"s71\",\"title\":\"3. 编写消息组件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s103\",\"title\":\"4. 注册并启用插件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s103\"}}},{\"sectionId\":\"s149\",\"title\":\"5. 检查结果\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s149\"}}}],\"content\":\"# 自定义 AG-UI 事件与消息渲染\\n\\n下面以“工单摘要”为例。Runtime 会将 `CUSTOM` 事件自动转成消息，你只需编写解析函数，再注册对应的插件渲染器。\\n\\n文件路径均相对于生成目录，默认是 `src/agent-ui/`。示例使用项目已有的 React 和 `zod`。\\n\\n相关代码放在同一个插件目录：\\n\\n```text\\nplugins/ticket-summary-message/\\n  schema.ts       # 数据解析\\n  index.tsx       # 消息组件、文案和渲染注册\\n  manifest.json   # 插件声明\\n  definition.ts   # 插件入口\\n```\\n\\n\",\"nextOffset\":null}}","role":"tool"}

