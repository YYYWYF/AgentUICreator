data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_x5ZyHLaAt7ca14O8dZwY5829","messageId":"e407de27-406a-4447-a703-55cc93246862","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"ec814f21d2857a86f24a3cd35ae3cbc8d079f4b634bd7553dc7738d8ba4c5d7c\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"sales-report-message\",\"name\":\"Sales Report Message\",\"description\":\"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\",\"directory\":\"sales-report-message\",\"manifestPath\":\"src/agent-ui/plugins/sales-report-message/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/sales-report-message/definition.ts\",\"capabilities\":[\"sales-report-message\"],\"authoring\":{\"intents\":[\"显示月度销售报表表格\",\"在聊天消息里显示报表\",\"按收入排序查看每月订单数量\",\"render sales report table in chat\"],\"visualRole\":\"chat message renderer for the app.sales.report custom event\"},\"childSlots\":{},\"dataMessageUINames\":[],\"selected\":false},\"selected\":false,\"instances\":[],\"manifest\":{\"id\":\"sales-report-message\",\"name\":\"Sales Report Message\",\"description\":\"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\",\"version\":\"0.0.1\",\"capabilities\":[\"sales-report-message\"],\"data\":{\"messageUI\":true},\"authoring\":{\"intents\":[\"显示月度销售报表表格\",\"在聊天消息里显示报表\",\"按收入排序查看每月订单数量\",\"render sales report table in chat\"],\"visualRole\":\"chat message renderer for the app.sales.report custom event\"}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { SalesReportMessagePlugin } from \\\"./index\\\";\\nimport { SALES_REPORT_EVENT_NAME } from \\\"./schema\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      name: SALES_REPORT_EVENT_NAME,\\n      render: SalesReportMessagePlugin,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":658},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/sales-report-message/definition.ts\",\"kind\":\"file\",\"bytes\":658},{\"path\":\"src/agent-ui/plugins/sales-report-message/index.tsx\",\"kind\":\"file\",\"bytes\":5742},{\"path\":\"src/agent-ui/plugins/sales-report-message/manifest.json\",\"kind\":\"file\",\"bytes\":596},{\"path\":\"src/agent-ui/plugins/sales-report-message/schema.ts\",\"kind\":\"file\",\"bytes\":3417},{\"path\":\"src/agent-ui/plugins/sales-report-message/styles.css\",\"kind\":\"file\",\"bytes\":2548}],\"filesTruncated\":false}}","role":"tool"}

