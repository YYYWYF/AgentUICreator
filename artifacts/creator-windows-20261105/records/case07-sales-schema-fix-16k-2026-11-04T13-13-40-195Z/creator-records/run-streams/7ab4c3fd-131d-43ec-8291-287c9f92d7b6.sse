data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_jCtwxNvBRn6t4oOpVsbp4315","messageId":"5080bfb1-be02-4e76-9e36-e9f1ce41c04a","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"3. 编写消息组件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"76bc2c6aeaa63f8b7ee3cf1263bda6df5ec37ed63d9af83845e80d2b4c4daf12\",\"sectionId\":\"s71\",\"offset\":0,\"totalCharacters\":941,\"content\":\"## 3. 编写消息组件\\n\\n新建同目录的 `index.tsx`，放入组件和中英文文案：\\n\\n```tsx\\nimport { defineDataMessageUI, useAgentUILocaleCode } from '@za38.03/agent-ui-plugins';\\nimport { TICKET_SUMMARY_EVENT, parseTicketSummary } from './schema';\\n\\nconst messages = {\\n  'zh-CN': { heading: '工单摘要', invalid: '工单数据格式不正确。' },\\n  'en-US': { heading: 'Ticket summary', invalid: 'Invalid ticket data.' },\\n};\\n\\nexport function TicketSummaryMessage({ data }: { data: unknown }) {\\n  const labels = messages[useAgentUILocaleCode()];\\n  const result = parseTicketSummary(data);\\n  if (!result.success) return <p role=\\\"alert\\\">{labels.invalid}</p>;\\n\\n  return <section aria-label={labels.heading}>\\n    <h3>{labels.heading}</h3>\\n    <p>{result.data.ticketId}：{result.data.title}</p>\\n  </section>;\\n}\\n\\nexport const ticketSummaryUI = defineDataMessageUI<unknown>({\\n  name: TICKET_SUMMARY_EVENT,\\n  render: TicketSummaryMessage,\\n});\\n```\\n\\n这里的 `name` 必须与后端事件名一致。组件通过 `parseTicketSummary(data)` 取得解析结果后渲染。\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"call_01_pIw0kjOCcRqJZOYyTDz12277","toolCallName":"read_creator_documentation"}

