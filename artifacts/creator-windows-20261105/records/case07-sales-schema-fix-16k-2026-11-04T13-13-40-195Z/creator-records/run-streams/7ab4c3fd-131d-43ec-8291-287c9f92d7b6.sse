\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p12\",\"pluginId\":\"composer\",\"enabled\":true,\"slots\":{\"leadingActions\":[{\"id\":\"p13\",\"pluginId\":\"add-attachment-action\",\"enabled\":true}],\"submitAction\":[{\"id\":\"p14\",\"pluginId\":\"submit-action\",\"enabled\":true}],\"beforeInput\":[{\"id\":\"p15\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]}}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"emptySuggestions\"},\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p11\",\"pluginId\":\"conversation-suggestions\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"emptyWelcome\"},\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"headerActions\"},\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"reasoningGroup\"},\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p16\",\"pluginId\":\"reasoning\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"taskGroup\"},\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"thinkingIndicator\"},\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"toolFallback\"},\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p18\",\"pluginId\":\"tool-result\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"toolGroup\"},\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p17\",\"pluginId\":\"tool-group\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"toolTimeline\"},\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"transientMessages\"},\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[{\"id\":\"p26\",\"pluginId\":\"transient-assistant-messages\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"userEditComposer\"},\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p10\",\"pluginId\":\"conversation-surface\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"beforeInput\"},\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"plugins\":[{\"id\":\"p15\",\"pluginId\":\"conversation-quote\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"input\"},\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"leadingActions\"},\"description\":\"Inline actions displayed on the leading side of the composer.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-leading-action\",\"conversation-composer-trailing-action\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"plugins\":[{\"id\":\"p13\",\"pluginId\":\"add-attachment-action\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"submitAction\"},\"description\":\"The primary send or stop action for the composer.\",\"cardinality\":\"one\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-submit-action\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"plugins\":[{\"id\":\"p14\",\"pluginId\":\"submit-action\",\"enabled\":true}]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"trailingActions\"},\"description\":\"Inline actions displayed before the composer submit action.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trailing-action\",\"conversation-composer-leading-action\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"plugins\":[]},{\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"triggers\"},\"description\":\"Optional conversation input triggers.\",\"cardinality\":\"many\",\"mode\":\"content\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trigger\"]},\"owner\":{\"kind\":\"plugin\",\"instanceId\":\"p12\",\"pluginId\":\"composer\"},\"pl