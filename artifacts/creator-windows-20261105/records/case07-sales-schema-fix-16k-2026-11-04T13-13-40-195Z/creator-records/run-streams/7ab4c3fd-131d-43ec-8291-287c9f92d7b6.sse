ames\":[]},{\"pluginId\":\"slash-command-trigger\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"source-citations-message\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"submit-action\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"task-group\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"test-notice\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"theme-provider\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"theme-switch\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"thinking-indicator\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"tool-fallback\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"tool-group\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"tool-result\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"tool-timeline\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"transient-assistant-messages\",\"status\":\"available\",\"dataMessageUINames\":[]},{\"pluginId\":\"web-search\",\"status\":\"available\",\"dataMessageUINames\":[]}],\"capabilitySummaries\":[{\"pluginId\":\"add-attachment-action\",\"name\":\"Conversation Add Attachment Action\",\"description\":\"Adds Agent UI's attachment picker to the conversation composer.\",\"capabilities\":[\"conversation-composer-leading-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p13\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"leadingActions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add attachments to the conversation composer\"],\"visualRole\":\"conversation composer attachment action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"leadingActions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"agent-identity\",\"name\":\"Agent Identity\",\"description\":\"Displays configurable Agent name, logo and optional description in a normal Layout Slot.\",\"capabilities\":[\"agent-identity\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p6\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l3\"},\"index\":1}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"rename Agent\",\"change Agent name\",\"change Agent logo\",\"change Agent brand information\",\"把我的 Agent 改名为智能研发助手\",\"把 Agent 的 Logo 换成公司的标志\"],\"visualRole\":\"Agent identity in a normal Layout Slot; edit plugins/agent-identity/config.ts for branding\"},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"agent-plan-message\",\"name\":\"Agent Plan\",\"description\":\"Renders authoritative AG-UI agent-plan activity in assistant messages.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render agent plan in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"agent-status-message\",\"name\":\"Agent Status\",\"description\":\"Renders mock_agent_status tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render agent status in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"ask-user-question\",\"name\":\"Ask User Question\",\"description\":\"Collect structured choices or text answers inside the conversation.\",\"capabilities\":[\"human-input\",\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"ask the user to choose options or provide text before continuing\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"auth-account\",\"name\":\"Account\",\"description\":\"Account\",\"capabilities\":[\"account\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add login authentication\",\"给 Agent 加上登录功能\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"auth.session\",\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"auth-gate\",\"name\":\"Authentication Gate\",\"description\":\"Authentication Gate\",\"capabilities\":[\"authentication\",\"plugin-service-provider\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add login authentication\",\"给 Agent 加上登录功能\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"chart-message\",\"name\":\"Chart Message\",\"description\":\"Renders named chart data inside assistant messages.\",\"capabilities\":[],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render structured chart data in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"composer\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/composer\",\"component\":\"ConversationComposerPlugin\",\"facts\":{\"presentation\":\"The editable text field is a textarea by default. data-slot=aui_composer-input is its containing div; data-slot=aui_composer-shell is the outer surface containing input and actions. Container height is distinct from editable field height.\",\"composition\":\"The public component prop type is ConversationCanonicalComposerProps, exported from @za38.03/agent-ui-plugins. The /composer entry exports the Plugin component. inputProps forwards textarea props including rows, style, className and onChange; preserve existing handlers. Other root props configure the outer form. Root rows and maxLength configure the default textarea; a defined root maxLength wins over inputProps.maxLength. The input prop replaces the default input; inspect an existing replacement before changing it. For a live character count that follows typing, send and programmatic clears, query useConversationComposer from the public root module and observe its text; this hook uses the existing canonical Composer and does not create a Runtime. The default shell is a column: input and aui_composer-actions are separate children; the actions row contains leading/trailing actions, with submitAction in trailing-actions.\",\"interaction\":\"A direct placeholder prop overrides composer.placeholder, including Host locale overrides; a fixed string also persists when the locale changes. Generated Agent accepts locales with per-locale overrides, for example zh-CN and en-US entries containing composer.placeholder; preserve existing Host overrides when adding project defaults. The public useAgentUILocale('composer') reads this shared namespace, and useAgentUILocaleCode() reads the same current locale. Custom project business labels may use a small project-owned en-US/zh-CN message dictionary selected by that unified locale code; do not create another language state/Context or add fields to the closed npm AgentUILocaleMessages type. Keep the existing Composer and its native event handlers.\",\"styles\":\"inputProps.style.minHeight sizes the textarea, not the shell. Project CSS may target [data-slot=aui_composer-input] textarea. The package's styled outer shell uses :is(.agent-ui-root, .agent-ui-conversation)[data-theme] [data-slot=\\\"aui_composer-shell\\\"] with border-radius:18px; :hover and :focus-within add border/shadow rules. A bare [data-slot=\\\"aui_composer-shell\\\"] override has lower specificity and can lose even when imported later. Use that full scoped selector and corresponding focus state in later project CSS for radius/border overrides, then inspect computed borderRadius/borderColor in the actual Host. Button wrapping belongs to the actions row and leading/trailing action groups; flex-basis on a child of the column shell can instead change input height. Preserve textarea, attachments and submit behavior.\"}},\"name\":\"Conversation Composer\",\"description\":\"Renders the canonical Agent UI conversation composer with composable action Slots.\",\"capabilities\":[\"conversation-composer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p12\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"composer\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary conversation composer\",\"compose conversation input actions\"],\"visualRole\":\"conversation composer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"composer\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"beforeInput\":{\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]}},\"input\":{\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]}},\"leadingActions\":{\"description\":\"Inline actions displayed on the leading side of the composer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-leading-action\",\"conversation-composer-trailing-action\"]}},\"submitAction\":{\"description\":\"The primary send or stop action for the composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-submit-action\"]}},\"trailingActions\":{\"description\":\"Inline actions displayed before the composer submit action.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trailing-action\",\"conversation-composer-leading-action\"]}},\"triggers\":{\"description\":\"Optional conversation input triggers.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trigger\"]}}}},{\"pluginId\":\"context-retrieval-message\",\"name\":\"Context Retrieval Message\",\"description\":\"Renders context retrieval results carried by AG-UI CUSTOM events.\",\"capabilities\":[],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p4\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":4}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render context retrieval results inside assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-command-source\",\"name\":\"Conversation Command Source\",\"description\":\"Provides project-owned slash commands through the existing Plugin Service lifecycle.\",\"capabilities\":[\"headless\",\"plugin-service-provider\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"Provide frontend conversation commands\"],\"cleanup\":{\"removeWhenUnused\":true}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-data-source\",\"name\":\"Conversation Data Source\",\"description\":\"Provides conversation history data through an application-owned API.\",\"capabilities\":[\"headless\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p0\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide persistent conversation history data to conversation capabilities\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-new\",\"name\":\"New Conversation\",\"description\":\"Starts a new conversation independently of history management.\",\"capabilities\":[\"conversation-create\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p8\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p7\",\"slot\":\"headerActions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"start a new conversation\"],\"visualRole\":\"conversation header action\"},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-quote\",\"name\":\"Conversation Quote\",\"description\":\"Quote assistant passages with an optional composer preview and selection toolbar. Sent quotes remain conversation history.\",\"capabilities\":[\"conversation-composer-before-input\",\"conversation-quote\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p15\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"beforeInput\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"quote part of an assistant response\",\"reply to a specific passage\",\"引用回答中的一段内容\",\"加上引用功能\"],\"visualRole\":\"conversation quote creation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"beforeInput\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-service\",\"name\":\"Conversation Service\",\"description\":\"Provides shared application conversation state and history navigation independently from presentation plugins.\",\"capabilities\":[\"conversation-service\",\"headless\",\"plugin-service-provider\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p1\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":1}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide shared conversation management state and history navigation\"]},\"requiredServices\":{\"names\":[\"agent-ui.conversation-data-source\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-suggestions\",\"name\":\"Conversation Suggestions\",\"description\":\"Renders starter prompts through the Conversation public surface.\",\"capabilities\":[\"conversation-suggestions\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p11\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"emptySuggestions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show starter prompts and suggested conversation actions\"],\"visualRole\":\"conversation empty-state suggestions\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"emptySuggestions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-surface\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/conversation-surface\",\"component\":\"ConversationSurfacePlugin\",\"facts\":{\"presentation\":\"The canonical empty conversation centers its welcome content and composer. A populated conversation pins its viewport footer toward the bottom. Resizing the outer AppUIModel track alone does not change this internal empty-state alignment.\",\"composition\":\"Keep the existing canonical Conversation Adapter, renderer slots and Composer. Layout changes inside this surface belong in project application composition or scoped CSS, without replacing the Runtime or adding component props to AppUIModel.\",\"styles\":\"The internal content has data-slot=agent-ui-thread-content and flex:1 with a column layout; the composer container has class aui-thread-viewport-footer. To keep the composer at the bottom even in an empty conversation, project CSS can override the content's justify-content and give its footer margin-top:auto. Scope selectors to this conversation surface and verify the actual desktop and narrow Host, including overflow, welcome content and messages.\"}},\"name\":\"Conversation Surface\",\"description\":\"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\"capabilities\":[\"conversation-surface\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p10\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l11\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the primary live and historical conversation experience\"],\"visualRole\":\"primary conversation surface\",\"recommendedSize\":{\"width\":\"minmax(0, 1fr)\"}},\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"childSlots\":{\"assistantResponseFooter\":{\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]}},\"composer\":{\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]}},\"emptySuggestions\":{\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]}},\"emptyWelcome\":{\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"optional\":true},\"headerActions\":{\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]}},\"reasoningGroup\":{\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]}},\"taskGroup\":{\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]}},\"thinkingIndicator\":{\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]}},\"toolFallback\":{\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]}},\"toolGroup\":{\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]}},\"toolTimeline\":{\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]}},\"transientMessages\":{\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]}},\"userEditComposer\":{\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]}}}},{\"pluginId\":\"conversation-thread-list\",\"name\":\"Conversation Thread List\",\"description\":\"Uses the public Conversation thread list with AgentUICreator policy and data binding.\",\"capabilities\":[\"conversation-history\",\"conversation-selection\",\"plugin-service-consumer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p7\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l4\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add conversation management\",\"browse conversation history\",\"select an existing conversation\"],\"visualRole\":\"conversation navigation\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"before\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"width\":\"280px\"}},\"requiredServ