data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_eK0xYjZ4yATyIMJVP6cm6548","messageId":"d46777ec-35c8-403a-92fd-5f3d96421374","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"query\":\"synchronizeAgentUIPluginRegistry 同步注册表 Creator 工具\",\"total\":124,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/create-plugin\",\"title\":\"创建自定义插件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/create-plugin.md\",\"summary\":\"已有插件的属性和组合无法满足需求时，可以在项目中编写新的 React 插件。先到插件检查可复用能力；只需让 Creator 帮你新增功能时，见增加新的界面功能。 以下路径相对于生成目录，默认为 src/agent-ui/。 开发时可以直接复用会话操作、状态 Hook、服务、事件、子插槽和消息展示接口。先查公共能力速查，各项提供使用前提和代码示例；插件组件和业务页面的接口入口也在其中区分。\",\"sha256\":\"e1ab2ce129fe251b39a7fa05e9fe0af74f01eeb50f4b8ef372781cc5f928fbbf\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\"}},\"matchingSections\":[{\"sectionId\":\"s62\",\"title\":\"4. 更新注册并检查\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s62\"}}},{\"sectionId\":\"s1\",\"title\":\"创建自定义插件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s25\",\"title\":\"2. 编写组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s25\"}}}]},{\"documentId\":\"public:guide/cli\",\"title\":\"Creator CLI 参数\",\"source\":\"public\",\"topic\":\"Creator\",\"path\":\"guide/cli.md\",\"summary\":\"安装的命令为 agent-ui-creator。它属于开发工具，默认只启动本地 Creator 服务。图形界面必须通过已接入 Dock 的宿主工程页面使用，宿主开发服务器需另外启动。\",\"sha256\":\"aebad437e491edfd888a0fba0fa1258b8a41a087643d68b443d21442a2bc180f\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/cli\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Creator CLI 参数\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/cli\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s18\",\"title\":\"默认值与退出行为\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/cli\",\"sectionId\":\"s18\"}}}]},{\"documentId\":\"internal:packages/creator/docs/typescript-distribution\",\"title\":\"Creator TypeScript 发行\",\"source\":\"internal\",\"topic\":\"更新与开发工具\",\"path\":\"references/packages/creator/docs/typescript-distribution.md\",\"summary\":\"Creator TypeScript 单包发行、离线文档交接、Node 与 Windows 安装和运行边界。\",\"sha256\":\"a468f9b94c286fc922371bc3bb35fb5b1cfb0a75505af717386cf13ae96675d9\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:packages/creator/docs/typescript-distribution\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Creator TypeScript 发行\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:packages/creator/docs/typescript-distribution\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:updates/creator-maintenance\",\"title\":\"Creator 更新\",\"source\":\"public\",\"topic\":\"更新日志\",\"path\":\"updates/creator-maintenance.md\",\"summary\":\"\",\"sha256\":\"fed747bb52d7648fd3755e442207822176a658e55afb419316d258e085b9549c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:updates/creator-maintenance\"}},\"matchingSections\":[{\"sectionId\":\"s18\",\"title\":\"如何更新 Creator\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:updates/creator-maintenance\",\"sectionId\":\"s18\"}}},{\"sectionId\":\"s1\",\"title\":\"Creator 更新\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:updates/creator-maintenance\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s3\",\"title\":\"1.0.0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:updates/creator-maintenance\",\"sectionId\":\"s3\"}}}]},{\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"title\":\"Creator 开发控制面实现\",\"source\":\"internal\",\"topic\":\"更新与开发工具\",\"path\":\"references/docs/creator-control-plane-implementation-plan.md\",\"summary\":\"Creator 工具控制面、命令、Host guards、上下文及 Mock 管理。\",\"sha256\":\"a55d71bc0dd2f6b4e8fa93b849f6abb6244a8d2d7c8528f16b3857638764526b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\"}},\"matchingSections\":[{\"sectionId\":\"s51\",\"title\":\"4. 权限、读后写与事务\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s51\"}}},{\"sectionId\":\"s121\",\"title\":\"9. 检查与剩余边界\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s121\"}}},{\"sectionId\":\"s113\",\"title\":\"Mock 宿主管理\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s113\"}}}]},{\"documentId\":\"public:guide/creator-dock-rsbuild-webpack\",\"title\":\"Rsbuild / Webpack / CRACO 开发面板接入\",\"source\":\"public\",\"topic\":\"Creator\",\"path\":\"guide/creator-dock-rsbuild-webpack.md\",\"summary\":\"在对应构建工具的开发配置中接入 Creator 面板，保留已有插件、代理和其他选项。Creator 面板自带样式。\",\"sha256\":\"98c82c75419a79e66b8849b7573a5343437df64d0eee1700f57d8c56d12fc88c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-rsbuild-webpack\"}},\"matchingSections\":[{\"sectionId\":\"s94\",\"title\":\"启动与验证\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-rsbuild-webpack\",\"sectionId\":\"s94\"}}},{\"sectionId\":\"s5\",\"title\":\"配置启动脚本\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-rsbuild-webpack\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s17\",\"title\":\"Rsbuild\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-rsbuild-webpack\",\"sectionId\":\"s17\"}}}]},{\"documentId\":\"public:guide/creator-dock-vite\",\"title\":\"Vite 开发面板接入\",\"source\":\"public\",\"topic\":\"Creator\",\"path\":\"guide/creator-dock-vite.md\",\"summary\":\"Vite Dock 在开发页面中添加 Creator Agent 按钮，展开后即可对话修改工程。\",\"sha256\":\"4257d16950626c58bdb8062ded564e6f77f0d19294475ef1637d64a26ae55aed\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-vite\"}},\"matchingSections\":[{\"sectionId\":\"s5\",\"title\":\"配置启动脚本\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-vite\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s36\",\"title\":\"启动与验证\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-vite\",\"sectionId\":\"s36\"}}},{\"sectionId\":\"s13\",\"title\":\"配置开发面板\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:guide/creator-dock-vite\",\"sectionId\":\"s13\"}}}]},{\"documentId\":\"public:development/vue\",\"title\":\"Vue 工程接入\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/vue.md\",\"summary\":\"Vue 页面通过 Web Component 显示 Agent UI。Vue 工程负责放置组件、传入配置和监听事件；助理的组件实现和定制在提供该 Web Component 的 React 工程中维护。 按是否需要定制选择接入方式：\",\"sha256\":\"76bf141c94a1b85bf109619404bd3d15371102a877859d214ad1e1acba9d9883\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/vue\"}},\"matchingSections\":[{\"sectionId\":\"s17\",\"title\":\"1. 启动 Creator 并选择 Vue 工程\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/vue\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s13\",\"title\":\"通过 Creator 创建并定制\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/vue\",\"sectionId\":\"s13\"}}},{\"sectionId\":\"s49\",\"title\":\"4. 定制后更新到 Vue 页面\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/vue\",\"sectionId\":\"s49\"}}}]}],\"nextOffset\":8}}","role":"tool"}

