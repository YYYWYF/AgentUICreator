data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_NJu0Zpblkv1zewr6gv4Q2167","messageId":"a0bb0a5e-d002-45e7-b069-7ed892b468db","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"d66aa08238c6290005ef4ca1ab11c4e213c9224bfa9453d991ec02f9a2fa30fc\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"sales-report-message\",\"name\":\"Sales Report Message\",\"description\":\"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\",\"directory\":\"sales-report-message\",\"manifestPath\":\"src/agent-ui/plugins/sales-report-message/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/sales-report-message/definition.ts\",\"capabilities\":[\"sales-report-message\"],\"authoring\":{\"intents\":[\"显示月度销售报表表格\",\"在聊天消息里显示报表\",\"按收入排序查看每月订单数量\",\"render sales report table in chat\"],\"visualRole\":\"chat message renderer for the app.sales.report custom event\"},\"childSlots\":{},\"dataMessageUINames\":[\"app.sales.report\"],\"selected\":true},\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":1,\"resolved\":1,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-runtime/ui\",\"symbols\":[{\"name\":\"AgentProps\",\"status\":\"available\",\"type\":\"AgentProps\",\"truncated\":false,\"memberNames\":[\"appEventSchemas\",\"locales\",\"defaultLocale\",\"welcome\",\"suggestions\",\"enableMessageQueue\",\"assistantPanelWidth\",\"conversationDataSource\",\"toolkit\",\"frontendToolUIs\",\"integrations\",\"frontendTools\",\"getRunContext\",\"theme\",\"onThemeChange\",\"user\",\"transientMessages\",\"locale\",\"onLocaleChange\",\"endpoint\",\"observability\",\"onError\",\"runResumeProvider\",\"initialThreadId\",\"attachments\",\"dictation\",\"feedback\",\"attachmentAdapter\",\"dictationAdapter\",\"feedbackAdapter\"],\"memberNamesTruncated\":false,\"parameterQueries\":[\"AgentProps.integrations.$parameter0\",\"AgentProps.getRunContext.$parameter0\",\"AgentProps.onThemeChange.$parameter0\",\"AgentProps.onLocaleChange.$parameter0\",\"AgentProps.onError.$parameter0\",\"AgentProps.runResumeProvider.$parameter0\"],\"parameterContracts\":[{\"query\":\"AgentProps.integrations.$parameter0\",\"type\":\"{ children: ReactNode; }\",\"truncated\":false,\"propNames\":[\"children\"],\"propNamesTruncated\":false,\"members\":[{\"name\":\"children\",\"type\":\"ReactNode\",\"truncated\":false}],\"membersTruncated\":false}],\"parameterContractsTruncated\":true,\"nextEvidence\":\"Invocation parameters are included in parameterContracts. Truncation flags identify omitted details; parameterQueries expand exact parameter paths.\",\"members\":[{\"name\":\"appEventSchemas\",\"type\":\"Readonly<Record<string, ZodTypeAny<unknown, unknown, $ZodTypeInternals<unknown, unknown>>>> | undefined\",\"truncated\":false},{\"name\":\"locales\",\"type\":\"Partial<Record<AgentUILocaleCode, AgentUILocaleOverrides>> | undefined\",\"truncated\":false},{\"name\":\"defaultLocale\",\"type\":\"AgentUILocaleCode | undefined\",\"truncated\":false},{\"name\":\"welcome\",\"type\":\"ConversationWelcomeConfig | undefined\",\"truncated\":false},{\"name\":\"suggestions\",\"type\":\"readonly ConversationStarterSuggestion[] | ((locale: AgentUILocaleCode) => readonly ConversationStarterSuggestion[]) | undefined\",\"truncated\":false},{\"name\":\"enableMessageQueue\",\"type\":\"boolean | undefined\",\"truncated\":false},{\"name\":\"assistantPanelWidth\",\"type\":\"number | undefined\",\"truncated\":false},{\"name\":\"conversationDataSource\",\"type\":\"ConversationDataSource | undefined\",\"truncated\":false},{\"name\":\"toolkit\",\"type\":\"Readonly<Record<string, ConversationToolkitEntry>> | undefined\",\"truncated\":false},{\"name\":\"frontendToolUIs\",\"type\":\"Readonly<Record<string, ConversationFrontendToolUIEntry>> | undefined\",\"truncated\":false},{\"name\":\"integrations\",\"type\":\"ComponentType<{ children: ReactNode; }> | undefined\",\"truncated\":false},{\"name\":\"frontendTools\",\"type\":\"AgentFrontendToolSource | undefined\",\"truncated\":false},{\"name\":\"getRunContext\",\"type\":\"ConversationRunContextGetter | undefined\",\"truncated\":false},{\"name\":\"theme\",\"type\":\"\\\"dark\\\" | \\\"light\\\" | \\\"violet\\\" | undefined\",\"truncated\":false},{\"name\":\"onThemeChange\",\"type\":\"((theme: \\\"dark\\\" | \\\"light\\\" | \\\"violet\\\") => void) | undefined\",\"truncated\":false},{\"name\":\"user\",\"type\":\"AgentUIUser | null | undefined\",\"truncated\":false},{\"name\":\"transientMessages\",\"type\":\"ConversationTransientMessageService | undefined\",\"truncated\":false},{\"name\":\"locale\",\"type\":\"AgentUILocaleCode | undefined\",\"truncated\":false},{\"name\":\"onLocaleChange\",\"type\":\"((locale: AgentUILocaleCode) => void) | undefined\",\"truncated\":false},{\"name\":\"endpoint\",\"type\":\"string | undefined\",\"truncated\":false},{\"name\":\"observability\",\"type\":\"AgentObservability | undefined\",\"truncated\":false},{\"name\":\"onError\",\"type\":\"((error: Error) => void) | undefined\",\"truncated\":false},{\"name\":\"runResumeProvider\",\"type\":\"ConversationRunResumeProvider<AppAgentState> | undefined\",\"truncated\":false},{\"name\":\"initialThreadId\",\"type\":\"string | undefined\",\"truncated\":false},{\"name\":\"attachments\",\"type\":\"false | AttachmentConfig | undefined\",\"truncated\":false},{\"name\":\"dictation\",\"type\":\"false | DictationConfig | undefined\",\"truncated\":false},{\"name\":\"feedback\",\"type\":\"false | FeedbackConfig | undefined\",\"truncated\":false},{\"name\":\"attachmentAdapter\",\"type\":\"AttachmentAdapter | undefined\",\"truncated\":false},{\"name\":\"dictationAdapter\",\"type\":\"DictationAdapter | undefined\",\"truncated\":false},{\"name\":\"feedbackAdapter\",\"type\":\"ConversationFeedbackAdapter | undefined\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"sales-report-message-main\",\"pluginId\":\"sales-report-message\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":5,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"sales-report-message-main\"}],\"manifest\":{\"id\":\"sales-report-message\",\"name\":\"Sales Report Message\",\"description\":\"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\",\"version\":\"0.0.1\",\"capabilities\":[\"sales-report-message\"],\"data\":{\"messageUI\":true},\"authoring\":{\"intents\":[\"显示月度销售报表表格\",\"在聊天消息里显示报表\",\"按收入排序查看每月订单数量\",\"render sales report table in chat\"],\"visualRole\":\"chat message renderer for the app.sales.report custom event\"}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { SalesReportMessagePlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      name: \\\"app.sales.report\\\",\\n      render: SalesReportMessagePlugin,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":601},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/sales-report-message/definition.ts\",\"kind\":\"file\",\"bytes\":601},{\"path\":\"src/agent-ui/plugins/sales-report-message/index.tsx\",\"kind\":\"file\",\"bytes\":5742},{\"path\":\"src/agent-ui/plugins/sales-report-message/manifest.json\",\"kind\":\"file\",\"bytes\":596},{\"path\":\"src/agent-ui/plugins/sales-report-message/schema.ts\",\"kind\":\"file\",\"bytes\":3417},{\"path\":\"src/agent-ui/plugins/sales-report-message/styles.css\",\"kind\":\"file\",\"bytes\":2548}],\"filesTruncated\":false}}","role":"tool"}

