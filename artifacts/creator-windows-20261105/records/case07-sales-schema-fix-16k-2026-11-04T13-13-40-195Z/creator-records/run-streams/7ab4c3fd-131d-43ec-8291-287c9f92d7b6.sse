"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"agent-plan-message\",\"name\":\"Agent Plan\",\"description\":\"Renders authoritative AG-UI agent-plan activity in assistant messages.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"agent-status-message\",\"name\":\"Agent Status\",\"description\":\"Renders mock_agent_status tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"ask-user-question\",\"name\":\"Ask User Question\",\"description\":\"Collect structured choices or text answers inside the conversation.\",\"capabilities\":[\"human-input\",\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"auth-account\",\"name\":\"Account\",\"description\":\"Account\",\"capabilities\":[\"account\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"auth.session\",\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"auth-gate\",\"name\":\"Authentication Gate\",\"description\":\"Authentication Gate\",\"capabilities\":[\"authentication\",\"plugin-service-provider\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"chart-message\",\"name\":\"Chart Message\",\"description\":\"Renders named chart data inside assistant messages.\",\"capabilities\":[],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"composer\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/composer\",\"component\":\"ConversationComposerPlugin\",\"facts\":{\"presentation\":\"The editable text field is a textarea by default. data-slot=aui_composer-input is its containing div; data-slot=aui_composer-shell is the outer surface containing input and actions. Container height is distinct from editable field height.\",\"composition\":\"The public component prop type is ConversationCanonicalComposerProps, exported from @za38.03/agent-ui-plugins. The /composer entry exports the Plugin component. inputProps forwards textarea props including rows, style, className and onChange; preserve existing handlers. Other root props configure the outer form. Root rows and maxLength configure the default textarea; a defined root maxLength wins over inputProps.maxLength. The input prop replaces the default input; inspect an existing replacement before changing it. For a live character count that follows typing, send and programmatic clears, query useConversationComposer from the public root module and observe its text; this hook uses the existing canonical Composer and does not create a Runtime. The default shell is a column: input and aui_composer-actions are separate children; the actions row contains leading/trailing actions, with submitAction in trailing-actions.\",\"interaction\":\"A direct placeholder prop overrides composer.placeholder, including Host locale overrides; a fixed string also persists when the locale changes. Generated Agent accepts locales with per-locale overrides, for example zh-CN and en-US entries containing composer.placeholder; preserve existing Host overrides when adding project defaults. The public useAgentUILocale('composer') reads this shared namespace, and useAgentUILocaleCode() reads the same current locale. Custom project business labels may use a small project-owned en-US/zh-CN message dictionary selected by that unified locale code; do not create another language state/Context or add fields to the closed npm AgentUILocaleMessages type. Keep the existing Composer and its native event handlers.\",\"styles\":\"inputProps.style.minHeight sizes the textarea, not the shell. Project CSS may target [data-slot=aui_composer-input] textarea. The package's styled outer shell uses :is(.agent-ui-root, .agent-ui-conversation)[data-theme] [data-slot=\\\"aui_composer-shell\\\"] with border-radius:18px; :hover and :focus-within add border/shadow rules. A bare [data-slot=\\\"aui_composer-shell\\\"] override has lower specificity and can lose even when imported later. Use that full scoped selector and corresponding focus state in later project CSS for radius/border overrides, then inspect computed borderRadius/borderColor in the actual Host. Button wrapping belongs to the actions row and leading/trailing action groups; flex-basis on a child of the column shell can instead change input height. Preserve textarea, attachments and submit behavior.\"}},\"name\":\"Conversation Composer\",\"description\":\"Renders the canonical Agent UI conversation composer with composable action Slots.\",\"capabilities\":[\"conversation-composer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"beforeInput\":{\"description\":\"Content displayed between attachments and the composer input.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-before-input\"]}},\"input\":{\"description\":\"Optional text input presentation; falls back to the canonical textarea.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-input\"]}},\"leadingActions\":{\"description\":\"Inline actions displayed on the leading side of the composer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-leading-action\",\"conversation-composer-trailing-action\"]}},\"submitAction\":{\"description\":\"The primary send or stop action for the composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-submit-action\"]}},\"trailingActions\":{\"description\":\"Inline actions displayed before the composer submit action.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trailing-action\",\"conversation-composer-leading-action\"]}},\"triggers\":{\"description\":\"Optional conversation input triggers.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer-trigger\"]}}}},{\"pluginId\":\"context-retrieval-message\",\"name\":\"Context Retrieval Message\",\"description\":\"Renders context retrieval results carried by AG-UI CUSTOM events.\",\"capabilities\":[],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-command-source\",\"name\":\"Conversation Command Source\",\"description\":\"Provides project-owned slash commands through the existing Plugin Service lifecycle.\",\"capabilities\":[\"headless\",\"plugin-service-provider\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-data-source\",\"name\":\"Conversation Data Source\",\"description\":\"Provides conversation history data through an application-owned API.\",\"capabilities\":[\"headless\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-new\",\"name\":\"New Conversation\",\"description\":\"Starts a new conversation independently of history management.\",\"capabilities\":[\"conversation-create\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-quote\",\"name\":\"Conversation Quote\",\"description\":\"Quote assistant passages with an optional composer preview and selection toolbar. Sent quotes remain conversation history.\",\"capabilities\":[\"conversation-composer-before-input\",\"conversation-quote\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"conversation-service\",\"name\":\"Conversation Service\",\"description\":\"Provides shared application conversation state and history navigation independently from presentation plugins.\",\"capabilities\":[\"conversation-service\",\"headless\",\"plugin-service-provider\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.conversation-data-source\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-suggestions\",\"name\":\"Conversation Suggestions\",\"description\":\"Renders starter prompts through the Conversation public surface.\",\"capabilities\":[\"conversation-suggestions\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"conversation-surface\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/conversation-surface\",\"component\":\"ConversationSurfacePlugin\",\"facts\":{\"presentation\":\"The canonical empty conversation centers its welcome content and composer. A populated conversation pins its viewport footer toward the bottom. Resizing the outer AppUIModel track alone does not change this internal empty-state alignment.\",\"composition\":\"Keep the existing canonical Conversation Adapter, renderer slots and Composer. Layout changes inside this surface belong in project application composition or scoped CSS, without replacing the Runtime or adding component props to AppUIModel.\",\"styles\":\"The internal content has data-slot=agent-ui-thread-content and flex:1 with a column layout; the composer container has class aui-thread-viewport-footer. To keep the composer at the bottom even in an empty conversation, project CSS can override the content's justify-content and give its footer margin-top:auto. Scope selectors to this conversation surface and verify the actual desktop and narrow Host, including overflow, welcome content and messages.\"}},\"name\":\"Conversation Surface\",\"description\":\"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\"capabilities\":[\"conversation-surface\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"childSlots\":{\"assistantResponseFooter\":{\"description\":\"Renderer displayed once beneath the final assistant message of a complete response.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-footer-renderer\"]}},\"composer\":{\"description\":\"Primary conversation composer.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-composer\"]}},\"emptySuggestions\":{\"description\":\"Suggested prompts or actions displayed when the conversation is empty.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-suggestions\"]}},\"emptyWelcome\":{\"description\":\"Welcome content displayed when the conversation is empty.\",\"cardinality\":\"one\",\"optional\":true},\"headerActions\":{\"description\":\"Top-right controls displayed on the Conversation surface.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"theme-control\",\"locale-control\"]}},\"reasoningGroup\":{\"description\":\"Renderer for one assistant reasoning group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-reasoning-renderer\"]}},\"taskGroup\":{\"description\":\"Renderer for one or more tool calls containing nested agent tasks.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-task-group-renderer\"]}},\"thinkingIndicator\":{\"description\":\"Message-scoped thinking placeholder.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-thinking-indicator-renderer\"]}},\"toolFallback\":{\"description\":\"Renderer for an unnamed tool UI fallback.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-fallback-renderer\"]}},\"toolGroup\":{\"description\":\"Renderer for one assistant tool group.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-group-renderer\"]}},\"toolTimeline\":{\"description\":\"One tool execution timeline per assistant message.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-tool-timeline-renderer\"]}},\"transientMessages\":{\"description\":\"Display-only temporary user and assistant messages, isolated from Agent history and context.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-transient-messages-renderer\"]}},\"userEditComposer\":{\"description\":\"Renderer for the active user message edit composer.\",\"cardinality\":\"one\",\"mode\":\"renderer\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-user-edit-composer-renderer\"]}}}},{\"pluginId\":\"conversation-thread-list\",\"name\":\"Conversation Thread List\",\"description\":\"Uses the public Conversation thread list with AgentUICreator policy and data binding.\",\"capabilities\":[\"conversation-history\",\"conversation-selection\",\"plugin-service-consumer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.conversations\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.theme\",\"agent-ui.locale\"],\"available\":[\"agent-ui.theme\",\"agent-ui.locale\"]},\"sidebar\":{\"icon\":\"messages-square\",\"labels\":{\"en-US\":\"History\",\"zh-CN\":\"历史会话\"}},\"childSlots\":{\"headerActions\":{\"description\":\"Optional conversation navigation actions displayed above search and history.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-create\"]}}}},{\"pluginId\":\"copy-action\",\"name\":\"Conversation Copy Action\",\"description\":\"Copies text from the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"dictation-action\",\"name\":\"Conversation Dictation Action\",\"description\":\"Adds Agent UI dictation controls to the conversation composer.\",\"capabilities\":[\"conversation-composer-trailing-action\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"export-markdown-action\",\"name\":\"Conversation Export Markdown Action\",\"description\":\"Renders More with a Markdown export item for the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"feedback-actions\",\"name\":\"Conversation Feedback Actions\",\"description\":\"Submits helpful or not helpful feedback for the response tail.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"generated-file-message\",\"name\":\"Generated File\",\"description\":\"Renders successful generate_file backend results with the official File element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"help-dismiss-action\",\"name\":\"Help Dismiss Action\",\"description\":\"Header action for the quick help card that dismisses the help body; the card title expands it again.\",\"capabilities\":[\"help-dismiss-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"job-progress-message\",\"name\":\"Job Progress\",\"description\":\"Renders run_ci_job tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-composer-input\",\"name\":\"Conversation Lexical Composer Input\",\"description\":\"Optional plain text input with atomic directive chips.\",\"capabilities\":[\"conversation-composer-input\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-edit-composer\",\"name\":\"Conversation Lexical Edit Composer\",\"description\":\"Rich editing of existing directives in historical user messages.\",\"capabilities\":[\"conversation-user-edit-composer-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/locale-provider\",\"component\":\"LocaleProviderPlugin\",\"facts\":{\"presentation\":\"Generated Agent applications and createAgentUILocaleService() default to zh-CN. Standalone presentation components without the generated Runtime bridge default to en-US. The supported locale codes are zh-CN and en-US; do not search protected implementation source to infer the generated default.\",\"composition\":\"Keep the existing locale-provider service and Runtime locale bridge. Agent locale is controlled, defaultLocale initializes an uncontrolled instance, onLocaleChange observes selection, and locales supplies per-locale partial message overrides. For example, locales['zh-CN'].composer.placeholder customizes the existing Chinese input hint. Supply the English counterpart. Merge project defaults and Host overrides at both locale and domain-field levels: spreading locales only at the top level replaces entire locale dictionaries, losing project defaults when the Host overrides an unrelated domain. Host values win for the exact fields they supply. LocaleProviderPlugin itself only renders children, with no locale/message props.\",\"interaction\":\"The public useAgentUILocale(namespace) reads existing shared domain messages; useAgentUILocaleCode() reads the same current code. For custom project business messages use a small en-US/zh-CN project dictionary keyed by that unified code, without another language state or Context. AgentUILocaleMessages and Overrides describe the package's existing namespaces; unrelated new business keys do not require extending those closed npm types.\"}},\"name\":\"Headless Locale Service Provider\",\"description\":\"Provides the shared application locale service to UI plugins.\",\"capabilities\":[\"headless\",\"locale\",\"plugin-service-provider\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-switch\",\"name\":\"Locale Switch\",\"description\":\"Selects the application language through the shared locale service.\",\"capabilities\":[\"locale-control\",\"plugin-service-consumer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.locale\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"mention-trigger\",\"name\":\"Conversation Mention Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.mention-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"capabilities\":[\"quick-help-card\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"help-dismiss-action\"]}}}},{\"pluginId\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"capabiliti