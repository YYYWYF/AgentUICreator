data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_e5vO5zRvtWUohRLRvRPI1230","messageId":"13b72467-d6b5-47c0-807a-48434cb5e4c7","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/application/Agent.tsx\",\"content\":\"1: import { AgentApplication, type AgentProps } from \\\"@za38.03/agent-ui-runtime/ui\\\";\\n2: import { agentUIProject } from \\\"./project-config\\\";\\n3: export type { AgentProps } from \\\"@za38.03/agent-ui-runtime/ui\\\";\\n4: \\n5: export function Agent(props: AgentProps = {}) {\\n6:   const { locales, ...rest } = props;\\n7:   return (\\n8:     <AgentApplication\\n9:       project={agentUIProject}\\n10:       {...rest}\\n11:       locales={{\\n12:         \\\"zh-CN\\\": { composer: { placeholder: \\\"请输入你的问题\\\" } },\\n13:         \\\"en-US\\\": { composer: { placeholder: \\\"Enter your question\\\" } },\\n14:         ...locales,\\n15:       }}\\n16:     />\\n17:   );\\n18: }\\n19: \",\"hash\":\"eaf24f292fc9b22afd302552de9ae8ea85d8b45d69af6cab563d75f771d437e7\",\"totalLines\":19,\"nextOffset\":null}}","role":"tool"}

data: {"type":"RUN_ERROR","code":"CREATOR_RUN_STOPPED","message":"CREATOR_RUN_STOPPED","metadata":{"receipt":{"files":[{"path":"src/agent-ui/plugins/sales-report-message/manifest.json","status":"created","diff":"--- a/src/agent-ui/plugins/sales-report-message/manifest.json\n+++ b/src/agent-ui/plugins/sales-report-message/manifest.json\n@@ -1,1 +1,22 @@\n-\n+{\n+  \"id\": \"sales-report-message\",\n+  \"name\": \"Sales Report Message\",\n+  \"description\": \"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\",\n+  \"version\": \"0.0.1\",\n+  \"capabilities\": [\n+    \"sales-report-message\"\n+  ],\n+  \"data\": {\n+    \"messageUI\": true\n+  },\n+  \"authoring\": {\n+    \"intents\": [\n+      \"显示月度销售报表表格\",\n+      \"在聊天消息里显示报表\",\n+      \"按收入排序查看每月订单数量\",\n+      \"render sales report table in chat\"\n+    ],\n+    \"visualRole\": \"chat message renderer for the app.sales.report custom event\"\n+  }\n+}\n+","truncated":false},{"path":"src/agent-ui/plugins/sales-report-message/schema.ts","status":"created","diff":"--- a/src/agent-ui/plugins/sales-report-message/schema.ts\n+++ b/src/agent-ui/plugins/sales-report-message/schema.ts\n@@ -1,1 +1,125 @@\n-\n+import { z } from \"zod\";\n+\n+/** Name of the Agent `CUSTOM` event that carries the report envelope. */\n+export const SALES_REPORT_EVENT_NAME = \"app.sales.report\";\n+\n+/**\n+ * The Agent sends `{ format: \"json\", payload: \"<json string>\" }` as the event\n+ * value. The runtime uses this schema only to recognize the event name as an app\n+ * event; the renderer performs the strict decoding itself so an unexpected but\n+ * real payload still reaches the message instead of being dropped silently.\n+ */\n+export const salesReportEventSchema = z.unknown();\n+\n+export type SalesReportRow = {\n+  month: string;\n+  revenue: number;\n+  orderCount: number;\n+};\n+\n+export type SalesReportData = {\n+  title?: string;\n+  rows: SalesReportRow[];\n+};\n+\n+function parseJsonText(value: string): unknown {\n+  const text = value.trim();\n+  if (text === \"\") {\n+    return undefined;\n+  }\n+  try {\n+    return JSON.parse(text) as unknown;\n+  } catch {\n+    return undefined;\n+  }\n+}\n+\n+function isRecord(value: unknown): value is Record<string, unknown> {\n+  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n+}\n+\n+function toFiniteNumber(value: unknown): number | null {\n+  if (typeof value === \"number\") {\n+    return Number.isFinite(value) ? value : null;\n+  }\n+  if (typeof value === \"string\" && value.trim() !== \"\") {\n+    const parsed = Number(value);\n+    return Number.isFinite(parsed) ? parsed : null;\n+  }\n+  return null;\n+}\n+\n+/**\n+ * Unwraps the shapes the report can arrive in: the `{format, payload}` envelope,\n+ * an already decoded `{title, rows}` object, or the raw JSON text.\n+ */\n+function unwrapReportSource(input: unknown, depth = 0): unknown {\n+  if (depth > 4) {\n+    return undefined;\n+  }\n+  if (typeof input === \"string\") {\n+    return parseJsonText(input);\n+  }\n+  if (!isRecord(input)) {\n+    return undefined;\n+  }\n+  if (\"payload\" in input) {\n+    const payload = input.payload;\n+    if (typeof payload === \"string\") {\n+      return parseJsonText(payload);\n+    }\n+    if (isRecord(payload) || Array.isArray(payload)) {\n+      return payload;\n+    }\n+    return undefined;\n+  }\n+  if (\"rows\" in input) {\n+    return input;\n+  }\n+  if (\"value\" in input) {\n+    return unwrapReportSource(input.value, depth + 1);\n+  }\n+  if (\"data\" in input) {\n+    return unwrapReportSource(input.data, depth + 1);\n+  }\n+  return undefined;\n+}\n+\n+function normalizeRow(input: unknown): SalesReportRow | null {\n+  if (!isRecord(input)) {\n+    return null;\n+  }\n+  const month = typeof input.month === \"string\" ? input.month.trim() : \"\";\n+  if (month === \"\") {\n+    return null;\n+  }\n+  const revenue = toFiniteNumber(input.revenue);\n+  const orderCount = toFiniteNumber(input.order_count ?? input.orderCount);\n+  if (revenue === null || orderCount === null) {\n+    return null;\n+  }\n+  return { month, revenue, orderCount };\n+}\n+\n+/** Returns the decoded report, or `null` when the payload is not a usable report. */\n+export function parseSalesReport(input: unknown): SalesReportData | null {\n+  const candidate = unwrapReportSource(input);\n+  if (!isRecord(candidate) || !Array.isArray(candidate.rows)) {\n+    return null;\n+  }\n+\n+  const rows: SalesReportRow[] = [];\n+  for (const item of candidate.rows) {\n+    const row = normalizeRow(item);\n+    if (row) {\n+      rows.push(row);\n+    }\n+  }\n+  if (rows.length === 0 && candidate.rows.length > 0) {\n+    return null;\n+  }\n+\n+  const title = typeof candidate.title === \"string\" ? candidate.title.trim() : \"\";\n+  return { title: title === \"\" ? undefined : title, rows };\n+}\n+","truncated":false},{"path":"src/agent-ui/plugins/sales-report-message/index.tsx","status":"created","diff":"--- a/src/agent-ui/plugins/sales-report-message/index.tsx\n+++ b/src/agent-ui/plugins/sales-report-message/index.tsx\n@@ -1,1 +1,166 @@\n-\n+import { useAgentUILocaleCode } from \"@za38.03/agent-ui-plugins\";\n+import { useMemo, useState } from \"react\";\n+import { parseSalesReport } from \"./schema\";\n+import \"./styles.css\";\n+\n+type SalesReportMessageProps = {\n+  data?: unknown;\n+};\n+\n+type SalesReportLocaleText = {\n+  fallbackTitle: string;\n+  month: string;\n+  revenue: string;\n+  sortDescending: string;\n+  sortAscending: string;\n+  empty: string;\n+  invalid: string;\n+  detailHint: string;\n+  detail: (month: string, orderCount: string) => string;\n+};\n+\n+const messages: Record<string, SalesReportLocaleText> = {\n+  \"zh-CN\": {\n+    fallbackTitle: \"销售报表\",\n+    month: \"月份\",\n+    revenue: \"收入\",\n+    sortDescending: \"收入从高到低\",\n+    sortAscending: \"收入从低到高\",\n+    empty: \"报表中没有可显示的数据行。\",\n+    invalid: \"无法解析这条报表数据，暂时无法显示表格。\",\n+    detailHint: \"点击任意一行查看该月的订单数量。\",\n+    detail: (month, orderCount) => `${month} 的订单数量：${orderCount}`,\n+  },\n+  \"en-US\": {\n+    fallbackTitle: \"Sales report\",\n+    month: \"Month\",\n+    revenue: \"Revenue\",\n+    sortDescending: \"Revenue high to low\",\n+    sortAscending: \"Revenue low to high\",\n+    empty: \"The report has no rows to display.\",\n+    invalid: \"This report data could not be parsed, so the table cannot be shown.\",\n+    detailHint: \"Select a row to see that month's order count.\",\n+    detail: (month, orderCount) => `${month} order count: ${orderCount}`,\n+  },\n+};\n+\n+type SortDirection = \"desc\" | \"asc\";\n+\n+export function SalesReportMessagePlugin(props: SalesReportMessageProps) {\n+  const localeCode = useAgentUILocaleCode();\n+  const text = messages[localeCode] ?? messages[\"zh-CN\"]!;\n+  const report = useMemo(() => parseSalesReport(props.data), [props.data]);\n+  const [direction, setDirection] = useState<SortDirection>(\"desc\");\n+  const [selectedKey, setSelectedKey] = useState<string | null>(null);\n+\n+  const orderedRows = useMemo(() => {\n+    if (!report) {\n+      return [];\n+    }\n+    return report.rows\n+      .map((row, index) => ({ key: `${row.month}#${index}`, row }))\n+      .sort((left, right) =>\n+        direction === \"desc\"\n+          ? right.row.revenue - left.row.revenue\n+          : left.row.revenue - right.row.revenue,\n+      );\n+  }, [report, direction]);\n+\n+  const formatNumber = (value: number) =>\n+    new Intl.NumberFormat(localeCode === \"en-US\" ? \"en-US\" : \"zh-CN\", {\n+      maximumFractionDigits: 0,\n+    }).format(value);\n+\n+  if (!report) {\n+    return (\n+      <div className=\"sales-report sales-report--invalid\" role=\"status\">\n+        <p className=\"sales-report__invalid-text\">{text.invalid}</p>\n+      </div>\n+    );\n+  }\n+\n+  const selected = orderedRows.find((entry) => entry.key === selectedKey) ?? null;\n+  const sortLabel = direction === \"desc\" ? text.sortDescending : text.sortAscending;\n+  const selectRow = (key: string) => {\n+    setSelectedKey((current) => (current === key ? null : key));\n+  };\n+\n+  return (\n+    <section className=\"sales-report\" aria-label={report.title ?? text.fallbackTitle}>\n+      <h3 className=\"sales-report__title\">{report.title ?? text.fallbackTitle}</h3>\n+      <div className=\"sales-report__table-wrap\">\n+        <table className=\"sales-report__table\">\n+          <thead>\n+            <tr>\n+              <th scope=\"col\" className=\"sales-report__head-cell\">\n+                {text.month}\n+              </th>\n+              <th\n+                scope=\"col\"\n+                className=\"sales-report__head-cell sales-report__head-cell--revenue\"\n+                aria-sort={direction === \"desc\" ? \"descending\" : \"ascending\"}\n+              >\n+                <button\n+                  type=\"button\"\n+                  className=\"sales-report__sort\"\n+                  aria-label={`${text.revenue}：${sortLabel}`}\n+                  onClick={() =>\n+                    setDirection((current) => (current === \"desc\" ? \"asc\" : \"desc\"))\n+                  }\n+                >\n+                  <span>{text.revenue}</span>\n+                  <span aria-hidden=\"true\">{direction === \"desc\" ? \"↓\" : \"↑\"}</span>\n+                </button>\n+              </th>\n+            </tr>\n+          </thead>\n+          <tbody>\n+            {orderedRows.length === 0 ? (\n+              <tr>\n+                <td className=\"sales-report__empty\" colSpan={2}>\n+                  {text.empty}\n+                </td>\n+              </tr>\n+            ) : (\n+              orderedRows.map((entry) => {\n+                const isSelected = entry.key === selectedKey;\n+                return (\n+                  <tr\n+                    key={entry.key}\n+                    className=\"sales-report__row\"\n+                    data-selected={isSelected ? \"true\" : \"false\"}\n+                    tabIndex={0}\n+                    aria-selected={isSelected}\n+                    onClick={() => selectRow(entry.key)}\n+                    onKeyDown={(event) => {\n+                      if (event.key === \"Enter\" || event.key === \" \") {\n+                        event.preventDefault();\n+                        selectRow(entry.key);\n+                      }\n+                    }}\n+                  >\n+                    <th scope=\"row\" className=\"sales-report__month\">\n+                      {entry.row.month}\n+                    </th>\n+                    <td className=\"sales-report__revenue\">{formatNumber(entry.row.revenue)}</td>\n+                  </tr>\n+                );\n+              })\n+            )}\n+          </tbody>\n+        </table>\n+      </div>\n+      <div\n+        className=\"sales-report__detail\"\n+        role=\"status\"\n+        aria-live=\"polite\"\n+        data-empty={selected ? \"false\" : \"true\"}\n+      >\n+        {selected\n+          ? text.detail(selected.row.month, formatNumber(selected.row.orderCount))\n+          : text.detailHint}\n+      </div>\n+    </section>\n+  );\n+}\n+","truncated":false},{"path":"src/agent-ui/plugins/sales-report-message/definition.ts","status":"created","diff":"--- a/src/agent-ui/plugins/sales-report-message/definition.ts\n+++ b/src/agent-ui/plugins/sales-report-message/definition.ts\n@@ -1,1 +1,21 @@\n-\n+import type { UIPluginDefinition, UIPluginManifest } from \"@za38.03/agent-ui-plugins\";\n+import { defineDataMessageUI } from \"@za38.03/agent-ui-plugins\";\n+import manifestJson from \"./manifest.json\";\n+import { SalesReportMessagePlugin } from \"./index\";\n+\n+const definition: UIPluginDefinition = {\n+  manifest: manifestJson as UIPluginManifest,\n+  provides: [],\n+  inject: [],\n+  optionalInject: [\"agent-ui.locale\"],\n+  dataMessageUIs: [\n+    defineDataMessageUI<unknown>({\n+      name: \"app.sales.report\",\n+      render: SalesReportMessagePlugin,\n+    }),\n+  ],\n+  Component: () => null,\n+};\n+\n+export default definition;\n+","truncated":false},{"path":"src/agent-ui/plugins/sales-report-message/styles.css","status":"created","diff":"--- a/src/agent-ui/plugins/sales-report-message/styles.css\n+++ b/src/agent-ui/plugins/sales-report-message/styles.css\n@@ -1,1 +1,152 @@\n-\n+.sales-report {\n+  box-sizing: border-box;\n+  width: 100%;\n+  min-width: 0;\n+  padding: 12px;\n+  border: 1px solid var(--border);\n+  border-radius: 12px;\n+  background: var(--card);\n+  color: var(--foreground);\n+  font-size: 13px;\n+  line-height: 1.5;\n+}\n+\n+.sales-report__title {\n+  margin: 0 0 8px;\n+  font-size: 14px;\n+  font-weight: 600;\n+  overflow-wrap: anywhere;\n+}\n+\n+.sales-report__table-wrap {\n+  min-width: 0;\n+  overflow-x: auto;\n+}\n+\n+.sales-report__table {\n+  width: 100%;\n+  border-collapse: collapse;\n+  font-variant-numeric: tabular-nums;\n+}\n+\n+.sales-report__table th,\n+.sales-report__table td {\n+  padding: 6px 8px;\n+  text-align: left;\n+  white-space: nowrap;\n+  border-bottom: 1px solid var(--border);\n+}\n+\n+.sales-report__table tbody tr:last-child th,\n+.sales-report__table tbody tr:last-child td {\n+  border-bottom: none;\n+}\n+\n+.sales-report__head-cell {\n+  font-size: 12px;\n+  font-weight: 600;\n+  opacity: 0.75;\n+}\n+\n+.sales-report__head-cell--revenue {\n+  text-align: right;\n+}\n+\n+.sales-report__sort {\n+  display: inline-flex;\n+  align-items: center;\n+  gap: 4px;\n+  margin: 0;\n+  padding: 2px 4px;\n+  border: none;\n+  border-radius: 6px;\n+  background: transparent;\n+  color: inherit;\n+  font: inherit;\n+  font-size: 12px;\n+  font-weight: 600;\n+  cursor: pointer;\n+}\n+\n+.sales-report__sort:hover {\n+  background: var(--muted);\n+}\n+\n+.sales-report__sort:focus-visible {\n+  outline: 2px solid var(--ring, var(--border));\n+  outline-offset: 2px;\n+}\n+\n+.sales-report__row {\n+  cursor: pointer;\n+}\n+\n+.sales-report__row:hover {\n+  background: var(--muted);\n+}\n+\n+.sales-report__row:focus-visible {\n+  outline: 2px solid var(--ring, var(--border));\n+  outline-offset: -2px;\n+}\n+\n+.sales-report__row[data-selected=\"true\"] {\n+  background: var(--muted);\n+}\n+\n+.sales-report__month {\n+  font-weight: 500;\n+  text-align: left;\n+}\n+\n+.sales-report__row[data-selected=\"true\"] .sales-report__month {\n+  font-weight: 600;\n+}\n+\n+.sales-report__revenue {\n+  text-align: right;\n+}\n+\n+.sales-report__detail {\n+  margin-top: 8px;\n+  padding: 6px 8px;\n+  border-radius: 8px;\n+  background: var(--muted);\n+  font-size: 13px;\n+  overflow-wrap: anywhere;\n+}\n+\n+.sales-report__detail[data-empty=\"true\"] {\n+  padding-left: 0;\n+  background: transparent;\n+  font-size: 12px;\n+  opacity: 0.7;\n+}\n+\n+.sales-report__empty {\n+  padding: 8px;\n+  text-align: center;\n+  opacity: 0.7;\n+}\n+\n+.sales-report--invalid {\n+  border-style: dashed;\n+}\n+\n+.sales-report__invalid-text {\n+  margin: 0;\n+  font-size: 13px;\n+  overflow-wrap: anywhere;\n+}\n+\n+@media (max-width: 480px) {\n+  .sales-report {\n+    padding: 10px;\n+  }\n+\n+  .sales-report__table th,\n+  .sales-report__table td {\n+    padding: 6px;\n+  }\n+}\n+","truncated":false},{"path":"src/agent-ui/plugins/registry.generated.ts","status":"modified","diff":"--- a/src/agent-ui/plugins/registry.generated.ts\n+++ b/src/agent-ui/plugins/registry.generated.ts\n@@ -1,1070 +1,711 @@\n-/**\n- * Generated by scripts/generate-plugin-registry.ts from plugins/* capabilities.\n- * Do not edit this file by hand.\n- */\n-import { createPluginCapabilityCatalog } from \"@za38.03/agent-ui-runtime/ui\";\n-\n-export const capabilityCatalogRevision = \"03f888fce2d7783381854d8fa83978107fd642ae60dcbaa150c148f5a1ac9769\";\n-\n-export const pluginCapabilityCatalog = createPluginCapabilityCatalog([\n-  {\n-    manifest: {\n-      \"id\": \"add-attachment-action\",\n-      \"name\": \"Conversation Add Attachment Action\",\n-      \"description\": \"Adds Agent UI's attachment picker to the conversation composer.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-composer-leading-action\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"add attachments to the conversation composer\"\n-        ],\n-        \"visualRole\": \"conversation composer attachment action\",\n-        \"defaultPlacement\": {\n-          \"type\": \"plugin_slot\",\n-          \"parentPluginId\": \"composer\",\n-          \"slot\": \"leadingActions\"\n-        }\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./add-attachment-action/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"agent-identity\",\n-      \"name\": \"Agent Identity\",\n-      \"description\": \"Displays configurable Agent name, logo and optional description in a normal Layout Slot.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"agent-identity\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"rename Agent\",\n-          \"change Agent name\",\n-          \"change Agent logo\",\n-          \"change Agent brand information\",\n-          \"把我的 Agent 改名为智能研发助手\",\n-          \"把 Agent 的 Logo 换成公司的标志\"\n-        ],\n-        \"visualRole\": \"Agent identity in a normal Layout Slot; edit plugins/agent-identity/config.ts for branding\"\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [\"agent-ui.locale\"],\n-    loadDefinition: () =>\n-      import(\"./agent-identity/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"composer\",\n-      \"name\": \"Conversation Composer\",\n-      \"description\": \"Renders the canonical Agent UI conversation composer with composable action Slots.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-composer\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"show the primary conversation composer\",\n-          \"compose conversation input actions\"\n-        ],\n-        \"visualRole\": \"conversation composer\",\n-        \"defaultPlacement\": {\n-          \"type\": \"plugin_slot\",\n-          \"parentPluginId\": \"conversation-surface\",\n-          \"slot\": \"composer\"\n-        }\n-      },\n-      \"slots\": {\n-        \"children\": {\n-          \"triggers\": {\n-            \"description\": \"Optional conversation input triggers.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-trigger\"\n-              ]\n-            }\n-          },\n-          \"beforeInput\": {\n-            \"description\": \"Content displayed between attachments and the composer input.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-before-input\"\n-              ]\n-            }\n-          },\n-          \"leadingActions\": {\n-            \"description\": \"Inline actions displayed on the leading side of the composer.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-leading-action\",\n-                \"conversation-composer-trailing-action\"\n-              ]\n-            }\n-          },\n-          \"trailingActions\": {\n-            \"description\": \"Inline actions displayed before the composer submit action.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-trailing-action\",\n-                \"conversation-composer-leading-action\"\n-              ]\n-            }\n-          },\n-          \"submitAction\": {\n-            \"description\": \"The primary send or stop action for the composer.\",\n-            \"cardinality\": \"one\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-submit-action\"\n-              ]\n-            }\n-          },\n-          \"input\": {\n-            \"description\": \"Optional text input presentation; falls back to the canonical textarea.\",\n-            \"cardinality\": \"one\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-composer-input\"\n-              ]\n-            }\n-          }\n-        }\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [\"agent-ui.locale\"],\n-    loadDefinition: () =>\n-      import(\"./composer/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"context-retrieval-message\",\n-      \"name\": \"Context Retrieval Message\",\n-      \"description\": \"Renders context retrieval results carried by AG-UI CUSTOM events.\",\n-      \"version\": \"0.0.1\",\n-      \"authoring\": {\n-        \"intents\": [\n-          \"render context retrieval results inside assistant messages\"\n-        ]\n-      },\n-      \"data\": {\n-        \"messageUI\": true\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./context-retrieval-message/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-data-source\",\n-      \"name\": \"Conversation Data Source\",\n-      \"description\": \"Provides conversation history data through an application-owned API.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"headless\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"provide persistent conversation history data to conversation capabilities\"\n-        ]\n-      }\n-    },\n-    provides: [\"agent-ui.conversation-data-source\"],\n-    inject: [],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./conversation-data-source/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-new\",\n-      \"name\": \"New Conversation\",\n-      \"description\": \"Starts a new conversation independently of history management.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-create\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"start a new conversation\"\n-        ],\n-        \"visualRole\": \"conversation header action\"\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./conversation-new/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-quote\",\n-      \"name\": \"Conversation Quote\",\n-      \"description\": \"Quote assistant passages with an optional composer preview and selection toolbar. Sent quotes remain conversation history.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-quote\",\n-        \"conversation-composer-before-input\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"quote part of an assistant response\",\n-          \"reply to a specific passage\",\n-          \"引用回答中的一段内容\",\n-          \"加上引用功能\"\n-        ],\n-        \"visualRole\": \"conversation quote creation\",\n-        \"defaultPlacement\": {\n-          \"type\": \"plugin_slot\",\n-          \"parentPluginId\": \"composer\",\n-          \"slot\": \"beforeInput\"\n-        }\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [\"agent-ui.locale\"],\n-    loadDefinition: () =>\n-      import(\"./conversation-quote/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-service\",\n-      \"name\": \"Conversation Service\",\n-      \"description\": \"Provides shared application conversation state and history navigation independently from presentation plugins.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"headless\",\n-        \"conversation-service\",\n-        \"plugin-service-provider\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"provide shared conversation management state and history navigation\"\n-        ]\n-      }\n-    },\n-    provides: [\"agent-ui.conversations\"],\n-    inject: [\"agent-ui.conversation-data-source\"],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./conversation-service/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-suggestions\",\n-      \"name\": \"Conversation Suggestions\",\n-      \"description\": \"Renders starter prompts through the Conversation public surface.\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-suggestions\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"show starter prompts and suggested conversation actions\"\n-        ],\n-        \"visualRole\": \"conversation empty-state suggestions\",\n-        \"defaultPlacement\": {\n-          \"type\": \"plugin_slot\",\n-          \"parentPluginId\": \"conversation-surface\",\n-          \"slot\": \"emptySuggestions\"\n-        }\n-      }\n-    },\n-    provides: [],\n-    inject: [],\n-    optionalInject: [],\n-    loadDefinition: () =>\n-      import(\"./conversation-suggestions/definition\").then(\n-        ({ default: definition }) => definition,\n-      ),\n-  },\n-  {\n-    manifest: {\n-      \"id\": \"conversation-surface\",\n-      \"name\": \"Conversation Surface\",\n-      \"description\": \"组合 Live 与只读 History 会话的空状态、消息时间线与输入区。\",\n-      \"version\": \"0.0.1\",\n-      \"capabilities\": [\n-        \"conversation-surface\"\n-      ],\n-      \"authoring\": {\n-        \"intents\": [\n-          \"show the primary live and historical conversation experience\"\n-        ],\n-        \"visualRole\": \"primary conversation surface\",\n-        \"recommendedSize\": {\n-          \"width\": \"minmax(0, 1fr)\"\n-        }\n-      },\n-      \"slots\": {\n-        \"children\": {\n-          \"emptyWelcome\": {\n-            \"description\": \"Welcome content displayed when the conversation is empty.\",\n-            \"cardinality\": \"one\",\n-            \"optional\": true\n-          },\n-          \"emptySuggestions\": {\n-            \"description\": \"Suggested prompts or actions displayed when the conversation is empty.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"conversation-suggestions\"\n-              ]\n-            }\n-          },\n-          \"headerActions\": {\n-            \"description\": \"Top-right controls displayed on the Conversation surface.\",\n-            \"cardinality\": \"many\",\n-            \"optional\": true,\n-            \"accepts\": {\n-              \"anyOfCapabilities\": [\n-                \"theme-control\",\n-                \"locale-control\"\n-              ]\n-            }\n-          },\n-          \"composer\": {\n-            \"description\": \"Primary conversation composer.\",\n- 