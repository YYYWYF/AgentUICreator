data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_S4unYYbErlr9CyjiVUFh1272","delta":"{\"pluginId\":\"sales-report-message\",\"files\":[{\"relativePath\":\"manifest.json\",\"content\":\"{\\n  \\\"id\\\": \\\"sales-report-message\\\",\\n  \\\"name\\\": \\\"Sales Report Message\\\",\\n  \\\"description\\\": \\\"Renders app.sales.report custom events as a sortable monthly revenue table inside chat messages.\\\",\\n  \\\"version\\\": \\\"0.0.1\\\",\\n  \\\"capabilities\\\": [\\n    \\\"sales-report-message\\\"\\n  ],\\n  \\\"data\\\": {\\n    \\\"messageUI\\\": true\\n  },\\n  \\\"authoring\\\": {\\n    \\\"intents\\\": [\\n      \\\"显示月度销售报表表格\\\",\\n      \\\"在聊天消息里显示报表\\\",\\n      \\\"按收入排序查看每月订单数量\\\",\\n      \\\"render sales report table in chat\\\"\\n    ],\\n    \\\"visualRole\\\": \\\"chat message renderer for the app.sales.report custom event\\\"\\n  }\\n}\\n\"},{\"relativePath\":\"schema.ts\",\"content\":\"import { z } from \\\"zod\\\";\\n\\n/** Name of the Agent `CUSTOM` event that carries the report envelope. */\\nexport const SALES_REPORT_EVENT_NAME = \\\"app.sales.report\\\";\\n\\n/**\\n * The Agent sends `{ format: \\\"json\\\", payload: \\\"<json string>\\\" }` as the event\\n * value. The runtime uses this schema only to recognize the event name as an app\\n * event; the renderer performs the strict decoding itself so an unexpected but\\n * real payload still reaches the message instead of being dropped silently.\\n */\\nexport const salesReportEventSchema = z.unknown();\\n\\nexport type SalesReportRow = {\\n  month: string;\\n  revenue: number;\\n  orderCount: number;\\n};\\n\\nexport type SalesReportData = {\\n  title?: string;\\n  rows: SalesReportRow[];\\n};\\n\\nfunction parseJsonText(value: string): unknown {\\n  const text = value.trim();\\n  if (text === \\\"\\\") {\\n    return undefined;\\n  }\\n  try {\\n    return JSON.parse(text) as unknown;\\n  } catch {\\n    return undefined;\\n  }\\n}\\n\\nfunction isRecord(value: unknown): value is Record<string, unknown> {\\n  return typeof value === \\\"object\\\" && value !== null && !Array.isArray(value);\\n}\\n\\nfunction toFiniteNumber(value: unknown): number | null {\\n  if (typeof value === \\\"number\\\") {\\n    return Number.isFinite(value) ? value : null;\\n  }\\n  if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") {\\n    const parsed = Number(value);\\n    return Number.isFinite(parsed) ? parsed : null;\\n  }\\n  return null;\\n}\\n\\n/**\\n * Unwraps the shapes the report can arrive in: the `{format, payload}` envelope,\\n * an already decoded `{title, rows}` object, or the raw JSON text.\\n */\\nfunction unwrapReportSource(input: unknown, depth = 0): unknown {\\n  if (depth > 4) {\\n    return undefined;\\n  }\\n  if (typeof input === \\\"string\\\") {\\n    return parseJsonText(input);\\n  }\\n  if (!isRecord(input)) {\\n    return undefined;\\n  }\\n  if (\\\"payload\\\" in input) {\\n    const payload = input.payload;\\n    if (typeof payload === \\\"string\\\") {\\n      return parseJsonText(payload);\\n    }\\n    if (isRecord(payload) || Array.isArray(payload)) {\\n      return payload;\\n    }\\n    return undefined;\\n  }\\n  if (\\\"rows\\\" in input) {\\n    return input;\\n  }\\n  if (\\\"value\\\" in input) {\\n    return unwrapReportSource(input.value, depth + 1);\\n  }\\n  if (\\\"data\\\" in input) {\\n    return unwrapReportSource(input.data, depth + 1);\\n  }\\n  return undefined;\\n}\\n\\nfunction normalizeRow(input: unknown): SalesReportRow | null {\\n  if (!isRecord(input)) {\\n    return null;\\n  }\\n  const month = typeof input.month === \\\"string\\\" ? input.month.trim() : \\\"\\\";\\n  if (month === \\\"\\\") {\\n    return null;\\n  }\\n  const revenue = toFiniteNumber(input.revenue);\\n  const orderCount = toFiniteNumber(input.order_count ?? input.orderCount);\\n  if (revenue === null || orderCount === null) {\\n    return null;\\n  }\\n  return { month, revenue, orderCount };\\n}\\n\\n/** Returns the decoded report, or `null` when the payload is not a usable report. */\\nexport function parseSalesReport(input: unknown): SalesReportData | null {\\n  const candidate = unwrapReportSource(input);\\n  if (!isRecord(candidate) || !Array.isArray(candidate.rows)) {\\n    return null;\\n  }\\n\\n  const rows: SalesReportRow[] = [];\\n  for (const item of candidate.rows) {\\n    const row = normalizeRow(item);\\n    if (row) {\\n      rows.push(row);\\n    }\\n  }\\n  if (rows.length === 0 && candidate.rows.length > 0) {\\n    return null;\\n  }\\n\\n  const title = typeof candidate.title === \\\"string\\\" ? candidate.title.trim() : \\\"\\\";\\n  return { title: title === \\\"\\\" ? undefined : title, rows };\\n}\\n\"},{\"relativePath\":\"index.tsx\",\"content\":\"import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { useMemo, useState } from \\\"react\\\";\\nimport { parseSalesReport } from \\\"./schema\\\";\\nimport \\\"./styles.css\\\";\\n\\ntype SalesReportMessageProps = {\\n  data?: unknown;\\n};\\n\\ntype SalesReportLocaleText = {\\n  fallbackTitle: string;\\n  month: string;\\n  revenue: string;\\n  sortDescending: string;\\n  sortAscending: string;\\n  empty: string;\\n  invalid: string;\\n  detailHint: string;\\n  detail: (month: string, orderCount: string) => string;\\n};\\n\\nconst messages: Record<string, SalesReportLocaleText> = {\\n  \\\"zh-CN\\\": {\\n    fallbackTitle: \\\"销售报表\\\",\\n    month: \\\"月份\\\",\\n    revenue: \\\"收入\\\",\\n    sortDescending: \\\"收入从高到低\\\",\\n    sortAscending: \\\"收入从低到高\\\",\\n    empty: \\\"报表中没有可显示的数据行。\\\",\\n    invalid: \\\"无法解析这条报表数据，暂时无法显示表格。\\\",\\n    detailHint: \\\"点击任意一行查看该月的订单数量。\\\",\\n    detail: (month, orderCount) => `${month} 的订单数量：${orderCount}`,\\n  },\\n  \\\"en-US\\\": {\\n    fallbackTitle: \\\"Sales report\\\",\\n    month: \\\"Month\\\",\\n    revenue: \\\"Revenue\\\",\\n    sortDescending: \\\"Revenue high to low\\\",\\n    sortAscending: \\\"Revenue low to high\\\",\\n    empty: \\\"The report has no rows to display.\\\",\\n    invalid: \\\"This report data could not be parsed, so the table cannot be shown.\\\",\\n    detailHint: \\\"Select a row to see that month's order count.\\\",\\n    detail: (month, orderCount) => `${month} order count: ${orderCount}`,\\n  },\\n};\\n\\ntype SortDirection = \\\"desc\\\" | \\\"asc\\\";\\n\\nexport function SalesReportMessagePlugin(props: SalesReportMessageProps) {\\n  const localeCode = useAgentUILocaleCode();\\n  const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n  const report = useMemo(() => parseSalesReport(props.data), [props.data]);\\n  const [direction, setDirection] = useState<SortDirection>(\\\"desc\\\");\\n  const [selectedKey, setSelectedKey] = useState<string | null>(null);\\n\\n  const orderedRows = useMemo(() => {\\n    if (!report) {\\n      return [];\\n    }\\n    return report.rows\\n      .map((row, index) => ({ key: `${row.month}#${index}`, row }))\\n      .sort((left, right) =>\\n        direction === \\\"desc\\\"\\n          ? right.row.revenue - left.row.revenue\\n          : left.row.revenue - right.row.revenue,\\n      );\\n  }, [report, direction]);\\n\\n  const formatNumber = (value: number) =>\\n    new Intl.NumberFormat(localeCode === \\\"en-US\\\" ? \\\"en-US\\\" : \\\"zh-CN\\\", {\\n      maximumFractionDigits: 0,\\n    }).format(value);\\n\\n  if (!report) {\\n    return (\\n      <div className=\\\"sales-report sales-report--invalid\\\" role=\\\"status\\\">\\n        <p className=\\\"sales-report__invalid-text\\\">{text.invalid}</p>\\n      </div>\\n    );\\n  }\\n\\n  const selected = orderedRows.find((entry) => entry.key === selectedKey) ?? null;\\n  const sortLabel = direction === \\\"desc\\\" ? text.sortDescending : text.sortAscending;\\n  const selectRow = (key: string) => {\\n    setSelectedKey((current) => (current === key ? null : key));\\n  };\\n\\n  return (\\n    <section className=\\\"sales-report\\\" aria-label={report.title ?? text.fallbackTitle}>\\n      <h3 className=\\\"sales-report__title\\\">{report.title ?? text.fallbackTitle}</h3>\\n      <div className=\\\"sales-report__table-wrap\\\">\\n        <table className=\\\"sales-report__table\\\">\\n          <thead>\\n            <tr>\\n              <th scope=\\\"col\\\" className=\\\"sales-report__head-cell\\\">\\n                {text.month}\\n              </th>\\n              <th\\n                scope=\\\"col\\\"\\n                className=\\\"sales-report__head-cell sales-report__head-cell--revenue\\\"\\n                aria-sort={direction === \\\"desc\\\" ? \\\"descending\\\" : \\\"ascending\\\"}\\n              >\\n                <button\\n                  type=\\\"button\\\"\\n                  className=\\\"sales-report__sort\\\"\\n                  aria-label={`${text.revenue}：${sortLabel}`}\\n                  onClick={() =>\\n                    setDirection((current) => (current === \\\"desc\\\" ? \\\"asc\\\" : \\\"desc\\\"))\\n                  }\\n                >\\n                  <span>{text.revenue}</span>\\n                  <span aria-hidden=\\\"true\\\">{direction === \\\"desc\\\" ? \\\"↓\\\" : \\\"↑\\\"}</span>\\n                </button>\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            {orderedRows.length === 0 ? (\\n              <tr>\\n                <td className=\\\"sales-report__empty\\\" colSpan={2}>\\n                  {text.empty}\\n                </td>\\n              </tr>\\n            ) : (\\n              orderedRows.map((entry) => {\\n                const isSelected = entry.key === selectedKey;\\n                return (\\n                  <tr\\n                    key={entry.key}\\n                    className=\\\"sales-report__row\\\"\\n                    data-selected={isSelected ? \\\"true\\\" : \\\"false\\\"}\\n                    tabIndex={0}\\n                    aria-selected={isSelected}\\n                    onClick={() => selectRow(entry.key)}\\n                    onKeyDown={(event) => {\\n                      if (event.key === \\\"Enter\\\" || event.key === \\\" \\\") {\\n                        event.preventDefault();\\n                        selectRow(entry.key);\\n                      }\\n                    }}\\n                  >\\n                    <th scope=\\\"row\\\" className=\\\"sales-report__month\\\">\\n                      {entry.row.month}\\n                    </th>\\n                    <td className=\\\"sales-report__revenue\\\">{formatNumber(entry.row.revenue)}</td>\\n                  </tr>\\n                );\\n              })\\n            )}\\n          </tbody>\\n        </table>\\n      </div>\\n      <div\\n        className=\\\"sales-report__detail\\\"\\n        role=\\\"status\\\"\\n        aria-live=\\\"polite\\\"\\n        data-empty={selected ? \\\"false\\\" : \\\"true\\\"}\\n      >\\n        {selected\\n          ? text.detail(selected.row.month, formatNumber(selected.row.orderCount))\\n          : text.detailHint}\\n      </div>\\n    </section>\\n  );\\n}\\n\"},{\"relativePath\":\"definition.ts\",\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { SalesReportMessagePlugin } from \\\"./index\\\";\\nimport { SALES_REPORT_EVENT_NAME } from \\\"./schema\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      name: SALES_REPORT_EVENT_NAME,\\n      render: SalesReportMessagePlugin,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\"},{\"relativePath\":\"styles.css\",\"content\":\".sales-report {\\n  box-sizing: border-box;\\n  width: 100%;\\n  min-width: 0;\\n  padding: 12px;\\n  border: 1px solid var(--border);\\n  border-radius: 12px;\\n  background: var(--card);\\n  color: var(--foreground);\\n  font-size: 13px;\\n  line-height: 1.5;\\n}\\n\\n.sales-report__title {\\n  margin: 0 0 8px;\\n  font-size: 14px;\\n  font-weight: 600;\\n  overflow-wrap: anywhere;\\n}\\n\\n.sales-report__table-wrap {\\n  min-width: 0;\\n  overflow-x: auto;\\n}\\n\\n.sales-report__table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.sales-report__table th,\\n.sales-report__table td {\\n  padding: 6px 8px;\\n  text-align: left;\\n  white-space: nowrap;\\n  border-bottom: 1px solid var(--border);\\n}\\n\\n.sales-report__table tbody tr:last-child th,\\n.sales-report__table tbody tr:last-child td {\\n  border-bottom: none;\\n}\\n\\n.sales-report__head-cell {\\n  font-size: 12px;\\n  font-weight: 600;\\n  opacity: 0.75;\\n}\\n\\n.sales-report__head-cell--revenue {\\n  text-align: right;\\n}\\n\\n.sales-report__sort {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 4px;\\n  margin: 0;\\n  padding: 2px 4px;\\n  border: none;\\n  border-radius: 6px;\\n  background: transparent;\\n  color: inherit;\\n  font: inherit;\\n  font-size: 12px;\\n  font-weight: 600;\\n  cursor: pointer;\\n}\\n\\n.sales-report__sort:hover {\\n  background: var(--muted);\\n}\\n\\n.sales-report__sort:focus-visible {\\n  outline: 2px solid var(--ring, var(--border));\\n  outline-offset: 2px;\\n}\\n\\n.sales-report__row {\\n  cursor: pointer;\\n}\\n\\n.sales-report__row:hover {\\n  background: var(--muted);\\n}\\n\\n.sales-report__row:focus-visible {\\n  outline: 2px solid var(--ring, var(--border));\\n  outline-offset: -2px;\\n}\\n\\n.sales-report__row[data-selected=\\\"true\\\"] {\\n  background: var(--muted);\\n}\\n\\n.sales-report__month {\\n  font-weight: 500;\\n  text-align: left;\\n}\\n\\n.sales-report__row[data-selected=\\\"true\\\"] .sales-report__month {\\n  font-weight: 600;\\n}\\n\\n.sales-report__revenue {\\n  text-align: right;\\n}\\n\\n.sales-report__detail {\\n  margin-top: 8px;\\n  padding: 6px 8px;\\n  border-radius: 8px;\\n  background: var(--muted);\\n  font-size: 13px;\\n  overflow-wrap: anywhere;\\n}\\n\\n.sales-report__detail[data-empty=\\\"true\\\"] {\\n  padding-left: 0;\\n  background: transparent;\\n  font-size: 12px;\\n  opacity: 0.7;\\n}\\n\\n.sales-report__empty {\\n  padding: 8px;\\n  text-align: center;\\n  opacity: 0.7;\\n}\\n\\n.sales-report--invalid {\\n  border-style: dashed;\\n}\\n\\n.sales-report__invalid-text {\\n  margin: 0;\\n  font-size: 13px;\\n  overflow-wrap: anywhere;\\n}\\n\\n@media (max-width: 480px) {\\n  .sales-report {\\n    padding: 10px;\\n  }\\n\\n  .sales-report__table th,\\n  .sales-report__table td {\\n    padding: 6px;\\n  }\\n}\\n\"}]}"}

