rt\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onAbortCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlay\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayThrough\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onCanPlayThroughCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onDurationChange\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onDurationChangeCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEmptied\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEmptiedCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEncrypted\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEncryptedCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEnded\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onEndedCapture\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false},{\"name\":\"onLoadedData\",\"type\":\"ReactEventHandler<HTMLDetailsElement> | undefined\",\"typeTruncated\":false,\"runtimeManaged\":false}],\"interpretation\":\"Props describe supported seams, not a guarantee that all requested behavior is implemented. Nested type text may be abbreviated. Prefer application props/composition; if a required seam is absent, explain the gap before proposing implementation takeover. Do not trace Host Runtime to infer missing public APIs.\"}},\"selected\":true,\"instances\":[{\"id\":\"p4\",\"pluginId\":\"context-retrieval-message\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":4,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"auto_1cd2fa3d4e76208c\"}],\"manifest\":{\"id\":\"context-retrieval-message\",\"name\":\"Context Retrieval Message\",\"description\":\"Renders context retrieval results carried by AG-UI CUSTOM events.\",\"version\":\"0.0.1\",\"data\":{\"messageUI\":true},\"authoring\":{\"intents\":[\"render context retrieval results inside assistant messages\"]}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport implementation from \\\"@za38.03/agent-ui-plugins/context-retrieval-message\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { ContextRetrievalMessagePlugin } from \\\"./index\\\";\\nconst definition: UIPluginDefinition = { manifest: implementation.manifest, provides: [], inject: [], optionalInject: [], dataMessageUIs: [defineDataMessageUI<unknown>({ name: \\\"CONTEXT_CONTENT\\\", render: ContextRetrievalMessagePlugin })], Component: () => null };\\nexport default definition;\\n\",\"truncated\":false,\"characters\":563},\"services\":{\"provides\":[],\"required\":[],\"optional\":[]},\"files\":[{\"path\":\"src/agent-ui/plugins/context-retrieval-message/application.json\",\"kind\":\"file\",\"bytes\":68},{\"path\":\"src/agent-ui/plugins/context-retrieval-message/definition.ts\",\"kind\":\"file\",\"bytes\":563},{\"path\":\"src/agent-ui/plugins/context-retrieval-message/index.tsx\",\"kind\":\"file\",\"bytes\":301},{\"path\":\"src/agent-ui/plugins/context-retrieval-message/manifest.json\",\"kind\":\"file\",\"bytes\":338}],\"filesTruncated\":false}}","role":"tool"}

