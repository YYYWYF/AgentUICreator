"Displays configurable Agent name, logo and optional description in a normal Layout Slot.\\\",\\n44:       \\\"version\\\": \\\"0.0.1\\\",\\n45:       \\\"capabilities\\\": [\\n46:         \\\"agent-identity\\\"\\n47:       ],\\n48:       \\\"authoring\\\": {\\n49:         \\\"intents\\\": [\\n50:           \\\"rename Agent\\\",\\n51:           \\\"change Agent name\\\",\\n52:           \\\"change Agent logo\\\",\\n53:           \\\"change Agent brand information\\\",\\n54:           \\\"把我的 Agent 改名为智能研发助手\\\",\\n55:           \\\"把 Agent 的 Logo 换成公司的标志\\\"\\n56:         ],\\n57:         \\\"visualRole\\\": \\\"Agent identity in a normal Layout Slot; edit plugins/agent-identity/config.ts for branding\\\"\\n58:       }\\n59:     },\\n60:     provides: [],\\n61:     inject: [],\\n62:     optionalInject: [\\\"agent-ui.locale\\\"],\\n63:     loadDefinition: () =>\\n64:       import(\\\"./agent-identity/definition\\\").then(\\n65:         ({ default: definition }) => definition,\\n66:       ),\\n67:   },\\n68:   {\\n69:     manifest: {\\n70:       \\\"id\\\": \\\"composer\\\",\\n71:       \\\"name\\\": \\\"Conversation Composer\\\",\\n72:       \\\"description\\\": \\\"Renders the canonical Agent UI conversation composer with composable action Slots.\\\",\\n73:       \\\"version\\\": \\\"0.0.1\\\",\\n74:       \\\"capabilities\\\": [\\n75:         \\\"conversation-composer\\\"\\n76:       ],\\n77:       \\\"authoring\\\": {\\n78:         \\\"intents\\\": [\\n79:           \\\"show the primary conversation composer\\\",\\n80:           \\\"compose conversation input actions\\\"\\n81:         ],\\n82:         \\\"visualRole\\\": \\\"conversation composer\\\",\\n83:         \\\"defaultPlacement\\\": {\\n84:           \\\"type\\\": \\\"plugin_slot\\\",\\n85:           \\\"parentPluginId\\\": \\\"conversation-surface\\\",\\n86:           \\\"slot\\\": \\\"composer\\\"\\n87:         }\\n88:       },\\n89:       \\\"slots\\\": {\\n90:         \\\"children\\\": {\\n91:           \\\"triggers\\\": {\\n92:             \\\"description\\\": \\\"Optional conversation input triggers.\\\",\\n93:             \\\"cardinality\\\": \\\"many\\\",\\n94:             \\\"optional\\\": true,\\n95:             \\\"accepts\\\": {\\n96:               \\\"anyOfCapabilities\\\": [\\n97:                 \\\"conversation-composer-trigger\\\"\\n98:               ]\\n99:             }\\n100:           },\\n101:           \\\"beforeInput\\\": {\\n102:             \\\"description\\\": \\\"Content displayed between attachments and the composer input.\\\",\\n103:             \\\"cardinality\\\": \\\"many\\\",\\n104:             \\\"optional\\\": true,\\n105:             \\\"accepts\\\": {\\n106:               \\\"anyOfCapabilities\\\": [\\n107:                 \\\"conversation-composer-before-input\\\"\\n108:               ]\\n109:             }\\n110:           },\\n111:           \\\"leadingActions\\\": {\\n112:             \\\"description\\\": \\\"Inline actions displayed on the leading side of the composer.\\\",\\n113:             \\\"cardinality\\\": \\\"many\\\",\\n114:             \\\"optional\\\": true,\\n115:             \\\"accepts\\\": {\\n116:               \\\"anyOfCapabilities\\\": [\\n117:                 \\\"conversation-composer-leading-action\\\",\\n118:                 \\\"conversation-composer-trailing-action\\\"\\n119:               ]\\n120:             }\",\"hash\":\"c8e0f4822109c6fda15f4b26073301e0463b12990629755ec5b236b7bf949246\",\"totalLines\":1070,\"nextOffset\":120}}","role":"tool"}

