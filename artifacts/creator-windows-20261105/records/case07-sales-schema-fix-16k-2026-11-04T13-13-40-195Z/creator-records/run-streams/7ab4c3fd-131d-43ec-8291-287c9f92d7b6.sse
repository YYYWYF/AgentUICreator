data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_X3VqOIgNq3JbLWSCl2ec5082","messageId":"c2c7f65d-84c0-4747-a090-26683851114c","content":"{\"ok\":true,\"result\":[{\"path\":\"src/agent-ui/plugins/registry.generated.ts\",\"matches\":[{\"line\":116,\"text\":\"      id: 'context-retrieval-message',\"},{\"line\":127,\"text\":\"      import('./context-retrieval-message/definition').then(({ default: definition }) => definition),\"}]}]}","role":"tool"}

