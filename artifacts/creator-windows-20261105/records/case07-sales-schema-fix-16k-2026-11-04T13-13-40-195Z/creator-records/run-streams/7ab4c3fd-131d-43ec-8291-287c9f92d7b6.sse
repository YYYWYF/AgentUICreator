data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_Zdab9MMbBEQbE9WLhnPG9760","messageId":"df10684d-9a2d-4850-815b-46e44905cac5","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/sales-report-message/index.tsx\",\"content\":\"1: import { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import { useMemo, useState } from \\\"react\\\";\\n3: import { parseSalesReport } from \\\"./schema\\\";\\n4: import \\\"./styles.css\\\";\\n5: \\n6: type SalesReportMessageProps = {\\n7:   data?: unknown;\\n8: };\\n9: \\n10: type SalesReportLocaleText = {\\n11:   fallbackTitle: string;\\n12:   month: string;\\n13:   revenue: string;\\n14:   sortDescending: string;\\n15:   sortAscending: string;\\n16:   empty: string;\\n17:   invalid: string;\\n18:   detailHint: string;\\n19:   detail: (month: string, orderCount: string) => string;\\n20: };\\n21: \\n22: const messages: Record<string, SalesReportLocaleText> = {\\n23:   \\\"zh-CN\\\": {\\n24:     fallbackTitle: \\\"销售报表\\\",\\n25:     month: \\\"月份\\\",\\n26:     revenue: \\\"收入\\\",\\n27:     sortDescending: \\\"收入从高到低\\\",\\n28:     sortAscending: \\\"收入从低到高\\\",\\n29:     empty: \\\"报表中没有可显示的数据行。\\\",\\n30:     invalid: \\\"无法解析这条报表数据，暂时无法显示表格。\\\",\\n31:     detailHint: \\\"点击任意一行查看该月的订单数量。\\\",\\n32:     detail: (month, orderCount) => `${month} 的订单数量：${orderCount}`,\\n33:   },\\n34:   \\\"en-US\\\": {\\n35:     fallbackTitle: \\\"Sales report\\\",\\n36:     month: \\\"Month\\\",\\n37:     revenue: \\\"Revenue\\\",\\n38:     sortDescending: \\\"Revenue high to low\\\",\\n39:     sortAscending: \\\"Revenue low to high\\\",\\n40:     empty: \\\"The report has no rows to display.\\\",\\n41:     invalid: \\\"This report data could not be parsed, so the table cannot be shown.\\\",\\n42:     detailHint: \\\"Select a row to see that month's order count.\\\",\\n43:     detail: (month, orderCount) => `${month} order count: ${orderCount}`,\\n44:   },\\n45: };\\n46: \\n47: type SortDirection = \\\"desc\\\" | \\\"asc\\\";\\n48: \\n49: export function SalesReportMessagePlugin(props: SalesReportMessageProps) {\\n50:   const localeCode = useAgentUILocaleCode();\\n51:   const text = messages[localeCode] ?? messages[\\\"zh-CN\\\"]!;\\n52:   const report = useMemo(() => parseSalesReport(props.data), [props.data]);\\n53:   const [direction, setDirection] = useState<SortDirection>(\\\"desc\\\");\\n54:   const [selectedKey, setSelectedKey] = useState<string | null>(null);\\n55: \\n56:   const orderedRows = useMemo(() => {\\n57:     if (!report) {\\n58:       return [];\\n59:     }\\n60:     return report.rows\\n61:       .map((row, index) => ({ key: `${row.month}#${index}`, row }))\\n62:       .sort((left, right) =>\\n63:         direction === \\\"desc\\\"\\n64:           ? right.row.revenue - left.row.revenue\\n65:           : left.row.revenue - right.row.revenue,\\n66:       );\\n67:   }, [report, direction]);\\n68: \\n69:   const formatNumber = (value: number) =>\\n70:     new Intl.NumberFormat(localeCode === \\\"en-US\\\" ? \\\"en-US\\\" : \\\"zh-CN\\\", {\\n71:       maximumFractionDigits: 0,\\n72:     }).format(value);\\n73: \\n74:   if (!report) {\\n75:     return (\\n76:       <div className=\\\"sales-report sales-report--invalid\\\" role=\\\"status\\\">\\n77:         <p className=\\\"sales-report__invalid-text\\\">{text.invalid}</p>\\n78:       </div>\\n79:     );\\n80:   }\\n81: \\n82:   const selected = orderedRows.find((entry) => entry.key === selectedKey) ?? null;\\n83:   const sortLabel = direction === \\\"desc\\\" ? text.sortDescending : text.sortAscending;\\n84:   const selectRow = (key: string) => {\\n85:     setSelectedKey((current) => (current === key ? null : key));\\n86:   };\\n87: \\n88:   return (\\n89:     <section className=\\\"sales-report\\\" aria-label={report.title ?? text.fallbackTitle}>\\n90:       <h3 className=\\\"sales-report__title\\\">{report.title ?? text.fallbackTitle}</h3>\\n91:       <div className=\\\"sales-report__table-wrap\\\">\\n92:         <table className=\\\"sales-report__table\\\">\\n93:           <thead>\\n94:             <tr>\\n95:               <th scope=\\\"col\\\" className=\\\"sales-report__head-cell\\\">\\n96:                 {text.month}\\n97:               </th>\\n98:               <th\\n99:                 scope=\\\"col\\\"\\n100:                 className=\\\"sales-report__head-cell sales-report__head-cell--revenue\\\"\\n101:                 aria-sort={direction === \\\"desc\\\" ? \\\"descending\\\" : \\\"ascending\\\"}\\n102:               >\\n103:                 <button\\n104:                   type=\\\"button\\\"\\n105:                   className=\\\"sales-report__sort\\\"\\n106:                   aria-label={`${text.revenue}：${sortLabel}`}\\n107:                   onClick={() =>\\n108:                     setDirection((current) => (current === \\\"desc\\\" ? \\\"asc\\\" : \\\"desc\\\"))\\n109:                   }\\n110:                 >\\n111:                   <span>{text.revenue}</span>\\n112:                   <span aria-hidden=\\\"true\\\">{direction === \\\"desc\\\" ? \\\"↓\\\" : \\\"↑\\\"}</span>\\n113:                 </button>\\n114:               </th>\\n115:             </tr>\\n116:           </thead>\\n117:           <tbody>\\n118:             {orderedRows.length === 0 ? (\\n119:               <tr>\\n120:                 <td className=\\\"sales-report__empty\\\" colSpan={2}>\\n121:                   {text.empty}\\n122:                 </td>\\n123:               </tr>\\n124:             ) : (\\n125:               orderedRows.map((entry) => {\\n126:                 const isSelected = entry.key === selectedKey;\\n127:                 return (\\n128:                   <tr\\n129:                     key={entry.key}\\n130:                     className=\\\"sales-report__row\\\"\\n131:                     data-selected={isSelected ? \\\"true\\\" : \\\"false\\\"}\\n132:                     tabIndex={0}\\n133:                     aria-selected={isSelected}\\n134:                     onClick={() => selectRow(entry.key)}\\n135:                     onKeyDown={(event) => {\\n136:                       if (event.key === \\\"Enter\\\" || event.key === \\\" \\\") {\\n137:                         event.preventDefault();\\n138:                         selectRow(entry.key);\\n139:                       }\\n140:                     }}\\n141:                   >\\n142:                     <th scope=\\\"row\\\" className=\\\"sales-report__month\\\">\\n143:                       {entry.row.month}\\n144:                     </th>\\n145:                     <td className=\\\"sales-report__revenue\\\">{formatNumber(entry.row.revenue)}</td>\\n146:                   </tr>\\n147:                 );\\n148:               })\\n149:             )}\\n150:           </tbody>\\n151:         </table>\\n152:       </div>\\n153:       <div\\n154:         className=\\\"sales-report__detail\\\"\\n155:         role=\\\"status\\\"\\n156:         aria-live=\\\"polite\\\"\\n157:         data-empty={selected ? \\\"false\\\" : \\\"true\\\"}\\n158:       >\\n159:         {selected\\n160:           ? text.detail(selected.row.month, formatNumber(selected.row.orderCount))\\n161:           : text.detailHint}\\n162:       </div>\\n163:     </section>\\n164:   );\\n165: }\\n166: \",\"hash\":\"f9335a0f5258232620122846227fc89d6f5e325cd786f5d5e57bfe9f28d0ded7\",\"totalLines\":166,\"nextOffset\":null}}","role":"tool"}

