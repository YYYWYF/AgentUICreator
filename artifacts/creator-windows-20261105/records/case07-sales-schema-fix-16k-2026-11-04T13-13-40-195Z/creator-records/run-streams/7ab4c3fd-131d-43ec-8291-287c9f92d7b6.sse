data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_z7KLu8URcekni1qASkBp4011","messageId":"7f883b0c-b0f4-435f-af12-1aca3768b3d4","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"59c94751aad6e7f3db824614fc9732efc2bf1036a2c36b0885cc14a735d60a76\",\"query\":\"registry generated plugin capability catalog\",\"total\":113,\"offset\":0,\"entries\":[{\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"title\":\"Creator 开发控制面实现\",\"source\":\"internal\",\"topic\":\"更新与开发工具\",\"path\":\"references/docs/creator-control-plane-implementation-plan.md\",\"summary\":\"Creator 工具控制面、命令、Host guards、上下文及 Mock 管理。\",\"sha256\":\"a55d71bc0dd2f6b4e8fa93b849f6abb6244a8d2d7c8528f16b3857638764526b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\"}},\"matchingSections\":[{\"sectionId\":\"s71\",\"title\":\"5. AppUIModel 组合事务\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s7\",\"title\":\"1. 代码与发行职责\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s7\"}}},{\"sectionId\":\"s37\",\"title\":\"3. 检查与渐进上下文\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-control-plane-implementation-plan\",\"sectionId\":\"s37\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"统一 Plugins 包、内置源码目录与按需源码托管\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/architecture/npm-default-plugin-source-ownership.md\",\"summary\":\"npm 默认交付、项目薄应用层、源码接管授权、BASE/LOCAL/TARGET 与更新保护。\",\"sha256\":\"cbc8052587ee42d67d634c94f1fd9dac8ace5603ec4d4e92bf10e191af808eb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s49\",\"title\":\"4. Canonical 实现、元数据与构建\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s49\"}}},{\"sectionId\":\"s1\",\"title\":\"统一 Plugins 包、内置源码目录与按需源码托管\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s29\",\"title\":\"2. 项目外壳\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s29\"}}}]},{\"documentId\":\"public:development/create-plugin\",\"title\":\"创建自定义插件\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/create-plugin.md\",\"summary\":\"已有插件的属性和组合无法满足需求时，可以在项目中编写新的 React 插件。先到插件检查可复用能力；只需让 Creator 帮你新增功能时，见增加新的界面功能。 以下路径相对于生成目录，默认为 src/agent-ui/。 开发时可以直接复用会话操作、状态 Hook、服务、事件、子插槽和消息展示接口。先查公共能力速查，各项提供使用前提和代码示例；插件组件和业务页面的接口入口也在其中区分。\",\"sha256\":\"e1ab2ce129fe251b39a7fa05e9fe0af74f01eeb50f4b8ef372781cc5f928fbbf\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\"}},\"matchingSections\":[{\"sectionId\":\"s62\",\"title\":\"4. 更新注册并检查\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s62\"}}},{\"sectionId\":\"s25\",\"title\":\"2. 编写组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s25\"}}},{\"sectionId\":\"s52\",\"title\":\"3. 放入布局或已有子插槽\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/create-plugin\",\"sectionId\":\"s52\"}}}]},{\"documentId\":\"internal:architecture/transactional-preview-composition\",\"title\":\"Transactional Preview Composition\",\"source\":\"internal\",\"topic\":\"更新与开发工具\",\"path\":\"references/docs/architecture/transactional-preview-composition.md\",\"summary\":\"预览组合的事务、revision、校验与恢复。\",\"sha256\":\"e0a374e737f76df6bc365eb7b2f64f2e21204fb58354e376385a3e63b47fe006\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/transactional-preview-composition\"}},\"matchingSections\":[{\"sectionId\":\"s19\",\"title\":\"Capability and active-runtime boundaries\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/transactional-preview-composition\",\"sectionId\":\"s19\"}}},{\"sectionId\":\"s36\",\"title\":\"Candidate and published state\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/transactional-preview-composition\",\"sectionId\":\"s36\"}}},{\"sectionId\":\"s60\",\"title\":\"Runtime failure isolation\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/transactional-preview-composition\",\"sectionId\":\"s60\"}}}]},{\"documentId\":\"public:development/project-structure\",\"title\":\"工程结构与修改入口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/project-structure.md\",\"summary\":\"初始化后，Agent UI 源码默认放在 src/agent-ui/。以下路径都相对于这个目录；初始化时选择了其他目录，就在实际目录中找同名文件。 不同版本或历史工程的目录可能不同，先检查已有组件的导入和导出。官方插件通常由项目入口导入 npm 实现；已经接管的插件则引用本地实现。 新工程只生成布局中选用的插件入口，以及读取服务、传入数据和显示子插件所需的代码，添加插件时再生成对应入口。已经存在的项目入口会保留。 服务相关 Hook 统一放在 services/hooks/ 下：useConversations.ts、useConversationActions.ts 和按需生成的 useAu\",\"sha256\":\"d12f5d52751a6ac2fdd49c8a308ac1b080e59b0cf6076e91bbf7ffaa729b73db\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\"}},\"matchingSections\":[{\"sectionId\":\"s25\",\"title\":\"根据修改目标选择入口\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\",\"sectionId\":\"s25\"}}},{\"sectionId\":\"s1\",\"title\":\"工程结构与修改入口\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:start/index\",\"title\":\"开始使用\",\"source\":\"public\",\"topic\":\"开始使用\",\"path\":\"start/index.md\",\"summary\":\"为你的产品加入 AI 助理，用自然语言调整界面。从现有 React 工程出发，完成接入、首次对话和第一次定制。\",\"sha256\":\"11355dee8e8f6d796be9f50499c23a9ba7a038530da015a286f66070a752a125\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\"}},\"matchingSections\":[{\"sectionId\":\"s163\",\"title\":\"生成了哪些文件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:start/index\",\"sectionId\":\"s163\"}}}]},{\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"title\":\"Frontend Tool lifecycle\",\"source\":\"internal\",\"topic\":\"会话与交互\",\"path\":\"references/docs/architecture/frontend-tool-lifecycle.md\",\"summary\":\"Frontend Tool 注册、执行、审批、中断恢复、取消与历史副作用隔离。\",\"sha256\":\"a85582fdaf1e1290ec823ca5c9f7e61609ef3c3b2a5e6c181058d63d24d1367b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Frontend Tool lifecycle\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s67\",\"title\":\"Availability and cancellation\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"sectionId\":\"s67\"}}},{\"sectionId\":\"s27\",\"title\":\"Owners and integration\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/frontend-tool-lifecycle\",\"sectionId\":\"s27\"}}}]},{\"documentId\":\"internal:creator-plugin-development-decision-contract\",\"title\":\"Creator UI Plugin 编辑与开发确认\",\"source\":\"internal\",\"topic\":\"插件开发与组合\",\"path\":\"references/docs/creator-plugin-development-decision-contract.md\",\"summary\":\"复用与新开发决策、真实用户授权、方案范围、UI 库选择和依赖安装。\",\"sha256\":\"7b6b242b0f6c631ddde2217e78e53b351cd29ed9f31b3efc31adb6dc01e8c8e0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-development-decision-contract\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"Creator UI Plugin 编辑与开发确认\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:creator-plugin-development-decision-contract\",\"sectionId\":\"s1\"}}}]}],\"nextOffset\":8}}","role":"tool"}

