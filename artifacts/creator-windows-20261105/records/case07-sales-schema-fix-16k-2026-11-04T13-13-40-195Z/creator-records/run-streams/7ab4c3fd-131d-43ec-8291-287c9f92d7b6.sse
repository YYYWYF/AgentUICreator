data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_Kr7VfceafX6yMSkqGVZU9595","messageId":"94446c24-e84c-421d-854d-783ea9c9c5d9","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/sales-report-message/schema.ts\",\"content\":\"1: import { z } from \\\"zod\\\";\\n2: \\n3: /** Name of the Agent `CUSTOM` event that carries the report envelope. */\\n4: export const SALES_REPORT_EVENT_NAME = \\\"app.sales.report\\\";\\n5: \\n6: /**\\n7:  * The Agent sends `{ format: \\\"json\\\", payload: \\\"<json string>\\\" }` as the event\\n8:  * value. The runtime uses this schema only to recognize the event name as an app\\n9:  * event; the renderer performs the strict decoding itself so an unexpected but\\n10:  * real payload still reaches the message instead of being dropped silently.\\n11:  */\\n12: export const salesReportEventSchema = z.unknown();\\n13: \\n14: export type SalesReportRow = {\\n15:   month: string;\\n16:   revenue: number;\\n17:   orderCount: number;\\n18: };\\n19: \\n20: export type SalesReportData = {\\n21:   title?: string;\\n22:   rows: SalesReportRow[];\\n23: };\\n24: \\n25: function parseJsonText(value: string): unknown {\\n26:   const text = value.trim();\\n27:   if (text === \\\"\\\") {\\n28:     return undefined;\\n29:   }\\n30:   try {\\n31:     return JSON.parse(text) as unknown;\\n32:   } catch {\\n33:     return undefined;\\n34:   }\\n35: }\\n36: \\n37: function isRecord(value: unknown): value is Record<string, unknown> {\\n38:   return typeof value === \\\"object\\\" && value !== null && !Array.isArray(value);\\n39: }\\n40: \\n41: function toFiniteNumber(value: unknown): number | null {\\n42:   if (typeof value === \\\"number\\\") {\\n43:     return Number.isFinite(value) ? value : null;\\n44:   }\\n45:   if (typeof value === \\\"string\\\" && value.trim() !== \\\"\\\") {\\n46:     const parsed = Number(value);\\n47:     return Number.isFinite(parsed) ? parsed : null;\\n48:   }\\n49:   return null;\\n50: }\\n51: \\n52: /**\\n53:  * Unwraps the shapes the report can arrive in: the `{format, payload}` envelope,\\n54:  * an already decoded `{title, rows}` object, or the raw JSON text.\\n55:  */\\n56: function unwrapReportSource(input: unknown, depth = 0): unknown {\\n57:   if (depth > 4) {\\n58:     return undefined;\\n59:   }\\n60:   if (typeof input === \\\"string\\\") {\\n61:     return parseJsonText(input);\\n62:   }\\n63:   if (!isRecord(input)) {\\n64:     return undefined;\\n65:   }\\n66:   if (\\\"payload\\\" in input) {\\n67:     const payload = input.payload;\\n68:     if (typeof payload === \\\"string\\\") {\\n69:       return parseJsonText(payload);\\n70:     }\\n71:     if (isRecord(payload) || Array.isArray(payload)) {\\n72:       return payload;\\n73:     }\\n74:     return undefined;\\n75:   }\\n76:   if (\\\"rows\\\" in input) {\\n77:     return input;\\n78:   }\\n79:   if (\\\"value\\\" in input) {\\n80:     return unwrapReportSource(input.value, depth + 1);\\n81:   }\\n82:   if (\\\"data\\\" in input) {\\n83:     return unwrapReportSource(input.data, depth + 1);\\n84:   }\\n85:   return undefined;\\n86: }\\n87: \\n88: function normalizeRow(input: unknown): SalesReportRow | null {\\n89:   if (!isRecord(input)) {\\n90:     return null;\\n91:   }\\n92:   const month = typeof input.month === \\\"string\\\" ? input.month.trim() : \\\"\\\";\\n93:   if (month === \\\"\\\") {\\n94:     return null;\\n95:   }\\n96:   const revenue = toFiniteNumber(input.revenue);\\n97:   const orderCount = toFiniteNumber(input.order_count ?? input.orderCount);\\n98:   if (revenue === null || orderCount === null) {\\n99:     return null;\\n100:   }\\n101:   return { month, revenue, orderCount };\\n102: }\\n103: \\n104: /** Returns the decoded report, or `null` when the payload is not a usable report. */\\n105: export function parseSalesReport(input: unknown): SalesReportData | null {\\n106:   const candidate = unwrapReportSource(input);\\n107:   if (!isRecord(candidate) || !Array.isArray(candidate.rows)) {\\n108:     return null;\\n109:   }\\n110: \\n111:   const rows: SalesReportRow[] = [];\\n112:   for (const item of candidate.rows) {\\n113:     const row = normalizeRow(item);\\n114:     if (row) {\\n115:       rows.push(row);\\n116:     }\\n117:   }\\n118:   if (rows.length === 0 && candidate.rows.length > 0) {\\n119:     return null;\\n120:   }\\n121: \\n122:   const title = typeof candidate.title === \\\"string\\\" ? candidate.title.trim() : \\\"\\\";\\n123:   return { title: title === \\\"\\\" ? undefined : title, rows };\\n124: }\\n125: \",\"hash\":\"bb4a45022e115a95ab43a7adecad732c084f1328903c2ce5aadf927e7cc1f45f\",\"totalLines\":125,\"nextOffset\":null}}","role":"tool"}

