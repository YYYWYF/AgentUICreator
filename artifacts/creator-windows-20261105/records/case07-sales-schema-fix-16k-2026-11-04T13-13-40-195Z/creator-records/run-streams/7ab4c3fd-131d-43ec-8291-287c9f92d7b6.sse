py-action\",\"export-markdown-action\",\"help-dismiss-action\",\"locale-provider\",\"quick-help-card\",\"quick-help-content\",\"reasoning\",\"reload-action\",\"response-footer\",\"sales-report-message\",\"submit-action\",\"test-notice\",\"theme-provider\",\"theme-switch\",\"tool-group\",\"tool-result\",\"transient-assistant-messages\"],\"resolvedPluginIds\":[\"add-attachment-action\",\"agent-identity\",\"composer\",\"context-retrieval-message\",\"conversation-data-source\",\"conversation-new\",\"conversation-quote\",\"conversation-service\",\"conversation-suggestions\",\"conversation-surface\",\"conversation-thread-list\",\"copy-action\",\"export-markdown-action\",\"help-dismiss-action\",\"locale-provider\",\"quick-help-card\",\"quick-help-content\",\"reasoning\",\"reload-action\",\"response-footer\",\"sales-report-message\",\"submit-action\",\"test-notice\",\"theme-provider\",\"theme-switch\",\"tool-group\",\"tool-result\",\"transient-assistant-messages\"],\"headlessPluginIds\":[\"conversation-data-source\",\"conversation-service\",\"locale-provider\",\"theme-provider\"]},\"warnings\":[],\"snapshotToken\":{\"appUIModelHash\":\"d66aa08238c6290005ef4ca1ab11c4e213c9224bfa9453d991ec02f9a2fa30fc\",\"capabilityCatalogSourceHash\":\"aaff79e523f2847cfdc5038fc479fee468fcab4f2fcbd60735d88f7c3cf9935d\",\"capabilityCatalogRevision\":\"6d2cc162cf8b502fbb59ae3af56531c4d5bfbf41253dd19d0627add0f85aaa11\"},\"compositionRevision\":{\"transactionId\":\"1a4f854c-cdae-44ab-ae8d-28fa464118b5\",\"appUIModelHash\":\"d66aa08238c6290005ef4ca1ab11c4e213c9224bfa9453d991ec02f9a2fa30fc\",\"capabilityCatalogRevision\":\"6d2cc162cf8b502fbb59ae3af56531c4d5bfbf41253dd19d0627add0f85aaa11\"}}}","role":"tool"}

