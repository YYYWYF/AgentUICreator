data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-92b722e105c4dd6e","delta":"{\"file_path\":\"/skills/ag-ui-frontend/SKILL.md\",\"limit\":400,\"offset\":0}"}

