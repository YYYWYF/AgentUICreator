\"export-markdown-action\",\"name\":\"Conversation Export Markdown Action\",\"description\":\"Renders More with a Markdown export item for the complete assistant response.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p22\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p19\",\"slot\":\"actions\"},\"index\":2}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"export an assistant response as Markdown\"],\"visualRole\":\"assistant response Markdown export action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"feedback-actions\",\"name\":\"Conversation Feedback Actions\",\"description\":\"Submits helpful or not helpful feedback for the response tail.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"rate assistant response\"],\"visualRole\":\"assistant response feedback actions\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"response-footer\",\"slot\":\"actions\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"generated-file-message\",\"name\":\"Generated File\",\"description\":\"Renders successful generate_file backend results with the official File element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render generated file tool results in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"help-dismiss-action\",\"name\":\"Help Dismiss Action\",\"description\":\"Header action for the quick help card that dismisses the help body; the card title expands it again.\",\"capabilities\":[\"help-dismiss-action\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p9\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"headerActions\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"dismiss the quick help card body\",\"添加“知道了”按钮收起帮助内容\",\"collapse help content from the card header\"],\"visualRole\":\"quick help card header action button\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"headerActions\"},\"recommendedSize\":{\"height\":\"28px\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"job-progress-message\",\"name\":\"Job Progress\",\"description\":\"Renders run_ci_job tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"render job progress in assistant messages\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-composer-input\",\"name\":\"Conversation Lexical Composer Input\",\"description\":\"Optional plain text input with atomic directive chips.\",\"capabilities\":[\"conversation-composer-input\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show atomic mention and command chips in the composer\"],\"visualRole\":\"conversation input\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"input\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-edit-composer\",\"name\":\"Conversation Lexical Edit Composer\",\"description\":\"Rich editing of existing directives in historical user messages.\",\"capabilities\":[\"conversation-user-edit-composer-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show atomic directive chips when editing historical messages\"],\"visualRole\":\"historical message edit composer\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"userEditComposer\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/locale-provider\",\"component\":\"LocaleProviderPlugin\",\"facts\":{\"presentation\":\"Generated Agent applications and createAgentUILocaleService() default to zh-CN. Standalone presentation components without the generated Runtime bridge default to en-US. The supported locale codes are zh-CN and en-US; do not search protected implementation source to infer the generated default.\",\"composition\":\"Keep the existing locale-provider service and Runtime locale bridge. Agent locale is controlled, defaultLocale initializes an uncontrolled instance, onLocaleChange observes selection, and locales supplies per-locale partial message overrides. For example, locales['zh-CN'].composer.placeholder customizes the existing Chinese input hint. Supply the English counterpart. Merge project defaults and Host overrides at both locale and domain-field levels: spreading locales only at the top level replaces entire locale dictionaries, losing project defaults when the Host overrides an unrelated domain. Host values win for the exact fields they supply. LocaleProviderPlugin itself only renders children, with no locale/message props.\",\"interaction\":\"The public useAgentUILocale(namespace) reads existing shared domain messages; useAgentUILocaleCode() reads the same current code. For custom project business messages use a small en-US/zh-CN project dictionary keyed by that unified code, without another language state or Context. AgentUILocaleMessages and Overrides describe the package's existing namespaces; unrelated new business keys do not require extending those closed npm types.\"}},\"name\":\"Headless Locale Service Provider\",\"description\":\"Provides the shared application locale service to UI plugins.\",\"capabilities\":[\"headless\",\"locale\",\"plugin-service-provider\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p3\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":3}],\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-switch\",\"name\":\"Locale Switch\",\"description\":\"Selects the application language through the shared locale service.\",\"capabilities\":[\"locale-control\",\"plugin-service-consumer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"let the user switch between Chinese and English\"],\"visualRole\":\"language control\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"headerActions\"}},\"requiredServices\":{\"names\":[\"agent-ui.locale\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"mention-trigger\",\"name\":\"Conversation Mention Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"mention a person or resource\",\"add mention search to the composer\",\"添加提及功能\",\"输入 @ 搜索对象\"],\"visualRole\":\"conversation input trigger\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"triggers\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.mention-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"capabilities\":[\"quick-help-card\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p24\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l10\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a quick help card at the chat top\",\"显示使用帮助卡片\",\"在聊天区域顶部显示帮助卡片\",\"expand or collapse usage help\"],\"visualRole\":\"chat area collapsible help card\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"44px\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"help-dismiss-action\"]}}}},{\"pluginId\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"capabilities\":[\"quick-help-content\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p25\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"body\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show quick help body text\",\"显示帮助正文\",\"在帮助卡片正文显示提示\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"reasoning\",\"name\":\"Conversation Reasoning Renderer\",\"description\":\"Displays detailed Agent UI reasoning in a collapsible group. Disable this semantic contribution for status-only presentation; collapsing still permits viewing details.\",\"capabilities\":[\"conversation-reasoning-renderer\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p16\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p10\",\"slot\":\"reasoningGroup\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show the reasoning process\",\"restore reasoning presentation\",\"show deep thinking\"],\"visualRole\":\"assistant reasoning presentation\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"reasoningGroup\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"reload-action\",\"name\":\"Conversation Re