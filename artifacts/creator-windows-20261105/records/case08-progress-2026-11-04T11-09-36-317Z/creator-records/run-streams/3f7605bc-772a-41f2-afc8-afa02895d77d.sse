data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-87b306448e3e2cf9","delta":"{\"file_path\":\"/src/agent-ui/application/project-config.tsx\",\"limit\":200,\"offset\":0}"}

