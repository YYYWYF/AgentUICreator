data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-80a0755e243d171c","messageId":"c05c6c2f-4d1d-4952-9de7-d9c290976249","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/test-notice/definition.ts\",\"content\":\"1: import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: import manifestJson from \\\"./manifest.json\\\";\\n3: import { TestNoticePlugin } from \\\"./index\\\";\\n4: \\n5: const definition: UIPluginDefinition = {\\n6:   manifest: manifestJson as UIPluginManifest,\\n7:   provides: [],\\n8:   inject: [],\\n9:   optionalInject: [\\\"agent-ui.locale\\\"],\\n10:   Component: TestNoticePlugin,\\n11: };\\n12: \\n13: export default definition;\\n14: \",\"hash\":\"bba53cc3ebca46f9183dfca07295b5b29e48346c82e0dbcebc1d97585759e5ff\",\"totalLines\":14,\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"chatcmpl-tool-a62c992fc87562fd","toolCallName":"prepare_ui_plugin_development"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-a62c992fc87562fd","delta":"{\"targetPluginId\":\"job-progress-panel\",\"desiredOutcome\":\"在聊天区域右侧新增“任务进度”面板：消费 Agent 通过 AG-UI CUSTOM 事件 app.job.progress 返回的进度数据（job_id/title/status/completed/total/error），同一 job_id 更新同一条进度，多个任务分行显示；running 显示进度条与完成数，completed 显示完成状态，failed 时错误原因可展开。现有 job-progress-message（npm 官方包，只渲染 run_ci_job 工具调用）不满足该需求，因此新增项目自有 Plugin。\",\"workKind\":\"create-plugin\",\"deliveryContract\":{\"capability\":\"右侧任务进度面板，按 job_id 归并 app.job.progress 事件并展示状态、进度与可展开错误详情\",\"renderingCategory\":\"panel\",\"placement\":\"AppUIModel 中聊天区域右侧（根 row 的第三列，位于 conversation-surface 所在中间列右侧），随聊天区域等高，可滚动\",\"lifecycle\":\"React 组件通过 usePluginEvents() 订阅 app.job.progress；组件内存中按 job_id 维护列表（Map），不持久化、不重放历史\",\"dependencies\":[\"Agent 属性 appEventSchemas 中声明 'app.job.progress' 的 payload schema\",\"插件 manifest 的 data.events 声明 \\\"app.job.progress\\\"\",\"复用现有 Agent UI 主题 token 与统一 locale 文案\"],\"verificationMethod\":\"runtime\"}}"}

data: {"type":"TOOL_CALL_END","toolCallId":"chatcmpl-tool-a62c992fc87562fd"}

data: {"type":"CUSTOM","name":"on_interrupt","value":{"id":"c859abdcb68ddfeaea051c572fff5559","reason":"human_input","metadata":{"kind":"ask_user_question","steps":[{"id":"plugin-development-decision","question":"是否按此方案开发？","description":"目标: 在聊天区域右侧新增“任务进度”面板：消费 Agent 通过 AG-UI CUSTOM 事件 app.job.progress 返回的进度数据（job_id/title/status/completed/total/error），同一 job_id 更新同一条进度，多个任务分行显示；running 显示进度条与完成数，completed 显示完成状态，failed 时错误原因可展开。现有 job-progress-message（npm 官方包，只渲染 run_ci_job 工具调用）不满足该需求，因此新增项目自有 Plugin。\n\n目标插件与位置: job-progress-panel\n\nAppUIModel 中聊天区域右侧（根 row 的第三列，位于 conversation-surface 所在中间列右侧），随聊天区域等高，可滚动","options":[{"id":"start","label":"开始开发"},{"id":"adjust","label":"调整需求"},{"id":"defer","label":"暂不处理"}],"selectionMode":"single","minSelections":1,"maxSelections":1}]}}}

