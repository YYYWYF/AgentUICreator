rentInstances\":[{\"instanceId\":\"p14\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p12\",\"slot\":\"submitAction\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"add the conversation composer send and stop action\"],\"visualRole\":\"conversation composer submit action\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"composer\",\"slot\":\"submitAction\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"task-group\",\"name\":\"Task Group\",\"description\":\"Renders nested agent work as expandable task cards.\",\"capabilities\":[\"conversation-task-group-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show agent tasks\",\"show nested agent work\",\"show delegated agent tasks\",\"group nested tool tasks\"],\"visualRole\":\"conversation task group\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"taskGroup\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"test-notice\",\"name\":\"Test Notice\",\"description\":\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\",\"capabilities\":[\"test-notice\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p23\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l8\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a test notice at the chat top\",\"显示测试提示\",\"在聊天区域顶部显示提示\"],\"visualRole\":\"chat area top notice\",\"defaultPlacement\":{\"type\":\"relative\",\"relation\":\"above\",\"anchorPluginId\":\"conversation-surface\"},\"recommendedSize\":{\"height\":\"40px\"}},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"theme-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/theme-provider\",\"component\":\"ThemeProviderPlugin\",\"facts\":{\"presentation\":\"The built-in theme keys are light, dark and violet; the default is violet. A custom brand color such as blue is a project CSS palette customization, not a new theme enum value. ThemeProviderPlugin renders its children and does not accept palette/color props.\",\"composition\":\"Keep the existing theme service and AgentUIRoot. Agent theme props or createAgentUIThemeService(initialTheme) select a built-in preset; AppUIModel does not configure component props. Do not add another theme Runtime or edit npm implementation files.\",\"styles\":\"Import @za38.03/agent-ui-plugins/styles.css before project overrides. Scoped palette selectors are :is(.agent-ui-root, .agent-ui-conversation)[data-theme=\\\"violet\\\"] for the default preset. Override --agent-brand and --agent-brand-solid for the brand and solid actions; --primary, --ring, --sidebar-primary and --sidebar-ring are semantic control/sidebar colors. Violet derives --primary and sidebar/focus colors from --agent-brand-solid; neutral light/dark derive --agent-brand from --primary, so override both when customizing those presets. Other public tokens include --background, --foreground, --card, --muted, --border, --input, --primary-foreground, --sidebar and --sidebar-foreground. Keep surfaces/readability coherent and verify rendered colors and theme switching. These names describe this installed package; project CSS overrides need no source takeover.\"}},\"name\":\"Headless Theme Service Provider\",\"description\":\"Provides the shared Agent UI theme preset service to other UI plugins.\",\"capabilities\":[\"headless\",\"plugin-service-provider\",\"theme\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p2\",\"enabled\":true,\"target\":{\"type\":\"application\"},\"index\":2}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"provide shared light, dark, and violet theme preset state\"]},\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"theme-switch\",\"name\":\"Theme Switch\",\"description\":\"Calls the shared theme service exposed by another UI plugin.\",\"capabilities\":[\"plugin-service-consumer\",\"theme-control\"],\"selected\":true,\"currentInstances\":[{\"instanceId\":\"p5\",\"enabled\":true,\"target\":{\"type\":\"layout_slot\",\"slotRef\":\"l3\"},\"index\":0}],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"let the user select light, dark, or violet theme presets\"],\"visualRole\":\"theme control\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"conversation-surface\",\"slot\":\"headerActions\"}},\"requiredServices\":{\"names\":[\"agent-ui.theme\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"thinking-indicator\",\"name\":\"Conversation Thinking Indicator\",\"description\":\"Message-scoped live status placeholder. Yields to visible reasoning or tool activity; does not disable the separate reasoning renderer.\",\"capabilities\":[\"conversation-thinking-indicator-renderer\"],\"selected\":false,\"currentInstances\":[],\"selectionOwner\":\"composition\",\"authoring\":{\"intents\":[\"show a thinking status placeholder\",\"show a placeholder before reasoning details arrive\",\"显示正在思考状态提示\",\"详细推理到达前显示占位提示\"],\"visualRole\":\"assistant status placeholder; does not control reasoning detail visibility\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPlugi