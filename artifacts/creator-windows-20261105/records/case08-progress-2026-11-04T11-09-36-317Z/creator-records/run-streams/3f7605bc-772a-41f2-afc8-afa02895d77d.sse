data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-878c41d0481f2ffd","delta":"{\"file_path\":\"/src/agent-ui/application/Agent.tsx\",\"limit\":300,\"offset\":0}"}

