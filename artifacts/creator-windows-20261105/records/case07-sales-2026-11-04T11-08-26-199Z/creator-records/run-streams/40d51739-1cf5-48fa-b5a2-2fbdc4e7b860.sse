splays configurable Agent name, logo and optional description in a normal Layout Slot.\\\",\\n44:       \\\"version\\\": \\\"0.0.1\\\",\\n45:       \\\"capabilities\\\": [\\n46:         \\\"agent-identity\\\"\\n47:       ],\\n48:       \\\"authoring\\\": {\\n49:         \\\"intents\\\": [\\n50:           \\\"rename Agent\\\",\\n51:           \\\"change Agent name\\\",\\n52:           \\\"change Agent logo\\\",\\n53:           \\\"change Agent brand information\\\",\\n54:           \\\"把我的 Agent 改名为智能研发助手\\\",\\n55:           \\\"把 Agent 的 Logo 换成公司的标志\\\"\\n56:         ],\\n57:         \\\"visualRole\\\": \\\"Agent identity in a normal Layout Slot; edit plugins/agent-identity/config.ts for branding\\\"\\n58:       }\\n59:     },\\n60:     provides: [],\\n61:     inject: [],\\n62:     optionalInject: [\\\"agent-ui.locale\\\"],\\n63:     loadDefinition: () =>\\n64:       import(\\\"./agent-identity/definition\\\").then(\\n65:         ({ default: definition }) => definition,\\n66:       ),\\n67:   },\\n68:   {\\n69:     manifest: {\\n70:       \\\"id\\\": \\\"composer\\\",\\n71:       \\\"name\\\": \\\"Conversation Composer\\\",\\n72:       \\\"description\\\": \\\"Renders the canonical Agent UI conversation composer with composable action Slots.\\\",\\n73:       \\\"version\\\": \\\"0.0.1\\\",\\n74:       \\\"capabilities\\\": [\\n75:         \\\"conversation-composer\\\"\\n76:       ],\\n77:       \\\"authoring\\\": {\\n78:         \\\"intents\\\": [\\n79:           \\\"show the primary conversation composer\\\",\\n80:           \\\"compose conversation input actions\\\"\",\"hash\":\"c8e0f4822109c6fda15f4b26073301e0463b12990629755ec5b236b7bf949246\",\"totalLines\":1070,\"nextOffset\":80}}","role":"tool"}

