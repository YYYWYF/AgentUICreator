data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_a0fa2086794949fabc6ca56a","messageId":"b3641c98-e5ad-4158-88cb-f26f4a36e722","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/quick-help-card/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"quick-help-card\\\",\\n3:   \\\"name\\\": \\\"Quick Help Card\\\",\\n4:   \\\"description\\\": \\\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"capabilities\\\": [\\n7:     \\\"quick-help-card\\\"\\n8:   ],\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"show a quick help card at the chat top\\\",\\n12:       \\\"显示使用帮助卡片\\\",\\n13:       \\\"在聊天区域顶部显示帮助卡片\\\",\\n14:       \\\"expand or collapse usage help\\\"\\n15:     ],\\n16:     \\\"visualRole\\\": \\\"chat area collapsible help card\\\",\\n17:     \\\"recommendedSize\\\": {\\n18:       \\\"height\\\": \\\"44px\\\"\\n19:     },\\n20:     \\\"defaultPlacement\\\": {\\n21:       \\\"type\\\": \\\"relative\\\",\\n22:       \\\"relation\\\": \\\"above\\\",\\n23:       \\\"anchorPluginId\\\": \\\"conversation-surface\\\"\\n24:     }\\n25:   },\\n26:   \\\"slots\\\": {\\n27:     \\\"children\\\": {\\n28:       \\\"headerActions\\\": {\\n29:         \\\"description\\\": \\\"Optional actions displayed in the help card header.\\\",\\n30:         \\\"cardinality\\\": \\\"many\\\",\\n31:         \\\"optional\\\": true,\\n32:         \\\"accepts\\\": {\\n33:           \\\"anyOfCapabilities\\\": [\\n34:             \\\"help-dismiss-action\\\"\\n35:           ]\\n36:         }\\n37:       },\\n38:       \\\"body\\\": {\\n39:         \\\"description\\\": \\\"Help content displayed when the card is expanded.\\\",\\n40:         \\\"cardinality\\\": \\\"one\\\",\\n41:         \\\"optional\\\": true,\\n42:         \\\"accepts\\\": {\\n43:           \\\"anyOfCapabilities\\\": [\\n44:             \\\"quick-help-content\\\"\\n45:           ]\\n46:         }\\n47:       }\\n48:     }\\n49:   }\\n50: }\\n51: \",\"hash\":\"20bea8a1cebbebd130477421acd1c48e6fb6401be21e411b2e7833d9b88b7013\",\"totalLines\":51,\"nextOffset\":null}}","role":"tool"}

