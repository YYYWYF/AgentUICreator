data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_178bb0f5eb82408aa2fe5a7a","delta":"{\"file_path\":\"/skills/ui-layout/SKILL.md\",\"limit\":200,\"offset\":0}"}

