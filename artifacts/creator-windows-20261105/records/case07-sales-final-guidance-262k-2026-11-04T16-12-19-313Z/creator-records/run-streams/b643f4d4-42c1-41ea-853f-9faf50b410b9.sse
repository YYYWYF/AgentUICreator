data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_a2d08620874a423cbe63b5d2","messageId":"57fca58f-4bb3-4d5f-bcf6-f590f3bb694e","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/application/project-config.tsx\",\"content\":\"1: import { AgentUIProjectProvider, createAgentUIProject, resolveAgentUIProjectResources } from \\\"@za38.03/agent-ui-runtime/ui\\\";\\n2: import type { PropsWithChildren } from \\\"react\\\";\\n3: import appUIModelSource from \\\"../app-ui.json?raw\\\";\\n4: import { pluginCapabilityCatalog, capabilityCatalogRevision } from \\\"../plugins\\\";\\n5: import { ProjectShell } from \\\"./runtime-config.generated\\\";\\n6: import \\\"@za38.03/agent-ui-runtime/ui/styles.css\\\";\\n7: import \\\"../styles.css\\\";\\n8: \\n9: const revisions = import.meta.glob<string>(\\\"../composition-revision.generated.json\\\", { eager: true, query: \\\"?raw\\\", import: \\\"default\\\" });\\n10: const resources = import.meta.glob([\\n11:   \\\"../agent-contract/frontend-tools.generated.ts\\\",\\n12:   \\\"../agent-ui/conversation/frontend-tool-uis.generated.ts\\\",\\n13:   \\\"../agent-ui/conversation/integrations.generated.tsx\\\",\\n14: ], { eager: true });\\n15: export const agentUIProject = createAgentUIProject({\\n16:   ...resolveAgentUIProjectResources(resources),\\n17:   appUIModelSource, revisionDescriptorSource: revisions[\\\"../composition-revision.generated.json\\\"],\\n18:   pluginCapabilityCatalog, capabilityCatalogRevision, Shell: ProjectShell,\\n19:   development: import.meta.env.DEV, hot: import.meta.hot,\\n20: });\\n21: \\n22: export function ProjectProvider({ children }: PropsWithChildren) {\\n23:   return <AgentUIProjectProvider value={agentUIProject}>{children}</AgentUIProjectProvider>;\\n24: }\\n25: \",\"hash\":\"812c39cc3c73462e2e85ec0b4c2ac847fe5a62ebf7e2f826ae4a11bc27ad98f3\",\"totalLines\":25,\"nextOffset\":null}}","role":"tool"}

