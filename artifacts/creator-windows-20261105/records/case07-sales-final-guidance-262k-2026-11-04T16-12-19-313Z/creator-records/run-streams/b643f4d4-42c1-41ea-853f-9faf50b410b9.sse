data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_418d490f376a44908fb6a6da","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":4000,\"offset\":0,\"sectionId\":\"s34\"}"}

