data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_cb7a8d8406d84b848344eb27","messageId":"b1d51d6c-7fda-444b-834c-51b2c904dc4a","content":"{\"ok\":true,\"result\":{\"view\":\"composition\",\"workspaceDiagnostics\":[],\"sourceRoot\":\"src/agent-ui\",\"observationCoverage\":[\"composition.model\",\"composition.layout\",\"composition.slots\",\"composition.instances\",\"capability.inventory\",\"capability.composition-summary\",\"creator.actions\",\"creator.authoring-targets\"],\"appUIModel\":{\"hash\":\"ec814f21d2857a86f24a3cd35ae3cbc8d079f4b634bd7553dc7738d8ba4c5d7c\",\"layout\":{\"nodeRef\":\"l0\",\"type\":\"row\",\"sizes\":[\"300px\",\"minmax(0, 1fr)\"],\"gap\":0,\"children\":[{\"nodeRef\":\"l1\",\"type\":\"panel\",\"child\":{\"nodeRef\":\"l2\",\"type\":\"column\",\"sizes\":[\"52px\",\"minmax(0, 1fr)\"],\"gap\":0,\"children\":[{\"nodeRef\":\"l3\",\"type\":\"slot\",\"plugins\":[{\"id\":\"p5\",\"pluginId\":\"theme-switch\",\"enabled\":true},{\"id\":\"p6\",\"pluginId\":\"agent-identity\",\"enabled\":true}]},{\"nodeRef\":\"l4\",\"type\":\"slot\",\"plugins\":[{\"id\":\"p7\",\"pluginId\":\"conversation-thread-list\",\"enabled\":true,\"slots\":{\"headerActions\":[{\"id\":\"p8\",\"pluginId\":\"conversation-new\",\"enabled\":true}]}}]}]}},{\"nodeRef\":\"l5\",\"type\":\"panel\",\"child\":{\"nodeRef\":\"l6\",\"type\":\"column\",\"sizes\":[\"40px\",\"44px\",\"minmax(0, 1fr)\"],\"gap\":0,\"children\":[{\"nodeRef\":\"l7\",\"type\":\"panel\",\"child\":{\"nodeRef\":\"l8\",\"type\":\"slot\",\"plugins\":[{\"id\":\"p23\",\"pluginId\":\"test-notice\",\"enabled\":true}]}},{\"nodeRef\":\"l9\",\"type\":\"panel\",\"child\":{\"nodeRef\":\"l10\",\"type\":\"slot\",\"plugins\":[{\"id\":\"p24\",\"pluginId\":\"quick-help-card\",\"enabled\":true,\"slots\":{\"body\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true}],\"headerActions\":[{\"id\":\"p9\",\"pluginId\":\"help-dismiss-action\",\"enabled\":true}]}}]}},{\"nodeRef\":\"l11\",\"type\":\"slot\",\"plugins\":[{\"id\":\"p10\",