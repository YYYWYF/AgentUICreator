data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_482d8bb558fd4a88a9c2d043","delta":"{\"pluginId\":\"sales-report-message\",\"files\":[{\"relativePath\":\"manifest.json\",\"content\":\"{\\n  \\\"id\\\": \\\"sales-report-message\\\",\\n  \\\"name\\\": \\\"Sales Report Message\\\",\\n  \\\"description\\\": \\\"Renders app.sales.report CUSTOM events as a sortable sales table inside assistant messages.\\\",\\n  \\\"version\\\": \\\"0.0.1\\\",\\n  \\\"data\\\": {\\n    \\\"messageUI\\\": true\\n  },\\n  \\\"authoring\\\": {\\n    \\\"intents\\\": [\\n      \\\"render sales report as a table in assistant messages\\\",\\n      \\\"把销售报表显示成表格\\\",\\n      \\\"按收入排序查看月度销售\\\"\\n    ],\\n    \\\"visualRole\\\": \\\"assistant sales report message card\\\"\\n  }\\n}\\n\"},{\"relativePath\":\"schema.ts\",\"content\":\"export const SALES_REPORT_EVENT = \\\"app.sales.report\\\";\\n\\nexport interface SalesReportRow {\\n  id: string;\\n  month: string;\\n  revenue: number | null;\\n  orderCount: number | null;\\n}\\n\\nexport interface SalesReport {\\n  title: string | null;\\n  rows: SalesReportRow[];\\n}\\n\\nexport type SalesReportParseResult =\\n  | { ok: true; report: SalesReport }\\n  | { ok: false; reason: \\\"invalid\\\" };\\n\\nfunction parseJsonText(text: string): unknown {\\n  const trimmed = text.trim();\\n  if (!trimmed) return null;\\n  try {\\n    return JSON.parse(trimmed) as unknown;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * The report travels as a CUSTOM event value such as\\n * { format: \\\"json\\\", payload: \\\"{\\\\\\\"title\\\\\\\":...,\\\\\\\"rows\\\\\\\":[...]}\\\" }.\\n * Unwrap the JSON envelope strings until an object is reached.\\n */\\nfunction unwrapEnvelope(value: unknown, depth: number): unknown {\\n  if (depth > 5) return value;\\n  if (typeof value === \\\"string\\\") return unwrapEnvelope(parseJsonText(value), depth + 1);\\n  if (!value || typeof value !== \\\"object\\\") return value;\\n  const record = value as Record<string, unknown>;\\n  if (Array.isArray(record.rows)) return record;\\n  if (\\\"payload\\\" in record) return unwrapEnvelope(record.payload, depth + 1);\\n  if (\\\"value\\\" in record) return unwrapEnvelope(record.value, depth + 1);\\n  return record;\\n}\\n\\nfunction toNumber(input: unknown): number | null {\\n  if (typeof input === \\\"number\\\") return Number.isFinite(input) ? input : null;\\n  if (typeof input === \\\"string\\\") {\\n    const normalized = input.replace(/[,\\\\s]/g, \\\"\\\");\\n    if (!normalized) return null;\\n    const parsed = Number(normalized);\\n    return Number.isFinite(parsed) ? parsed : null;\\n  }\\n  return null;\\n}\\n\\nfunction normalizeRow(input: unknown, index: number): SalesReportRow | null {\\n  if (!input || typeof input !== \\\"object\\\") return null;\\n  const record = input as Record<string, unknown>;\\n\\n  const monthValue = record.month;\\n  const month =\\n    typeof monthValue === \\\"string\\\"\\n      ? monthValue.trim()\\n      : typeof monthValue === \\\"number\\\"\\n        ? String(monthValue)\\n        : \\\"\\\";\\n  if (!month) return null;\\n\\n  return {\\n    id: `${month}-${index}`,\\n    month,\\n    revenue: toNumber(record.revenue),\\n    orderCount: toNumber(record.order_count ?? record.orderCount),\\n  };\\n}\\n\\nexport function parseSalesReport(data: unknown): SalesReportParseResult {\\n  const root = unwrapEnvelope(data, 0);\\n  if (!root || typeof root !== \\\"object\\\" || Array.isArray(root)) {\\n    return { ok: false, reason: \\\"invalid\\\" };\\n  }\\n\\n  const record = root as Record<string, unknown>;\\n  if (!Array.isArray(record.rows)) return { ok: false, reason: \\\"invalid\\\" };\\n\\n  const rows = record.rows\\n    .map((row, index) => normalizeRow(row, index))\\n    .filter((row): row is SalesReportRow => row !== null);\\n  if (rows.length === 0) return { ok: false, reason: \\\"invalid\\\" };\\n\\n  const titleValue = record.title;\\n  const title = typeof titleValue === \\\"string\\\" && titleValue.trim() ? titleValue.trim() : null;\\n\\n  return { ok: true, report: { title, rows } };\\n}\\n\"},{\"relativePath\":\"index.tsx\",\"content\":\"import { Fragment, useMemo, useState } from \\\"react\\\";\\nimport { useAgentUILocaleCode } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { getProjectMessages } from \\\"../../application/i18n/messages\\\";\\nimport { parseSalesReport, type SalesReportRow } from \\\"./schema\\\";\\nimport \\\"./styles.css\\\";\\n\\ntype SortDirection = \\\"desc\\\" | \\\"asc\\\";\\n\\nfunction sortRows(rows: SalesReportRow[], direction: SortDirection): SalesReportRow[] {\\n  const factor = direction === \\\"desc\\\" ? -1 : 1;\\n  return [...rows].sort((a, b) => {\\n    if (a.revenue === null && b.revenue === null) return a.month.localeCompare(b.month);\\n    if (a.revenue === null) return 1;\\n    if (b.revenue === null) return -1;\\n    if (a.revenue === b.revenue) return a.month.localeCompare(b.month);\\n    return (a.revenue - b.revenue) * factor;\\n  });\\n}\\n\\nexport function SalesReportMessage({ data }: { data: unknown }) {\\n  const localeCode = useAgentUILocaleCode();\\n  const labels = getProjectMessages(localeCode).salesReport;\\n  const [direction, setDirection] = useState<SortDirection>(\\\"desc\\\");\\n  const [selectedId, setSelectedId] = useState<string | null>(null);\\n  const numbers = useMemo(\\n    () => new Intl.NumberFormat(localeCode, { maximumFractionDigits: 2 }),\\n    [localeCode],\\n  );\\n  const result = useMemo(() => parseSalesReport(data), [data]);\\n\\n  if (!result.ok) {\\n    return (\\n      <section className=\\\"sales-report\\\" role=\\\"alert\\\">\\n        <p className=\\\"sales-report__status\\\">{labels.invalid}</p>\\n      </section>\\n    );\\n  }\\n\\n  const { report } = result;\\n  const heading = report.title ?? labels.heading;\\n  const rows = sortRows(report.rows, direction);\\n\\n  const toggleRow = (rowId: string) => {\\n    setSelectedId((current) => (current === rowId ? null : rowId));\\n  };\\n\\n  const formatValue = (value: number | null) =>\\n    value === null ? labels.unknown : numbers.format(value);\\n\\n  return (\\n    <section className=\\\"sales-report\\\" aria-label={heading}>\\n      <header className=\\\"sales-report__header\\\">\\n        <h3 className=\\\"sales-report__title\\\">{heading}</h3>\\n        <p className=\\\"sales-report__hint\\\">{labels.hint}</p>\\n      </header>\\n\\n      {rows.length === 0 ? (\\n        <p className=\\\"sales-report__status\\\">{labels.empty}</p>\\n      ) : (\\n        <div className=\\\"sales-report__scroll\\\">\\n          <table className=\\\"sales-report__table\\\" aria-label={heading}>\\n            <thead>\\n              <tr>\\n                <th scope=\\\"col\\\" className=\\\"sales-report__col-month\\\">\\n                  {labels.month}\\n                </th>\\n                <th\\n                  scope=\\\"col\\\"\\n                  className=\\\"sales-report__col-revenue\\\"\\n                  aria-sort={direction === \\\"desc\\\" ? \\\"descending\\\" : \\\"ascending\\\"}\\n                >\\n                  <button\\n                    type=\\\"button\\\"\\n                    className=\\\"sales-report__sort\\\"\\n                    onClick={() =>\\n                      setDirection((current) => (current === \\\"desc\\\" ? \\\"asc\\\" : \\\"desc\\\"))\\n                    }\\n                  >\\n                    <span>{labels.revenue}</span>\\n                    <span className=\\\"sales-report__sort-icon\\\" aria-hidden=\\\"true\\\">\\n                      {direction === \\\"desc\\\" ? \\\"↓\\\" : \\\"↑\\\"}\\n                    </span>\\n                  </button>\\n                </th>\\n              </tr>\\n            </thead>\\n            <tbody>\\n              {rows.map((row) => {\\n                const selected = row.id === selectedId;\\n                return (\\n                  <Fragment key={row.id}>\\n                    <tr\\n                      className=\\\"sales-report__row\\\"\\n                      data-selected={selected ? \\\"true\\\" : undefined}\\n                      tabIndex={0}\\n                      aria-expanded={selected}\\n                      onClick={() => toggleRow(row.id)}\\n                      onKeyDown={(event) => {\\n                        if (event.key === \\\"Enter\\\" || event.key === \\\" \\\") {\\n                          event.preventDefault();\\n                          toggleRow(row.id);\\n                        }\\n                      }}\\n                    >\\n                      <th scope=\\\"row\\\" className=\\\"sales-report__col-month\\\">\\n                        {row.month}\\n                      </th>\\n                      <td className=\\\"sales-report__col-revenue\\\">\\n                        {formatValue(row.revenue)}\\n                      </td>\\n                    </tr>\\n                    {selected ? (\\n                      <tr className=\\\"sales-report__detail\\\">\\n                        <td colSpan={2}>\\n                          <span className=\\\"sales-report__detail-inner\\\" role=\\\"status\\\">\\n                            <span className=\\\"sales-report__detail-month\\\">{row.month}</span>\\n                            <span className=\\\"sales-report__detail-label\\\">\\n                              {labels.orderCount}\\n                            </span>\\n                            <span className=\\\"sales-report__detail-value\\\">\\n                              {formatValue(row.orderCount)}\\n                            </span>\\n                          </span>\\n                        </td>\\n                      </tr>\\n                    ) : null}\\n                  </Fragment>\\n                );\\n              })}\\n            </tbody>\\n          </table>\\n        </div>\\n      )}\\n    </section>\\n  );\\n}\\n\\nexport default SalesReportMessage;\\n\"},{\"relativePath\":\"definition.ts\",\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport { defineDataMessageUI } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { SalesReportMessage } from \\\"./index\\\";\\nimport { SALES_REPORT_EVENT } from \\\"./schema\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  dataMessageUIs: [\\n    defineDataMessageUI<unknown>({\\n      name: SALES_REPORT_EVENT,\\n      render: SalesReportMessage,\\n    }),\\n  ],\\n  Component: () => null,\\n};\\n\\nexport default definition;\\n\"},{\"relativePath\":\"styles.css\",\"content\":\".sales-report {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  box-sizing: border-box;\\n  min-width: 0;\\n  max-width: 100%;\\n  margin-block: 8px;\\n  padding: 12px 14px;\\n  border: 1px solid var(--border);\\n  border-radius: 12px;\\n  background: var(--card);\\n  color: var(--foreground);\\n  font-size: 13px;\\n  line-height: 1.45;\\n}\\n\\n.sales-report__header {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 2px;\\n  min-width: 0;\\n}\\n\\n.sales-report__title {\\n  margin: 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n}\\n\\n.sales-report__hint {\\n  margin: 0;\\n  font-size: 12px;\\n  opacity: 0.7;\\n}\\n\\n.sales-report__status {\\n  margin: 0;\\n  font-size: 12px;\\n}\\n\\n.sales-report__scroll {\\n  min-width: 0;\\n  max-width: 100%;\\n  overflow-x: auto;\\n}\\n\\n.sales-report__table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  table-layout: auto;\\n}\\n\\n.sales-report__table th,\\n.sales-report__table td {\\n  padding: 6px 8px;\\n  border-bottom: 1px solid var(--border);\\n  text-align: left;\\n  vertical-align: middle;\\n}\\n\\n.sales-report__table thead th {\\n  font-weight: 600;\\n  white-space: nowrap;\\n}\\n\\n.sales-report__col-revenue {\\n  text-align: right;\\n  white-space: nowrap;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.sales-report__col-month {\\n  white-space: nowrap;\\n}\\n\\n.sales-report__sort {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 4px;\\n  padding: 0;\\n  border: 0;\\n  background: none;\\n  color: inherit;\\n  font: inherit;\\n  font-weight: 600;\\n  cursor: pointer;\\n}\\n\\n.sales-report__sort:hover {\\n  text-decoration: underline;\\n}\\n\\n.sales-report__sort:focus-visible {\\n  outline: 2px solid var(--primary);\\n  outline-offset: 2px;\\n  border-radius: 4px;\\n}\\n\\n.sales-report__sort-icon {\\n  opacity: 0.7;\\n}\\n\\n.sales-report__row {\\n  cursor: pointer;\\n}\\n\\n.sales-report__row:hover {\\n  background: var(--muted);\\n}\\n\\n.sales-report__row:focus-visible {\\n  outline: 2px solid var(--primary);\\n  outline-offset: -2px;\\n}\\n\\n.sales-report__row[data-selected=\\\"true\\\"] {\\n  background: var(--muted);\\n}\\n\\n.sales-report__detail td {\\n  border-bottom: 1px solid var(--border);\\n  background: var(--background);\\n}\\n\\n.sales-report__detail-inner {\\n  display: inline-flex;\\n  flex-wrap: wrap;\\n  align-items: baseline;\\n  gap: 6px;\\n}\\n\\n.sales-report__detail-month {\\n  font-weight: 600;\\n}\\n\\n.sales-report__detail-label {\\n  font-size: 12px;\\n  opacity: 0.7;\\n}\\n\\n.sales-report__detail-value {\\n  font-weight: 600;\\n  font-variant-numeric: tabular-nums;\\n}\\n\"}]}"}

data: {"type":"TOOL_CALL_END","toolCallId":"call_482d8bb558fd4a88a9c2d043"}

