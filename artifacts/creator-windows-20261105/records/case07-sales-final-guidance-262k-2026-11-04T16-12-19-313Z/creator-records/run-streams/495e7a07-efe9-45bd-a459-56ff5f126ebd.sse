ected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"help-dismiss-action\",\"name\":\"Help Dismiss Action\",\"description\":\"Header action for the quick help card that dismisses the help body; the card title expands it again.\",\"capabilities\":[\"help-dismiss-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"job-progress-message\",\"name\":\"Job Progress\",\"description\":\"Renders run_ci_job tool calls with the conversation UI facade.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-composer-input\",\"name\":\"Conversation Lexical Composer Input\",\"description\":\"Optional plain text input with atomic directive chips.\",\"capabilities\":[\"conversation-composer-input\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"lexical-edit-composer\",\"name\":\"Conversation Lexical Edit Composer\",\"description\":\"Rich editing of existing directives in historical user messages.\",\"capabilities\":[\"conversation-user-edit-composer-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/locale-provider\",\"component\":\"LocaleProviderPlugin\",\"facts\":{\"presentation\":\"Generated Agent applications and createAgentUILocaleService() default to zh-CN. Standalone presentation components without the generated Runtime bridge default to en-US. The supported locale codes are zh-CN and en-US; do not search protected implementation source to infer the generated default.\",\"composition\":\"Keep the existing locale-provider service and Runtime locale bridge. Agent locale is controlled, defaultLocale initializes an uncontrolled instance, onLocaleChange observes selection, and locales supplies per-locale partial message overrides. For example, locales['zh-CN'].composer.placeholder customizes the existing Chinese input hint. Supply the English counterpart. Merge project defaults and Host overrides at both locale and domain-field levels: spreading locales only at the top level replaces entire locale dictionaries, losing project defaults when the Host overrides an unrelated domain. Host values win for the exact fields they supply. LocaleProviderPlugin itself only renders children, with no locale/message props.\",\"interaction\":\"The public useAgentUILocale(namespace) reads existing shared domain messages; useAgentUILocaleCode() reads the same current code. For custom project business messages use a small en-US/zh-CN project dictionary keyed by that unified code, without another language state or Context. AgentUILocaleMessages and Overrides describe the package's existing namespaces; unrelated new business keys do not require extending those closed npm types.\"}},\"name\":\"Headless Locale Service Provider\",\"description\":\"Provides the shared application locale service to UI plugins.\",\"capabilities\":[\"headless\",\"locale\",\"plugin-service-provider\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"locale-switch\",\"name\":\"Locale Switch\",\"description\":\"Selects the application language through the shared locale service.\",\"capabilities\":[\"locale-control\",\"plugin-service-consumer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.locale\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"mention-trigger\",\"name\":\"Conversation Mention Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.mention-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"quick-help-card\",\"name\":\"Quick Help Card\",\"description\":\"Collapsible usage-help card at the top of the chat area with headerActions and body semantic slots.\",\"capabilities\":[\"quick-help-card\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{\"body\":{\"description\":\"Help content displayed when the card is expanded.\",\"cardinality\":\"one\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"quick-help-content\"]}},\"headerActions\":{\"description\":\"Optional actions displayed in the help card header.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"help-dismiss-action\"]}}}},{\"pluginId\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"capabilities\":[\"quick-help-content\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"reasoning\",\"name\":\"Conversation Reasoning Renderer\",\"description\":\"Displays detailed Agent UI reasoning in a collapsible group. Disable this semantic contribution for status-only presentation; collapsing still permits viewing details.\",\"capabilities\":[\"conversation-reasoning-renderer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"reload-action\",\"name\":\"Conversation Reload Action\",\"description\":\"Regenerates the current assistant response through Agent UI.\",\"capabilities\":[\"conversation-assistant-response-action\",\"conversation-message-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"response-footer\",\"name\":\"Conversation Response Footer\",\"description\":\"Renders the canonical assistant response footer and its composable actions.\",\"capabilities\":[\"conversation-assistant-response-footer-renderer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{\"actions\":{\"description\":\"Actions displayed in the assistant response footer.\",\"cardinality\":\"many\",\"optional\":true,\"accepts\":{\"anyOfCapabilities\":[\"conversation-assistant-response-action\"]}}}},{\"pluginId\":\"retrieval-chunks\",\"name\":\"RetrievalChunks\",\"description\":\"Render search_docs backend tool calls with the official Agent UI Element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"sales-report-message\",\"name\":\"Sales Report Message\",\"description\":\"Renders app.sales.report CUSTOM events as a sortable sales table inside assistant messages.\",\"capabilities\":[],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"slash-command-trigger\",\"name\":\"Conversation Slash Command Trigger\",\"description\":\"Optional composer trigger backed by project-owned Plugin Services.\",\"capabilities\":[\"conversation-composer-trigger\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\",\"conversation.slash-command-source\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"source-citations-message\",\"name\":\"Source Citations\",\"description\":\"Renders validated search_sources backend results with the official Sources element.\",\"capabilities\":[\"headless\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"submit-action\",\"name\":\"Conversation Submit Action\",\"description\":\"Adds Agent UI send and stop controls to the conversation composer.\",\"capabilities\":[\"conversation-composer-submit-action\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"task-group\",\"name\":\"Task Group\",\"description\":\"Renders nested agent work as expandable task cards.\",\"capabilities\":[\"conversation-task-group-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"test-notice\",\"name\":\"Test Notice\",\"description\":\"Displays a static bilingual notice at the top of the chat area using React native elements and theme tokens.\",\"capabilities\":[\"test-notice\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"theme-provider\",\"componentPresentation\":{\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/theme-provider\",\"component\":\"ThemeProviderPlugin\",\"facts\":{\"presentation\":\"The built-in theme keys are light, dark and violet; the default is violet. A custom brand color such as blue is a project CSS palette customization, not a new theme enum value. ThemeProviderPlugin renders its children and does not accept palette/color props.\",\"composition\":\"Keep the existing theme service and AgentUIRoot. Agent theme props or createAgentUIThemeService(initialTheme) select a built-in preset; AppUIModel does not configure component props. Do not add another theme Runtime or edit npm implementation files.\",\"styles\":\"Import @za38.03/agent-ui-plugins/styles.css before project overrides. Scoped palette selectors are :is(.agent-ui-root, .agent-ui-conversation)[data-theme=\\\"violet\\\"] for the default preset. Override --agent-brand and --agent-brand-solid for the brand and solid actions; --primary, --ring, --sidebar-primary and --sidebar-ring are semantic control/sidebar colors. Violet derives --primary and sidebar/focus colors from --agent-brand-solid; neutral light/dark derive --agent-brand from --primary, so override both when customizing those presets. Other public tokens include --background, --foreground, --card, --muted, --border, --input, --primary-foreground, --sidebar and --sidebar-foreground. Keep surfaces/readability coherent and verify rendered colors and theme switching. These names describe this installed package; project CSS overrides need no source takeover.\"}},\"name\":\"Headless Theme Service Provider\",\"description\":\"Provides the shared Agent UI theme preset service to other UI plugins.\",\"capabilities\":[\"headless\",\"plugin-service-provider\",\"theme\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"theme-switch\",\"name\":\"Theme Switch\",\"description\":\"Calls the shared theme service exposed by another UI plugin.\",\"capabilities\":[\"plugin-service-consumer\",\"theme-control\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[\"agent-ui.theme\"],\"status\":\"resolved\",\"missing\":[]},\"optionalServices\":{\"names\":[\"agent-ui.locale\"],\"available\":[\"agent-ui.locale\"]},\"childSlots\":{}},{\"pluginId\":\"thinking-indicator\",\"name\":\"Conversation Thinking Indicator\",\"description\":\"Message-scoped live status placeholder. Yields to visible reasoning or tool activity; does not disable the separate reasoning renderer.\",\"capabilities\":[\"conversation-thinking-indicator-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-fallback\",\"name\":\"Conversation Tool Fallback Renderer\",\"description\":\"Displays an unregistered tool call with canonical Agent UI presentation.\",\"capabilities\":[\"conversation-tool-fallback-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-group\",\"name\":\"Conversation Tool Group Renderer\",\"description\":\"Displays one Agent UI tool group with canonical presentation.\",\"capabilities\":[\"conversation-tool-group-renderer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-result\",\"name\":\"Tool Result\",\"description\":\"Renders AG-UI tool result content parts with canonical image, audio, video and file presentation.\",\"capabilities\":[\"conversation-tool-fallback-renderer\"],\"selected\":true,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"tool-timeline\",\"name\":\"Conversation Tool Timeline\",\"description\":\"Message-level tool execution timeline with actions, targets and file-change statistics.\",\"capabilities\":[\"conversation-tool-timeline-renderer\"],\"selected\":false,\"selectionOwner\":\"composition\",\"requiredServices\":{\"names\":[],\"status\":\"not-required\",\"missing\":[]},\"optionalServices\":{\"names\":[],\"available\":[]},\"childSlots\":{}},{\"pluginId\":\"transient-assistant-messages\",\"name\":\"Transient Messages\",\"description\":\"Page-memory user and assistant bubbles without Agent runs, persistence or model context.\",\"capabilities\":[\"conversation-transient-messages-renderer\"],\"selected\":true,\"selectionOwner