data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_K40vALfXmNNVLiJjrdjv4394","messageId":"740d93ea-8a66-4aed-87b5-a1e14ee720bd","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"373e8784ed400aa3d4982d94a83cffc45fb4fede729b539cc5b62ef39947bfd9\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"29f23a159ddd3b0f79b1b0668e0270d52473e07b81a5196504ef6a85adfe708b\",\"totalSections\":6,\"offset\":0,\"sections\":[{\"sectionId\":\"s1\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"level\":1,\"characters\":3973,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s17\",\"title\":\"1. 让 Agent 返回事件\",\"level\":2,\"characters\":219,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s34\",\"title\":\"2. 编写解析函数并配置事件\",\"level\":2,\"characters\":840,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\"}}},{\"sectionId\":\"s71\",\"title\":\"3. 编写消息组件\",\"level\":2,\"characters\":1470,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s111\",\"title\":\"4. 注册并启用插件\",\"level\":2,\"characters\":943,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s111\"}}},{\"sectionId\":\"s157\",\"title\":\"5. 检查结果\",\"level\":2,\"characters\":187,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s157\"}}}],\"nextOffset\":null}}","role":"tool"}

