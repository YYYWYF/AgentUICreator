finitionPath\":\"src/agent-ui/plugins/copy-action/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/copy-action/manifest.json\",\"pluginId\":\"copy-action\",\"relatedPluginIds\":[\"copy-action\"]},{\"targetId\":\"official-plugin-reference:dictation-action\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"dictation-action\",\"relatedPluginIds\":[\"dictation-action\"]},{\"targetId\":\"plugin-source:export-markdown-action\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/export-markdown-action/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/export-markdown-action\",\"definitionPath\":\"src/agent-ui/plugins/export-markdown-action/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/export-markdown-action/manifest.json\",\"pluginId\":\"export-markdown-action\",\"relatedPluginIds\":[\"export-markdown-action\"]},{\"targetId\":\"official-plugin-reference:feedback-actions\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"feedback-actions\",\"relatedPluginIds\":[\"feedback-actions\"]},{\"targetId\":\"official-plugin-reference:generated-file-message\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"generated-file-message\",\"relatedPluginIds\":[\"generated-file-message\"]},{\"targetId\":\"plugin-source:help-dismiss-action\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/help-dismiss-action/definition.ts\",\"ownerRoot\":\"src/agent-ui/plugins/help-dismiss-action\",\"definitionPath\":\"src/agent-ui/plugins/help-dismiss-action/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/help-dismiss-action/manifest.json\",\"pluginId\":\"help-dismiss-action\",\"relatedPluginIds\":[\"help-dismiss-action\"]},{\"targetId\":\"official-plugin-reference:job-progress-message\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"job-progress-message\",\"relatedPluginIds\":[\"job-progress-message\"]},{\"targetId\":\"official-plugin-reference:lexical-composer-input\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"lexical-composer-input\",\"relatedPluginIds\":[\"lexical-composer-input\"]},{\"targetId\":\"official-plugin-reference:lexical-edit-composer\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"lexical-edit-composer\",\"relatedPluginIds\":[\"lexical-edit-composer\"]},{\"targetId\":\"plugin-source:locale-provider\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/locale-provider/index.tsx\",\"ownerRoot\":\"src/agent-ui/plugins/locale-provider\",\"definitionPath\":\"src/agent-ui/plugins/locale-provider/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/locale-provider/manifest.json\",\"pluginId\":\"locale-provider\",\"relatedPluginIds\":[\"locale-provider\"]},{\"targetId\":\"official-plugin-reference:locale-switch\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"locale-switch\",\"relatedPluginIds\":[\"locale-switch\"]},{\"targetId\":\"official-plugin-reference:mention-trigger\",\"kind\":\"official_plugin_reference\",\"pluginId\":\"mention-trigger\",\"relatedPluginIds\":[\"mention-trigger\"]},{\"targetId\":\"plugin-source:quick-help-card\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"ownerRoot\":\"src/agent-ui/plugins/quick-help-card\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-card/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-card/manifest.json\",\"pluginId\":\"quick-help-card\",\"relatedPluginIds\":[\"quick-help-card\"]},{\"targetId\":\"plugin-source:quick-help-content\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"ownerRoot\":\"src/agent-ui/plugins/quick-help-content\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"pluginId\":\"quick-help-content\",\"relatedPluginIds\":[\"quick-help-content\"]},{\"targetId\":\"plugin-source:reasoning\",\"kind\":\"plugin_source\",\"ownerPath\":\"src/agent-ui/plugins/reasonin