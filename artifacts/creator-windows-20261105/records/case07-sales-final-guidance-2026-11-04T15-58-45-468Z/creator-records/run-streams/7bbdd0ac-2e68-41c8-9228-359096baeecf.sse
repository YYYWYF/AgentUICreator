data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_jwx5uaNQVpsC1RlUg4Dz9798","delta":"{\"file_path\":\"/skills/ui-plugin-development/references/authoring-contracts.md\",\"limit\":300,\"offset\":0}"}

