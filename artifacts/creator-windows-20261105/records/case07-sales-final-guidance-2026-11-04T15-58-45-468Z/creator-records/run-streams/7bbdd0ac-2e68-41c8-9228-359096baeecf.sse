data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-9dc3e850a27eed0f","messageId":"78f84019-a12c-486b-989b-2dc229a6fb33","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/index.ts\",\"content\":\"1: export type { AgentUITheme } from \\\"@za38.03/agent-ui-plugins\\\";\\n2: export { Agent, type AgentProps } from \\\"./application/Agent\\\";\\n3: export type { AgentUser } from \\\"@za38.03/agent-ui-runtime/ui/application/host-user\\\";\\n4: export type { AgentObservability } from \\\"@za38.03/agent-ui-runtime/ui/application/observability\\\";\\n5: export { createAgentBackendTransport, type AgentBackendTransport } from \\\"@za38.03/agent-ui-runtime/ui\\\";\\n6: export { useAgentUI, useAgentUIState, useAgentUIEvent, useAgentUIUser, AgentUIHostError } from \\\"@za38.03/agent-ui-runtime\\\";\\n7: export type { AgentUIHost, AgentUIHostSnapshot, AgentUIEventMap, AgentUIConnectionStatus } from \\\"@za38.03/agent-ui-runtime\\\";\\n8: \",\"hash\":\"5a96671b3828130d4561417509e1b93bb3ba485391e5fe056ed273f998c5ddac\",\"totalLines\":8,\"nextOffset\":null}}","role":"tool"}

