data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_Ybk3lLTxJVkBI4FjuGhX6214","messageId":"1fef7f78-52c7-486e-8165-42b71d9a203b","content":"{\"ok\":true,\"result\":{\"path\":\"/src/agent-ui/plugins/context-retrieval-message/manifest.json\",\"content\":\"1: {\\n2:   \\\"id\\\": \\\"context-retrieval-message\\\",\\n3:   \\\"name\\\": \\\"Context Retrieval Message\\\",\\n4:   \\\"description\\\": \\\"Renders context retrieval results carried by AG-UI CUSTOM events.\\\",\\n5:   \\\"version\\\": \\\"0.0.1\\\",\\n6:   \\\"data\\\": {\\n7:     \\\"messageUI\\\": true\\n8:   },\\n9:   \\\"authoring\\\": {\\n10:     \\\"intents\\\": [\\n11:       \\\"render context retrieval results inside assistant messages\\\"\\n12:     ]\\n13:   }\\n14: }\\n15: \",\"hash\":\"7370a93b34c21c838365134558d2a22ad1f2fa43c002f364a8b3fe556907ae04\",\"totalLines\":15,\"nextOffset\":null}}","role":"tool"}

