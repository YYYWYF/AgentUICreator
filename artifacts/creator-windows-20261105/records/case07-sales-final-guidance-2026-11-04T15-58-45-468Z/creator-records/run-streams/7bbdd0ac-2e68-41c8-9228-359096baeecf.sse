data: {"type":"TOOL_CALL_RESULT","toolCallId":"chatcmpl-tool-9eb29441addd79e2","messageId":"93e71ac6-6867-4f1d-8beb-f86d5c8ff81b","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"373e8784ed400aa3d4982d94a83cffc45fb4fede729b539cc5b62ef39947bfd9\",\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"29f23a159ddd3b0f79b1b0668e0270d52473e07b81a5196504ef6a85adfe708b\",\"sectionId\":\"s1\",\"offset\":0,\"totalCharacters\":314,\"childSections\":[{\"sectionId\":\"s17\",\"title\":\"1. 让 Agent 返回事件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s34\",\"title\":\"2. 编写解析函数并配置事件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\"}}},{\"sectionId\":\"s71\",\"title\":\"3. 编写消息组件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s111\",\"title\":\"4. 注册并启用插件\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s111\"}}},{\"sectionId\":\"s157\",\"title\":\"5. 检查结果\",\"level\":2,\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s157\"}}}],\"content\":\"# 自定义 AG-UI 事件与消息渲染\\n\\n下面以“工单摘要”为例。Runtime 会将 `CUSTOM` 事件自动转成消息，你只需编写解析函数，再注册对应的插件渲染器。\\n\\n文件路径均相对于生成目录，默认是 `src/agent-ui/`。示例使用项目已有的 React 和 `zod`。\\n\\n相关代码放在同一个插件目录：\\n\\n```text\\nplugins/ticket-summary-message/\\n  schema.ts       # 数据解析\\n  index.tsx       # 消息组件、文案和渲染注册\\n  manifest.json   # 插件声明\\n  definition.ts   # 插件入口\\n```\\n\\n\",\"nextOffset\":null}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"chatcmpl-tool-a23d24777f08db28","toolCallName":"read_creator_documentation"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-a23d24777f08db28","delta":"{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"limit\":1200,\"offset\":0,\"sectionId\":\"s34\"}"}

