data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_01_j1uj2K1ohjBzXfso3xTc9570","delta":"{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s45\",\"offset\":0,\"limit\":5000}"}

