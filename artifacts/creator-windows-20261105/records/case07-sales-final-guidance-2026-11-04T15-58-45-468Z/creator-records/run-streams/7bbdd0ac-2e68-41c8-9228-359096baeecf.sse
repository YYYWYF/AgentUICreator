data: {"type":"TOOL_CALL_ARGS","toolCallId":"chatcmpl-tool-a1df30c4a6fe4c14","delta":"{\"targetPluginId\":\"sales-report-message\",\"desiredOutcome\":\"为 AG-UI CUSTOM 事件 app.sales.report 注册数据消息渲染器：解析 value.payload 中的 JSON 字符串（标题 + 月份/收入/订单数行），在聊天消息里以表格展示，收入列可按升/降序切换排序，点击某个月份行展示该月订单数量；payload 非法时给出可读的错误提示，其余既有消息渲染行为不变。\",\"workKind\":\"create-plugin\",\"missingCapabilities\":[\"app.sales.report CUSTOM 事件消息渲染器\",\"收入列排序交互\",\"行点击查看 order_count\"],\"deliveryContract\":{\"capability\":\"把 app.sales.report 事件 payload 的 JSON 字符串渲染为会话内销售报表表格，支持按收入排序与行点击查看订单数\",\"renderingCategory\":\"semantic-slot\",\"placement\":\"作为 data message UI 注册到会话消息内（applicationPlugins 组合，消息名 app.sales.report）\",\"lifecycle\":\"插件实例在 applicationPlugins 中启用时生效，停用即清理注册\",\"dependencies\":[\"@za38.03/agent-ui-plugins\",\"@za38.03/agent-ui-plugins/contracts\",\"zod\"],\"reusedComponents\":[],\"verificationMethod\":\"runtime\",\"interactions\":[\"点击收入列切换升序/降序\",\"点击某一月份行显示该月订单数量\"]}}"}

data: {"type":"TOOL_CALL_END","toolCallId":"chatcmpl-tool-a1df30c4a6fe4c14"}

