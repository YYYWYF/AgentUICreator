data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_01_npQkFIRyTdYLLZgmt3yL3645","messageId":"7571e1ec-d903-4a8f-b849-319c7c3fc1e6","content":"{\"ok\":true,\"result\":{\"pluginId\":\"context-retrieval-message\",\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"partial\",\"requested\":3,\"resolved\":1,\"unresolved\":2},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins/contracts\",\"symbols\":[{\"name\":\"defineDataMessageUI\",\"status\":\"unavailable\",\"reason\":\"Not exported by installed module @za38.03/agent-ui-plugins/contracts\",\"exportedNameSuggestions\":[],\"nextEvidence\":\"Suggestions are actual exports, not equivalent APIs. Compound members appear on the resolved parent export; other modules are not searched.\"},{\"name\":\"UIDataMessageUI\",\"status\":\"unavailable\",\"reason\":\"Not exported by installed module @za38.03/agent-ui-plugins/contracts\",\"exportedNameSuggestions\":[],\"nextEvidence\":\"Suggestions are actual exports, not equivalent APIs. Compound members appear on the resolved parent export; other modules are not searched.\"},{\"name\":\"UIPluginManifest\",\"status\":\"available\",\"type\":\"UIPluginManifest\",\"truncated\":false,\"memberNames\":[\"id\",\"name\",\"description\",\"version\",\"capabilities\",\"requiresRenderScope\",\"sidebar\",\"layout\",\"authoring\",\"application\",\"slots\",\"data\"],\"memberNamesTruncated\":false,\"members\":[{\"name\":\"id\",\"type\":\"string\",\"truncated\":false},{\"name\":\"name\",\"type\":\"string\",\"truncated\":false},{\"name\":\"description\",\"type\":\"string\",\"truncated\":false},{\"name\":\"version\",\"type\":\"string\",\"truncated\":false},{\"name\":\"capabilities\",\"type\":\"string[] | undefined\",\"truncated\":false},{\"name\":\"requiresRenderScope\",\"type\":\"boolean | undefined\",\"truncated\":false},{\"name\":\"sidebar\",\"type\":\"{ icon: AgentUISidebarIcon; labels?: { \\\"en-US\\\"?: string | undefined; \\\"zh-CN\\\"?: string | undefined; } | undefined; } | undefined\",\"truncated\":false},{\"name\":\"layout\",\"type\":\"{ width?: \\\"narrow\\\" | \\\"wide\\\" | undefined; } | undefined\",\"truncated\":false},{\"name\":\"authoring\",\"type\":\"{ intents: string[]; cleanup?: { removeWhenUnused: boolean; } | undefined; visualRole?: string | undefined; defaultPlacement?: PluginDefaultPlacement | undefined; recommendedSize?: { ...; } | undefined; } | undefined\",\"truncated\":true},{\"name\":\"application\",\"type\":\"{ gate?: { service: string; priority?: number | undefined; } | undefined; } | undefined\",\"truncated\":false},{\"name\":\"slots\",\"type\":\"{ children?: Readonly<Record<string, PluginChildSlotDefinition>> | undefined; } | undefined\",\"truncated\":false},{\"name\":\"data\",\"type\":\"{ messages?: boolean | undefined; state?: boolean | undefined; messageUI?: boolean | undefined; events?: readonly string[] | undefined; } | undefined\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"projection\":{\"kind\":\"installed_public_api\",\"referenceOnly\":true,\"pluginDetails\":{\"tool\":\"inspect_ui_plugin\",\"input\":{\"pluginId\":\"context-retrieval-message\"}},\"guidance\":\"API signatures only. For a large exported type, query the required export.member instead of reading all domains. This query does not select an editing target or grant source ownership.\"}}}","role":"tool"}

