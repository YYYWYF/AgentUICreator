data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_9edFEwOfiOYsjBQfJt8A8912","messageId":"b0f0c326-4b07-46c4-97cf-25a1bda8105f","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"373e8784ed400aa3d4982d94a83cffc45fb4fede729b539cc5b62ef39947bfd9\",\"query\":\"data message UI CUSTOM event renderer messageUI\",\"total\":127,\"offset\":0,\"entries\":[{\"documentId\":\"public:development/plugin-api\",\"title\":\"插件开发接口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/plugin-api.md\",\"summary\":\"项目插件由能力声明、组件和可选的服务生命周期组成。创建文件与注册步骤见创建自定义插件。修改已有官方插件外观时，先使用组件公开属性。\",\"sha256\":\"659aef8ff3bd74cf48227756d4c89fec05cab475f970d6bf6c1ddd05aba3b57c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\"}},\"matchingSections\":[{\"sectionId\":\"s360\",\"title\":\"消息与工具结果展示\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s360\"}}},{\"sectionId\":\"s50\",\"title\":\"插件定义\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s50\"}}},{\"sectionId\":\"s5\",\"title\":\"公共能力速查\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s5\"}}}]},{\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"29f23a159ddd3b0f79b1b0668e0270d52473e07b81a5196504ef6a85adfe708b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\"}},\"matchingSections\":[{\"sectionId\":\"s111\",\"title\":\"4. 注册并启用插件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s111\"}}},{\"sectionId\":\"s71\",\"title\":\"3. 编写消息组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s71\"}}},{\"sectionId\":\"s1\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:development/custom-renderers\",\"title\":\"自定义结果展示\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-renderers.md\",\"summary\":\"已有消息或工具结果需要不同的视觉结构时，在对应插件的项目入口中使用组件公开的渲染函数。保留原有消息名称、工具名称、运行状态，以及传给展示组件的当前消息或工具调用数据。 从自定义 AG-UI 事件开始接入新消息卡片时，见自定义 AG-UI 事件与消息渲染，其中包含事件格式、解析函数、插件注册与启用的完整示例。\",\"sha256\":\"1755a0b39145b093c5b9688528a8c591fe47c221fcbc0bf6bfe2684be972708a\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-renderers\"}},\"matchingSections\":[{\"sectionId\":\"s7\",\"title\":\"示例：调整图表数值\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-renderers\",\"sectionId\":\"s7\"}}},{\"sectionId\":\"s41\",\"title\":\"工具结果与其他消息\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-renderers\",\"sectionId\":\"s41\"}}},{\"sectionId\":\"s1\",\"title\":\"自定义结果展示\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-renderers\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"title\":\"统一 Plugins 包、内置源码目录与按需源码托管\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/architecture/npm-default-plugin-source-ownership.md\",\"summary\":\"npm 默认交付、项目薄应用层、源码接管授权、BASE/LOCAL/TARGET 与更新保护。\",\"sha256\":\"cbc8052587ee42d67d634c94f1fd9dac8ace5603ec4d4e92bf10e191af808eb0\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\"}},\"matchingSections\":[{\"sectionId\":\"s69\",\"title\":\"5. 薄应用层与语义接线\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s69\"}}},{\"sectionId\":\"s131\",\"title\":\"9. 默认组合与正式插件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s131\"}}},{\"sectionId\":\"s11\",\"title\":\"1. 通用基础设施与应用配置\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/npm-default-plugin-source-ownership\",\"sectionId\":\"s11\"}}}]},{\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"title\":\"Conversation Domain 架构\",\"source\":\"internal\",\"topic\":\"职责与所有权\",\"path\":\"references/docs/architecture/p3r-0-assistant-ui-conversation-domain-rebaseline.md\",\"summary\":\"Conversation Domain 当前所有权；assistant-ui Runtime、消息注册与 Custom Event 边界。\",\"sha256\":\"b2b0b4d9fc70734ea3ee03799137bfd83827b8a827c8b032008991dab1337b48\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\"}},\"matchingSections\":[{\"sectionId\":\"s45\",\"title\":\"数据、事件与展示\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s45\"}}},{\"sectionId\":\"s5\",\"title\":\"所有权\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s39\",\"title\":\"Frontend Tool 与 HITL\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/p3r-0-assistant-ui-conversation-domain-rebaseline\",\"sectionId\":\"s39\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s48\",\"title\":\"运行上下文回调\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s48\"}}},{\"sectionId\":\"s139\",\"title\":\"订阅 Agent 业务事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s139\"}}},{\"sectionId\":\"s92\",\"title\":\"Hooks 与界面组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s92\"}}}]},{\"documentId\":\"internal:source-citations\",\"title\":\"Sources / Citations\",\"source\":\"internal\",\"topic\":\"会话与交互\",\"path\":\"references/docs/source-citations.md\",\"summary\":\"Sources/Citations 引用数据 Schema、来源绑定及后端输出约定。\",\"sha256\":\"8b7ba78615ff09bedadd4c61077356d7c1c5b54d9061f14ee279d49e6ac9b7e6\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:source-citations\"}},\"matchingSections\":[{\"sectionId\":\"s5\",\"title\":\"原生 assistant-ui 链路\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:source-citations\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s11\",\"title\":\"AG-UI Reference Demo\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:source-citations\",\"sectionId\":\"s11\"}}},{\"sectionId\":\"s1\",\"title\":\"Sources / Citations\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:source-citations\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"internal:architecture/multimodal-output-phase-1\",\"title\":\"多模态工具结果展示\",\"source\":\"internal\",\"topic\":\"会话与交互\",\"path\":\"references/docs/architecture/multimodal-output-phase-1.md\",\"summary\":\"工具结果中文本、图片、音频、视频与文件的有序展示。\",\"sha256\":\"66b1e916999ec79c9e84982fd3219c8abaf9d4e8441a02326c247436ca048ee3\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/multimodal-output-phase-1\"}},\"matchingSections\":[{\"sectionId\":\"s5\",\"title\":\"协议与组合\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/multimodal-output-phase-1\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s38\",\"title\":\"验证\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/multimodal-output-phase-1\",\"sectionId\":\"s38\"}}},{\"sectionId\":\"s32\",\"title\":\"生成文件与 Mock\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/multimodal-output-phase-1\",\"sectionId\":\"s32\"}}}]}],\"nextOffset\":8}}","role":"tool"}

