n-activity.md\",\"summary\":\"Agent Plan Activity 的权威数据、计划状态与展示合同。\",\"sha256\":\"a5331bcb1c5f26c63a544cf76c4c0aab1d395225328e91d805deae2e29490a7b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\"}},\"matchingSections\":[{\"sectionId\":\"s37\",\"title\":\"Event ownership\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\",\"sectionId\":\"s37\"}}},{\"sectionId\":\"s7\",\"title\":\"Contract and presentation\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\",\"sectionId\":\"s7\"}}},{\"sectionId\":\"s1\",\"title\":\"Authoritative Agent Plan Activity\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"internal:architecture/authoritative-agent-plan-activity\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:development/custom-ag-ui-events\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/custom-ag-ui-events.md\",\"summary\":\"按步骤将自定义 CUSTOM 事件解析并显示为消息卡片。\",\"sha256\":\"29f23a159ddd3b0f79b1b0668e0270d52473e07b81a5196504ef6a85adfe708b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"自定义 AG-UI 事件与消息渲染\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s17\",\"title\":\"1. 让 Agent 返回事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s17\"}}},{\"sectionId\":\"s34\",\"title\":\"2. 编写解析函数并配置事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/custom-ag-ui-events\",\"sectionId\":\"s34\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s48\",\"title\":\"运行上下文回调\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s48\"}}},{\"sectionId\":\"s139\",\"title\":\"订阅 Agent 业务事件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s139\"}}},{\"sectionId\":\"s92\",\"title\":\"Hooks 与界面组件\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s92\"}}}]},{\"documentId\":\"public:development/agent-options\",\"title\":\"Agent 参数与配置\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/agent-options.md\",\"summary\":\"通过 Agent 参数设置服务地址、主题、语言，以及打开已有会话。首次挂载见 React 接入，完整类型见 React 页面参数与方法。\",\"sha256\":\"18e73f1fc5f6d6c600c8d53a420c6cb838e07ad28ba1d01b74c082bb21e1e16c\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/agent-options\"}},\"matchingSections\":[{\"sectionId\":\"s35\",\"title\":\"传入业务上下文\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"rea