data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_02_8jpDabVq1w4DGvEFpMPw3483","messageId":"0bc8e431-6838-48e7-b655-eae296b19546","content":"{\"ok\":true,\"result\":{\"pluginId\":\"context-retrieval-message\",\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":3,\"resolved\":3,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins\",\"symbols\":[{\"name\":\"defineDataMessageUI\",\"status\":\"available\",\"type\":\"<TData>(definition: DataMessageUIDefinition<TData>) => DataMessageUIDefinition<never>\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"parameterQueries\":[\"defineDataMessageUI.$parameter0\"],\"parameterContracts\":[{\"query\":\"defineDataMessageUI.$parameter0\",\"type\":\"DataMessageUIDefinition<TData>\",\"truncated\":false,\"propNames\":[\"name\",\"render\"],\"propNamesTruncated\":false,\"members\":[{\"name\":\"name\",\"type\":\"string\",\"truncated\":false},{\"name\":\"render\",\"type\":\"ComponentType<DataMessageUIRenderProps<TData>>\",\"truncated\":false}],\"membersTruncated\":false}],\"parameterContractsTruncated\":false,\"nextEvidence\":\"Invocation parameters are included in parameterContracts. Truncation flags identify omitted details; parameterQueries expand exact parameter paths.\",\"members\":[],\"membersTruncated\":false,\"returns\":[{\"type\":\"DataMessageUIDefinition<never>\",\"truncated\":false}],\"signaturesTruncated\":false},{\"name\":\"useAgentUILocaleCode\",\"status\":\"available\",\"type\":\"() => AgentUILocaleCode\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"members\":[],\"membersTruncated\":false,\"returns\":[{\"type\":\"AgentUILocaleCode\",\"truncated\":false}],\"signaturesTruncated\":false},{\"name\":\"useAgentUILocale\",\"status\":\"available\",\"type\":\"{ (): AgentUILocaleMessages; <N extends keyof AgentUILocaleMessages>(namespace: N): AgentUILocaleMessages[N]; }\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"members\":[],\"membersTruncated\":false,\"returns\":[{\"type\":\"AgentUILocaleMessages\",\"truncated\":false},{\"type\":\"AgentUILocaleMessages[N]\",\"truncated\":false}],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"projection\":{\"kind\":\"installed_public_api\",\"referenceOnly\":true,\"pluginDetails\":{\"tool\":\"inspect_ui_plugin\",\"input\":{\"pluginId\":\"context-retrieval-message\"}},\"guidance\":\"API signatures only. For a large exported type, query the required export.member instead of reading all domains. This query does not select an editing target or grant source ownership.\"}}}","role":"tool"}

data: {"type":"TOOL_CALL_START","toolCallId":"call_00_BSCffPb3zkDLu6det6xZ8937","toolCallName":"read_file"}

data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_00_BSCffPb3zkDLu6det6xZ8937","delta":"{\"file_path\":\"/skills/ag-ui-frontend/SKILL.md\",\"offset\":0,\"limit\":400}"}

