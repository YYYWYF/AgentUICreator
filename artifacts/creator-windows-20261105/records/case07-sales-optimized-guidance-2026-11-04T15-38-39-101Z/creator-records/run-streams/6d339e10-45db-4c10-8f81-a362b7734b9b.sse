data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_00_nWnjoAK9Sd0MPD79uB311619","messageId":"bc5c7dcc-d934-4e3b-824f-8fc900d5925a","content":"{\"ok\":true,\"result\":{\"path\":\"/package.json\",\"content\":\"1: {\\\"name\\\":\\\"ordinary-preview-host\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"dependencies\\\":{\\\"@assistant-ui/react-lexical\\\":\\\"0.2.15\\\",\\\"@lexical/history\\\":\\\"0.51.0\\\",\\\"@lexical/plain-text\\\":\\\"0.51.0\\\",\\\"@lexical/react\\\":\\\"0.51.0\\\",\\\"@lexical/utils\\\":\\\"0.51.0\\\",\\\"lexical\\\":\\\"0.51.0\\\",\\\"@za38.03/agent-ui-plugins\\\":\\\"workspace:*\\\",\\\"@za38.03/agent-ui-runtime\\\":\\\"workspace:*\\\",\\\"@za38.03/agent-ui-core\\\":\\\"workspace:*\\\",\\\"@za38.03/agent-ui-renderer\\\":\\\"workspace:*\\\",\\\"@base-ui/react\\\":\\\"1.8.0\\\",\\\"class-variance-authority\\\":\\\"0.7.1\\\",\\\"cn\\\":\\\"0.2.6\\\",\\\"lucide-react\\\":\\\"1.41.0\\\",\\\"react\\\":\\\"19.1.1\\\",\\\"react-dom\\\":\\\"19.1.1\\\",\\\"remark-gfm\\\":\\\"4.0.1\\\",\\\"zustand\\\":\\\"5.0.15\\\",\\\"zod\\\":\\\"4.5.4\\\"},\\\"devDependencies\\\":{\\\"tailwindcss\\\":\\\"4.3.3\\\",\\\"tw-animate-css\\\":\\\"1.4.0\\\",\\\"@tailwindcss/vite\\\":\\\"4.3.3\\\",\\\"vite\\\":\\\"8.3.0\\\",\\\"@vitejs/plugin-react\\\":\\\"6.1.1\\\",\\\"typescript\\\":\\\"7.0.2\\\",\\\"tsx\\\":\\\"4.20.6\\\",\\\"@types/react\\\":\\\"19.3.0\\\",\\\"@types/react-dom\\\":\\\"19.3.0\\\",\\\"@types/node\\\":\\\"20.19.43\\\"},\\\"packageManager\\\":\\\"pnpm@8.12.0\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node validate-build.mjs\\\",\\\"typecheck\\\":\\\"node node_modules/typescript/bin/tsc --noEmit\\\",\\\"verify:ui\\\":\\\"node verify-ui.mjs\\\"}}\",\"hash\":\"fbb5c32ebf841b804be47a30df589d8f2b8c6fe3e8edf2916114a0f892cef4ae\",\"totalLines\":1,\"nextOffset\":null}}","role":"tool"}

