data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_222fe4735d6746a690b79aee","delta":"{\"file_path\":\"/skills/ui-plugin-development/SKILL.md\",\"offset\":0,\"limit\":2000}"}

