data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_71c127664ef14b35b65c63ea","messageId":"2a392341-112e-40ed-9665-a41c96c2d007","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"c0190ce0113c44c938a625422461d3efdd634b35615c74e3efac8127bbf73c37\",\"asset\":{\"ownership\":\"project_source\",\"pluginId\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"directory\":\"quick-help-content\",\"manifestPath\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"definitionPath\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"capabilities\":[\"quick-help-content\"],\"authoring\":{\"intents\":[\"show quick help body text\",\"显示帮助正文\",\"在帮助卡片正文显示提示\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}},\"childSlots\":{},\"dataMessageUINames\":[],\"selected\":true},\"compositionParents\":[{\"instanceId\":\"p24\",\"slot\":\"body\",\"pluginId\":\"quick-help-card\",\"interpretation\":\"Current mounted parent boundary, not a selected mutation target or authority. A child action API does not describe append/replacement behavior in its parent. Use the parent's composition contract only if that boundary answers the requested change; preserve existing actions and permission checks.\"}],\"sharedTypes\":{\"status\":\"available\",\"queryResolution\":{\"status\":\"complete\",\"requested\":3,\"resolved\":3,\"unresolved\":0},\"statusMeaning\":\"available means the installed declaration module was inspected; queryResolution and each symbol status describe whether the requested contracts resolved.\",\"packageVersion\":\"0.0.1\",\"module\":\"@za38.03/agent-ui-plugins\",\"symbols\":[{\"name\":\"usePluginRenderScope\",\"status\":\"available\",\"type\":\"<T = unknown>() => UIPluginRenderScope<T> | null\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"members\":[],\"membersTruncated\":false,\"returns\":[{\"type\":\"UIPluginRenderScope<T> | null\",\"truncated\":false}],\"signaturesTruncated\":false},{\"name\":\"UIPluginRenderScope\",\"status\":\"available\",\"type\":\"UIPluginRenderScope<T>\",\"truncated\":false,\"memberNames\":[\"kind\",\"value\"],\"memberNamesTruncated\":false,\"members\":[{\"name\":\"kind\",\"type\":\"string\",\"truncated\":false},{\"name\":\"value\",\"type\":\"T\",\"truncated\":false}],\"membersTruncated\":false,\"returns\":[],\"signaturesTruncated\":false},{\"name\":\"useAgentUILocaleCode\",\"status\":\"available\",\"type\":\"() => AgentUILocaleCode\",\"truncated\":false,\"memberNames\":[],\"memberNamesTruncated\":false,\"members\":[],\"membersTruncated\":false,\"returns\":[{\"type\":\"AgentUILocaleCode\",\"truncated\":false}],\"signaturesTruncated\":false}],\"interpretation\":\"Installed public types and package-owned presentation contracts, not mutation authority. Queries: export.member; $parameter0 through $parameter9 for invocation props; $return for callable return; $element for array/index values; returned $variant0 through $variant7 paths for union branches. Types establish signatures, not runtime semantics; missing behavior facts must remain unverified. Unresolved queries and omitted details are explicit. Each presentation contract is returned once per root export in this response.\"},\"selected\":true,\"instances\":[{\"id\":\"p25\",\"pluginId\":\"quick-help-content\",\"enabled\":true,\"target\":{\"type\":\"plugin_slot\",\"parentInstanceId\":\"p24\",\"slot\":\"body\"},\"index\":0,\"effectiveEnabled\":true,\"runtimeInstanceId\":\"p25\"}],\"manifest\":{\"id\":\"quick-help-content\",\"name\":\"Quick Help Content\",\"description\":\"Bilingual usage-help sentence rendered inside the quick-help-card body slot.\",\"version\":\"0.0.1\",\"capabilities\":[\"quick-help-content\"],\"authoring\":{\"intents\":[\"show quick help body text\",\"显示帮助正文\",\"在帮助卡片正文显示提示\"],\"visualRole\":\"help card body content\",\"defaultPlacement\":{\"type\":\"plugin_slot\",\"parentPluginId\":\"quick-help-card\",\"slot\":\"body\"}}},\"definitionSource\":{\"content\":\"import type { UIPluginDefinition, UIPluginManifest } from \\\"@za38.03/agent-ui-plugins\\\";\\nimport manifestJson from \\\"./manifest.json\\\";\\nimport { QuickHelpContentPlugin } from \\\"./index\\\";\\n\\nconst definition: UIPluginDefinition = {\\n  manifest: manifestJson as UIPluginManifest,\\n  provides: [],\\n  inject: [],\\n  optionalInject: [\\\"agent-ui.locale\\\"],\\n  Component: QuickHelpContentPlugin,\\n};\\n\\nexport default definition;\\n\",\"truncated\":false,\"characters\":406},\"services\":{\"provides\":[],\"required\":[],\"optional\":[\"agent-ui.locale\"]},\"files\":[{\"path\":\"src/agent-ui/plugins/quick-help-content/definition.ts\",\"kind\":\"file\",\"bytes\":406},{\"path\":\"src/agent-ui/plugins/quick-help-content/index.tsx\",\"kind\":\"file\",\"bytes\":515},{\"path\":\"src/agent-ui/plugins/quick-help-content/manifest.json\",\"kind\":\"file\",\"bytes\":554},{\"path\":\"src/agent-ui/plugins/quick-help-content/styles.css\",\"kind\":\"file\",\"bytes\":168}],\"filesTruncated\":false}}","role":"tool"}

