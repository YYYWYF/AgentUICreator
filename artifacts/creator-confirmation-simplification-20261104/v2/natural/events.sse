data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_8cbb0c21b50349b0833b23a7","delta":"{\"targetPluginId\":\"quick-help-dismiss\",\"desiredOutcome\":\"新建 quick-help-dismiss 插件：一个“知道了”按钮，挂载到 existing quick-help-card（实例 p24）的 headerActions 槽位。点击后把帮助卡片内容区折叠/隐藏；随后点击卡片标题可重新展开。状态通过项目服务在卡片与按钮之间共享，切换 light/dark/violet 主题后仍然有效。保留现有 body 槽位中的 quick-help-content（p25）。\",\"workKind\":\"create-plugin\",\"deliveryContract\":{\"capability\":\"一键折叠帮助卡片内容，并提供中英双语文案与可访问名称\",\"renderingCategory\":\"semantic-slot\",\"placement\":\"quick-help-card 实例 p24 的 headerActions 子槽位\",\"lifecycle\":\"点击后更新卡片展开状态；停用或卸载时清理服务订阅\",\"dependencies\":[\"quick-help-card 提供的帮助卡片展开状态服务\"],\"reusedComponents\":[\"@za38.03/agent-ui-plugins 的 usePluginService / usePluginServiceSnapshot / useAgentUILocaleCode\"],\"verificationMethod\":\"runtime\"}}"}

