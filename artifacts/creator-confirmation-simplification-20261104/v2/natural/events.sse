data: {"type":"TOOL_CALL_ARGS","toolCallId":"call_a61e4e6360cc4bb4a6199f7f","delta":"{\"action\":\"read\",\"documentId\":\"internal:architecture/scoped-renderer-plugin\",\"offset\":0,\"limit\":4000,\"sectionId\":\"s5\"}"}

