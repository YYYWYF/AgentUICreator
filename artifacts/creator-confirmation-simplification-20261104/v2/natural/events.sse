data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_187684d05f1f4e0993b08a95","messageId":"5bfaaf32-f559-4d63-8419-06410b89ecaa","content":"{\"ok\":true,\"result\":{\"appUIModelHash\":\"c0190ce0113c44c938a625422461d3efdd634b35615c74e3efac8127bbf73c37\",\"capabilityCatalog\":{\"revision\":\"a2eb1933597edeac9f4954d748046d85ea87eb565d12f913263812f0338766b8\",\"pluginIds\":[\"add-attachment-action\",\"agent-identity\",\"composer\",\"context-retrieval-message\",\"conversation-data-source\",\"conversation-new\",\"conversation-quote\",\"conversation-service\",\"conversation-suggestions\",\"conversation-surface\",\"conversation-thread-list\",\"copy-action\",\"export-markdown-action\",\"locale-provider\",\"quick-help-card\",\"quick-help-content\",\"reasoning\",\"reload-action\",\"response-footer\",\"submit-action\",\"test-notice\",\"theme-provider\",\"theme-switch\",\"tool-group\",\"tool-result\",\"transient-assistant-messages\"],\"generatedFileFresh\":true},\"activeComposition\":{\"selectedPluginIds\":[\"add-attachment-action\",\"agent-identity\",\"composer\",\"context-retrieval-message\",\"conversation-data-source\",\"conversation-new\",\"conversation-quote\",\"conversation-service\",\"conversation-suggestions\",\"conversation-surface\",\"conversation-thread-list\",\"copy-action\",\"export-markdown-action\",\"locale-provider\",\"quick-help-card\",\"quick-help-content\",\"reasoning\",\"reload-action\",\"response-footer\",\"submit-action\",\"test-notice\",\"theme-provider\",\"theme-switch\",\"tool-group\",\"tool-result\",\"transient-assistant-messages\"],\"resolvedPluginIds\":[\"add-attachment-action\",\"agent-identity\",\"composer\",\"context-retrieval-message\",\"conversation-data-source\",\"conversation-new\",\"conversation-quote\",\"conversation-service\",\"conversation-suggestions\",\"conversation-surface\",\"conversation-thread-list\",\"copy-action\",\"export-markdown-action\",\"locale-provider\",\"quick-help-card\",\"quick-help-content\",\"reasoning\",\"reload-action\