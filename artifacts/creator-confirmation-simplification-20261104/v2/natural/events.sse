data: {"type":"TOOL_CALL_RESULT","toolCallId":"call_f8a6e4396eff4fc7a4384993","messageId":"226d6782-57ea-4e8e-bdc2-b5b6c8eb22c5","content":"{\"ok\":true,\"result\":{\"status\":\"available\",\"referenceOnly\":true,\"creatorVersion\":\"0.0.1\",\"versions\":{\"@za38.03/agent-ui-core\":\"0.0.1\",\"@za38.03/agent-ui-renderer\":\"0.0.1\",\"@za38.03/agent-ui-runtime\":\"0.0.1\",\"@za38.03/agent-ui-plugins\":\"0.0.1\",\"@za38.03/agent-ui-web-component\":\"0.0.1\",\"@za38.03/agent-ui-creator\":\"0.0.1\"},\"sourceDigest\":\"36c363e12ba6996246332ad2d3bbc5bbfdac9b49524ff624ed4a3387b850a575\",\"query\":\"services provide inject 服务 声明 观察者 getSnapshot subscribe\",\"total\":87,\"offset\":0,\"entries\":[{\"documentId\":\"public:plugins/locale-provider\",\"title\":\"语言服务（locale-provider）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/locale-provider.md\",\"summary\":\"接入统一语言服务，为插件提供当前语言和文案，不显示语言切换按钮。\",\"sha256\":\"894725aa8c0e12a1c793f0eb146cdd1c489626ed01f20b51645a22757a70b265\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/locale-provider\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"语言服务（locale-provider）\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/locale-provider\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/locale-provider\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s9\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/locale-provider\",\"sectionId\":\"s9\"}}}]},{\"documentId\":\"public:plugins/theme-provider\",\"title\":\"主题服务（theme-provider）\",\"source\":\"public\",\"topic\":\"插件\",\"path\":\"plugins/theme-provider.md\",\"summary\":\"接入统一主题服务，为插件提供当前主题，不显示主题切换按钮。\",\"sha256\":\"cfa8d89f1b568094b69d860de2954186fff14d0d108006ddcf826dfaac7f3b37\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/theme-provider\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"主题服务（theme-provider）\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/theme-provider\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s9\",\"title\":\"属性\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/theme-provider\",\"sectionId\":\"s9\"}}},{\"sectionId\":\"s5\",\"title\":\"手动开发\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:plugins/theme-provider\",\"sectionId\":\"s5\"}}}]},{\"documentId\":\"public:development/plugin-api\",\"title\":\"插件开发接口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/plugin-api.md\",\"summary\":\"项目插件由能力声明、组件和可选的服务生命周期组成。创建文件与注册步骤见创建自定义插件。修改已有官方插件外观时，先使用组件公开属性。\",\"sha256\":\"cd30e68bc788dd22fdccc937313217ed5e3c3816b86e84f9138f758709423720\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\"}},\"matchingSections\":[{\"sectionId\":\"s240\",\"title\":\"自定义服务\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s240\"}}},{\"sectionId\":\"s198\",\"title\":\"服务共享与状态订阅\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s198\"}}},{\"sectionId\":\"s1\",\"title\":\"插件开发接口\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/plugin-api\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:development/react-host-api\",\"title\":\"React 页面参数与方法\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-api.md\",\"summary\":\"AgentUIProvider 让业务组件与助理共享同一个会话。业务组件通过 useAgentUI() 发送消息、停止生成或新建会话，通过状态和事件 Hooks 更新页面。接入步骤、截图和完整代码见业务页面与 Agent 联动。\",\"sha256\":\"9bdc1d543a8d2af728da7757972ba7d35b76c8cba1bd9be1c4619aa3962e92ff\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\"}},\"matchingSections\":[{\"sectionId\":\"s5\",\"title\":\"Provider 属性表\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s1\",\"title\":\"React 页面参数与方法\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s61\",\"title\":\"会话方法\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-api\",\"sectionId\":\"s61\"}}}]},{\"documentId\":\"public:development/react-host-control\",\"title\":\"业务页面与 Agent 联动\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/react-host-control.md\",\"summary\":\"\",\"sha256\":\"a854709abc89e1b39e9dba85a5afbded4b307d50e199d08609d57f81a16281c6\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\"}},\"matchingSections\":[{\"sectionId\":\"s27\",\"title\":\"示例代码：Provider 接入\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\",\"sectionId\":\"s27\"}}},{\"sectionId\":\"s1\",\"title\":\"业务页面与 Agent 联动\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s132\",\"title\":\"其他方法示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/react-host-control\",\"sectionId\":\"s132\"}}}]},{\"documentId\":\"public:development/project-structure\",\"title\":\"工程结构与修改入口\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/project-structure.md\",\"summary\":\"初始化后，Agent UI 源码默认放在 src/agent-ui/。以下路径都相对于这个目录；初始化时选择了其他目录，就在实际目录中找同名文件。 不同版本或历史工程的目录可能不同，先检查已有组件的导入和导出。官方插件通常由项目入口导入 npm 实现；已经接管的插件则引用本地实现。 新工程只生成布局中选用的插件入口，以及读取服务、传入数据和显示子插件所需的代码，添加插件时再生成对应入口。已经存在的项目入口会保留。 服务相关 Hook 统一放在 services/hooks/ 下：useConversations.ts、useConversationActions.ts 和按需生成的 useAu\",\"sha256\":\"d12f5d52751a6ac2fdd49c8a308ac1b080e59b0cf6076e91bbf7ffaa729b73db\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"工程结构与修改入口\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/project-structure\",\"sectionId\":\"s1\"}}}]},{\"documentId\":\"public:development/attachments-dictation-feedback\",\"title\":\"附件、语音与评价服务\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/attachments-dictation-feedback.md\",\"summary\":\"通用能力已有默认实现。接入自己的服务时，通过 Agent 的 attachments、dictation、feedback 属性传入配置。也可以把接口说明交给 Creator 完成。\",\"sha256\":\"5f45a1a3339e56bd983bc715546053216a3e83c8b333b3603adba2f0d899f92f\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/attachments-dictation-feedback\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"附件、语音与评价服务\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/attachments-dictation-feedback\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s25\",\"title\":\"手动配置示例\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/attachments-dictation-feedback\",\"sectionId\":\"s25\"}}},{\"sectionId\":\"s19\",\"title\":\"反馈\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/attachments-dictation-feedback\",\"sectionId\":\"s19\"}}}]},{\"documentId\":\"public:development/connect-agent\",\"title\":\"连接 AG-UI 服务\",\"source\":\"public\",\"topic\":\"开发文档\",\"path\":\"development/connect-agent.md\",\"summary\":\"生成的 Agent 前端通过一个 AG-UI 接口与业务 Agent 通信。完成页面挂载后，在页面的 Agent 配置中填写服务地址，再验证消息与运行状态。\",\"sha256\":\"4d517fe43c1873492033fc6cfd0ca791aac8a984d6f59b2cd802ea19224c3c2b\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/connect-agent\"}},\"matchingSections\":[{\"sectionId\":\"s1\",\"title\":\"连接 AG-UI 服务\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/connect-agent\",\"sectionId\":\"s1\"}}},{\"sectionId\":\"s5\",\"title\":\"配置应用地址\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/connect-agent\",\"sectionId\":\"s5\"}}},{\"sectionId\":\"s17\",\"title\":\"验证实际响应\",\"nextRead\":{\"tool\":\"read_creator_documentation\",\"input\":{\"action\":\"read\",\"documentId\":\"public:development/connect-agent\",\"sectionId\":\"s17\"}}}]}],\"nextOffset\":8}}","role":"tool"}

