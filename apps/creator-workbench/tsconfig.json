{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../examples/agent-frontend/src/*"],
      "@agent-ui/creator/ui": ["../../packages/creator/src/ui/CreatorWorkbench.tsx"],
      "@agent-ui/creator/runtime-diagnostics": [
        "../../packages/creator/src/runtime-diagnostics/runtimeDiagnosticReporter.ts"
      ],
      "@agent-ui/creator/visual-observation": [
        "../../packages/creator/src/visual-observation/VisualObservationReporter.ts"
      ],
      "@agent-ui/example-agent-frontend/App": ["../../examples/agent-frontend/src/App.tsx"],
      "@agent-ui/mock-agent": ["../../packages/mock-agent/src/index.ts"],
      "@agent-ui/react": [
        "../../packages/react/src/index.ts"
      ],
      "@agent-ui/runtime-conversation": [
        "../../packages/runtime-conversation/src/index.ts"
      ],
      "@agent-ui/runtime-core": ["../../packages/runtime-core/src/index.ts"],
      "@agent-ui/runtime-react": ["../../packages/runtime-react/src/index.ts"],
      "@agent-ui/runtime-core/testing": [
        "../../packages/runtime-core/src/testing/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../../packages/creator/src/ui/**/*.tsx",
    "../../packages/creator/src/runtime-diagnostics/runtimeDiagnosticReporter.ts",
    "../../packages/creator/src/visual-observation/VisualObservationReporter.ts",
    "../../packages/creator/src/shared.ts",
    "../../examples/agent-frontend/app-ui/**/*.json",
    "../../examples/agent-frontend/framework/**/*.ts",
    "../../examples/agent-frontend/plugins/**/*.ts",
    "../../examples/agent-frontend/plugins/**/*.tsx",
    "../../examples/agent-frontend/runtime/**/*.ts",
    "../../examples/agent-frontend/runtime/**/*.tsx",
    "../../examples/agent-frontend/src/App.tsx",
    "../../examples/agent-frontend/src/preview-data.ts",
    "../../packages/mock-agent/src/**/*.ts",
    "../../packages/react/src/**/*.ts",
    "../../packages/react/src/**/*.tsx",
    "../../packages/runtime-conversation/src/**/*.ts",
    "../../packages/runtime-conversation/src/**/*.tsx",
    "../../packages/runtime-core/src/**/*.ts",
    "../../packages/runtime-react/src/**/*.ts",
    "../../packages/runtime-react/src/**/*.tsx"
  ]
}
