{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@za38.03/agent-ui-creator/ui": [
        "../../packages/creator/src/ui/CreatorWorkbench.tsx"
      ],
      "@za38.03/agent-ui-creator/runtime-diagnostics": [
        "../../packages/creator/src/runtime-diagnostics/runtimeDiagnosticReporter.ts"
      ],
      "@za38.03/agent-ui-creator/visual-observation": [
        "../../packages/creator/src/visual-observation/VisualObservationReporter.ts"
      ],
      "@za38.03/agent-ui-creator/mock-agent": [
        "../../packages/creator/src/mock-agent/index.ts"
      ],
      "@za38.03/agent-ui-plugins": [
        "../../packages/plugins/src/index.ts"
      ],
      "@za38.03/agent-ui-runtime": [
        "../../packages/runtime/src/index.ts"
      ],
      "@za38.03/agent-ui-core": [
        "../../packages/core/src/index.ts"
      ],
      "@za38.03/agent-ui-renderer": [
        "../../packages/renderer/src/index.ts"
      ],
      "@za38.03/agent-ui-core/testing": [
        "../../packages/core/src/testing/index.ts"
      ],
      "@za38.03/agent-ui-creator/host-preview": [
        "../../packages/creator/src/host-preview/hostPreviewWorkbench.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "host-preview.vite.config.ts",
    "../../packages/creator/src/ui/**/*.tsx",
    "../../packages/creator/src/runtime-diagnostics/runtimeDiagnosticReporter.ts",
    "../../packages/creator/src/visual-observation/VisualObservationReporter.ts",
    "../../packages/creator/src/shared.ts",
    "../../packages/creator/src/mock-agent/**/*.ts",
    "../../packages/plugins/src/**/*.ts",
    "../../packages/plugins/src/**/*.tsx",
    "../../packages/runtime/src/**/*.ts",
    "../../packages/runtime/src/**/*.tsx",
    "../../packages/core/src/**/*.ts",
    "../../packages/renderer/src/**/*.ts",
    "../../packages/renderer/src/**/*.tsx"
  ]
}
