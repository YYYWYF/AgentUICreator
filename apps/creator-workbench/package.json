{
  "name": "@agent-ui/creator-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:style-isolation": "playwright test -c playwright.embedded.config.ts",
    "predev": "node ../../scripts/prepare-workbench.mjs",
    "test:e2e:agent-connection": "node ../../scripts/prepare-workbench.mjs && playwright test -c playwright.agent-connection.config.ts",
    "typecheck:preview-tests": "tsc -p tsconfig.preview-tests.json --noEmit",
    "test:e2e:i18n-plugin-visual": "node ../../scripts/test-i18n-plugin-visual.mjs",
    "test:e2e:theme-commands": "node ../../scripts/prepare-workbench.mjs && playwright test -c playwright.theme-commands.config.ts"
  },
  "dependencies": {
    "@agent-ui/creator": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@agent-ui/project-control": "workspace:*",
    "@agent-ui/bootstrap": "workspace:*",
    "@agent-ui/mock-agent": "workspace:*"
  }
}
